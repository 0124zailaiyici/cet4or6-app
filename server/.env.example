# ==========================================
# 四级备考助手 - 本地代理服务器配置
# ==========================================
# 使用步骤：
#   1. 复制此文件为 .env
#   2. 填入你的 DeepSeek API Key
#   3. npm start 启动服务器
#   4. 在微信开发者工具中编译使用
# ==========================================

# DeepSeek API 密钥（必填）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# DeepSeek API 地址（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本地服务器端口
PORT=3001
