# ==========================================
# 四级备考助手 - 本地代理服务器配置
# ==========================================
# 使用步骤：
#   1. 复制此文件为 .env
#   2. 填入 DeepSeek API Key 或配置 Ollama
#   3. npm start 启动服务器
#   4. 在微信开发者工具中编译使用
# ==========================================

# === 方案A: DeepSeek（远程API，需要Key）===
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here
# DeepSeek API 地址（一般无需修改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 方案B: Ollama（本地免费模型，不需要Key）===
# 设置 Ollama 地址后优先使用本地模型
# OLLAMA_URL=http://localhost:11434
# Ollama 模型名称（默认 qwen2.5:7b）
# OLLAMA_MODEL=qwen2.5:7b

# === 访问令牌（部署到公网时必须设置）===
# 微信小程序端通过 wx.setStorageSync('api_token', 'xxx') 配置
# 不设置时本地开发不校验，方便调试
API_ACCESS_TOKEN=your-random-secret-token

# 本地服务器端口
PORT=3001
