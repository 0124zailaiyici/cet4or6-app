<view class="page">
  <view class="page-header">
    <text class="page-title">学习统计</text>
  </view>

  <view class="checkin-summary">
    <view class="ci-card">
      <text class="ci-num">{{streak}}</text>
      <text class="ci-label">连续天数 🔥</text>
    </view>
    <view class="ci-card">
      <text class="ci-num">{{totalCheckins}}</text>
      <text class="ci-label">累计打卡 ✅</text>
    </view>
    <view class="ci-card">
      <text class="ci-num">{{totalCompleted}}</text>
      <text class="ci-label">完成题数 📝</text>
    </view>
  </view>

  <view class="calendar-section">
    <text class="section-title">📅 {{monthYear}} 打卡记录</text>
    <view class="calendar">
      <view class="cal-row cal-header">
        <text class="cal-h">日</text>
        <text class="cal-h">一</text>
        <text class="cal-h">二</text>
        <text class="cal-h">三</text>
        <text class="cal-h">四</text>
        <text class="cal-h">五</text>
        <text class="cal-h">六</text>
      </view>
      <view class="cal-row" wx:for="{{calendarRows}}" wx:key="*this">
        <view
          class="cal-cell {{cell.day === null ? 'empty' : ''}} {{cell.isToday ? 'today' : ''}} {{cell.checked ? 'checked' : ''}}"
          wx:for="{{item}}"
          wx:for-item="cell"
          wx:key="day"
        >
          <text wx:if="{{cell.day !== null}}">{{cell.day}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="overview-grid">
    <view class="overview-card">
      <text class="ov-num">{{listenedCount}}</text>
      <text class="ov-label">听力精听</text>
    </view>
    <view class="overview-card">
      <text class="ov-num">{{masteredCount}}</text>
      <text class="ov-label">句子掌握</text>
    </view>
    <view class="overview-card">
      <text class="ov-num">{{translationCount}}</text>
      <text class="ov-label">翻译练习</text>
    </view>
    <view class="overview-card">
      <text class="ov-num">{{writingCount}}</text>
      <text class="ov-label">写作练习</text>
    </view>
  </view>

  <view class="section" wx:if="{{maxScores.length > 0}}">
    <text class="section-title">翻译成绩趋势</text>
    <view class="chart">
      <view class="bar-item" wx:for="{{maxScores}}" wx:key="*this">
        <view class="bar-fill" style="height: {{item * 2.5}}rpx;"></view>
        <text class="bar-label">{{item}}分</text>
      </view>
    </view>
  </view>

  <view class="section" wx:else>
    <text class="section-title">学习建议</text>
    <view class="tip-block">
      <text class="tip-text">开始学习后，这里将展示你的成绩趋势和分析报告。</text>
      <text class="tip-text">建议每天完成：1篇听力 + 5个句子 + 1篇翻译 + 1篇写作</text>
    </view>
  </view>

  <view class="clear-btn" catchtap="clearData">清除所有记录</view>
</view>
