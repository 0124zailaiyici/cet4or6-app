<view class="page {{darkMode ? 'dark-theme' : ''}}" style="--fs: {{fs}}">
  <view class="topbar"><view class="h1">学习统计</view><view class="p">你的进步，一清二楚</view></view>

  <view class="body" scroll-y scroll-with-animation>
    <!-- Summary cards -->
    <view class="sum">
      <view class="sc"><text class="n">{{streak}}</text><text class="l">🔥 连续学习</text></view>
      <view class="sc"><text class="n">{{totalItems}}</text><text class="l">📝 累计题数</text></view>
      <view class="sc"><text class="n">{{accuracy}}%</text><text class="l">✅ 正确率</text></view>
      <view class="sc"><text class="n">{{monthDays}}</text><text class="l">📅 本月学习</text></view>
    </view>

    <!-- Weekly trend -->
    <view class="card">
      <view class="st">📈 本周趋势</view>
      <view class="chart">
        <view class="bar" wx:for="{{weekBars}}" wx:key="*this">
          <view class="fill" style="height:{{item.h}}%;background:{{item.today ? 'linear-gradient(180deg,#4fc3f7,#2196f3)' : 'linear-gradient(180deg,#ff8fab,#ff6b8a)'}}"></view>
          <text class="dl {{item.today ? 'on' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- Module accuracy -->
    <view class="card">
      <view class="st">📊 各模块正确率</view>
      <view class="row" wx:for="{{modules}}" wx:key="label">
        <text class="mi">{{item.icon}}</text>
        <view class="mb">
          <view class="mn"><text>{{item.label}}</text><text class="mr">{{item.detail}}</text></view>
          <view class="mm"><view class="mf" style="width:{{item.pct}}%;background:{{item.color}}"></view></view>
        </view>
      </view>
    </view>

    <!-- Stats table -->
    <view class="card">
      <view class="st">📋 详细数据</view>
      <view class="srow"><text>累计学习天数</text><text class="sv">{{streak > 0 ? streak > 30 ? streak : streak : 0}} 天</text></view>
      <view class="srow"><text>总做题数</text><text class="sv">{{totalCorrect + totalWrong}} 题</text></view>
      <view class="srow"><text>答对题数</text><text class="sv">{{totalCorrect}} 题</text></view>
      <view class="srow"><text>答错题数</text><text class="sv">{{totalWrong}} 题</text></view>
      <view class="srow"><text>最长连续</text><text class="sv">{{streak}} 天</text></view>
    </view>

    <!-- Calendar -->
    <view class="card">
      <view class="st"><text>🔥 学习日历</text><text class="more">{{monthLabel}}</text></view>
      <view class="cal-h"><text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text></view>
      <view class="cal-row" wx:for="{{calendar}}" wx:key="*this" wx:for-item="row">
        <view class="cd {{item.day === null ? 'emp' : ''}} {{item.level > 2 ? 'strong' : item.level > 1 ? 'mid' : item.level > 0 ? 'light' : ''}} {{item.isToday ? 'today' : ''}}" wx:for="{{row}}" wx:for-item="item" wx:key="day"><text wx:if="{{item.day !== null}}">{{item.day}}</text></view>
      </view>
    </view>

    <!-- Achievements -->
    <view class="card">
      <view class="st">🏆 成就</view>
      <view class="ach-grid">
        <view class="ach {{item.unlocked ? '' : 'locked'}}" wx:for="{{achievements}}" wx:key="name">
          <text class="ae">{{item.emoji}}</text>
          <text class="an">{{item.name}}</text>
          <view class="al" wx:if="{{!item.unlocked}}">🔒</view>
        </view>
      </view>
    </view>

    <view class="clear-btn" catchtap="clearData">清除所有记录</view>
  </view>

<!-- 字号调节 -->
<view class="fs-ctrl {{fsOpen ? 'fs-show' : ''}}">
  <view class="fs-btn-box" catchtap="toggleFs">
    <text class="fs-btn-icon">Aa</text>
  </view>
  <view class="fs-slider" wx:if="{{fsOpen}}">
    <text class="fs-label fs-dec" catchtap="changeFs" data-d="-2">A−</text>
    <view class="fs-track">
      <view class="fs-fill" style="width: {{(fs - 12) / 14 * 100}}%"></view>
      <view class="fs-thumb" style="left: {{(fs - 12) / 14 * 100}}%"></view>
    </view>
    <text class="fs-label fs-inc" catchtap="changeFs" data-d="2">A+</text>
  </view>
</view>
</view>
