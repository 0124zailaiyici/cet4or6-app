.page {
  min-height: 100vh;
  padding: 32rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.overview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.overview-card {
  width: calc(33.33% - 11rpx);
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.1);
  text-align: center;
}

.ov-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.ov-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.section {
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.1);
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.chart {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  height: 280rpx;
  padding: 0 8rpx;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  height: 100%;
  justify-content: flex-end;
}

.bar-fill {
  width: 100%;
  max-width: 40rpx;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx;
  background: linear-gradient(180deg, #ff9eb5, var(--pink-dark));
  transition: height 0.6s;
}

.bar-label {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.tip-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.checkin-summary {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ci-card {
  flex: 1;
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.1);
  text-align: center;
}

.ci-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ff9eb5;
}

.ci-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.calendar-section {
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.1);
  margin-bottom: 24rpx;
}

.calendar {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cal-row {
  display: flex;
  gap: 8rpx;
}

.cal-h {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #b5a0c0;
  padding: 8rpx 0;
}

.cal-cell {
  flex: 1;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.cal-cell.empty {
  background: transparent;
}

.cal-cell.today {
  border: 2rpx solid #ff9eb5;
  font-weight: 600;
}

.cal-cell.checked {
  background: rgba(255, 158, 181, 0.15);
  color: #ff9eb5;
  font-weight: 600;
}

.clear-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--peach);
  color: var(--peach);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 211, 182, 0.08);
}
