<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="page-header">
    <text class="page-title">英语词典</text>
    <view class="ai-badge {{aiAvailable ? '' : 'hidden'}} {{aiEnabled ? '' : 'off'}}" catchtap="toggleAi">
      <text class="ai-dot"></text>
      <text>AI</text>
    </view>
  </view>

  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="输入要查的英文单词…" value="{{query}}" bindinput="onInput" confirm-type="search" bindconfirm="search" />
    <text class="search-clear" wx:if="{{query}}" catchtap="clear">✕</text>
    <text class="search-btn" catchtap="search">{{loading ? '…' : '搜索'}}</text>
  </view>

  <view class="loading-tip" wx:if="{{loading}}">
    <text class="loading-dot">•</text>
    <text>查询中…</text>
  </view>

  <block wx:if="{{error}}">
    <view class="empty-state">
      <text class="empty-icon">😕</text>
      <text class="empty-text">{{error}}</text>
      <view class="history-section" wx:if="{{history.length > 0}}">
        <text class="section-title">试试这些：</text>
        <view class="history-list">
          <text class="history-item" wx:for="{{history}}" wx:key="*this" catchtap="search" data-word="{{item}}">{{item}}</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{result}}">
    <view class="result-card">
      <view class="card-word">
        <view class="word-row">
          <text class="word-large">{{result.word}}</text>
          <text class="word-phonetic" wx:if="{{result.phonetic}}">{{result.phonetic}}</text>
          <text class="word-audio" wx:if="{{result.audio}}" catchtap="playAudio">🔊</text>
        </view>
        <view class="word-meta">
          <text class="meta-count" wx:if="{{result.meanings.length > 0}}">{{result.meanings.length}} 项释义</text>
          <text class="meta-examples" wx:if="{{exampleCount > 0}}">{{exampleCount}} 条例句</text>
        </view>
        <view class="word-chinese" wx:if="{{result.chinese}}">
          <text class="chinese-label">{{aiEnabled && aiAvailable ? '🤖' : '🌐'}}</text>
          <text class="chinese-value">{{result.chinese}}</text>
        </view>
      </view>

      <view class="card-body">
        <view class="meaning-group" wx:for="{{result.meanings}}" wx:key="partOfSpeech">
          <view class="pos-row">
            <text class="pos-badge {{item._posClass}}">{{item.partOfSpeech}}</text>
            <view class="pos-words" wx:if="{{item.synonyms.length > 0}}">
              <text class="pos-label">同义</text>
              <text class="pos-word" wx:for="{{item.synonyms}}" wx:for-index="si" wx:key="si">{{item}}</text>
            </view>
          </view>
          <view class="def-list">
            <view class="def-item" wx:for="{{item.definitions}}" wx:key="definition">
              <text class="def-num">{{index + 1}}.</text>
              <view class="def-body">
                <text class="def-text">{{item.definition}}</text>
                <text class="def-cn" wx:if="{{item.definitionCn}}">{{item.definitionCn}}</text>
                <text class="def-example" wx:if="{{item.example}}">{{item.example}}</text>
                <text class="def-example-cn" wx:if="{{item.exampleCn}}">{{item.exampleCn}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="add-vocab {{adding ? 'done' : ''}}" catchtap="addToVocab">{{adding ? '✅ 已加入单词本' : '➕ 加入单词本'}}</view>
    </view>
  </block>

  <block wx:elif="{{!query && history.length > 0}}">
    <view class="history-section">
      <text class="section-title">最近查询</text>
      <view class="history-list">
        <text class="history-item" wx:for="{{history}}" wx:key="*this" catchtap="search" data-word="{{item}}">{{item}}</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="empty-state">
      <text class="empty-icon">📖</text>
      <text class="empty-text">输入英文单词查释义</text>
      <text class="empty-hint">支持音标、词性、例句、发音</text>
    </view>
  </block>

<!-- 字号调节 -->
<view class="fs-ctrl {{fsOpen ? 'fs-show' : ''}}">
  <view class="fs-btn-box" catchtap="toggleFs">
    <text class="fs-btn-icon">Aa</text>
  </view>
  <view class="fs-panel" wx:if="{{fsOpen}}">
    <view class="fs-row">
      <text class="fs-row-label">标题</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="title" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsTitle}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="title" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">正文</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="body" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsBody}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="body" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">选项</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="opt" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsOpt}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="opt" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">按钮</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="btn" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsBtn}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="btn" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">辅助</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="sm" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsSm}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="sm" data-d="2">+</text>
      </view>
    </view>
  </view>
</view>
</view>
