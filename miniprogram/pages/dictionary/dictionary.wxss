.page {
  min-height: 100vh;
  padding: 32rpx;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.ai-badge {
  display: flex; align-items: center; gap: 6rpx; padding: 6rpx 16rpx;
  border-radius: 24rpx; background: rgba(244,114,182,0.06); font-size: 20rpx;
  color: #f472b6; font-weight: 500;
}
.ai-badge.hidden { display: none; }
.ai-badge.off { opacity: 0.35; }
.ai-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #66bb6a; transition: background 0.2s;
}
.ai-badge.off .ai-dot { background: #ccc; }

.search-bar {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.1);
  gap: 12rpx;
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}

.search-clear {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 8rpx;
}

.search-btn {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #ff9eb5, var(--pink-dark));
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.loading-tip {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 40rpx 0; font-size: 26rpx; color: var(--text-secondary);
}

@keyframes dotPulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }
.loading-dot { animation: dotPulse 1s ease-in-out infinite; }

.error-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.error-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.result-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.word {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.phonetic {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-style: italic;
}

.audio-btn {
  font-size: 36rpx;
  padding: 4rpx 8rpx;
}

.chinese-block {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 158, 181, 0.08);
}

.chinese-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  display: block;
}

.chinese-text {
  font-size: 34rpx;
  color: var(--text-primary);
  font-weight: 600;
  line-height: 1.5;
}

.meaning-block {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 158, 181, 0.08);
}

.pos-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #ff9eb5;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 158, 181, 0.1);
  margin-bottom: 16rpx;
}

.def-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.def-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.def-example {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  font-style: italic;
}

.history-section {
  margin-top: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: block;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  font-size: 26rpx;
  color: #ff9eb5;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 158, 181, 0.1);
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
}
