.page {
  min-height: 100vh;
  padding: 28rpx;
}

/* ── 顶部导航 ── */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.page-title {
  font-size: calc(38 * var(--fs-title) / 16 * 1rpx);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.ai-badge {
  display: flex; align-items: center; gap: 6rpx; padding: 6rpx 16rpx;
  border-radius: 24rpx; background: rgba(244,114,182,0.06); font-size: calc(20 * var(--fs-sm) / 16 * 1rpx);
  color: #f472b6; font-weight: 500;
}
.ai-badge.hidden { display: none; }
.ai-badge.off { opacity: 0.35; }
.ai-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #66bb6a; transition: background 0.2s;
}
.ai-badge.off .ai-dot { background: #ccc; }

/* ── 搜索栏 ── */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: 60rpx;
  padding: 0 12rpx 0 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 158, 181, 0.06);
  gap: 8rpx;
  border: 2rpx solid rgba(255, 158, 181, 0.06);
}

.search-icon {
  font-size: calc(28 * var(--fs-body) / 16 * 1rpx);
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: calc(28 * var(--fs-body) / 16 * 1rpx);
  color: var(--text-primary);
}

.search-clear {
  font-size: calc(32 * var(--fs-body) / 16 * 1rpx);
  color: var(--text-secondary);
  padding: 8rpx 12rpx;
  flex-shrink: 0;
}

.search-btn {
  padding: 12rpx 28rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #ff9eb5, #e8789a);
  color: #fff;
  font-size: calc(26 * var(--fs-btn) / 16 * 1rpx);
  font-weight: 600;
  flex-shrink: 0;
}

.search-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

/* ── 加载骨架 ── */
.loading-tip {
  display: flex;
  align-items: center; justify-content: center; gap: 10rpx;
  padding: 80rpx 0; font-size: calc(26 * var(--fs-body) / 16 * 1rpx); color: var(--text-secondary);
}

@keyframes dotPulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }
.loading-dot { animation: dotPulse 1s ease-in-out infinite; font-size: calc(32 * var(--fs-body) / 16 * 1rpx); }

/* ── 空状态 / 错误 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: calc(88 * var(--fs-body) / 16 * 1rpx);
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: calc(30 * var(--fs-body) / 16 * 1rpx);
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 10rpx;
  text-align: center;
}

.empty-hint {
  font-size: calc(26 * var(--fs-sm) / 16 * 1rpx);
  color: var(--text-secondary);
  text-align: center;
}

/* ── 结果卡片 ── */
.result-card {
  background: var(--card-bg);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(255, 158, 181, 0.06);
  animation: cardFadeIn 0.35s ease-out;
}

@keyframes cardFadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 单词头部 */
.card-word {
  padding: 36rpx 28rpx 28rpx;
  background: linear-gradient(135deg, rgba(255, 158, 181, 0.08), rgba(244, 114, 182, 0.02));
  border-bottom: 2rpx solid rgba(255, 158, 181, 0.06);
}

.word-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.word-large {
  font-size: calc(56 * var(--fs-body) / 16 * 1rpx);
  font-weight: 800;
  color: var(--text-primary);
}

.word-phonetic {
  font-size: calc(28 * var(--fs-body) / 16 * 1rpx);
  color: var(--text-secondary);
  font-style: italic;
}

.word-audio {
  font-size: calc(40 * var(--fs-body) / 16 * 1rpx);
  padding: 8rpx;
  margin-left: auto;
}

.word-audio:active {
  transform: scale(0.9);
}

.word-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}

.meta-count, .meta-examples {
  font-size: calc(20 * var(--fs-sm) / 16 * 1rpx);
  color: var(--text-secondary);
  opacity: 0.6;
}

.word-chinese {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 158, 181, 0.08);
}

.chinese-label {
  font-size: calc(26 * var(--fs-sm) / 16 * 1rpx);
}

.chinese-value {
  font-size: calc(38 * var(--fs-body) / 16 * 1rpx);
  color: var(--text-primary);
  font-weight: 600;
  line-height: 1.4;
}

/* 释义主体 */
.card-body {
  padding: 4rpx 0;
}

.meaning-group {
  padding: 28rpx 28rpx;
  position: relative;
}

.meaning-group::after {
  content: '';
  position: absolute;
  left: 28rpx; right: 28rpx; bottom: 0;
  height: 2rpx;
  background: rgba(255, 158, 181, 0.04);
}

.meaning-group:last-child::after {
  display: none;
}

.pos-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.pos-badge {
  font-size: calc(22 * var(--fs-sm) / 16 * 1rpx);
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}

.pos-badge.noun { color: #f472b6; background: rgba(244,114,182,0.1); }
.pos-badge.verb { color: #60a5fa; background: rgba(96,165,250,0.1); }
.pos-badge.adjective { color: #34d399; background: rgba(52,211,153,0.1); }
.pos-badge.adverb { color: #a78bfa; background: rgba(167,139,250,0.1); }
.pos-badge.preposition { color: #fb923c; background: rgba(251,146,60,0.1); }
.pos-badge.conjunction { color: #fbbf24; background: rgba(251,191,36,0.1); }
.pos-badge.pronoun { color: #f472b6; background: rgba(244,114,182,0.1); }
.pos-badge.interjection { color: #2dd4bf; background: rgba(45,212,191,0.1); }

.pos-words {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
}

.pos-label {
  font-size: calc(18 * var(--fs-sm) / 16 * 1rpx);
  color: var(--text-secondary);
  margin-right: 4rpx;
}

.pos-word {
  font-size: calc(20 * var(--fs-body) / 16 * 1rpx);
  color: #f472b6;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(244,114,182,0.06);
}

.def-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.def-item {
  display: flex;
  gap: 14rpx;
}

.def-num {
  font-size: calc(22 * var(--fs-sm) / 16 * 1rpx);
  color: var(--text-secondary);
  font-weight: 600;
  width: 32rpx;
  flex-shrink: 0;
  line-height: 1.7;
}

.def-body {
  flex: 1;
}

.def-text {
  display: block;
  font-size: calc(28 * var(--fs-body) / 16 * 1rpx);
  color: var(--text-primary);
  line-height: 1.65;
}

.def-cn {
  display: block;
  font-size: calc(26 * var(--fs-body) / 16 * 1rpx);
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.5;
}

.def-example {
  display: block;
  font-size: calc(24 * var(--fs-body) / 16 * 1rpx);
  color: #999;
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 158, 181, 0.04);
  border-radius: 12rpx;
  font-style: italic;
  line-height: 1.5;
}

.def-example-cn {
  display: block;
  font-size: calc(22 * var(--fs-body) / 16 * 1rpx);
  color: var(--text-secondary);
  margin-top: 4rpx;
  padding-left: 16rpx;
  line-height: 1.4;
}

/* ── 查询历史 ── */
.history-section {
  margin-top: 8rpx;
}

.section-title {
  font-size: calc(28 * var(--fs-title) / 16 * 1rpx);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: block;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  font-size: calc(26 * var(--fs-body) / 16 * 1rpx);
  color: #ff9eb5;
  padding: 14rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 158, 181, 0.08);
}

.history-item:active {
  opacity: 0.6;
  transform: scale(0.95);
}

.add-vocab {
  text-align: center; padding: 24rpx; margin-top: 20rpx;
  border-radius: 16rpx; font-size: calc(28 * var(--fs-body) / 16 * 1rpx); font-weight: 600;
  color: #1e88e5; border: 2rpx solid rgba(30,136,229,0.2);
}
.add-vocab.done {
  color: #388e3c; border-color: rgba(56,142,60,0.2); background: rgba(56,142,60,0.04);
}
.dark-theme .add-vocab { color: #4fc3f7; border-color: rgba(79,195,247,0.2); }
.dark-theme .add-vocab.done { color: #66bb6a; border-color: rgba(102,187,106,0.2); background: rgba(102,187,106,0.08); }
