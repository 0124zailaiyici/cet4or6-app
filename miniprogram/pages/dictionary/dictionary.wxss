.page {
  min-height: 100vh;
  padding: 32rpx;
}

.page-header {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2d2d4e;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.1);
  gap: 12rpx;
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: #2d2d4e;
}

.search-clear {
  font-size: 28rpx;
  color: #8a7a9a;
  padding: 8rpx;
}

.search-btn {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #ff9eb5, #ff8a80);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.error-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.error-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.error-text {
  font-size: 28rpx;
  color: #8a7a9a;
}

.result-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.word {
  font-size: 48rpx;
  font-weight: 700;
  color: #2d2d4e;
}

.phonetic {
  font-size: 30rpx;
  color: #8a7a9a;
  font-style: italic;
}

.meaning-block {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 158, 181, 0.08);
}

.pos-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #ff9eb5;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 158, 181, 0.1);
  margin-bottom: 16rpx;
}

.def-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.def-text {
  display: block;
  font-size: 28rpx;
  color: #2d2d4e;
  line-height: 1.6;
}

.def-example {
  display: block;
  font-size: 24rpx;
  color: #8a7a9a;
  margin-top: 6rpx;
  font-style: italic;
}

.history-section {
  margin-top: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d2d4e;
  margin-bottom: 20rpx;
  display: block;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  font-size: 26rpx;
  color: #ff9eb5;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 158, 181, 0.1);
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #2d2d4e;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #8a7a9a;
}
