.page { min-height: 100vh; background: #f3eeed; }
.topbar {
  display: flex; align-items: center; gap: 10px;
  padding: 48rpx 24rpx 14rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #ffb3c6, #ff8fab); color: #fff;
}
.topbar .h1 { flex: 1; font-size: calc(34 * var(--fs-title) / 16 * 1rpx); font-weight: 800; }
.topbar .tag { font-size: calc(22 * var(--fs-btn) / 16 * 1rpx); background: rgba(255,255,255,0.2); padding: 4rpx 16rpx; border-radius: 12rpx; }

.card { background: #fff; margin: 12rpx 20rpx; border-radius: 18rpx; padding: 20rpx; box-shadow: 0 2rpx 12rpx rgba(255,158,181,0.04); }
.types { display: flex; gap: 8rpx; flex-wrap: wrap; margin-bottom: 16rpx; }
.t { font-size: calc(22 * var(--fs-body) / 16 * 1rpx); color: #8a7a9a; background: #fff0f3; padding: 8rpx 18rpx; border-radius: 20rpx; border: 2rpx solid transparent; }
.t.on { color: #ff6b8a; background: rgba(255,107,138,0.06); border-color: rgba(255,107,138,0.15); }

.input {
  width: 100%; padding: 16rpx; border-radius: 14rpx; border: 2rpx solid #fff0f3;
  background: #fafafa; font-size: calc(26 * var(--fs-body) / 16 * 1rpx); color: #2d2d4e; outline: none;
  resize: none; height: 200rpx; box-sizing: border-box;
}
.input::placeholder { color: #c0c0c0; }
.count { text-align: right; font-size: calc(20 * var(--fs-sm) / 16 * 1rpx); color: #ccc; margin-top: 4rpx; }

.submit {
  margin-top: 16rpx; padding: 20rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #ff8fab, #ff6b8a); color: #fff;
  text-align: center; font-size: calc(28 * var(--fs-body) / 16 * 1rpx); font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.2);
}
.submit:active { opacity: 0.9; }
.note { display: block; font-size: calc(22 * var(--fs-body) / 16 * 1rpx); color: #8a7a9a; text-align: center; margin-top: 12rpx; }

.link { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid #fff0f3; font-size: calc(26 * var(--fs-body) / 16 * 1rpx); color: #2d2d4e; }
.link:last-child { border-bottom: none; }
.arrow { font-size: calc(32 * var(--fs-body) / 16 * 1rpx); color: #ccc; }
.ver { font-size: calc(24 * var(--fs-body) / 16 * 1rpx); color: #8a7a9a; }

.dark-theme.page { background: #12121f !important; }
.dark-theme .topbar { background: linear-gradient(135deg, #2a2a4a, #1a1a38) !important; }
.dark-theme .card { background: #1e1e38 !important; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.2) !important; }
.dark-theme .t { background: #2a2a4a !important; color: #a090b0 !important; }
.dark-theme .t.on { color: #ff8fab !important; background: rgba(255,143,171,0.08) !important; border-color: rgba(255,143,171,0.2) !important; }
.dark-theme .input { background: #2a2a4a !important; color: #e0d0e8 !important; border-color: #3a3a5a !important; }
.dark-theme .note { color: #a090b0 !important; }
.dark-theme .link { color: #e0d0e8 !important; border-color: #2a2a4a !important; }
.dark-theme .arrow { color: #6a6a8a !important; }
.dark-theme .ver { color: #a090b0 !important; }
