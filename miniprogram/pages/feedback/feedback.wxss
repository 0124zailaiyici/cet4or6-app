.page { min-height: 100vh; background: #f3eeed; }
.topbar {
  display: flex; align-items: center; gap: 10px;
  padding: 48rpx 24rpx 14rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #ffb3c6, #ff8fab); color: #fff;
}
.topbar h1 { flex: 1; font-size: 34rpx; font-weight: 800; }
.topbar .tag { font-size: 22rpx; background: rgba(255,255,255,0.2); padding: 4rpx 16rpx; border-radius: 12rpx; }

.card { background: #fff; margin: 12rpx 20rpx; border-radius: 18rpx; padding: 20rpx; box-shadow: 0 2rpx 12rpx rgba(255,158,181,0.04); }
.types { display: flex; gap: 8rpx; flex-wrap: wrap; margin-bottom: 16rpx; }
.t { font-size: 22rpx; color: #8a7a9a; background: #fff0f3; padding: 8rpx 18rpx; border-radius: 20rpx; border: 2rpx solid transparent; }
.t.on { color: #ff6b8a; background: rgba(255,107,138,0.06); border-color: rgba(255,107,138,0.15); }

.input {
  width: 100%; padding: 16rpx; border-radius: 14rpx; border: 2rpx solid #fff0f3;
  background: #fafafa; font-size: 26rpx; color: #2d2d4e; outline: none;
  resize: none; height: 200rpx; box-sizing: border-box;
}
.input::placeholder { color: #c0c0c0; }
.count { text-align: right; font-size: 20rpx; color: #ccc; margin-top: 4rpx; }

.submit {
  margin-top: 16rpx; padding: 20rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #ff8fab, #ff6b8a); color: #fff;
  text-align: center; font-size: 28rpx; font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.2);
}
.submit:active { opacity: 0.9; }
.note { display: block; font-size: 22rpx; color: #8a7a9a; text-align: center; margin-top: 12rpx; }

.link { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid #fff0f3; font-size: 26rpx; color: #2d2d4e; }
.link:last-child { border-bottom: none; }
.arrow { font-size: 32rpx; color: #ccc; }
.ver { font-size: 24rpx; color: #8a7a9a; }
