.page {
  width: 100vw; height: 100vh; display: flex; flex-direction: column;
  align-items: center; background: #fff5f7; position: relative; overflow: hidden;
}
.skip {
  position: absolute; top: 60rpx; right: 32rpx; font-size: 26rpx; color: #8a7a9a; z-index: 10;
}
.swipe-wrap { flex: 1; width: 100vw; overflow: hidden; }
.swipe { display: flex; width: 300vw; height: 100%; transition: transform 0.3s ease; }
.gp {
  width: 100vw; display: flex; flex-direction: column; align-items: center;
  justify-content: center; text-align: center; padding: 40rpx 60rpx 0;
  flex-shrink: 0;
}
.emoji { font-size: 120rpx; margin-bottom: 40rpx; }
.title { font-size: 48rpx; font-weight: 800; color: #2d2d4e; line-height: 1.4; white-space: pre-line; margin-bottom: 20rpx; }
.desc { font-size: 28rpx; color: #8a7a9a; line-height: 1.7; white-space: pre-line; }
.dots { display: flex; justify-content: center; gap: 12rpx; margin-bottom: 60rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #d0c8d0; transition: 0.2s; }
.dot.on { width: 40rpx; border-radius: 6rpx; background: #ff6b8a; }
.btn {
  margin-bottom: 80rpx; padding: 24rpx 120rpx; border-radius: 48rpx;
  background: linear-gradient(135deg, #ff8fab, #ff6b8a); color: #fff;
  font-size: 30rpx; font-weight: 700; box-shadow: 0 8rpx 32rpx rgba(255,107,138,0.3);
}
.btn:active { opacity: 0.9; transform: scale(0.98); }
