<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <!-- ===== 列表页 ===== -->
  <block wx:if="{{mode === 'list'}}">
    <view class="l-header">
      <view class="welcome-card">
        <view class="wc-avatar">🐱</view>
        <view class="wc-text">
          <text class="wc-title">今天也要加油喔！</text>
          <text class="wc-sub">{{completedPassages.length}}/{{passages.length}} 篇已完成</text>
        </view>
      </view>
    </view>

    <view class="sec-title">
      <text>📚 我的听力</text>
      <text>{{passages.length}} 篇材料</text>
    </view>

    <scroll-view class="lcard-scroll" scroll-y>
      <view class="lcard-list">
        <view class="lcard" wx:for="{{passages}}" wx:key="id" data-id="{{item.id}}" catchtap="enterDetail">
          <view class="lc-icon s{{(index % 3) + 1}}">
            <text>🎵</text>
            <text class="lc-sticker">{{index === 0 ? '✨' : (index === 1 ? '⭐' : '🌸')}}</text>
          </view>
          <view class="lc-info">
            <text class="lc-title">{{item.title}}</text>
            <text class="lc-meta">{{item.sentences.length}} 句 · 约 25 分钟</text>
          </view>
          <view class="lc-tag">🎧 精听</view>
          <view wx:if="{{!completedPassages.includes(item.id) && index < 2}}" class="lc-badge {{index === 1 ? 'hot' : ''}}">{{index === 0 ? 'NEW' : '🔥 热门'}}</view>
        </view>
      </view>
    </scroll-view>
  </block>

  <!-- ===== 总结页 ===== -->
  <block wx:elif="{{mode === 'summary'}}">
    <view class="detail-header">
      <view class="back-btn" catchtap="backToList">←</view>
      <text class="detail-title">📊 作答总结</text>
      <view wx:if="{{!examMode}}" class="da-complete" catchtap="markCompleted">✓</view>
    </view>

    <scroll-view class="summary-scroll" scroll-y>
      <view class="summary-card">
        <text class="sc-emoji">🎉</text>
        <text class="sc-title">做得不错！</text>
        <view class="summary-stats">
          <view class="summary-stat">
            <text class="summary-num">{{summaryAnswered}}</text>
            <text class="summary-label">已作答</text>
          </view>
          <view class="summary-divider"></view>
          <view class="summary-stat">
            <text class="summary-num">{{summaryTotal}}</text>
            <text class="summary-label">总题数</text>
          </view>
          <view class="summary-divider"></view>
          <view class="summary-stat">
            <text class="summary-num">{{summaryMarked}}</text>
            <text class="summary-label">已标记</text>
          </view>
        </view>
      </view>

      <view class="sm-results" wx:if="{{summaryResults && summaryResults.length > 0}}">
        <view class="sm-subtitle">📝 答题详情（{{summaryCorrectCount}}/{{summaryTotal}} 正确）</view>
        <view class="sm-qitem" wx:for="{{summaryResults}}" wx:key="pi">
          <view class="smq-hd">
            <text class="smq-icon {{item.isCorrect ? 'ok' : (item.isAnswered ? 'bad' : 'miss')}}">{{item.isCorrect ? '✓' : (item.isAnswered ? '✗' : '—')}}</text>
            <text class="smq-label">{{item.stem}}</text>
            <text class="smq-sec">{{pages[item.pi].section}}</text>
          </view>
          <view wx:if="{{item.isAnswered}}" class="smq-line">你的: <text class="smq-ltr">{{item.userLetter}}</text> {{item.userText}}</view>
          <view wx:if="{{!item.isCorrect && item.hasAnswerKey}}" class="smq-line correct">正确: <text class="smq-ltr">{{item.correctLetter}}</text> {{item.correctText}}</view>
          <view wx:elif="{{!item.isCorrect && !item.hasAnswerKey}}" class="smq-line dim">无标准答案</view>
        </view>
      </view>

      <view class="sm-marked" wx:if="{{summaryMarked > 0}}">
        <view class="sm-subtitle">📌 标记需重听的题目</view>
        <view class="sm-mitem" wx:for="{{pages}}" wx:key="type" wx:for-index="pi" wx:if="{{markedFlags[pi] && item.type === 'q'}}">
          <text class="smm-tag">{{item.stem}}</text>
          <view class="smm-opt {{selectedAnswers[pi] === oi ? 'on' : ''}}" wx:for="{{item.opts}}" wx:for-index="oi" wx:key="*this">
            <text>{{optionLetters[oi]}}. {{item}}</text>
          </view>
        </view>
      </view>
      <view class="sm-marked" wx:else>
        <view class="sm-empty">没有标记的题目，表现不错 🎀</view>
      </view>

      <view class="sm-actions">
        <view class="sm-btn primary" catchtap="retryPages">继续做题</view>
        <view class="sm-btn" catchtap="backToList">返回列表</view>
      </view>
    </scroll-view>
  </block>

  <!-- ===== 详情模式 ===== -->
  <block wx:else>
    <view class="detail-header">
      <view class="back-btn" catchtap="backToList">{{examMode ? '←' : '←'}}</view>
      <text class="detail-title">{{currentPassage.title}}</text>
      <view class="detail-actions">
        <view wx:if="{{!examMode && pages.length > 0}}" class="da-btn" catchtap="viewSummary">📊 总结</view>
        <view wx:if="{{!examMode}}" class="da-complete" catchtap="markCompleted">✓</view>
      </view>
    </view>

    <!-- ===== 标准 MP3 翻页模式 ===== -->
    <block wx:if="{{audioMode}}">
      <view class="s2-body">
        <!-- 进度条 -->
        <view class="seek-bar">
          <view class="seek-track" catchtap="seekAudio">
            <view class="seek-fill" style="width: {{audioDuration > 0 ? audioTime / audioDuration * 100 : 0}}%">
              <view class="seek-thumb"></view>
            </view>
          </view>
          <view class="seek-time">
            <text>{{audioTimeStr}}</text>
            <text>{{audioDurationStr}}</text>
          </view>
        </view>

        <!-- 控制按钮 -->
        <view class="controls-row">
          <view class="ctl-pill {{speed === item ? 'on' : ''}}" wx:for="{{speedOptions}}" wx:key="*this" data-speed="{{item}}" catchtap="setSpeed">{{item}}x</view>
          <view class="ctl-pill {{loopSentence ? 'on' : ''}}" catchtap="toggleLoop">{{loopSentence ? '🔁' : '循环'}}</view>
        </view>

        <!-- 数据警告 -->
        <view class="dwarn" wx:if="{{dataWarning}}">
          <text user-select>{{dataWarning}}</text>
        </view>

        <!-- 题目卡片 -->
        <view class="page-area">
          <view class="page-view" bindtouchstart="onPageTouchStart" bindtouchend="onPageTouchEnd">
            <view class="page-track" style="transform: translateX(-{{currentPage * 100}}%);">
              <view class="page-card" wx:for="{{pages}}" wx:key="type" wx:for-index="pi">
                <!-- Directions -->
                <view wx:if="{{item.type === 'dir'}}" class="p-dir">
                  <view class="p-section">{{item.section}}</view>
                  <view class="p-dir-text">{{item.stem}}</view>
                </view>
                <!-- Question -->
                <view wx:else class="p-q">
                  <view class="p-section">{{item.section}}<text wx:if="{{focusMode && markedFlags[pi]}}" style="color:var(--rose);font-size:18rpx;margin-left:6rpx"> 📌</text></view>
                  <view class="p-stem">{{item.stem}}</view>
                  <view class="p-opts">
                    <view class="po {{selectedAnswers[pi] === oi ? 'on' : ''}}" wx:for="{{item.opts}}" wx:key="*this" wx:for-index="oi" data-i="{{pi}}" data-oi="{{oi}}" catchtap="onOptionTap">
                      <view class="po-l">{{optionLetters[oi]}}</view>
                      <view class="po-t">{{item}}</view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 底栏 -->
        <view class="bottom-bar">
          <view class="bot-nav" catchtap="prevPage">⬅ 上一题</view>
          <view class="bot-play" catchtap="playPause">{{loading ? '...' : (isPlaying ? '⏸' : '▶')}}</view>
          <view class="bot-dots">
            <view class="bd {{i === currentPage ? 'on' : ''}}" wx:for="{{pages}}" wx:key="*this" wx:for-index="i"></view>
          </view>
          <view class="bot-nav" catchtap="nextPage">下一题 ➔</view>
        </view>
      </view>
    </block>

    <!-- ===== 逐句精听模式（无音频） ===== -->
    <block wx:else>
      <view class="controls-bar">
        <view class="speed-btn {{speed === item ? 'active' : ''}}" wx:for="{{speedOptions}}" wx:key="*this" data-speed="{{item}}" catchtap="setSpeed">{{item}}x</view>
        <view class="ctrl-btn {{showTranscript ? 'active' : ''}}" catchtap="toggleTranscript">原文</view>
        <view class="ctrl-btn {{loopSentence ? 'active' : ''}}" catchtap="toggleLoop">{{loopSentence ? '🔁' : '单句'}}</view>
      </view>

      <scroll-view class="sentence-scroll" scroll-y scroll-into-view="s-{{currentIndex}}">
        <view class="sentence-list">
          <view class="sentence-item {{index === currentIndex ? 'current' : ''}} {{hardSentences.indexOf(index) !== -1 ? 'hard' : ''}}" wx:for="{{currentPassage.sentences}}" wx:key="start" id="s-{{index}}">
            <view class="se-num">{{index + 1}}</view>
            <view class="se-text">
              <text class="se-en" wx:if="{{showTranscript}}" user-select>{{item.text}}</text>
              <text class="se-en hidden" wx:else>🔇 点击播放收听</text>
            </view>
            <view class="se-actions">
              <view class="se-play {{index === currentIndex && isPlaying ? 'playing' : ''}}" data-index="{{index}}" catchtap="playSentence">{{index === currentIndex && loading ? '...' : '▶'}}</view>
              <view class="se-hard {{hardSentences.indexOf(index) !== -1 ? 'active' : ''}}" data-index="{{index}}" catchtap="toggleHard">!</view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="player-bar">
        <view class="pb-prev" catchtap="prevSentence">◀</view>
        <view class="pb-play" catchtap="playPause">{{loading ? '...' : (isPlaying ? '⏸' : '▶')}}</view>
        <view class="pb-next" catchtap="nextSentence">▶</view>
        <view class="pb-progress"><view class="pb-fill" style="width: {{currentIndex / currentPassage.sentences.length * 100}}%"></view></view>
      </view>
    </block>
  </block>
</view>