<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <block wx:if="{{mode === 'list'}}">
    <view class="l-header">
      <view class="lh-bg"></view>
      <view class="lh-content">
        <text class="lh-title">听力精听</text>
        <text class="lh-sub">{{passages.length}} 篇听力材料</text>
      </view>
    </view>

    <scroll-view class="lcard-scroll" scroll-y>
      <view class="lcard-list">
      <view class="lcard" wx:for="{{passages}}" wx:key="id" data-id="{{item.id}}" catchtap="enterDetail">
        <view class="lc-icon" style="background: linear-gradient(135deg, #4fc3f7, #2196f3);">
          <text>🎵</text>
        </view>
        <view class="lc-info">
          <text class="lc-title">{{item.title}}</text>
          <text class="lc-meta">{{item.sentences.length}} 句</text>
        </view>
        <view class="lc-arrow">
          <text>→</text>
        </view>
      </view>
    </view>
    </scroll-view>
  </block>

  <block wx:else>
    <view class="detail-header">
      <view class="back-btn" catchtap="backToList">返回</view>
      <text class="detail-title">{{currentPassage.title}}</text>
      <view wx:if="{{audioMode}}" class="focus-toggle {{focusMode ? 'on' : ''}}" catchtap="toggleFocus">精听</view>
      <view class="detail-complete" catchtap="markCompleted">✓</view>
    </view>

    <!-- === 精听模式 === -->
    <block wx:if="{{audioMode && focusMode}}">
      <view class="f-player">
        <view class="f-track" catchtap="seekAudio">
          <view class="f-fill" style="width: {{audioDuration > 0 ? audioTime / audioDuration * 100 : 0}}%"></view>
        </view>
        <view class="f-time"><text>{{audioTimeStr}}</text><text>{{audioDurationStr}}</text></view>
        <view class="f-row">
          <view class="f-loop {{loopSentence ? 'on' : ''}}" catchtap="toggleLoop">循环</view>
          <view class="f-b" catchtap="rewindAudio">⏪</view>
          <view class="f-play" catchtap="playPause">{{loading ? '...' : (isPlaying ? '⏸' : '▶')}}</view>
          <view class="f-b" catchtap="forwardAudio">⏩</view>
          <view class="f-sp {{speed === item ? 'on' : ''}}" wx:for="{{speedOptions}}" wx:key="*this" data-speed="{{item}}" catchtap="setSpeed">{{item}}x</view>
        </view>
      </view>
      <view class="f-pos"><text>📍 {{currentSectionLabel}}</text></view>
      <view class="page-area">
        <view class="page-view">
          <view class="page-track" style="transform: translateX(-{{currentPage * 100}}%);">
            <view class="page-card" wx:for="{{pages}}" wx:key="type" wx:for-index="pi">
              <view wx:if="{{item.type === 'dir'}}" class="p-dir">
                <view class="p-section">{{item.section}}</view>
                <view class="p-dir-text">{{item.stem}}</view>
              </view>
              <view wx:else class="p-q">
                <view class="p-section">{{item.section}}<text wx:if="{{focusMode && markedFlags[pi]}}" style="color:#ff6b8a;font-size:20rpx;margin-left:8rpx"> 📌 标记</text></view>
                <view class="p-stem">{{item.stem}}</view>
                <view class="p-opts">
                  <view class="po {{selectedAnswers[pi] === oi ? 'on' : ''}}" wx:for="{{item.opts}}" wx:key="*this" wx:for-index="oi" data-i="{{pi}}" data-oi="{{oi}}" catchtap="onOptionTap">
                    <view class="po-l">{{optionLetters[oi]}}</view>
                    <view class="po-t">{{item}}</view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="f-bar">
        <view class="f-nav" catchtap="prevPage">⬅ 上题</view>
        <view class="f-mark {{isCurrentMarked ? 'on' : ''}}" catchtap="markForReview">{{isCurrentMarked ? '✅ 已标记' : '❗ 标记'}}</view>
        <view class="f-nav" catchtap="nextPage">下题 ➔</view>
      </view>
    </block>

    <!-- === 标准MP3翻页模式 === -->
    <block wx:elif="{{audioMode}}">
      <view class="audio-player">
        <view class="ap-bar" catchtap="seekAudio">
          <view class="ap-fill" style="width: {{audioDuration > 0 ? audioTime / audioDuration * 100 : 0}}%"></view>
          <view class="ap-thumb" style="left: {{audioDuration > 0 ? audioTime / audioDuration * 100 : 0}}%"></view>
        </view>
        <view class="ap-time">
          <text>{{audioTimeStr}}</text>
          <text>{{audioDurationStr}}</text>
        </view>
      </view>

      <view class="controls">
        <view class="spd {{speed === s ? 'on' : ''}}" wx:for="{{speedOptions}}" wx:key="*this" data-speed="{{item}}" catchtap="setSpeed">{{item}}x</view>
        <view class="ctl {{loopSentence ? 'on' : ''}}" catchtap="toggleLoop">循环</view>
      </view>

      <view class="dwarn" wx:if="{{dataWarning}}">
        <text>{{dataWarning}} — 编辑 listening.ts 补全</text>
      </view>

      <view class="page-area">
        <view class="page-view" bindtouchstart="onPageTouchStart" bindtouchend="onPageTouchEnd">
          <view class="page-track" style="transform: translateX(-{{currentPage * 100}}%);">
            <view class="page-card" wx:for="{{pages}}" wx:key="type" wx:for-index="pi">
              <!-- Directions page -->
              <view wx:if="{{item.type === 'dir'}}" class="p-dir">
                <view class="p-section">{{item.section}}</view>
                <view class="p-dir-text">{{item.stem}}</view>
              </view>
              <!-- Question page -->
              <view wx:else class="p-q">
                <view class="p-section">{{item.section}}<text wx:if="{{focusMode && markedFlags[pi]}}" style="color:#ff6b8a;font-size:20rpx;margin-left:8rpx"> 📌 标记</text></view>
                <view class="p-stem">{{item.stem}}</view>
                <view class="p-opts">
                  <view class="po {{selectedAnswers[pi] === oi ? 'on' : ''}}" wx:for="{{item.opts}}" wx:key="*this" wx:for-index="oi" data-i="{{pi}}" data-oi="{{oi}}" catchtap="onOptionTap">
                    <view class="po-l">{{optionLetters[oi]}}</view>
                    <view class="po-t">{{item}}</view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="p-bar">
        <view class="p-nav" catchtap="prevPage">⬅ 上一题</view>
        <view class="p-play" catchtap="playPause">{{loading ? '...' : (isPlaying ? '⏸' : '▶')}}</view>
        <view class="p-dots">
          <view class="pd {{i === currentPage ? 'on' : ''}}" wx:for="{{pages}}" wx:key="*this" wx:for-index="i"></view>
        </view>
        <view class="p-nav" catchtap="nextPage">下一题 ➔</view>
      </view>
    </block>

    <!-- === 逐句精听模式（原） === -->
    <block wx:else>
    <view class="controls-bar">
      <view class="speed-btn {{speed === item ? 'active' : ''}}" wx:for="{{speedOptions}}" wx:key="*this" data-speed="{{item}}" catchtap="setSpeed">{{item}}x</view>
      <view class="ctrl-btn {{showTranscript ? 'active' : ''}}" catchtap="toggleTranscript">原文</view>
      <view class="ctrl-btn {{dictationMode ? 'active' : ''}}" catchtap="toggleDictation">填空</view>
      <view class="ctrl-btn {{loopSentence ? 'active' : ''}}" catchtap="toggleLoop">单句</view>
    </view>

    <scroll-view class="sentence-scroll" scroll-y scroll-into-view="s-{{currentIndex}}">
      <view class="sentence-list">
        <view class="sentence-item {{index === currentIndex ? 'current' : ''}} {{hardSentences.indexOf(index) !== -1 ? 'hard' : ''}}" wx:for="{{currentPassage.sentences}}" wx:key="start" id="s-{{index}}">
          <view class="se-num">{{index + 1}}</view>
          <view class="se-text">
            <text class="se-en" wx:if="{{showTranscript}}">{{getBlankText(item.text)}}</text>
            <text class="se-en hidden" wx:else>🔇 点击播放收听</text>
          </view>
          <view class="se-actions">
            <view class="se-play {{index === currentIndex && isPlaying ? 'playing' : ''}}" data-index="{{index}}" catchtap="playSentence">{{index === currentIndex && loading ? '...' : '▶'}}</view>
            <view class="se-hard {{hardSentences.indexOf(index) !== -1 ? 'active' : ''}}" data-index="{{index}}" catchtap="toggleHard">!</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="player-bar">
      <view class="pb-prev" catchtap="prevSentence">◀</view>
      <view class="pb-play" catchtap="playPause">{{loading ? '...' : (isPlaying ? '⏸' : '▶')}}</view>
      <view class="pb-next" catchtap="nextSentence">▶</view>
      <view class="pb-progress"><view class="pb-fill" style="width: {{currentIndex / currentPassage.sentences.length * 100}}%"></view></view>
    </view>
    </block>
  </block>
</view>
