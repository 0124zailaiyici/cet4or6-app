page { height: 100%; }
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  --pink: #FFB7C5;
  --pink-light: #FFE8EE;
  --pink-dark: #FF8FAB;
  --lavender: #D4B5FF;
  --lavender-light: #F0E6FF;
  --mint: #B5EACF;
  --mint-light: #E6F9F0;
  --peach: #FFD4B5;
  --peach-light: #FFF0E6;
  --cream: #FFF8F5;
  --rose: #FF6B8A;
  --brown: #5C4A4A;
  --brown-light: #8A7A7A;
  --shadow: 0 8rpx 30rpx rgba(255,183,197,0.15);
  --shadow-hover: 0 12rpx 40rpx rgba(255,183,197,0.25);
  --radius: 24rpx;
  --radius-sm: 14rpx;
  --radius-xs: 10rpx;
}

/* ===== 列表页 ===== */
.l-header { padding: 20rpx 28rpx 0; }
.welcome-card {
  display: flex; align-items: center; gap: 14rpx;
  padding: 20rpx 22rpx;
  background: linear-gradient(135deg, #FFF0F3, #FFF5FF);
  border-radius: var(--radius);
  position: relative; overflow: hidden;
}
.welcome-card::after {
  content: '🎀'; position: absolute; right: -10rpx; bottom: -10rpx;
  font-size: 60rpx; opacity: 0.2; transform: rotate(-15deg);
  pointer-events: none;
}
.wc-avatar {
  width: 56rpx; height: 56rpx;
  background: linear-gradient(135deg, var(--pink), var(--lavender));
  border-radius: 50%; display: flex;
  align-items: center; justify-content: center; font-size: 28rpx; flex-shrink: 0;
}
.wc-text { flex: 1; }
.wc-text .wc-title { font-size: 30rpx; font-weight: 800; color: var(--brown); display: block; }
.wc-text .wc-sub { font-size: 22rpx; color: var(--brown-light); font-weight: 600; display: block; margin-top: 4rpx; }

.sec-title {
  display: flex; align-items: center; gap: 8rpx;
  padding: 28rpx 28rpx 14rpx;
}
.sec-title text:first-child { font-size: 28rpx; font-weight: 800; color: var(--brown); }
.sec-title text:last-child { font-size: 20rpx; color: var(--brown-light); font-weight: 600; }

.lcard-scroll { flex: 1; padding: 0 24rpx; }
.lcard-list { display: flex; flex-direction: column; gap: 12rpx; padding-bottom: 20rpx; }
.lcard {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 20rpx;
  background: #FFF; border-radius: var(--radius);
  box-shadow: var(--shadow);
  border: 2rpx solid transparent;
  position: relative; overflow: hidden;
  transition: 0.25s;
}
.lcard:active { transform: translateY(-3rpx); box-shadow: var(--shadow-hover); border-color: var(--pink-light); }
.lc-icon {
  width: 56rpx; height: 56rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; flex-shrink: 0;
  position: relative;
}
.lc-icon.s1 { background: linear-gradient(135deg, #FFE0E8, #FFB7C5); }
.lc-icon.s2 { background: linear-gradient(135deg, #E8E0FF, #D4B5FF); }
.lc-icon.s3 { background: linear-gradient(135deg, #E0FFE8, #B5EACF); }
.lc-sticker { position: absolute; top: -8rpx; right: -8rpx; font-size: 14rpx; }
.lc-info { flex: 1; }
.lc-info .lc-title { font-size: 26rpx; font-weight: 800; color: var(--brown); display: block; }
.lc-info .lc-meta { font-size: 20rpx; color: var(--brown-light); font-weight: 600; display: block; margin-top: 4rpx; }
.lc-tag {
  padding: 5rpx 14rpx; border-radius: 20rpx; font-size: 18rpx; font-weight: 700;
  background: var(--pink-light); color: var(--pink-dark); white-space: nowrap;
}
.lc-badge {
  position: absolute; top: 8rpx; right: 8rpx;
  background: var(--rose); color: #fff; font-size: 18rpx; font-weight: 800;
  padding: 3rpx 10rpx; border-radius: 10rpx;
}
.lc-badge.hot { background: var(--lavender); }

/* ===== Detail header ===== */
.detail-header {
  display: flex; align-items: center; gap: 10rpx;
  padding: 10rpx 20rpx 12rpx; flex-shrink: 0;
}
.back-btn {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--pink-light); display: flex;
  align-items: center; justify-content: center;
  font-size: 28rpx; flex-shrink: 0;
}
.detail-title {
  flex: 1; font-size: 28rpx; font-weight: 900; color: var(--brown);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.detail-actions { display: flex; gap: 6rpx; flex-shrink: 0; }
.da-btn {
  padding: 8rpx 20rpx; border-radius: 20rpx; font-size: 22rpx; font-weight: 700;
  background: var(--pink-light); color: var(--pink-dark); white-space: nowrap;
}
.da-btn.on { background: var(--pink-dark); color: #fff; }
.da-complete {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--mint-light); display: flex;
  align-items: center; justify-content: center;
  font-size: 28rpx; color: #7ECBA1;
}

/* ===== 标准模式 ===== */
.s2-body { flex: 1; padding: 0 20rpx; display: flex; flex-direction: column; overflow: hidden; }

/* 进度条 */
.seek-bar { padding: 4rpx 0 2rpx; flex-shrink: 0; }
.seek-track {
  height: 8rpx; border-radius: 4rpx; background: #F0E8F0;
  position: relative; overflow: hidden;
}
.seek-fill {
  height: 100%; border-radius: 4rpx;
  background: linear-gradient(90deg, var(--pink-dark), var(--lavender));
  transition: width 0.3s; position: relative; min-width: 0;
}
.seek-thumb {
  position: absolute; right: -8rpx; top: 50%; transform: translateY(-50%);
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #fff; border: 3rpx solid var(--pink-dark);
  box-shadow: 0 2rpx 8rpx rgba(255,143,171,0.3);
}
.seek-time {
  display: flex; justify-content: space-between;
  font-size: 18rpx; color: var(--brown-light); font-weight: 700; padding: 4rpx 4rpx 0;
}

/* 速度按钮（放底栏了） */
.ctl-pill {
  padding: 6rpx 18rpx; border-radius: 14rpx; font-size: 22rpx; font-weight: 700;
  background: #F0E8F0; color: var(--brown-light);
}
.ctl-pill.on { background: var(--pink-dark); color: #fff; }

/* 警告 */
.dwarn {
  padding: 8rpx 14rpx; border-radius: var(--radius-xs);
  background: #FFF5E6; font-size: 20rpx; color: #C9A030;
  font-weight: 600; margin-bottom: 10rpx; flex-shrink: 0; line-height: 1.4;
}

/* 题目卡片区 */
.page-area {
  flex: 1; min-height: 0; overflow: hidden;
  border-radius: var(--radius); background: #FFF;
  box-shadow: var(--shadow); position: relative;
}
.page-view { height: 100%; overflow: hidden; position: relative; }
.page-track {
  display: flex; height: 100%;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.page-card {
  min-width: 100%; height: 100%; overflow-y: auto; padding: 20rpx 22rpx;
}
.page-card::-webkit-scrollbar { width: 3rpx; }
.page-card::-webkit-scrollbar-thumb { background: #E8D8E8; border-radius: 2rpx; }

.p-q { display: flex; flex-direction: column; height: 100%; }
.p-q .p-opts { margin-top: auto; }

.p-section {
  font-size: 20rpx; font-weight: 700; color: var(--pink-dark);
  letter-spacing: 0.5px; margin-bottom: 8rpx;
}
.p-dir-text {
  font-size: 26rpx; line-height: 1.8; color: var(--brown-light); font-weight: 600;
}
.p-stem {
  font-size: 30rpx; font-weight: 800; color: var(--brown); line-height: 1.6;
  margin-bottom: 16rpx; padding-bottom: 14rpx; border-bottom: 2rpx dashed #F0E8F0;
}
.p-opts { display: flex; flex-wrap: wrap; gap: 10rpx; }
.po {
  width: 100%;
  display: flex; align-items: flex-start; gap: 8rpx;
  padding: 14rpx 16rpx; border-radius: var(--radius-sm);
  font-size: 24rpx; color: var(--brown-light); line-height: 1.5; font-weight: 600;
  background: #FFF; border: 2rpx solid #F0E8F0; transition: 0.18s;
}
.po-l {
  width: 32rpx; height: 32rpx; border-radius: 10rpx;
  background: var(--pink-light); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 800; color: var(--pink-dark);
}
.po.on {
  color: var(--rose); border-color: var(--pink-dark);
  background: linear-gradient(135deg, var(--pink-light), #FFF5FF);
  box-shadow: 0 3rpx 12rpx rgba(255,143,171,0.12);
}
.po.on .po-l { background: var(--pink-dark); color: #fff; }

/* 题目模式原文 */
.p-q-transcript {
  flex: 1; min-height: 0; overflow-y: auto;
  padding: 12rpx 14rpx; margin: 0 0 10rpx;
  background: #FAF7FD; border-radius: 12rpx; border: 1rpx solid #F0E8F5;
  font-size: 26rpx; line-height: 1.8; color: #4A3A5A; font-weight: 500;
}
.p-q-transcript .hlt {
  background: rgba(255, 200, 50, 0.35); color: #B8860B;
  border-radius: 3rpx; padding: 0 3rpx;
}

/* ===== 原文面板 ===== */
.ts-area { margin-top: 16rpx; border-top: 2rpx dashed #f0e8ee; padding-top: 12rpx; }
.ts-toggle { display: flex; align-items: center; gap: 6rpx; padding: 8rpx 0; }
.ts-toggle:active { opacity: .7; }
.ts-label { font-size: 22rpx; font-weight: 700; color: var(--brown); flex: 1; }
.ts-arrow { font-size: 20rpx; color: var(--brown-light); transition: .2s; }
.ts-toggle.open .ts-arrow { transform: rotate(180deg); }
.ts-body { display: none; flex-direction: column; gap: 8rpx; margin-top: 8rpx; }
.ts-body.open { display: flex; }
.ts-text { font-size: 24rpx; line-height: 1.7; color: var(--brown); font-weight: 600; }
.ts-play {
  align-self: flex-start; padding: 6rpx 18rpx; border-radius: 14rpx;
  background: var(--pink-light); color: var(--pink-dark); font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; gap: 4rpx;
}
.ts-play:active { opacity: .7; }
.ts-play.on { background: var(--pink-dark); color: #fff; }
.dark-theme .ts-label { color: var(--brown) !important; }
.dark-theme .ts-text { color: var(--brown) !important; }

/* 底栏 */
.bottom-bar {
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  padding: 8rpx 20rpx 36rpx; flex-shrink: 0;
}
.bb-speed {
  display: flex; gap: 8rpx; justify-content: center;
}
.bb-ctrl {
  display: flex; align-items: center; gap: 24rpx;
}
.bot-play {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--pink-dark), var(--lavender));
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #fff;
  box-shadow: 0 4rpx 18rpx rgba(255,143,171,0.22);
}
.bot-play:active { transform: scale(0.92); }

/* ===== 精听模式 ===== */
.s3-body { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

/* 控制栏 */
.focus-ctls {
  display: flex; gap: 6rpx; padding: 0 20rpx 10rpx;
  flex-wrap: wrap; align-items: center; flex-shrink: 0;
}
.fc-pill {
  padding: 8rpx 18rpx; border-radius: 16rpx; font-size: 22rpx; font-weight: 700;
  background: #F0E8F0; color: var(--brown-light);
}
.fc-pill.on { background: var(--peach); color: var(--rose); }
.fc-time {
  margin-left: auto; font-size: 20rpx; font-weight: 700; color: var(--brown-light); white-space: nowrap;
}

/* 句子列表 */
.sent-scroll {
  flex: 1; padding: 0 20rpx 150rpx; overflow-y: auto;
}
.sent-scroll::-webkit-scrollbar { width: 3rpx; }
.sent-scroll::-webkit-scrollbar-thumb { background: #E8D8E8; border-radius: 2rpx; }

.sent-item {
  display: flex; align-items: flex-start; gap: 12rpx;
  padding: 16rpx 18rpx; background: #FFF; border-radius: var(--radius);
  box-shadow: var(--shadow); margin-bottom: 10rpx;
  border: 2rpx solid transparent; transition: 0.2s;
}
.sent-item.current {
  border-color: var(--pink);
  background: linear-gradient(135deg, #FFF5F7, #FFF);
}
.sent-item.hard { border-left: 5rpx solid #FCD34D; }

.sent-num {
  width: 40rpx; height: 40rpx; border-radius: 12rpx;
  background: var(--pink-light); display: flex;
  align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 800; color: var(--pink-dark); flex-shrink: 0;
  transition: 0.2s;
}
.sent-item.current .sent-num {
  background: linear-gradient(135deg, var(--pink), var(--lavender));
  color: #fff;
}

.sent-body { flex: 1; }
.sent-text { font-size: 26rpx; line-height: 1.7; color: var(--brown); font-weight: 600; }

.sent-acts { display: flex; gap: 6rpx; flex-shrink: 0; align-items: center; }
.sent-play, .sent-hard {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #F0E8F0; display: flex;
  align-items: center; justify-content: center;
  font-size: 20rpx; color: var(--brown-light);
}
.sent-play.playing { background: rgba(255,143,171,0.15); color: var(--pink-dark); }
.sent-hard.active { background: #FFF5E6; color: #D4A017; font-weight: 700; }

/* 精听播放器 */
.fplayer {
  display: flex; align-items: center; gap: 14rpx;
  padding: 14rpx 20rpx 36rpx; flex-shrink: 0;
  background: #FFF; border-top: 2rpx solid #F0E8F0;
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 10;
}
.fprev, .fnext {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #F0E8F0; display: flex;
  align-items: center; justify-content: center; font-size: 24rpx; color: var(--brown-light);
}
.fplay {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--pink-dark), var(--lavender));
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(255,143,171,0.25);
}
.fplay:active { transform: scale(0.92); }
.fprogress { flex: 1; height: 6rpx; border-radius: 3rpx; background: #F0E8F0; overflow: hidden; }
.fprogress-fill {
  height: 100%; border-radius: 3rpx;
  background: linear-gradient(90deg, var(--pink-dark), var(--lavender));
  transition: width 0.3s;
}

/* ===== TTS 逐句模式（无音频时） ===== */
.controls-bar {
  display: flex; gap: 10rpx; padding: 0 36rpx 16rpx; flex-wrap: wrap; flex-shrink: 0; align-items: center;
}
.speed-btn, .ctrl-btn {
  padding: 10rpx 24rpx; border-radius: 20rpx; font-size: 24rpx; font-weight: 700;
  color: var(--brown-light); background: #F0E8F0;
}
.speed-btn.active, .ctrl-btn.active { background: var(--pink-dark); color: #fff; }

.sentence-scroll { flex: 1; padding: 0 36rpx 150rpx; }
.sentence-list { display: flex; flex-direction: column; gap: 12rpx; }
.sentence-item {
  display: flex; align-items: flex-start; gap: 14rpx; padding: 24rpx;
  border-radius: 22rpx; background: #FFF;
  box-shadow: var(--shadow); border: 2rpx solid transparent;
}
.sentence-item.current { border-color: var(--pink); background: rgba(255,183,197,0.03); }
.sentence-item.hard { border-left: 4rpx solid #FCD34D; }
.se-num {
  width: 48rpx; height: 48rpx; border-radius: 13rpx;
  background: var(--pink-light); display: flex;
  align-items: center; justify-content: center;
  font-size: 22rpx; color: var(--pink-dark); flex-shrink: 0; font-weight: 700;
}
.se-text { flex: 1; }
.se-en { font-size: 28rpx; line-height: 1.7; color: var(--brown); font-weight: 600; }
.se-en.hidden { color: var(--brown-light); font-style: italic; }
.se-actions { display: flex; gap: 10rpx; flex-shrink: 0; }
.se-play, .se-hard {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #F0E8F0; display: flex;
  align-items: center; justify-content: center; font-size: 22rpx; color: var(--brown-light);
}
.se-play.playing { background: rgba(255,143,171,0.15); color: var(--pink-dark); }
.se-hard.active { background: #FFF5E6; color: #D4A017; font-weight: 700; }

.player-bar {
  display: flex; align-items: center; gap: 20rpx; padding: 20rpx 36rpx 36rpx;
  background: #FFF; border-top: 2rpx solid #F0E8F0; flex-shrink: 0;
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 10;
}
.pb-prev, .pb-next {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #F0E8F0; display: flex;
  align-items: center; justify-content: center; font-size: 24rpx; color: var(--brown-light);
}
.pb-play {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--pink-dark), var(--lavender));
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(255,143,171,0.22);
}
.pb-progress { flex: 1; height: 6rpx; border-radius: 3rpx; background: #F0E8F0; overflow: hidden; }
.pb-fill { height: 100%; border-radius: 3rpx; background: linear-gradient(90deg, var(--pink-dark), var(--lavender)); transition: width 0.3s; }

/* ===== 废弃旧样式（占位） ===== */
.f-player, .f-track, .f-fill, .f-time, .f-row, .f-b, .f-play, .f-sp, .f-loop,
.f-pos, .f-bar, .f-nav, .f-mark, .f-dots, .fd { display: none; }

/* ===== 总结页 ===== */
.summary-scroll { flex: 1; padding: 0 28rpx; }
.summary-card {
  background: #FFF; border-radius: var(--radius);
  padding: 32rpx 24rpx; box-shadow: var(--shadow);
  margin-bottom: 20rpx; text-align: center;
}
.summary-card .sc-emoji { font-size: 48rpx; display: block; margin-bottom: 12rpx; }
.summary-card .sc-title {
  font-size: 34rpx; font-weight: 900; color: var(--brown);
  margin-bottom: 24rpx; display: block;
}
.summary-stats { display: flex; align-items: center; justify-content: center; }
.summary-stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.summary-num { font-size: 48rpx; font-weight: 900; color: var(--pink-dark); }
.summary-label { font-size: 22rpx; color: var(--brown-light); font-weight: 600; }
.summary-divider { width: 2rpx; height: 48rpx; background: #F0E8F0; border-radius: 1rpx; }

.sm-results { margin-bottom: 20rpx; }
.sm-qitem { background: #fff; border-radius: var(--radius-sm); padding: 16rpx 18rpx; margin-bottom: 8rpx; box-shadow: var(--shadow); border-left: 5rpx solid transparent; }
.smq-hd { display: flex; align-items: center; gap: 8rpx; margin-bottom: 8rpx; }
.smq-icon { width: 34rpx; height: 34rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 700; color: #fff; flex-shrink: 0; }
.smq-icon.ok { background: #81c784; }
.smq-icon.bad { background: #e57373; }
.smq-icon.miss { background: #b0a8b8; }
.smq-label { font-size: 24rpx; font-weight: 700; color: var(--brown); }
.smq-sec { font-size: 18rpx; color: var(--brown-light); margin-left: auto; }
.smq-line { font-size: 20rpx; color: var(--brown-light); line-height: 1.6; }
.smq-line.correct { color: #388e3c; font-weight: 600; }
.smq-line.dim { color: #b0a8b8; font-style: italic; }
.smq-ltr { display: inline-flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; border-radius: 6rpx; background: rgba(84,110,122,0.1); font-size: 20rpx; font-weight: 700; color: var(--brown); margin-right: 4rpx; }
.dark-theme .sm-results .sm-subtitle { color: #f0c060 !important; }
.dark-theme .sm-qitem { background: #1E1E38 !important; }
.dark-theme .smq-label { color: #e0d0e8 !important; }
.dark-theme .smq-ltr { background: rgba(160,144,176,0.15) !important; color: #e0d0e8 !important; }

.sm-marked { margin-bottom: 20rpx; }
.sm-subtitle {
  font-size: 24rpx; font-weight: 700; color: #D4A017;
  margin-bottom: 12rpx; display: flex; align-items: center; gap: 6rpx;
}
.sm-mitem {
  background: #FFF; border-radius: var(--radius-sm);
  padding: 16rpx 18rpx; margin-bottom: 8rpx;
  box-shadow: var(--shadow); border-left: 5rpx solid #FCD34D;
}
.smm-tag { font-size: 24rpx; font-weight: 700; color: var(--brown); display: block; margin-bottom: 8rpx; }
.smm-opt {
  font-size: 20rpx; color: var(--brown-light); line-height: 1.6; display: block; font-weight: 600;
}
.smm-opt.on { color: var(--pink-dark); font-weight: 700; }

.sm-empty {
  text-align: center; font-size: 24rpx; color: var(--brown-light); font-weight: 600;
  padding: 30rpx 0; background: #FFF; border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.sm-actions { display: flex; gap: 12rpx; padding-bottom: 32rpx; }
.sm-btn {
  flex: 1; height: 52rpx; border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700; background: #F0E8F0; color: var(--brown-light);
}
.sm-btn:active { transform: scale(0.97); }
.sm-btn.primary {
  background: linear-gradient(135deg, var(--pink-dark), var(--lavender));
  color: #fff; box-shadow: 0 4rpx 18rpx rgba(255,143,171,0.2);
}

/* ===== 暗色模式 ===== */
