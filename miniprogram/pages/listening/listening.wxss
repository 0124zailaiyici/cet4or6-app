.dark-theme .fc-speed.on, .dark-theme .fc-toggle.on { background: #ff8fab !important; color: #fff !important; }
.dark-theme .fs-item { background: #1e1e38 !important; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.2) !important; }
.dark-theme .fs-item.current { border-color: rgba(255,143,171,0.3) !important; background: rgba(255,143,171,0.05) !important; }
.dark-theme .fs-num { background: #2a2a4a !important; color: #ff8fab !important; }
.dark-theme .fs-item.current .fs-num { background: #ff8fab !important; color: #fff !important; }
.dark-theme .fs-text { color: #e0d0e8 !important; }
.dark-theme .fs-text.hidden { color: #685878 !important; }
.dark-theme .fs-play, .dark-theme .fs-hard { background: #2a2a4a !important; color: #685878 !important; }
.dark-theme .fs-play.playing { background: rgba(255,143,171,0.12) !important; color: #ff8fab !important; }
.dark-theme .fs-hard.active { background: rgba(255,205,80,0.1) !important; color: #fcd34d !important; }
.dark-theme .focus-bar { background: #1e1e38 !important; border-color: #2a2a4a !important; }
.dark-theme .fb-nav { background: #2a2a4a !important; color: #a090b0 !important; }
.dark-theme .fb-nav:active { background: #3a2a3a !important; }
.dark-theme .fb-progress { background: #2a2a4a !important; }

.dark-theme .sentence-item { background: #1e1e38 !important; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.2) !important; }
.dark-theme .sentence-item.current { border-color: rgba(255,143,171,0.3) !important; background: rgba(255,143,171,0.05) !important; }
.dark-theme .se-num { background: #2a2a4a !important; color: #ff8fab !important; }
.dark-theme .se-en { color: #e0d0e8 !important; }
.dark-theme .se-en.hidden { color: #685878 !important; }
.dark-theme .se-play, .dark-theme .se-hard { background: #2a2a4a !important; color: #685878 !important; }
.dark-theme .se-play.playing { background: rgba(255,143,171,0.12) !important; color: #ff8fab !important; }
.dark-theme .se-hard.active { background: rgba(255,205,80,0.1) !important; color: #fcd34d !important; }
.dark-theme .player-bar { background: #1e1e38 !important; border-color: #2a2a4a !important; }
.dark-theme .pb-prev, .dark-theme .pb-next { background: #2a2a4a !important; color: #685878 !important; }
.dark-theme .pb-progress { background: #2a2a4a !important; }
.dark-theme .speed-btn, .dark-theme .ctrl-btn { background: #2a2a4a !important; color: #a090b0 !important; }
.dark-theme .speed-btn.active, .dark-theme .ctrl-btn.active { background: #ff8fab !important; color: #fff !important; }

.dark-theme .sm-card { background: #1e1e38 !important; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.2) !important; }
