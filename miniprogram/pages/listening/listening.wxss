.page { min-height: 100vh; padding-bottom: 48rpx; display: flex; flex-direction: column; }

/* Header */
.l-header { position: relative; margin-bottom: 0; overflow: hidden; }
.lh-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 220rpx;
  background: linear-gradient(135deg, #4fc3f7, #2196f3);
  border-radius: 0 0 40rpx 40rpx;
}
.lh-content { position: relative; padding: 48rpx 36rpx 36rpx; }
.lh-title { font-size: 48rpx; font-weight: 800; color: #fff; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); }
.lh-sub { display: block; font-size: 26rpx; color: rgba(255,255,255,0.8); margin-top: 6rpx; }

/* Card list */
.lcard-scroll { flex: 1; }
.lcard-list { padding: 20rpx 36rpx; display: flex; flex-direction: column; gap: 16rpx; }
.lcard {
  background: #fff; border-radius: 22rpx; padding: 24rpx; box-shadow: 0 4rpx 20rpx rgba(33,150,243,0.06);
  display: flex; align-items: center; gap: 20rpx; transition: transform 0.2s;
}
.lcard:active { transform: translateY(-2rpx); box-shadow: 0 8rpx 28rpx rgba(33,150,243,0.1); }
.lc-icon {
  width: 64rpx; height: 64rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; flex-shrink: 0;
}
.lc-info { flex: 1; }
.lc-title { display: block; font-size: 30rpx; font-weight: 600; color: #2d2d4e; }
.lc-meta { display: block; font-size: 24rpx; color: #8a7a9a; margin-top: 4rpx; }
.lc-arrow { font-size: 28rpx; color: #2196f3; }

/* Detail header */
.detail-header { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 36rpx; }
.back-btn {
  width: 64rpx; height: 64rpx; border-radius: 18rpx; background: rgba(33,150,243,0.08);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #2196f3;
}
.detail-title { flex: 1; font-size: 32rpx; font-weight: 700; color: #2d2d4e; }
.detail-complete {
  width: 64rpx; height: 64rpx; border-radius: 50%; background: linear-gradient(135deg, #4fc3f7, #2196f3);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #fff;
}

/* Controls */
.controls-bar { display: flex; gap: 10rpx; padding: 0 36rpx 16rpx; flex-wrap: wrap; }
.speed-btn, .ctrl-btn {
  padding: 10rpx 22rpx; border-radius: 18rpx; font-size: 24rpx; color: #8a7a9a;
  background: #fff0f3; border: 2rpx solid transparent;
}
.speed-btn.active, .ctrl-btn.active {
  color: #fff; background: #2196f3; border-color: #2196f3; font-weight: 700;
}

/* Sentence list */
.sentence-scroll { flex: 1; padding: 0 36rpx; }
.sentence-list { display: flex; flex-direction: column; gap: 12rpx; }
.sentence-item {
  display: flex; align-items: flex-start; gap: 14rpx; padding: 24rpx;
  border-radius: 20rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(33,150,243,0.04);
  border: 2rpx solid transparent;
}
.sentence-item.current { border-color: rgba(33,150,243,0.3); background: rgba(33,150,243,0.04); }
.sentence-item.hard { border-color: rgba(255,158,181,0.2); }
.se-num {
  width: 44rpx; height: 44rpx; border-radius: 12rpx; background: rgba(33,150,243,0.06);
  display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #2196f3; flex-shrink: 0;
}
.se-text { flex: 1; }
.se-en { font-size: 28rpx; line-height: 1.7; color: #2d2d4e; }
.se-en.hidden { color: #b5a0c0; font-style: italic; }
.se-actions { display: flex; gap: 10rpx; flex-shrink: 0; }
.se-play, .se-hard {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #fff0f3;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #8a7a9a;
}
.se-play.playing { background: rgba(33,150,243,0.12); color: #2196f3; }
.se-hard.active { background: rgba(255,158,181,0.2); color: #ff6b8a; font-weight: 700; }

/* Player bar */
.player-bar {
  display: flex; align-items: center; gap: 20rpx; padding: 20rpx 36rpx;
  background: #fff; border-top: 2rpx solid #fff0f3; margin-top: 16rpx;
}
.pb-prev, .pb-next {
  width: 72rpx; height: 72rpx; border-radius: 50%; background: #fff0f3;
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #8a7a9a;
}
.pb-play {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: linear-gradient(135deg, #4fc3f7, #2196f3);
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: #fff;
  box-shadow: 0 6rpx 24rpx rgba(33,150,243,0.3);
}
.pb-progress { flex: 1; height: 6rpx; border-radius: 3rpx; background: #fff0f3; overflow: hidden; }
.pb-fill { height: 100%; border-radius: 3rpx; background: #2196f3; transition: width 0.3s; }

/* ===== 整段MP3翻页模式 ===== */
.ap-bar {
  height: 8rpx; border-radius: 4rpx; background: #ece4e2; position: relative;
  margin: 0 20rpx; margin-bottom: 4rpx; cursor: pointer;
}
.ap-fill {
  height: 100%; border-radius: 4rpx;
  background: linear-gradient(90deg, #4fc3f7, #2196f3);
  transition: width 0.3s; min-width: 0;
}
.ap-thumb {
  position: absolute; top: 50%; transform: translate(-50%, -50%);
  width: 20rpx; height: 20rpx; border-radius: 50%;
  background: #2196f3; box-shadow: 0 2rpx 8rpx rgba(33,150,243,0.4);
}
.ap-time { display: flex; justify-content: space-between; padding: 0 20rpx; font-size: 20rpx; color: #8a7a9a; }

/* Controls row */
.controls { display: flex; gap: 6rpx; padding: 6rpx 20rpx; flex-wrap: wrap; flex-shrink: 0; }
.controls .spd, .controls .ctl {
  padding: 6rpx 16rpx; border-radius: 14rpx; font-size: 22rpx; color: #8a7a9a;
  background: #fff0f3; border: 2rpx solid transparent;
}
.controls .spd.on, .controls .ctl.on {
  color: #fff; background: #2196f3; border-color: #2196f3; font-weight: 700;
}

/* Data warning banner */
.dwarn {
  margin: 0 20rpx 6rpx; padding: 10rpx 16rpx; border-radius: 12rpx;
  background: #fff3e0; border: 2rpx solid #ffcc80;
  font-size: 22rpx; color: #e65100; line-height: 1.4; flex-shrink: 0;
}

/* Swipe area */
.page-area { flex: 1; padding: 0 12rpx 4rpx; min-height: 0; overflow: hidden; }
.page-view {
  height: 100%; overflow: hidden; position: relative;
  border-radius: 18rpx; background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(33,150,243,0.04);
}
.page-track { display: flex; height: 100%; transition: transform 0.25s ease; }
.page-card { min-width: 100%; height: 100%; overflow-y: auto; padding: 20rpx 24rpx; }

/* Section label */
.p-section { font-size: 20rpx; color: #2196f3; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 8rpx; }

/* Direction page */
.p-dir { display: flex; flex-direction: column; }
.p-dir-text { font-size: 28rpx; line-height: 1.8; color: #4a4a6a; }

/* Question stem */
.p-stem {
  font-size: 28rpx; font-weight: 600; color: #2d2d4e; line-height: 1.6;
  margin-bottom: 16rpx; padding-bottom: 14rpx; border-bottom: 2rpx solid #f5f0f0;
}

/* Options - V3 card style */
.p-opts { display: flex; flex-wrap: wrap; gap: 12rpx; }
.po {
  width: calc(50% - 6rpx);
  display: flex; align-items: flex-start; gap: 10rpx;
  padding: 18rpx 20rpx; border-radius: 16rpx;
  font-size: 26rpx; color: #4a4a6a; line-height: 1.5;
  background: #f8f5f4; border: 2rpx solid #ece4e2;
  transition: 0.15s;
}
.po .po-l {
  width: 32rpx; height: 32rpx; border-radius: 8rpx;
  background: rgba(84,110,122,0.06); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; color: #8a7a9a;
}
.po .po-t { flex: 1; }
.po.on {
  color: #1e88e5; font-weight: 600;
  border-color: #1e88e5;
  background: rgba(30,136,229,0.04);
  box-shadow: 0 2rpx 12rpx rgba(30,136,229,0.1);
}
.po.on .po-l { background: #1e88e5; color: #fff; }

/* Bottom bar */
.p-bar {
  display: flex; align-items: center; gap: 8rpx;
  padding: 6rpx 12rpx 14rpx; flex-shrink: 0;
}
.p-nav {
  height: 48rpx; border-radius: 12rpx; background: #fff0f3; padding: 0 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #546e7a; font-weight: 600; white-space: nowrap;
}
.p-nav:active { background: #ffe0e6; }
.p-play {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: linear-gradient(135deg, #4fc3f7, #2196f3);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #fff; flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(33,150,243,0.3);
}
.p-dots { flex: 1; display: flex; justify-content: center; gap: 4rpx; overflow: hidden; }
.pd { min-width: 6rpx; height: 6rpx; border-radius: 50%; background: #d0c8d0; transition: 0.2s; }
.pd.on { min-width: 20rpx; border-radius: 3rpx; background: #546e7a; }

/* scrollbar */
.page-view ::-webkit-scrollbar { width: 3rpx; }
.page-view ::-webkit-scrollbar-thumb { background: #d0c8d0; border-radius: 2rpx; }

/* ===== 精听模式 ===== */
.focus-toggle {
  font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 12rpx;
  background: rgba(33,150,243,0.15); color: #2196f3; font-weight: 600; margin-right: 4rpx;
}
.focus-toggle.on { background: rgba(33,150,243,0.25); color: #fff; font-weight: 700; }

.f-player { background: #fff; margin: 4rpx 14rpx 2rpx; border-radius: 14rpx; padding: 12rpx 16rpx 8rpx; box-shadow: 0 2rpx 12rpx rgba(255,158,181,0.06); flex-shrink: 0; }
.f-track { height: 6rpx; border-radius: 3rpx; background: #ece4e2; margin-bottom: 4rpx; position: relative; cursor: pointer; }
.f-track .f-fill { height: 100%; border-radius: 3rpx; background: linear-gradient(90deg, #4fc3f7, #2196f3); min-width: 0; }
.f-time { display: flex; justify-content: space-between; font-size: 20rpx; color: #8a7a9a; margin-bottom: 6rpx; }
.f-row { display: flex; align-items: center; justify-content: center; gap: 14rpx; flex-wrap: wrap; }
.f-b { width: 48rpx; height: 48rpx; border-radius: 50rpx; background: #fff0f3; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #8a7a9a; white-space: nowrap; }
.f-b.on { color: #fff; background: #ff6b8a; padding: 0 12rpx; }
.f-play { width: 60rpx; height: 60rpx; border-radius: 50%; background: linear-gradient(135deg, #4fc3f7, #2196f3); display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; box-shadow: 0 4rpx 16rpx rgba(33,150,243,0.3); }
.f-sp { font-size: 22rpx; color: #8a7a9a; background: #fff0f3; padding: 6rpx 16rpx; border-radius: 10rpx; border: 2rpx solid transparent; }
.f-sp.on { color: #fff; background: #2196f3; border-color: #2196f3; font-weight: 700; }

.f-loop { font-size: 22rpx; color: #8a7a9a; background: #fff0f3; padding: 6rpx 16rpx; border-radius: 10rpx; border: 2rpx solid transparent; }
.f-loop.on { color: #fff; background: #2196f3; border-color: #2196f3; font-weight: 700; }

.f-pos { font-size: 22rpx; color: #2196f3; font-weight: 600; padding: 2rpx 14rpx 4rpx; flex-shrink: 0; }

.f-bar { display: flex; align-items: center; gap: 6rpx; padding: 2rpx 10rpx 14rpx; flex-shrink: 0; }
.f-nav { height: 44rpx; border-radius: 10rpx; background: #fff0f3; padding: 0 16rpx; display: flex; align-items: center; font-size: 22rpx; color: #546e7a; font-weight: 600; }
.f-mark { height: 44rpx; border-radius: 10rpx; background: rgba(255,107,138,0.06); border: 2rpx solid rgba(255,107,138,0.12); padding: 0 14rpx; display: flex; align-items: center; font-size: 20rpx; color: #ff6b8a; }
.f-dots { flex: 1; display: flex; justify-content: center; gap: 4rpx; }
.fd { min-width: 6rpx; height: 6rpx; border-radius: 50%; background: #d0c8d0; }
.fd.on { min-width: 16rpx; border-radius: 3rpx; background: #546e7a; }

/* Dark mode for focus mode */
.dark-theme .focus-toggle { background: rgba(255,255,255,0.1) !important; color: rgba(255,255,255,0.6) !important; }
.dark-theme .focus-toggle.on { background: rgba(255,255,255,0.15) !important; color: #e0d0e8 !important; }
.dark-theme .f-player { background: #1e1e38 !important; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.2) !important; }
.dark-theme .f-track { background: #2a2a4a !important; }
.dark-theme .f-time { color: #a090b0 !important; }
.dark-theme .f-b { background: #2a2a4a !important; color: #a090b0 !important; }
.dark-theme .f-loop { background: #2a2a4a !important; color: #a090b0 !important; }
.dark-theme .f-loop.on { color: #fff !important; background: #4fc3f7 !important; border-color: #4fc3f7 !important; }
.dark-theme .f-sp { background: #2a2a4a !important; color: #a090b0 !important; }
.dark-theme .f-sp.on { color: #fff !important; background: #4fc3f7 !important; border-color: #4fc3f7 !important; }
.dark-theme .f-pos { color: #4fc3f7 !important; }
.dark-theme .f-nav { background: #2a2a4a !important; color: #a090b0 !important; }
.dark-theme .f-mark { background: rgba(255,143,171,0.06) !important; border-color: rgba(255,143,171,0.15) !important; color: #ff8fab !important; }
.dark-theme .fd { background: #3a3a5a !important; }
.dark-theme .fd.on { background: #a090b0 !important; }
.dark-theme .speed-btn.active, .dark-theme .ctrl-btn.active,
.dark-theme .spd.on, .dark-theme .ctl.on {
  color: #fff !important; background: #4fc3f7 !important; border-color: #4fc3f7 !important;
}
