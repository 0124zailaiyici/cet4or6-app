.page {
  min-height: 100vh;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.passage-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.passage-card {
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.1);
}

.passage-card:active {
  transform: scale(0.98);
}

.passage-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.passage-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.passage-badge {
  font-size: 22rpx;
  color: var(--mint);
  background: rgba(197, 225, 165, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.passage-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.passage-play {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #ff9eb5;
}

.arrow {
  font-size: 28rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.back-btn {
  width: 100rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tag-bg);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
}

.controls-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.control-group {
  display: flex;
  gap: 12rpx;
}

.speed-btn {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--tag-bg);
}

.speed-btn.active {
  color: #ff9eb5;
  background: rgba(255, 158, 181, 0.15);
}

.ctrl-btn {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--tag-bg);
}

.ctrl-btn.active {
  color: var(--mint);
  background: rgba(197, 225, 165, 0.2);
}

.sentence-scroll {
  flex: 1;
  margin-bottom: 24rpx;
}

.sentence-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sentence-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--card-bg);
  box-shadow: 0 2rpx 12rpx rgba(255, 158, 181, 0.08);
  transition: all 0.3s;
}

.sentence-item.current {
  background: rgba(255, 158, 181, 0.08);
  box-shadow: 0 2rpx 16rpx rgba(255, 158, 181, 0.2);
}

.sentence-item.hard {
  background: rgba(255, 211, 182, 0.15);
  box-shadow: 0 2rpx 12rpx rgba(255, 211, 182, 0.2);
}

.sentence-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: var(--tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.sentence-content {
  flex: 1;
}

.sentence-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-primary);
}

.sentence-text.hidden {
  color: var(--text-secondary);
  font-style: italic;
}

.sentence-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.s-action {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.s-action.playing {
  background: rgba(255, 158, 181, 0.2);
  color: #ff9eb5;
}

.hard-btn.active {
  color: var(--peach);
  background: rgba(255, 211, 182, 0.2);
}

.bottom-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.bottom-controls {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.nav-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.play-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9eb5, var(--pink-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 158, 181, 0.35);
}

.complete-btn {
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(197, 225, 165, 0.2);
  color: var(--mint);
  font-size: 26rpx;
}
