/* ===== 模式切换 ===== */
.mode-tabs {
  display: flex; gap: 8rpx; padding: 8rpx 24rpx 4rpx; position: relative;
}
.mtab {
  flex: 1; padding: 10rpx 20rpx; font-size: 26rpx; border-radius: 16rpx 16rpx 0 0;
  background: #F5F0F8; color: #8A7A8A; font-weight: 700; transition: .2s; text-align: center; position: relative;
}
.mtab.on {
  background: linear-gradient(135deg, var(--rose), #D4B5FF); color: #FFF;
}
.mtab-indicator {
  position: absolute; bottom: 0; left: 20%; right: 20%; height: 4rpx;
  background: currentColor; border-radius: 2rpx; opacity: 0.8;
}
.mtab:not(.on) { background: #EDE8F2; color: #A090B0; }

/* ===== Lite Mode ===== */
.lite-active .page-area { background: #F8F4FE; border-radius: 16rpx 16rpx 0 0; padding-top: 8rpx; }

/* ===== Lite Mode ===== */
.lite-transcript {
  background: #F9F6FC; border-radius: 16rpx; margin: 8rpx 16rpx; padding: 16rpx; border: 1rpx solid #EFE8F5;
}
.lt-body {
  overflow: hidden; line-height: 1.7; font-size: 26rpx; color: #4A3A5A;
}
.lt-text { word-break: break-word; }
.hl {
  background: rgba(255, 200, 50, 0.35); color: #B8860B; border-radius: 4rpx; padding: 0 4rpx;
}
.lt-foot {
  display: flex; justify-content: space-between; align-items: center; margin-top: 10rpx;
}
.lt-expand { font-size: 22rpx; color: #A090B0; }
.lt-anki {
  font-size: 22rpx; color: #FFF; background: linear-gradient(135deg, #FF8FAB, #D4B5FF);
  padding: 2rpx 14rpx; border-radius: 10rpx; font-weight: 700;
}

.opts-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8rpx 20rpx 0;
}
.tiny-btn {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 12rpx;
  background: #F0EDF5; color: #8A7A8A; border: 1rpx solid #E8E0F0; font-weight: 600;
}
.tiny-btn.on {
  background: var(--rose); color: #FFF; border-color: var(--rose);
}

/* TINY options */
.p-opts.tiny .po { padding: 8rpx 14rpx; }
.p-opts.tiny .po-l { width: 32rpx; height: 32rpx; font-size: 20rpx; }
.p-opts.tiny .po-t { font-size: 22rpx; }

/* Replay button */
.bot-replay {
  font-size: 32rpx; width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #F0EDF5; display: flex; align-items: center; justify-content: center;
  color: #8A7A8A; font-weight: 700;
}
/* Dark theme overrides */
.dark-theme .mtab { background: #2A2A4A; color: #685878; }
.dark-theme .mtab.on { background: linear-gradient(135deg, var(--rose), #D4B5FF); color: #FFF; }
.dark-theme .mtab:not(.on) { background: #22223A; color: #504868; }
.dark-theme .lite-active .page-area { background: #1A1A30; }
.dark-theme .lite-transcript { background: #1E1E38; border-color: #2A2A4A; }
.dark-theme .lt-text { color: #C8B8D8; }
.dark-theme .hl { background: rgba(255, 200, 50, 0.25); color: #E8C840; }
.dark-theme .p-q-transcript { background: #1E1E38 !important; border-color: #2A2A4A !important; color: #C8B8D8 !important; }
.dark-theme .p-q-transcript .hlt { background: rgba(255, 200, 50, 0.25) !important; color: #E8C840 !important; }
.dark-theme .lt-expand { color: #685878; }
.dark-theme .tiny-btn { background: #2A2A4A; color: #685878; border-color: #3A3A5A; }
.dark-theme .tiny-btn.on { background: var(--rose); color: #FFF; border-color: var(--rose); }
.dark-theme .bot-replay { background: #2A2A4A; color: #685878; }