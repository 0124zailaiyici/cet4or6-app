<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <block wx:if="{{mode === 'list'}}">
    <view class="t-header">
      <view class="th-bg"></view>
      <view class="th-content">
        <text class="th-title">翻译练习</text>
        <text class="th-sub">已完成 {{completedIds.length}} / {{translations.length}}</text>
      </view>
    </view>

    <view class="tlist">
      <view class="tcard" wx:for="{{translations}}" wx:key="id" data-id="{{item.id}}" catchtap="enterDetail">
        <view class="tc-main">
          <text class="tc-cn">{{item.chinese ? (item.chinese.length > 40 ? item.chinese.slice(0, 40) + '…' : item.chinese) : ''}}</text>
          <text class="tc-src">{{item.source}}</text>
        </view>
        <view class="tc-status {{completedIds.indexOf(item.id) !== -1 ? 'done' : ''}}">
          {{completedIds.indexOf(item.id) !== -1 ? '✓' : '待练'}}
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="detail-header">
      <view class="back-btn" catchtap="backToList">←</view>
      <text class="detail-title">翻译练习</text>
      <view class="ai-toggle {{aiAvailable ? '' : 'hidden'}}" catchtap="toggleAi">
        <text class="ai-label">AI</text>
        <view class="ai-track {{aiEnabled ? 'on' : ''}}"><view class="ai-thumb"></view></view>
      </view>
    </view>

    <scroll-view class="detail-scroll" scroll-y>
      <view class="question-card">
        <text class="q-label">请翻译成英文：</text>
        <text class="q-text">{{currentItem.chinese}}</text>
      </view>

      <view class="answer-area">
        <textarea class="answer-input" placeholder="在此输入你的翻译…" value="{{userAnswer}}" bindinput="onInput" maxlength="500" auto-height disabled="{{submitting}}"></textarea>
      </view>

      <view class="submit-btn {{submitting ? 'disabled' : ''}}" catchtap="submit">
        {{submitting ? '评分中…' : '提交评分'}}
      </view>

      <view class="result-card" wx:if="{{result.show}}">
        <view class="rc-score">
          <text class="rc-num">{{result.score}}</text>
          <text class="rc-label">分</text>
        </view>
        <view class="rc-bar"><view class="rc-fill" style="width: {{result.score}}%"></view></view>

        <view class="rc-dims">
          <view class="rc-dim" wx:for="{{[result.dimensions.vocabulary, result.dimensions.grammar, result.dimensions.semantics, result.dimensions.expression]}}" wx:for-index="i" wx:key="i">
            <text class="rc-dl">{{['词汇', '语法', '语义', '表达'][i]}}</text>
            <view class="rc-dbar"><view class="rc-dfill" style="width: {{item}}%"></view></view>
            <text class="rc-dn">{{item}}</text>
          </view>
        </view>

        <text class="rc-suggest-title">修改建议</text>
        <text class="rc-suggest">{{result.suggestions}}</text>

        <view class="rc-ref">
          <text class="rc-rl">参考译文</text>
          <text class="rc-rt">{{result.reference}}</text>
        </view>
      </view>

      <view class="action-bar" wx:if="{{result.show}}">
        <view class="retry-btn" catchtap="retry">重新翻译</view>
      </view>

      <view class="history-area" wx:if="{{questionHistory.length > 0}}">
        <text class="h-title">历史记录</text>
        <view class="h-item" wx:for="{{questionHistory}}" wx:for-index="i" wx:key="index">
          <view class="h-head">
            <text class="h-date">第 {{questionHistory.length - i}} 次 · {{item.date}}</text>
            <text class="h-score {{item.score >= 80 ? 'h-good' : item.score >= 60 ? 'h-mid' : 'h-low'}}">{{item.score}} 分</text>
          </view>
          <text class="h-answer">{{item.userAnswer}}</text>
        </view>
      </view>
    </scroll-view>
  </block>
</view>
