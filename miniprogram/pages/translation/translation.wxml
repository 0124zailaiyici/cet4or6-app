<view class="page {{darkMode ? 'dark-theme' : ''}}">

  <!-- ═══ 导航 ═══ -->
  <view class="nav">
    <view class="nav-l">
      <view class="nav-avatar">🌟</view>
      <view>
        <view class="nav-greeting">✨ 翻译练习</view>
        <view class="nav-title">每日一练</view>
      </view>
    </view>
    <view class="nav-r">
      <view class="nav-icon">🔔</view>
      <view class="nav-icon {{aiEnabled ? 'on' : ''}}" catchtap="toggleAi">🤖</view>
    </view>
  </view>

  <!-- ═══ 进度卡片 ═══ -->
  <view class="progress-card">
    <view class="pc-ring" style="background: conic-gradient(#f472b6 0deg {{ringDeg}}deg, rgba(244,114,182,0.08) {{ringDeg}}deg 360deg)"><view class="pc-ring-in"><text class="pc-num">{{completedIds.length}}</text><text class="pc-unit">/{{translations.length}}</text></view></view>
    <view class="pc-body">
      <text class="pc-tip">已完成 {{completedIds.length}} 题 ✨</text>
      <text class="pc-sub">{{translations.length - completedIds.length > 0 ? '还剩 ' + (translations.length - completedIds.length) + ' 题，加油哦' : '全部完成啦，太棒了 🎉'}}</text>
    </view>
    <text class="pc-badge">{{pct}}%</text>
  </view>

  <!-- ═══ 标签 ═══ -->
  <view class="tabs">
    <view class="tab {{mode === 'list' ? 'active' : ''}}" catchtap="backToList">📚 题目</view>
    <view class="tab {{mode === 'detail' ? 'active' : ''}}">✏️ 答题</view>
  </view>

  <!-- ════════════════ 列表模式 ════════════════ -->
  <block wx:if="{{mode === 'list'}}">
    <view class="list">
      <view class="lc" wx:for="{{translations}}" wx:key="id" data-id="{{item.id}}" catchtap="enterDetail" style="animation-delay:{{index * 60}}ms">
        <view class="lc-emoji {{item._tag.type}}">{{item._emoji}}</view>
        <view class="lc-body">
          <text class="lc-text">{{item._display}}</text>
          <view class="lc-tags">
            <text class="lc-tag {{item._tag.type}}">{{item._tag.label}}</text>
          </view>
        </view>
        <view class="lc-right">
          <text class="lc-check done" wx:if="{{completedIds.indexOf(item.id) !== -1}}">✅</text>
          <text class="lc-score {{item._scoreClass || ''}}" wx:if="{{item._score}}">{{item._score}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ════════════════ 答题模式 ════════════════ -->
  <block wx:else>
    <view class="d-nav">
      <view class="d-back" catchtap="backToList">←</view>
      <text class="d-title">翻译 · {{currentItem._tag ? currentItem._tag.label : '练习'}}</text>
      <view class="ai-badge {{aiAvailable ? '' : 'hidden'}} {{aiEnabled ? '' : 'off'}}" catchtap="toggleAi">
        <text class="ai-dot"></text>
        <text>AI</text>
      </view>
    </view>

    <scroll-view class="d-scroll" scroll-y enhanced show-scrollbar="{{false}}">

      <!-- 题目气泡 -->
      <view class="q-bubble">
        <view class="q-hint">📝 把它翻成英文吧</view>
        <text class="q-text">{{currentItem.chinese}}</text>
        <view class="q-kws" wx:if="{{currentItem.keywords && currentItem.keywords.length > 0}}">
          <text class="q-kw" wx:for="{{currentItem.keywords}}" wx:for-index="idx" wx:key="idx">{{item}}</text>
        </view>
      </view>

      <!-- 输入区 -->
      <view class="input-area">
        <textarea class="input-field" placeholder="写下你的翻译…" value="{{userAnswer}}" bindinput="onInput" maxlength="500" auto-height disabled="{{submitting}}"></textarea>
        <view class="input-foot">
          <text class="wc {{wordCount > 0 ? 'has' : ''}}">{{wordCount}} / 500</text>
        </view>
      </view>

      <!-- 提交按钮 -->
      <view class="btn-go {{submitting ? 'disabled' : ''}}" catchtap="submit">
        <text wx:if="{{!submitting}}">✨ 提交评分</text>
        <text wx:else>评分中～</text>
      </view>

      <!-- 结果卡片 -->
      <view class="result-card" wx:if="{{result.show}}">
        <view class="rc-top">
          <view class="rc-stars">
            <view class="rc-stars-in">
              <text class="rc-star-num">{{result.score}}</text>
              <text class="rc-star-lb">分</text>
              <view class="rc-starlets">
                <text class="{{result.score >= 20 ? 'on' : ''}}">★</text>
                <text class="{{result.score >= 40 ? 'on' : ''}}">★</text>
                <text class="{{result.score >= 60 ? 'on' : ''}}">★</text>
                <text class="{{result.score >= 80 ? 'on' : ''}}">★</text>
                <text class="{{result.score >= 95 ? 'on' : ''}}">★</text>
              </view>
            </view>
          </view>
          <view class="rc-quickie">
            <view class="rc-q"><text class="rc-ql">最高</text><text class="rc-qr good">{{hMax}}</text></view>
            <view class="rc-q"><text class="rc-ql">最低</text><text class="rc-qr low">{{hMin}}</text></view>
            <view class="rc-q"><text class="rc-ql">趋势</text><text class="rc-qr {{hTrend === 'up' ? 'good' : 'mid'}}">{{questionHistory.length >= 1 ? (hTrend === 'up' ? '↗ 上升' : '↘ 下降') : '—'}}</text></view>
          </view>
        </view>

        <view class="rc-dims">
          <view class="rc-dim" wx:for="{{[result.dimensions.vocabulary, result.dimensions.grammar, result.dimensions.semantics, result.dimensions.expression]}}" wx:for-index="i" wx:key="i">
            <text class="rc-dl">{{['词汇', '语法', '语义', '表达'][i]}}</text>
            <view class="rc-dbar"><view class="rc-dfill {{item >= 80 ? 'good' : item >= 60 ? 'mid' : 'low'}}" style="width: {{item}}%"></view></view>
            <text class="rc-dn {{item >= 80 ? 'c-good' : item >= 60 ? 'c-mid' : 'c-low'}}">{{item}}</text>
          </view>
        </view>

        <view class="rc-block">
          <view class="rc-bt">💡 修改建议</view>
          <view class="rc-suggest">{{result.suggestions}}</view>
        </view>

        <view class="rc-block">
          <view class="rc-bt">📖 参考译文</view>
          <view class="rc-ref">
            <text class="rc-ref-t">{{result.reference}}</text>
            <text class="rc-ref-play">▶</text>
          </view>
        </view>
      </view>

      <!-- 重做按钮 -->
      <view class="btn-retry" wx:if="{{result.show}}" catchtap="retry">🔄 重新翻译</view>

      <!-- 历史记录 -->
      <view class="h-area" wx:if="{{questionHistory.length > 0}}">
        <view class="h-title"><text class="h-star">⭐</text> 历史记录 · {{questionHistory.length}} 次</view>

        <view class="h-chart">
          <view class="h-bar" wx:for="{{questionHistory}}" wx:key="index" style="height: {{item.score / 3}}rpx; background: {{item.score >= 80 ? '#a5d6a7' : item.score >= 60 ? '#ffcc80' : '#ef9a9a'}}">
            <text class="hb-l">{{item.score}}</text>
          </view>
        </view>

        <view class="h-items">
          <view class="h-item" wx:for="{{questionHistory}}" wx:for-index="i" wx:key="index">
            <text class="h-idx">#{{questionHistory.length - i}}</text>
            <view class="h-body">
              <view class="h-head">
                <text class="h-date">{{item.date.slice(5)}}</text>
                <text class="h-sc {{item.score >= 80 ? 'good' : item.score >= 60 ? 'mid' : 'low'}}">{{item.score}}</text>
              </view>
              <text class="h-ans">{{item.userAnswer}}</text>
            </view>
        </view>
      </view>
      </view>

    </scroll-view>
  </block>

</view>
