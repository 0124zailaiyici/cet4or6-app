.page { min-height: 100vh; padding-bottom: 48rpx; }

/* Header */
.t-header { position: relative; }
.th-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 220rpx;
  background: linear-gradient(135deg, #ffb74d, #ff9800);
  border-radius: 0 0 40rpx 40rpx;
}
.th-content { position: relative; padding: 48rpx 36rpx 36rpx; }
.th-title { font-size: 48rpx; font-weight: 800; color: #fff; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); }
.th-sub { display: block; font-size: 26rpx; color: rgba(255,255,255,0.8); margin-top: 6rpx; }

/* List */
.tlist { padding: 20rpx 36rpx; display: flex; flex-direction: column; gap: 16rpx; }
.tcard {
  background: #fff; border-radius: 22rpx; padding: 24rpx; box-shadow: 0 4rpx 20rpx rgba(255,152,0,0.06);
  display: flex; justify-content: space-between; align-items: center; gap: 16rpx;
  transition: transform 0.2s;
}
.tcard:active { transform: translateY(-2rpx); }
.tc-main { flex: 1; }
.tc-cn { display: block; font-size: 28rpx; line-height: 1.6; color: #2d2d4e; }
.tc-src { display: block; font-size: 22rpx; color: #8a7a9a; margin-top: 6rpx; }
.tc-status {
  font-size: 22rpx; color: #ff9800; padding: 8rpx 18rpx; border-radius: 16rpx;
  background: rgba(255,152,0,0.08); white-space: nowrap; flex-shrink: 0;
}
.tc-status.done { color: #81c784; background: rgba(129,199,132,0.1); }

/* Detail */
.detail-header { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 36rpx; }
.back-btn {
  width: 64rpx; height: 64rpx; border-radius: 18rpx; background: rgba(255,152,0,0.08);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #ff9800;
}
.detail-title { font-size: 32rpx; font-weight: 700; color: #2d2d4e; flex: 1; }

.detail-scroll { padding: 0 36rpx; }
.question-card {
  background: #fff; border-radius: 22rpx; padding: 32rpx; box-shadow: 0 4rpx 20rpx rgba(255,152,0,0.06);
  margin-bottom: 24rpx;
}
.q-label { display: block; font-size: 24rpx; color: #8a7a9a; margin-bottom: 12rpx; }
.q-text { font-size: 32rpx; line-height: 1.7; color: #2d2d4e; font-weight: 500; }

.answer-area { margin-bottom: 24rpx; }
.answer-input {
  width: 100%; min-height: 180rpx; padding: 28rpx; border-radius: 22rpx;
  background: #fff; border: 2rpx solid #ffd9e0; color: #2d2d4e; font-size: 28rpx; line-height: 1.7;
}

.submit-btn {
  width: 100%; height: 88rpx; border-radius: 44rpx;
  background: linear-gradient(135deg, #ffb74d, #ff9800); color: #fff;
  font-size: 30rpx; font-weight: 600; display: flex; align-items: center; justify-content: center;
  margin-bottom: 32rpx; box-shadow: 0 6rpx 24rpx rgba(255,152,0,0.25);
}

.result-card {
  background: #fff; border-radius: 22rpx; padding: 32rpx; box-shadow: 0 4rpx 20rpx rgba(255,152,0,0.06);
  margin-bottom: 32rpx;
}
.rc-score { display: flex; align-items: baseline; justify-content: center; gap: 8rpx; margin-bottom: 16rpx; }
.rc-num { font-size: 72rpx; font-weight: 700; color: #ff9800; }
.rc-label { font-size: 32rpx; color: #8a7a9a; }
.rc-bar { height: 8rpx; border-radius: 4rpx; background: #fff0f3; margin-bottom: 24rpx; overflow: hidden; }
.rc-fill { height: 100%; border-radius: 4rpx; background: linear-gradient(90deg, #ffb74d, #ff9800); transition: width 0.6s; }
.rc-suggest { display: block; font-size: 28rpx; color: #2d2d4e; line-height: 1.7; margin-bottom: 20rpx; }
.rc-ref { padding: 20rpx; border-radius: 16rpx; background: rgba(255,152,0,0.04); }
.rc-rl { display: block; font-size: 24rpx; color: #8a7a9a; margin-bottom: 6rpx; }
.rc-rt { font-size: 28rpx; color: #6a6a8a; line-height: 1.7; }
