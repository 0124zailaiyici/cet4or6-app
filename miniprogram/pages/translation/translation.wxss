.page{min-height:100vh;padding-bottom:110rpx;background:#fff8fc}
/* ── 导航 ── */
.nav{display:flex;justify-content:space-between;align-items:center;padding:20rpx 32rpx 10rpx}
.nav-l{display:flex;align-items:center;gap:12rpx}
.nav-avatar{width:48rpx;height:48rpx;border-radius:50%;background:linear-gradient(135deg,#f9a8d4,#f472b6);display:flex;align-items:center;justify-content:center;font-size:24rpx;box-shadow:0 4rpx 16rpx rgba(244,114,182,0.2)}
.nav-greeting{font-size:20rpx;color:#f9a8d4;font-weight:500}
.nav-title{font-size:28rpx;font-weight:700;color:#4a1a2e}
.nav-r{display:flex;gap:10rpx}
.nav-icon{width:48rpx;height:48rpx;border-radius:16rpx;background:rgba(244,114,182,0.06);display:flex;align-items:center;justify-content:center;font-size:22rpx}
.nav-icon:active{transform:scale(0.92)}.nav-icon.on{background:rgba(244,114,182,0.1)}
/* ── 进度卡片 ── */
.gc{margin:8rpx 24rpx 12rpx;padding:20rpx 24rpx;border-radius:28rpx;background:linear-gradient(135deg,#fce4ec,#fff3e0);display:flex;align-items:center;gap:16rpx}
.gc-ring{width:64rpx;height:64rpx;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.gc-ring-in{width:50rpx;height:50rpx;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center}
.gc-num{font-size:20rpx;font-weight:800;color:#ec407a;line-height:1}
.gc-lb{font-size:9rpx;color:#f9a8d4}
.gc-body{flex:1}
.gc-tip{display:block;font-size:24rpx;font-weight:600;color:#4a1a2e}
.gc-sub{display:block;font-size:18rpx;color:#f9a8d4;margin-top:2rpx}
.gc-streak{padding:8rpx 16rpx;border-radius:20rpx;background:rgba(255,202,40,0.12);text-align:center}
.gc-streak .n{font-weight:800;color:#ff8f00;display:block;font-size:24rpx}
.gc-streak .l{font-size:9rpx;color:#ffa000}
/* ── 等级进度 ── */
.stitle{font-size:24rpx;font-weight:600;color:#4a1a2e;padding:12rpx 32rpx 8rpx}
.levels{padding:0 24rpx;display:flex;flex-direction:column;gap:8rpx}
.lv{background:#fff;border-radius:18rpx;padding:14rpx 18rpx;display:flex;align-items:center;gap:14rpx}
.lv-ico{width:44rpx;height:44rpx;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-size:22rpx}
.lv-ico.l1{background:#e8f5e9}.lv-ico.l2{background:#e3f2fd}.lv-ico.l3{background:#fff3e0}.lv-ico.l4{background:#fce4ec}
.lv-body{flex:1}
.lv-name{font-size:22rpx;font-weight:600;color:#4a1a2e}
.lv-bar-wrap{display:flex;align-items:center;gap:10rpx;margin-top:6rpx}
.lv-bar{flex:1;height:8rpx;border-radius:4rpx;background:#f0f0f0;overflow:hidden}
.lv-fill{height:100%;border-radius:4rpx}
.lv-fill.l1{background:linear-gradient(90deg,#81c784,#66bb6a)}
.lv-fill.l2{background:linear-gradient(90deg,#64b5f6,#42a5f5)}
.lv-fill.l3{background:linear-gradient(90deg,#ffcc80,#ffa726)}
.lv-fill.l4{background:linear-gradient(90deg,#f48fb1,#ec407a)}
.lv-pct{font-size:20rpx;font-weight:600;color:#999;min-width:50rpx;text-align:right}
.lv-lock{font-size:20rpx;color:#ddd}.lv-check{font-size:20rpx;color:#66bb6a}
/* ── 题目列表 ── */
.tasks{padding:4rpx 24rpx 20rpx}
.task{background:#fff;border-radius:18rpx;padding:14rpx 16rpx;margin-bottom:8rpx;display:flex;align-items:center;gap:12rpx}
.task:active{transform:scale(0.98)}
.task-emoji{width:44rpx;height:44rpx;border-radius:14rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:22rpx}
.task-emoji.exam{background:#fce4ec}.task-emoji.sim{background:#f3e8ff}.task-emoji.para{background:#e0f2e9}
.task-body{flex:1;min-width:0}
.task-text{display:block;font-size:24rpx;font-weight:500;color:#4a1a2e;line-height:1.5}
.task-tags{display:flex;gap:6rpx;margin-top:6rpx;flex-wrap:wrap}
.task-tag{font-size:16rpx;font-weight:600;padding:2rpx 12rpx;border-radius:8rpx}
.task-tag.l1{background:#e8f5e9;color:#388e3c}.task-tag.l2{background:#e3f2fd;color:#1976d2}
.task-tag.l3{background:#fff3e0;color:#e65100}.task-tag.l4{background:#fce4ec;color:#c2185b}
.task-tag.exam{background:#fce4ec;color:#d81b60}.task-tag.sim{background:#f3e8ff;color:#8e24aa}.task-tag.para{background:#e0f2e9;color:#00897b}
.task-right{text-align:right;flex-shrink:0}
.task-check{font-size:26rpx;display:block}
.task-check.done{color:#66bb6a}
.task-fav{font-size:22rpx;display:block;margin-top:4rpx;color:#ffca28}
.empty-tip{padding:60rpx 40rpx;text-align:center;font-size:24rpx;color:#f9a8d4;line-height:1.8}
/* ── 答题导航 ── */
.d-nav{display:flex;align-items:center;padding:14rpx 24rpx 10rpx}
.d-title{flex:1;font-size:26rpx;font-weight:700;color:#4a1a2e}
.d-step{font-size:20rpx;font-weight:600;padding:6rpx 16rpx;border-radius:14rpx;background:#fce4ec;color:#ec407a}
/* ── 步骤指示器 ── */
.si{display:flex;align-items:center;justify-content:center;gap:8rpx;padding:4rpx 24rpx 14rpx}
.si-dot{width:10rpx;height:10rpx;border-radius:50%;background:#fce4ec;transition:all .3s}
.si-dot.active{width:28rpx;border-radius:6rpx;background:#f472b6}
.si-dot.done{background:#66bb6a}
.si-line{width:24rpx;height:3rpx;background:#fce4ec}
.d-scroll{padding:0 24rpx 20rpx}
/* ── 准备卡片 ── */
.pc{background:#fff;border-radius:28rpx;padding:24rpx;margin-bottom:14rpx}
.ps{margin-bottom:16rpx}.ps:last-child{margin-bottom:0}
.pst{font-size:22rpx;font-weight:600;color:#ec407a;margin-bottom:10rpx;display:flex;align-items:center;gap:6rpx}
.ps-kws{display:flex;gap:8rpx;flex-wrap:wrap}
.ps-kw{padding:6rpx 16rpx;border-radius:12rpx;background:#fce4ec;font-size:22rpx;color:#4a1a2e;font-weight:500}
.ps-struct{background:#f8f4ff;border-radius:16rpx;padding:14rpx 18rpx;font-size:24rpx;line-height:1.8}
.ps-struct .c{display:block;color:#6d3352;margin-bottom:6rpx}
.ps-struct .e{display:block;color:#7c4d8a;font-weight:500}
.ps-tip{background:#fff8e6;border-radius:14rpx;padding:14rpx 18rpx;font-size:22rpx;line-height:1.7;color:#6d4c2a}
/* ── 按钮 ── */
.btn-next{width:100%;height:88rpx;border-radius:44rpx;border:none;background:linear-gradient(135deg,#f9a8d4,#f472b6);color:#fff;font-size:28rpx;font-weight:600;display:flex;align-items:center;justify-content:center;box-shadow:0 6rpx 24rpx rgba(244,114,182,0.15);margin-bottom:8rpx}
.btn-next:active{transform:scale(0.97)}
.btn-next.disabled{opacity:0.5}
/* ── 题目 ── */
.qt{background:#fff;border-radius:28rpx;padding:24rpx;margin-bottom:14rpx;position:relative;overflow:hidden}
.qt::before{content:'';position:absolute;top:0;left:0;right:0;height:6rpx;background:linear-gradient(90deg,#f9a8d4,#f472b6)}
.qt-l{font-size:20rpx;font-weight:600;color:#f9a8d4;margin-bottom:10rpx}
.qt-b{display:block;font-size:30rpx;font-weight:600;line-height:1.8;color:#4a1a2e}
/* ── 输入框 ── */
.ib{background:#fff;border-radius:24rpx;padding:16rpx;border:2rpx solid #fce4ec;margin-bottom:14rpx}
.ib textarea{width:100%;min-height:140rpx;border:none;outline:none;font-size:26rpx;line-height:1.7;color:#4a1a2e;background:transparent;resize:none}
.ib textarea[disabled]{opacity:0.5}
.ib textarea::placeholder{color:#f9a8d4}
.ib-foot{display:flex;justify-content:flex-end;padding:4rpx 4rpx 0;font-size:18rpx;color:#f9a8d4}
/* ── 对比顶部 ── */
.ct{display:flex;align-items:center;gap:20rpx;margin-bottom:18rpx}
.cs{width:120rpx;height:120rpx;border-radius:50%;flex-shrink:0;background:conic-gradient(#f472b6 0deg 306deg,#fce4ec 306deg 360deg);display:flex;align-items:center;justify-content:center}
.cs-in{width:92rpx;height:92rpx;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center}
.cs-n{font-size:36rpx;font-weight:800;color:#ec407a;line-height:1}
.cs-stars{display:flex;gap:2rpx;margin-top:2rpx}
.cs-stars .s{font-size:14rpx}
.cs-stars .on{color:#ffca28}.cs-stars .off{color:#fce4ec}
.cq{flex:1}
.cqr{display:flex;justify-content:space-between;padding:6rpx 0;font-size:22rpx}
.cql{color:#f9a8d4}
.cqr{font-weight:600}
.cqr.good{color:#66bb6a}
/* ── 维度 ── */
.cds{margin-bottom:18rpx}
.cd{display:flex;align-items:center;gap:12rpx;margin-bottom:10rpx}
.cdl{width:48rpx;font-size:22rpx;color:#f9a8d4;text-align:right;flex-shrink:0}
.cdb{flex:1;height:12rpx;border-radius:6rpx;background:#fce4ec;overflow:hidden}
.cdf{height:100%;border-radius:6rpx;transition:width .5s}
.cdf.good{background:linear-gradient(90deg,#81c784,#66bb6a)}
.cdf.mid{background:linear-gradient(90deg,#ffcc80,#ffa726)}
.cdf.low{background:linear-gradient(90deg,#ef9a9a,#ef5350)}
.cdn{width:36rpx;font-size:22rpx;font-weight:600;text-align:right;flex-shrink:0}
/* ── 对比区块 ── */
.csec{margin-bottom:16rpx}
.cst{font-size:20rpx;font-weight:600;color:#f9a8d4;margin-bottom:8rpx;display:flex;align-items:center;gap:6rpx}
.csc-b{margin-top:6rpx;font-size:24rpx;color:#6d3352;background:#fce4ec;padding:14rpx 18rpx;border-radius:14rpx;line-height:1.7}
.crf{background:#f3e8ff;border-radius:16rpx;padding:16rpx 18rpx;display:flex;align-items:flex-start;gap:12rpx}
.crf-t{flex:1;font-size:24rpx;line-height:1.7;color:#6b3d7a}
.crf-p{width:44rpx;height:44rpx;border-radius:50%;background:rgba(171,71,188,0.06);display:flex;align-items:center;justify-content:center;font-size:20rpx;color:#ab47bc;flex-shrink:0}
/* ── 操作按钮 ── */
.ca{display:flex;gap:12rpx}
.ca .b{flex:1;height:80rpx;border-radius:40rpx;font-size:24rpx;font-weight:600;display:flex;align-items:center;justify-content:center}
.ca .bp{background:linear-gradient(135deg,#f9a8d4,#f472b6);color:#fff;border:none;box-shadow:0 6rpx 20rpx rgba(244,114,182,0.15)}
.ca .bg{background:transparent;border:2rpx solid #fce4ec;color:#f472b6}
.ca .bg:active{background:#fce4ec}
/* ── Tab 栏 ── */
.tabbar{position:fixed;bottom:0;left:0;right:0;z-index:100;display:flex;padding:6rpx 24rpx 12rpx;gap:4rpx;border-top:1rpx solid rgba(244,114,182,0.04);background:#fff8fc;box-shadow:0 -2rpx 12rpx rgba(0,0,0,0.02)}
.tab{flex:1;text-align:center;padding:8rpx 0;font-size:18rpx;font-weight:600;border-radius:16rpx;color:#f9a8d4}
.tab.active{background:#fce4ec;color:#ec407a}
.tab:active{transform:scale(0.96)}
.tab .tab-ico{display:block;font-size:32rpx;margin-bottom:4rpx}
/* ── 深色主题 ── */
.dark-theme{background:#1a1025}
.dark-theme .nav-title{color:#f0e0ec}
.dark-theme .gc{background:linear-gradient(135deg,#2d1a30,#2a1f28)}
.dark-theme .gc-tip{color:#f0dae8}
.dark-theme .gc-ring-in{background:#1a1025}
.dark-theme .lv{background:#201628}
.dark-theme .lv-name{color:#f0e0ec}
.dark-theme .task{background:#201628}
.dark-theme .task-text{color:#e8d0e0}
.dark-theme .stitle{color:#e8d0e0}
.dark-theme .d-title{color:#f0e0ec}
.dark-theme .pc{background:#201628}
.dark-theme .qt{background:#201628}
.dark-theme .qt-b{color:#f0e0ec}
.dark-theme .ib{background:#201628;border-color:#3a2040}
.dark-theme .ib textarea{color:#e8d0e0}
.dark-theme .cs-in{background:#1a1025}
.dark-theme .cql{color:#7a4a6a}
.dark-theme .cdl{color:#7a4a6a}
.dark-theme .cdb{background:#3a2040}
.dark-theme .cst{color:#7a4a6a}
.dark-theme .csc-b{background:#2d1a30;color:#dab0c8}
.dark-theme .crf{background:#201630}
.dark-theme .crf-t{color:#b8a0c0}
.dark-theme .tabbar{background:#1a1025;border-top-color:rgba(244,114,182,0.06);box-shadow:0 -2rpx 12rpx rgba(0,0,0,0.2)}
.dark-theme .tab{color:#6a4a6a}
.dark-theme .tab.active{background:#2d1a30;color:#f472b6}
.dark-theme .ps-struct{background:#2d1a30}
.dark-theme .ps-struct .c{color:#dab0c8}
.dark-theme .ps-struct .e{color:#b8a0c0}
.dark-theme .ps-tip{background:#2a2020;color:#d4c0a0}

.dark-theme .task-emoji.exam{background:#2d1a30}
.dark-theme .task-emoji.sim{background:#1a2030}
.dark-theme .task-emoji.para{background:#1a2a20}
.dark-theme .task-tag.exam{background:#2d1a30}
.dark-theme .task-tag.sim{background:#1a2030}
.dark-theme .task-tag.para{background:#1a2a20}
