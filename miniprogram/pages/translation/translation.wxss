.page {
  min-height: 100vh;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2d2d4e;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #b5d8f7;
  margin-top: 8rpx;
}

.trans-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.trans-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.1);
}

.trans-card:active {
  transform: scale(0.98);
}

.trans-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.trans-chinese {
  font-size: 30rpx;
  line-height: 1.6;
  color: #2d2d4e;
  flex: 1;
}

.trans-badge {
  font-size: 22rpx;
  color: #8a7a9a;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: #fff0f3;
  flex-shrink: 0;
}

.trans-badge.done {
  color: #c5e1a5;
  background: rgba(197, 225, 165, 0.2);
}

.trans-source {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9a8aaa;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.back-btn {
  width: 100rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f3;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #8a7a9a;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d2d4e;
}

.detail-scroll {
  flex: 1;
}

.chinese-block {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.1);
  margin-bottom: 24rpx;
}

.chinese-label {
  font-size: 24rpx;
  color: #8a7a9a;
  display: block;
  margin-bottom: 12rpx;
}

.chinese-text {
  font-size: 32rpx;
  line-height: 1.7;
  color: #2d2d4e;
}

.answer-block {
  margin-bottom: 24rpx;
}

.answer-input {
  width: 100%;
  min-height: 200rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #ffd9e0;
  color: #2d2d4e;
  font-size: 28rpx;
  line-height: 1.7;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ff9eb5, #ff8a80);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 158, 181, 0.3);
}

.result-block {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.1);
  margin-bottom: 32rpx;
}

.result-score {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.score-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #ff9eb5;
}

.score-label {
  font-size: 32rpx;
  color: #8a7a9a;
}

.result-bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: #fff0f3;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #ff9eb5, #ff8a80);
  transition: width 0.6s;
}

.result-suggestions {
  font-size: 28rpx;
  color: #2d2d4e;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.result-ref {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff5f7;
}

.ref-label {
  font-size: 24rpx;
  color: #8a7a9a;
  display: block;
  margin-bottom: 8rpx;
}

.ref-text {
  font-size: 28rpx;
  color: #6a6a8a;
  line-height: 1.7;
}
