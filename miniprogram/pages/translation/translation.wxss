.page { min-height: 100vh; padding-bottom: 24rpx; background: #fff8fc; }

/* ── 导航 ── */
.nav { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 32rpx 10rpx; }
.nav-l { display: flex; align-items: center; gap: 12rpx; }
.nav-avatar {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: linear-gradient(135deg, #f9a8d4, #f472b6); display: flex;
  align-items: center; justify-content: center; font-size: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(244,114,182,0.2);
}
.nav-greeting { font-size: 20rpx; color: #f9a8d4; font-weight: 500; }
.nav-title { font-size: 28rpx; font-weight: 700; color: #4a1a2e; }
.nav-r { display: flex; gap: 10rpx; }
.nav-icon {
  width: 48rpx; height: 48rpx; border-radius: 16rpx;
  background: rgba(244,114,182,0.06); display: flex;
  align-items: center; justify-content: center; font-size: 22rpx;
}
.nav-icon:active { transform: scale(0.92); }
.nav-icon.on { background: rgba(244,114,182,0.1); }

/* ── 进度卡片 ── */
.progress-card {
  margin: 8rpx 24rpx 12rpx; padding: 20rpx 24rpx; border-radius: 28rpx;
  background: linear-gradient(135deg, #fce4ec, #fff3e0);
  display: flex; align-items: center; gap: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(244,114,182,0.06);
}
.pc-ring {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0;
  background: conic-gradient(#f472b6 0deg 162deg, rgba(244,114,182,0.08) 162deg 360deg);
  display: flex; align-items: center; justify-content: center;
}
.pc-ring-in {
  width: 50rpx; height: 50rpx; border-radius: 50%; background: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.pc-num { font-size: 20rpx; font-weight: 800; color: #ec407a; line-height: 1; }
.pc-unit { font-size: 9rpx; color: #f9a8d4; }
.pc-body { flex: 1; }
.pc-tip { display: block; font-size: 24rpx; font-weight: 600; color: #4a1a2e; }
.pc-sub { display: block; font-size: 18rpx; color: #f9a8d4; margin-top: 2rpx; }
.pc-badge {
  padding: 6rpx 16rpx; border-radius: 20rpx;
  background: rgba(244,114,182,0.06); font-size: 20rpx;
  color: #ec407a; font-weight: 700; white-space: nowrap; flex-shrink: 0;
}

/* ── 标签栏 ── */
.tabs { display: flex; gap: 4rpx; padding: 4rpx 24rpx; margin-bottom: 6rpx; }
.tab {
  flex: 1; text-align: center; padding: 10rpx 0; font-size: 22rpx; font-weight: 600;
  border-radius: 18rpx; color: #f9a8d4; transition: all 0.2s;
}
.tab.active { background: #fff; color: #ec407a; box-shadow: 0 2rpx 12rpx rgba(244,114,182,0.04); }
.tab:active { transform: scale(0.96); }

/* ═══════════ 列表 ═══════════ */
.list { padding: 8rpx 20rpx 20rpx; display: flex; flex-direction: column; gap: 10rpx; }

.lc {
  background: #fff; border-radius: 24rpx; padding: 18rpx 20rpx;
  display: flex; align-items: center; gap: 14rpx;
  box-shadow: 0 2rpx 16rpx rgba(244,114,182,0.03);
  animation: bounceIn 0.4s ease both;
}
.lc:active { transform: scale(0.97); }

@keyframes bounceIn {
  0% { opacity: 0; transform: translateY(16rpx) scale(0.96); }
  60% { transform: translateY(-2rpx); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.lc-emoji {
  width: 52rpx; height: 52rpx; border-radius: 18rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.lc-emoji.exam { background: #fce4ec; }
.lc-emoji.sim  { background: #f3e8ff; }
.lc-emoji.para { background: #e0f2e9; }

.lc-body { flex: 1; min-width: 0; }
.lc-text { display: block; font-size: 26rpx; font-weight: 500; color: #4a1a2e; line-height: 1.5; }
.lc-tags { display: flex; gap: 6rpx; margin-top: 6rpx; flex-wrap: wrap; }
.lc-tag {
  font-size: 16rpx; font-weight: 600; padding: 2rpx 12rpx; border-radius: 8rpx;
}
.lc-tag.exam { background: #fce4ec; color: #d81b60; }
.lc-tag.sim  { background: #f3e8ff; color: #8e24aa; }
.lc-tag.para { background: #e0f2e9; color: #00897b; }

.lc-right { text-align: right; flex-shrink: 0; }
.lc-check { font-size: 26rpx; line-height: 1; display: block; }
.lc-check.done { color: #66bb6a; }
.lc-check.pending { color: #f9a8d4; }
.lc-score { display: block; font-size: 20rpx; font-weight: 700; margin-top: 4rpx; }
.lc-score.good { color: #66bb6a; }
.lc-score.mid  { color: #ffa726; }

/* ═══════════ 答题导航 ═══════════ */
.d-nav {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 24rpx 16rpx;
}
.d-back {
  width: 48rpx; height: 48rpx; border-radius: 18rpx;
  background: rgba(244,114,182,0.06); display: flex;
  align-items: center; justify-content: center; font-size: 24rpx; color: #f472b6;
}
.d-back:active { transform: scale(0.9); }
.d-title { flex: 1; font-size: 28rpx; font-weight: 700; color: #4a1a2e; }

.ai-badge {
  display: flex; align-items: center; gap: 6rpx; padding: 6rpx 16rpx;
  border-radius: 24rpx; background: rgba(244,114,182,0.06); font-size: 20rpx;
  color: #f472b6; font-weight: 500;
}
.ai-badge.hidden { display: none; }
.ai-badge.off { opacity: 0.35; }
.ai-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #66bb6a; transition: background 0.2s;
}
.ai-badge.off .ai-dot { background: #ccc; }

.d-scroll { padding: 0 24rpx 24rpx; max-height: 100vh; }

/* ── 题目气泡 ── */
.q-bubble {
  background: #fff; border-radius: 28rpx; padding: 24rpx;
  margin-bottom: 16rpx; position: relative; overflow: hidden;
}
.q-bubble::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6rpx;
  background: linear-gradient(90deg, #f9a8d4, #f472b6, #f9a8d4);
}
.q-hint {
  display: inline-flex; align-items: center; gap: 6rpx;
  padding: 4rpx 14rpx; border-radius: 14rpx; background: #fce4ec;
  font-size: 18rpx; font-weight: 600; color: #d81b60; margin-bottom: 12rpx;
}
.q-text { display: block; font-size: 30rpx; font-weight: 600; line-height: 1.7; color: #4a1a2e; }
.q-kws { display: flex; gap: 6rpx; flex-wrap: wrap; margin-top: 14rpx; }
.q-kw {
  font-size: 18rpx; padding: 4rpx 14rpx; border-radius: 10rpx;
  background: rgba(38,166,154,0.04); color: #26a69a; font-weight: 500;
}

/* ── 输入区 ── */
.input-area {
  background: #fff; border-radius: 24rpx; padding: 16rpx;
  border: 2rpx solid #fce4ec; margin-bottom: 16rpx;
}
.input-field {
  width: 100%; min-height: 140rpx; font-size: 26rpx; line-height: 1.7;
  color: #4a1a2e; border: none; outline: none; resize: none; background: transparent;
}
.input-field[disabled] { opacity: 0.5; }
.input-field::placeholder { color: #f9a8d4; }
.input-foot { display: flex; justify-content: flex-end; padding: 4rpx 4rpx 0; }
.wc { font-size: 18rpx; color: #f9a8d4; }
.wc.has { color: #f472b6; }

/* ── 提交按钮 ── */
.btn-go {
  width: 100%; height: 88rpx; border-radius: 44rpx;
  background: linear-gradient(135deg, #f9a8d4, #f472b6);
  color: #fff; font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 24rpx rgba(244,114,182,0.2);
  margin-bottom: 20rpx;
}
.btn-go:active { transform: scale(0.97); }
.btn-go.disabled { opacity: 0.5; }

/* ── 结果卡片 ── */
.result-card {
  background: #fff; border-radius: 28rpx; padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(244,114,182,0.04);
  margin-bottom: 16rpx;
  animation: popIn 0.45s ease;
}
@keyframes popIn {
  0% { opacity: 0; transform: scale(0.92) translateY(16rpx); }
  70% { transform: scale(1.01) translateY(-2rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

.rc-top { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }

.rc-stars {
  width: 120rpx; height: 120rpx; border-radius: 50%; flex-shrink: 0;
  background: conic-gradient(#f472b6 0deg 306deg, #fce4ec 306deg 360deg);
  display: flex; align-items: center; justify-content: center;
}
.rc-stars-in {
  width: 92rpx; height: 92rpx; border-radius: 50%; background: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.rc-star-num { font-size: 38rpx; font-weight: 800; color: #ec407a; line-height: 1; }
.rc-star-lb { font-size: 16rpx; color: #f9a8d4; }
.rc-starlets { display: flex; gap: 2rpx; margin-top: 2rpx; }
.rc-starlets text { font-size: 16rpx; color: #fce4ec; }
.rc-starlets text.on { color: #ffca28; }

.rc-quickie { flex: 1; }
.rc-q { display: flex; justify-content: space-between; padding: 4rpx 0; font-size: 22rpx; }
.rc-ql { color: #f9a8d4; }
.rc-qr { font-weight: 700; }
.rc-qr.good { color: #66bb6a; }
.rc-qr.mid  { color: #ffa726; }
.rc-qr.low  { color: #ef5350; }

.rc-dims { margin-bottom: 16rpx; display: flex; flex-direction: column; gap: 10rpx; }
.rc-dim { display: flex; align-items: center; gap: 12rpx; padding: 0 4rpx; }
.rc-dl { width: 56rpx; font-size: 22rpx; color: #f9a8d4; text-align: right; flex-shrink: 0; }
.rc-dbar { flex: 1; height: 14rpx; border-radius: 7rpx; background: #fce4ec; overflow: hidden; }
.rc-dfill { height: 100%; border-radius: 7rpx; transition: width 0.5s; }
.rc-dfill.good { background: linear-gradient(90deg, #81c784, #66bb6a); }
.rc-dfill.mid  { background: linear-gradient(90deg, #ffcc80, #ffa726); }
.rc-dfill.low  { background: linear-gradient(90deg, #ef9a9a, #ef5350); }
.rc-dn { width: 36rpx; font-size: 22rpx; font-weight: 700; text-align: right; flex-shrink: 0; }
.rc-dn.c-good { color: #66bb6a; }
.rc-dn.c-mid  { color: #ffa726; }
.rc-dn.c-low  { color: #ef5350; }

.rc-block { margin-bottom: 14rpx; }
.rc-bt { display: block; font-size: 20rpx; font-weight: 600; color: #f9a8d4; margin-bottom: 8rpx; }

.rc-suggest {
  background: #fce4ec; border-radius: 16rpx; padding: 16rpx 18rpx;
  font-size: 24rpx; line-height: 1.7; color: #6d3352;
}
.rc-ref {
  background: #f3e8ff; border-radius: 16rpx; padding: 16rpx 18rpx;
  display: flex; align-items: flex-start; gap: 12rpx;
}
.rc-ref-t { flex: 1; font-size: 24rpx; line-height: 1.7; color: #6b3d7a; }
.rc-ref-play {
  width: 44rpx; height: 44rpx; border-radius: 50%; flex-shrink: 0;
  background: rgba(171,71,188,0.04); display: flex; align-items: center;
  justify-content: center; font-size: 20rpx; color: #ab47bc;
}

/* ── 重做 ── */
.btn-retry {
  width: 100%; height: 80rpx; border-radius: 40rpx;
  border: 2rpx solid #fce4ec; color: #f472b6;
  font-size: 24rpx; font-weight: 600; display: flex;
  align-items: center; justify-content: center;
  background: transparent; margin-bottom: 20rpx;
}
.btn-retry:active { background: #fce4ec; }

/* ── 历史 ── */
.h-area { margin-bottom: 16rpx; }
.h-title { font-size: 22rpx; font-weight: 600; color: #4a1a2e; margin-bottom: 14rpx; display: flex; align-items: center; gap: 6rpx; }
.h-star { color: #ffca28; }

.h-chart { display: flex; align-items: flex-end; gap: 8rpx; height: 80rpx; margin-bottom: 16rpx; }
.h-bar {
  flex: 1; border-radius: 6rpx 6rpx 0 0; position: relative; min-height: 8rpx;
}
.hb-l {
  position: absolute; top: -22rpx; left: 50%; transform: translateX(-50%);
  font-size: 16rpx; font-weight: 700; color: #f9a8d4; white-space: nowrap;
}

.h-items { display: flex; flex-direction: column; }
.h-item {
  display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(244,114,182,0.03);
}
.h-item:last-child { border-bottom: none; }
.h-idx { font-size: 20rpx; color: #f9a8d4; width: 44rpx; flex-shrink: 0; font-weight: 600; }
.h-body { flex: 1; min-width: 0; }
.h-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4rpx; }
.h-date { font-size: 18rpx; color: #f9a8d4; }
.h-sc { font-size: 22rpx; font-weight: 700; padding: 2rpx 12rpx; border-radius: 8rpx; }
.h-sc.good { color: #66bb6a; background: rgba(102,187,106,0.04); }
.h-sc.mid  { color: #ffa726; background: rgba(255,167,38,0.04); }
.h-sc.low  { color: #ef5350; background: rgba(239,83,80,0.04); }
.h-ans { display: block; font-size: 22rpx; color: #b07a96; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.h-arrow { font-size: 18rpx; width: 28rpx; text-align: center; flex-shrink: 0; }
.h-arrow.up { color: #66bb6a; }
.h-arrow.down { color: #ef5350; }

/* ═══════════ 深色主题 ═══════════ */
.dark-theme { background: #1a1025; }
.dark-theme .nav-title { color: #f0e0ec; }
.dark-theme .progress-card { background: linear-gradient(135deg, #2d1a30, #2a1f28); }
.dark-theme .pc-tip { color: #f0dae8; }
.dark-theme .pc-ring-in { background: #1a1025; }
.dark-theme .pc-badge { background: rgba(244,114,182,0.1); }
.dark-theme .tab.active { background: #2d1a30; color: #f472b6; }
.dark-theme .tab { color: #6a4a6a; }
.dark-theme .lc { background: #201628; }
.dark-theme .lc-text { color: #e8d0e0; }
.dark-theme .d-title { color: #f0e0ec; }
.dark-theme .q-bubble { background: #201628; }
.dark-theme .q-text { color: #f0e0ec; }
.dark-theme .input-area { background: #201628; border-color: #3a2040; }
.dark-theme .input-field { color: #e8d0e0; }
.dark-theme .result-card { background: #201628; }
.dark-theme .rc-star-lb { color: #7a4a6a; }
.dark-theme .rc-stars-in { background: #1a1025; }
.dark-theme .rc-ql { color: #7a4a6a; }
.dark-theme .rc-dl { color: #7a4a6a; }
.dark-theme .rc-dbar { background: #3a2040; }
.dark-theme .rc-bt { color: #7a4a6a; }
.dark-theme .rc-suggest { background: #2d1a30; color: #dab0c8; }
.dark-theme .rc-ref { background: #201630; }
.dark-theme .rc-ref-t { color: #b8a0c0; }
.dark-theme .h-title { color: #f0e0ec; }
.dark-theme .h-date { color: #7a4a6a; }
.dark-theme .h-ans { color: #8a6a7a; }
.dark-theme .h-bar { opacity: 0.7; }
.dark-theme .h-idx { color: #7a4a6a; }
.dark-theme .hb-l { color: #7a4a6a; }
.dark-theme .d-back { background: rgba(244,114,182,0.08); }
.dark-theme .btn-retry { border-color: #3a2040; color: #7a4a6a; }
.dark-theme .q-kw { background: rgba(38,166,154,0.08); color: #4db6ac; }
.dark-theme .lc-emoji.exam { background: #2d1a30; }
.dark-theme .lc-emoji.sim  { background: #1a2030; }
.dark-theme .lc-emoji.para { background: #1a2a20; }
.dark-theme .lc-tag.exam { background: #2d1a30; }
.dark-theme .lc-tag.sim  { background: #1a2030; }
.dark-theme .lc-tag.para { background: #1a2a20; }
