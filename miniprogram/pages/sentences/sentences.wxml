<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="s-header">
    <view class="sh-bg"></view>
    <view class="sh-content">
      <view class="sh-top">
        <text class="sh-title">语境句子</text>
        <view class="sh-actions">
          <view class="sh-btn" catchtap="goDict">📖 查词</view>
          <text class="sh-counter">{{masteredIds.length}}/{{allSentences.length}}</text>
        </view>
      </view>
      <view class="search-box">
        <text class="sb-icon">🔍</text>
        <input class="sb-input" placeholder="搜索句子或关键词…" value="{{searchQuery}}" bindinput="onSearchInput" confirm-type="search" />
        <view class="sb-clear" wx:if="{{searchQuery}}" catchtap="clearSearch">✕</view>
      </view>
    </view>
  </view>

  <scroll-view class="topic-scroll" scroll-x>
    <view class="topic-bar">
      <view class="topic-pill {{currentTopic === item ? 'active' : ''}}" wx:for="{{topics}}" wx:key="*this" data-topic="{{item}}" catchtap="filterByTopic">{{item}}</view>
    </view>
  </scroll-view>

  <scroll-view class="card-scroll" scroll-y>
    <view class="card-list">
      <view class="empty-state" wx:if="{{filteredSentences.length === 0}}">
        <text class="empty-emoji">🔍</text>
        <text class="empty-text">没有匹配的句子</text>
        <text class="empty-hint">试试其他关键词</text>
      </view>

      <view class="s-card {{masteredIds.indexOf(item.id) !== -1 ? 'done' : ''}} {{favoriteIds.indexOf(item.id) !== -1 ? 'fav' : ''}}" wx:for="{{filteredSentences}}" wx:key="id" data-id="{{item.id}}" catchtap="toggleExpand">
        <view class="sc-main">
          <view class="sc-num">{{index + 1}}</view>
          <view class="sc-body">
            <view class="sc-english">
              <rich-text nodes="{{highlightText(item.english, item.keywords)}}"></rich-text>
            </view>
            <view class="sc-chinese" wx:if="{{expandedIds.indexOf(item.id) !== -1}}">{{item.chinese}}</view>
            <view class="sc-bottom">
              <view class="sc-tag">{{item.topic}}</view>
              <view class="sc-actions">
                <view class="sc-fav {{favoriteIds.indexOf(item.id) !== -1 ? 'on' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite">{{favoriteIds.indexOf(item.id) !== -1 ? '★' : '☆'}}</view>
                <view class="sc-master {{masteredIds.indexOf(item.id) !== -1 ? 'on' : ''}}" data-id="{{item.id}}" catchtap="toggleMaster">{{masteredIds.indexOf(item.id) !== -1 ? '✓' : '○'}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
