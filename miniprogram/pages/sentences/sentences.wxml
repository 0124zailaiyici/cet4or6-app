<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="s-header">
    <view class="sh-bg"></view>
    <view class="sh-content">
      <view class="sh-top">
        <text class="sh-title">语境句子</text>
        <text class="sh-counter">{{masteredIds.length}}/{{allSentences.length}}</text>
      </view>
      <view class="search-box">
        <text class="sb-icon">🔍</text>
        <input class="sb-input" placeholder="搜索句子或关键词…" value="{{searchQuery}}" bindinput="onSearchInput" confirm-type="search" />
        <view class="sb-clear" wx:if="{{searchQuery}}" catchtap="clearSearch">✕</view>
      </view>
      <view class="sh-actions">
        <view class="sh-btn" catchtap="goDict">📖 查词</view>
        <view class="sh-btn" catchtap="openPasteModal">📋 导入</view>
        <view class="sh-btn sh-btn-primary" catchtap="openGenModal">✨ AI生成</view>
      </view>
    </view>
  </view>

  <view class="topic-section">
    <scroll-view class="topic-scroll" scroll-x>
      <view class="topic-bar">
        <view class="topic-pill {{currentTopic === item ? 'active' : ''}}" wx:for="{{topics}}" wx:key="*this" data-topic="{{item}}" catchtap="filterByTopic">
          {{item}}<text class="topic-count" wx:if="{{item === '全部'}}">{{allSentences.length}}</text>
          <text class="topic-count" wx:elif="{{topicCounts[item] !== undefined}}">{{topicCounts[item]}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="mode-bar">
    <view class="mode-btn {{viewMode === 'list' ? 'active' : ''}}" data-mode="list" catchtap="switchMode">📋 列表</view>
    <view class="mode-btn {{viewMode === 'immersion' ? 'active' : ''}}" data-mode="immersion" catchtap="switchMode">🎯 沉浸</view>
    <view class="mode-btn {{viewMode === 'puzzle' ? 'active' : ''}}" data-mode="puzzle" catchtap="switchMode">🧩 拼图</view>
  </view>

  <scroll-view class="card-scroll" scroll-y wx:if="{{viewMode === 'list'}}" style="height: {{scrollHeight}}px;">
    <view class="card-list">
      <view class="empty-state" wx:if="{{filteredSentences.length === 0}}">
        <text class="empty-icon">📭</text>
        <text class="empty-title">还没有匹配的句子</text>
        <text class="empty-desc">试试其他关键词，或通过 AI 生成</text>
        <view class="empty-actions">
          <view class="empty-btn gen" catchtap="openGenModal">✨ AI 生成</view>
          <view class="empty-btn paste" catchtap="openPasteModal">📋 导入文本</view>
        </view>
      </view>

      <view class="s-card" wx:for="{{filteredSentences}}" wx:for-item="item" wx:for-index="index">
        <view class="sc-main">
          <view class="sc-num">{{index + 1}}</view>
          <view class="sc-body">
            <view class="sc-english">
              <text>{{item.english}}</text>
            </view>
            <view class="sc-chinese">{{item.chinese}}</view>
            <view class="sc-bottom">
              <view class="sc-tag">{{item.topic}}</view>
              <view class="sc-actions">
                <view class="fav-btn {{favStatus[index] ? 'on' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite">{{favTexts[index]}}</view>
                <view class="master-btn {{masterStatus[index] ? 'on' : ''}}" data-id="{{item.id}}" catchtap="toggleMaster">{{masterTexts[index]}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="immersion-area" wx:if="{{viewMode === 'immersion' && filteredSentences.length > 0}}">
    <view class="imm-card">
      <view class="imm-num">{{immersionIndex + 1}} / {{filteredSentences.length}}</view>
      <view class="imm-english">
        <text>{{filteredSentences[immersionIndex].english}}</text>
      </view>
      <view class="imm-chinese">{{filteredSentences[immersionIndex].chinese}}</view>
      <view class="imm-actions">
        <view class="imm-btn {{immFavStatus ? 'fav-on on' : 'fav-on'}}" data-id="{{filteredSentences[immersionIndex].id}}" catchtap="toggleFavorite">{{favTexts[immersionIndex]}}</view>
        <view class="imm-btn {{immMasterStatus ? 'master-on on' : 'master-on'}}" data-id="{{filteredSentences[immersionIndex].id}}" catchtap="toggleMaster">{{masterTexts[immersionIndex]}}</view>
      </view>
    </view>
    <view class="imm-nav">
      <view class="nav-btn {{immersionIndex === 0 ? 'disabled' : ''}}" catchtap="prevSentence">‹</view>
      <text class="imm-progress">{{immersionIndex + 1}} / {{filteredSentences.length}}</text>
      <view class="nav-btn {{immersionIndex === filteredSentences.length - 1 ? 'disabled' : ''}}" catchtap="nextSentence">›</view>
    </view>
  </view>

  <!-- Puzzle Mode -->
  <view class="puzzle-area" wx:if="{{viewMode === 'puzzle'}}">
    <view class="pz-header">
      <view class="pz-h-left">
        <text class="pz-title">🧩 句子拼图</text>
        <text class="pz-progress">{{puzzleIndex + 1}} / {{puzzleTotal}}</text>
      </view>
      <view class="pz-stats">
        <text class="pz-score">★ {{puzzleScore}}</text>
        <text class="pz-combo">🔥 x{{puzzleCombo}}</text>
      </view>
    </view>

    <block wx:if="{{!puzzleFinished || puzzleStars === 0}}">
      <view class="pz-hint">
        <text class="pz-hint-cn">{{filteredSentences.length > puzzleIndex ? filteredSentences[puzzleIndex].chinese : ''}}</text>
        <text class="pz-word-count" wx:if="{{puzzleAnswers.length > 0}}">共 <text class="pz-wc-num">{{puzzleAnswers.length}}</text> 个单词，<text class="pz-wc-hint">{{puzzleHintIndices.length}} 个已给出</text></text>
        <text class="pz-hint-progress warn" wx:if="{{puzzleErrors >= 3}}">需要帮助？试试 👁答案 或 ⏭跳过</text>
      </view>

      <view class="pz-drop">
        <block wx:for="{{puzzleSelected}}" wx:for-index="pos">
          <text wx:if="{{item !== null}}"
            class="pz-drop-word {{puzzleFinished ? 'done' : ''}} {{puzzleHintIndices.indexOf(item) >= 0 ? 'hint-glow' : ''}}"
            data-pos="{{pos}}" catchtap="untapPuzzleWord"
          >
            {{puzzleWords[item]}}
          </text>
          <text wx:else class="pz-drop-slot">___</text>
        </block>
      </view>

      <view class="pz-error" wx:if="{{puzzleErrors > 0}}">
        <text class="pz-error-icon">❌</text>
        <text class="pz-error-text">已尝试 {{puzzleErrors}} 次</text>
      </view>

      <view class="pz-actions">
        <view class="pz-act pz-act-reveal" catchtap="showAnswer">👁 答案</view>
        <view class="pz-act pz-act-skip" catchtap="skipSentence">⏭ 跳过</view>
      </view>

      <view class="pz-bank">
        <text
          class="pz-bank-word {{puzzleWordUsed[index] ? 'used' : ''}}"
          wx:for="{{puzzleWords}}" wx:key="*this" wx:for-index="index"
          data-wi="{{index}}"
          catchtap="tapPuzzleWord"
        >
          {{item}}
        </text>
      </view>

    </block>

    <!-- Puzzle Result -->
    <view class="pz-result" wx:if="{{puzzleFinished && puzzleStars > 0}}">
      <text class="pz-r-icon">🎉</text>
      <text class="pz-r-title">拼图完成！</text>
      <view class="pz-r-stars">
        <text class="pz-star {{puzzleStars >= 1 ? 'lit' : ''}}">★</text>
        <text class="pz-star {{puzzleStars >= 2 ? 'lit' : ''}}">★</text>
        <text class="pz-star {{puzzleStars >= 3 ? 'lit' : ''}}">★</text>
      </view>
      <view class="pz-r-stats">
        <view class="pz-rs-item"><text class="pz-rs-num">{{puzzleScore}}</text><text class="pz-rs-lbl">得分</text></view>
        <view class="pz-rs-item"><text class="pz-rs-num">{{puzzleCombo}}</text><text class="pz-rs-lbl">最高连击</text></view>
      </view>
      <view class="pz-r-actions">
        <view class="pz-r-btn primary" catchtap="restartPuzzle">🔄 再来一次</view>
        <view class="pz-r-btn" catchtap="switchMode" data-mode="list">📋 返回列表</view>
      </view>
    </view>

    <view class="pz-tip">💡 点击单词拼成句子 · 提示消耗连击 · 答案不计分</view>
  </view>

  <view class="immersion-area" wx:if="{{viewMode === 'immersion' && filteredSentences.length === 0}}">
    <view class="empty-state">
      <text class="empty-icon">📭</text>
      <text class="empty-title">没有句子可学习</text>
      <text class="empty-desc">换个话题筛选，或导入新句子</text>
    </view>
  </view>

  <view class="gen-overlay" wx:if="{{showGenModal}}" catchtap="closeGenModal">
    <view class="gen-modal" catchtap="noop">
      <view class="gen-header">
        <text class="gen-title">AI 生成语境句子</text>
        <view class="gen-close" catchtap="closeGenModal">✕</view>
      </view>
      <view class="gen-type-switch">
        <view class="gen-type-btn {{genType === 'word' ? 'active' : ''}}" data-type="word" catchtap="setGenType">按单词</view>
        <view class="gen-type-btn {{genType === 'topic' ? 'active' : ''}}" data-type="topic" catchtap="setGenType">按话题</view>
      </view>
      <input class="gen-input" placeholder="{{genType === 'word' ? '输入四级单词，如：sustainable' : '输入话题，如：环保'}}" value="{{genInput}}" bindinput="onGenInput" confirm-type="done" />
      <view class="gen-count-row">
        <text class="gen-count-label">生成数量</text>
        <view class="gen-count-ctrl">
          <view class="gen-count-btn" data-delta="-1" catchtap="adjustGenCount">−</view>
          <text class="gen-count-num">{{genCount}}</text>
          <view class="gen-count-btn" data-delta="1" catchtap="adjustGenCount">+</view>
        </view>
      </view>
      <view class="gen-submit {{generating ? 'loading' : ''}}" catchtap="doGenerate">
        {{generating ? '生成中…' : '生成句子'}}
      </view>
      <view class="gen-hint">基于四级大纲难度，生成含关键词的语境句子</view>
    </view>
  </view>

  <view class="gen-overlay" wx:if="{{showPasteModal}}" catchtap="closePasteModal">
    <view class="gen-modal" catchtap="noop">
      <view class="gen-header">
        <text class="gen-title">粘贴文本导入句子</text>
        <view class="gen-close" catchtap="closePasteModal">✕</view>
      </view>
      <textarea class="paste-area" placeholder="粘贴英文文章或段落（如四级真题阅读、英语新闻等），AI 自动拆句并标注翻译、关键词、话题" value="{{pasteText}}" bindinput="onPasteInput" auto-height maxlength="3000" />
      <view class="gen-submit {{parsing ? 'loading' : ''}}" catchtap="doParse">
        {{parsing ? '解析中…' : '开始解析导入'}}
      </view>
      <view class="gen-hint">支持英文段落、文章，AI 自动拆句并适配四级难度</view>
    </view>
  </view>
</view>
