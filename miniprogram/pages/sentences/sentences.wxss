.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

/* ===== Header ===== */
.s-header {
  position: relative;
  margin-bottom: 0;
  overflow: hidden;
}

.sh-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 260rpx;
  background: linear-gradient(135deg, #81c784, #4caf50);
  border-radius: 0 0 40rpx 40rpx;
}

.sh-content {
  position: relative;
  padding: 48rpx 36rpx 36rpx;
}

.sh-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.sh-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.sh-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sh-btn {
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255,255,255,0.2);
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
}

.sh-counter {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.15);
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
}

/* Search */
.search-box {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.92);
  border-radius: 20rpx;
  padding: 0 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.sb-icon { font-size: 28rpx; margin-right: 12rpx; }

.sb-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #2d2d4e;
}

.sb-clear {
  font-size: 28rpx;
  color: #8a7a9a;
  padding: 8rpx;
}

/* Topic pills */
.topic-scroll {
  padding: 24rpx 36rpx 16rpx;
  white-space: nowrap;
}

.topic-bar {
  display: flex;
  gap: 14rpx;
}

.topic-pill {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #4caf50;
  background: rgba(76, 175, 80, 0.08);
  border: 2rpx solid rgba(76, 175, 80, 0.15);
  font-weight: 500;
}

.topic-pill.active {
  color: #ffffff;
  background: linear-gradient(135deg, #81c784, #4caf50);
  border-color: transparent;
}

/* Card list */
.card-scroll {
  padding: 0 36rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Card */
.s-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(76, 175, 80, 0.06);
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.s-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 32rpx rgba(76, 175, 80, 0.1);
}

.s-card.done {
  background: linear-gradient(135deg, #f5fff0, #ffffff);
  border-color: rgba(76, 175, 80, 0.12);
}

.s-card.fav {
  border-color: rgba(255, 215, 0, 0.2);
}

.sc-main {
  display: flex;
  gap: 20rpx;
}

.sc-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: rgba(76, 175, 80, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #4caf50;
  flex-shrink: 0;
}

.sc-body {
  flex: 1;
}

.sc-english {
  font-size: 30rpx;
  line-height: 1.7;
  color: #2d2d4e;
}

.sc-english .kw {
  color: #ff9eb5;
  font-style: normal;
  font-weight: 600;
}

.sc-chinese {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(76, 175, 80, 0.04);
  font-size: 28rpx;
  color: #6a6a8a;
  line-height: 1.6;
}

.sc-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.sc-tag {
  font-size: 22rpx;
  color: #4caf50;
  padding: 6rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(76, 175, 80, 0.06);
}

.sc-actions {
  display: flex;
  gap: 16rpx;
}

.sc-fav {
  font-size: 36rpx;
  color: #d0c0d8;
  line-height: 1;
}

.sc-fav.on { color: #ffd700; }

.sc-master {
  font-size: 32rpx;
  color: #d0c0d8;
  line-height: 1;
}

.sc-master.on { color: #81c784; }

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-emoji { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; color: #2d2d4e; font-weight: 600; margin-bottom: 8rpx; }
.empty-hint { font-size: 26rpx; color: #8a7a9a; }
