.page {
  min-height: 100vh;
  background: #f5f7f8;
  padding-bottom: 48rpx;
}

/* ===== Header ===== */
.s-header {
  position: relative;
  overflow: hidden;
}

.sh-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #66bb6a, #388e3c);
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(56,142,60,0.15);
}

.sh-content {
  position: relative;
  padding: 48rpx 36rpx 36rpx;
}

.sh-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.sh-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.sh-counter {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.2);
  padding: 10rpx 22rpx;
  border-radius: 22rpx;
}

/* Search */
.search-box {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.92);
  border-radius: 20rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.sb-icon { font-size: 28rpx; margin-right: 12rpx; }

.sb-input {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
  color: #2d2d4e;
}

.sb-clear {
  font-size: 28rpx;
  color: #8a7a9a;
  padding: 8rpx;
}

/* Header action buttons */
.sh-actions {
  display: flex;
  gap: 14rpx;
}

.sh-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255,255,255,0.2);
  padding: 14rpx 0;
  border-radius: 22rpx;
  font-weight: 500;
}

.sh-btn-primary {
  background: rgba(255,255,255,0.35);
  font-weight: 700;
}

/* ===== Topic Section ===== */
.topic-section {
  padding: 20rpx 0 16rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.03);
}

.topic-scroll {
  padding: 0 36rpx;
  white-space: nowrap;
}

.topic-bar {
  display: flex;
  gap: 14rpx;
}

.topic-pill {
  display: inline-block;
  padding: 14rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #388e3c;
  background: rgba(56,142,60,0.06);
  border: 2rpx solid rgba(56,142,60,0.1);
  font-weight: 500;
}

.topic-pill.active {
  color: #ffffff;
  background: linear-gradient(135deg, #66bb6a, #388e3c);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(56,142,60,0.2);
}

.topic-count {
  font-size: 22rpx;
  margin-left: 6rpx;
  opacity: 0.7;
}

/* ===== Mode Bar ===== */
.mode-bar {
  display: flex;
  padding: 20rpx 36rpx;
  gap: 16rpx;
  background: #ffffff;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #8a7a9a;
  background: rgba(0,0,0,0.03);
}

.mode-btn.active {
  color: #ffffff;
  background: linear-gradient(135deg, #66bb6a, #388e3c);
  box-shadow: 0 4rpx 16rpx rgba(56,142,60,0.2);
}

/* ===== Card List ===== */
.card-scroll {
  padding: 16rpx 36rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* Card */
.s-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}

.s-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 28rpx rgba(56,142,60,0.08);
}

.sc-main {
  display: flex;
  gap: 18rpx;
}

.sc-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(56,142,60,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #388e3c;
  flex-shrink: 0;
}

.sc-body {
  flex: 1;
  min-width: 0;
}

.sc-english {
  font-size: 30rpx;
  line-height: 1.7;
  color: #2d2d4e;
}

.sc-chinese {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(56,142,60,0.04);
  font-size: 28rpx;
  color: #777;
  line-height: 1.6;
}

.sc-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.sc-tag {
  font-size: 22rpx;
  color: #388e3c;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(56,142,60,0.06);
  font-weight: 500;
}

.sc-actions {
  display: flex;
  gap: 28rpx;
}

.fav-btn, .master-btn {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid;
}

.fav-btn {
  color: #e6a800;
  border-color: rgba(230,168,0,0.3);
  background: rgba(230,168,0,0.08);
}
.fav-btn.on {
  color: #bbb;
  border-color: rgba(0,0,0,0.08);
  background: rgba(0,0,0,0.03);
}

.master-btn {
  color: #388e3c;
  border-color: rgba(56,142,60,0.3);
  background: rgba(56,142,60,0.08);
}
.master-btn.on {
  color: #bbb;
  border-color: rgba(0,0,0,0.08);
  background: rgba(0,0,0,0.03);
}

.sc-action-label {
  font-size: 22rpx;
}

/* ===== Empty State ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 30rpx; color: #2d2d4e; font-weight: 600; margin-bottom: 8rpx; }
.empty-desc { font-size: 26rpx; color: #999; margin-bottom: 36rpx; }

.empty-actions {
  display: flex;
  gap: 20rpx;
}

.empty-btn {
  padding: 18rpx 40rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-btn.gen {
  background: linear-gradient(135deg, #66bb6a, #388e3c);
  color: #ffffff;
  box-shadow: 0 4rpx 18rpx rgba(56,142,60,0.25);
}

.empty-btn.paste {
  background: rgba(56,142,60,0.08);
  color: #388e3c;
}

/* ===== Immersion Mode ===== */
.immersion-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 36rpx;
  min-height: 50vh;
}

.imm-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  width: 100%;
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.06);
  text-align: center;
  box-sizing: border-box;
}

.imm-num {
  font-size: 26rpx;
  color: #bbb;
  margin-bottom: 36rpx;
}

.imm-english {
  font-size: 38rpx;
  line-height: 1.7;
  color: #2d2d4e;
  margin-bottom: 28rpx;
  font-weight: 500;
}

.imm-chinese {
  font-size: 30rpx;
  color: #888;
  line-height: 1.7;
  padding: 24rpx;
  background: rgba(56,142,60,0.04);
  border-radius: 20rpx;
  margin-bottom: 32rpx;
}

.imm-actions {
  display: flex;
  gap: 28rpx;
  justify-content: center;
  margin-bottom: 0;
}

.imm-btn {
  padding: 14rpx 32rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid;
}

.imm-btn.fav-on { color: #e6a800; border-color: rgba(230,168,0,0.3); background: rgba(230,168,0,0.08); }
.imm-btn.fav-on.on { color: #bbb; border-color: rgba(0,0,0,0.08); background: rgba(0,0,0,0.03); }

.imm-btn.master-on { color: #388e3c; border-color: rgba(56,142,60,0.3); background: rgba(56,142,60,0.08); }
.imm-btn.master-on.on { color: #bbb; border-color: rgba(0,0,0,0.08); background: rgba(0,0,0,0.03); }

.imm-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-top: 48rpx;
}

.nav-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #66bb6a, #388e3c);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(56,142,60,0.25);
}

.nav-btn:active {
  opacity: 0.8;
}

.nav-btn.disabled {
  opacity: 0.3;
  box-shadow: none;
}

.imm-progress {
  font-size: 28rpx;
  color: #888;
}

/* ===== Generate Modal ===== */
.gen-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.gen-modal {
  width: 100%;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 36rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.gen-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.gen-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d2d4e;
}

.gen-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8a7a9a;
}

.gen-type-switch {
  display: flex;
  background: rgba(56,142,60,0.04);
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}

.gen-type-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #6a6a8a;
}

.gen-type-btn.active {
  background: linear-gradient(135deg, #66bb6a, #388e3c);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(56,142,60,0.2);
}

.gen-input {
  width: 100%;
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: rgba(56,142,60,0.04);
  font-size: 28rpx;
  color: #2d2d4e;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.paste-area {
  width: 100%;
  min-height: 280rpx;
  max-height: 500rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(56,142,60,0.04);
  font-size: 28rpx;
  color: #2d2d4e;
  line-height: 1.6;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.gen-count-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.gen-count-label {
  font-size: 28rpx;
  color: #888;
}

.gen-count-ctrl {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.gen-count-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(56,142,60,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #388e3c;
  font-weight: 600;
}

.gen-count-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d2d4e;
  min-width: 48rpx;
  text-align: center;
}

.gen-submit {
  width: 100%;
  height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #66bb6a, #388e3c);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(56,142,60,0.25);
  margin-bottom: 20rpx;
}

.gen-submit:active {
  opacity: 0.85;
}

.gen-submit.loading {
  opacity: 0.6;
}

.gen-hint {
  text-align: center;
  font-size: 24rpx;
  color: #b0b0c8;
}

/* ===== Dark Theme Overrides ===== */
.dark-theme {
  background: #1a1a2e;
}

.dark-theme .topic-section,
.dark-theme .mode-bar,
.dark-theme .s-card,
.dark-theme .imm-card {
  background: #252540;
}

.dark-theme .topic-section {
  border-bottom-color: rgba(255,255,255,0.04);
}

.dark-theme .sc-english,
.dark-theme .imm-english,
.dark-theme .empty-title {
  color: #e0e0f0;
}

.dark-theme .sc-chinese,
.dark-theme .imm-chinese {
  color: #a0a0c0;
  background: rgba(255,255,255,0.04);
}

.dark-theme .gen-modal {
  background: #252540;
}

.dark-theme .gen-title {
  color: #e0e0f0;
}

.dark-theme .gen-input,
.dark-theme .paste-area {
  background: rgba(255,255,255,0.06);
  color: #e0e0f0;
}

.dark-theme .gen-type-switch {
  background: rgba(255,255,255,0.04);
}

/* ===== Puzzle Mode ===== */
.puzzle-area { padding: 20rpx 24rpx; min-height: 70vh; }
.pz-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.pz-h-left { display: flex; align-items: center; gap: 12rpx; }
/* ===== Puzzle: Green ===== */
.pz-title {
  font-size: 30rpx; font-weight: 800;
  background: linear-gradient(135deg, #66bb6a, #388e3c);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.pz-progress { font-size: 22rpx; color: #66bb6a; font-weight: 600; }
.pz-stats { display: flex; gap: 16rpx; }
.pz-score {
  font-size: 24rpx; font-weight: 800; color: #f59e0b;
  background: #fef3c7; padding: 2rpx 16rpx; border-radius: 30rpx;
}
.pz-combo {
  font-size: 22rpx; font-weight: 700; color: #388e3c;
  background: #e8f5e9; padding: 2rpx 16rpx; border-radius: 30rpx;
}

/* Adjust controls */
.pz-adj {
  display: flex; align-items: center; justify-content: center;
  gap: 6rpx; margin-bottom: 12rpx; padding: 4rpx 0;
}
.pz-adj-lbl { font-size: 20rpx; color: #a5d6a7; font-weight: 600; margin: 0 4rpx; }
.pz-adj-btn {
  font-size: 28rpx; font-weight: 800; color: #66bb6a;
  background: #e8f5e9; width: 36rpx; height: 36rpx; line-height: 36rpx;
  text-align: center; border-radius: 50%; cursor: pointer;
}
.pz-adj-btn:active { transform: scale(.85); background: #c8e6c9; }
.pz-adj-val {
  font-size: 20rpx; font-weight: 700; color: #388e3c;
  min-width: 48rpx; text-align: center;
}

.pz-hint { text-align: center; margin-bottom: 14rpx; background: #e8f5e9; border-radius: 28rpx; padding: 16rpx 18rpx; }
.pz-hint-label { display: inline-block; font-size: 20rpx; color: #388e3c; font-weight: 600; background: #c8e6c9; padding: 2rpx 18rpx; border-radius: 20rpx; margin-bottom: 6rpx; }
.pz-hint-cn { display: block; font-size: 32rpx; color: #1b5e20; font-weight: 700; line-height: 1.5; margin-bottom: 4rpx; }
.pz-word-count { display: block; font-size: 22rpx; color: #66bb6a; margin-top: 4rpx; }
.pz-wc-num { font-weight: 700; color: #388e3c; }
.pz-wc-hint { font-weight: 700; color: #388e3c; }
.pz-hint-progress { display: block; font-size: 22rpx; color: #f43f5e; font-weight: 600; margin-top: 6rpx; animation: pulseHint 1.5s ease-in-out infinite; }
.pz-hp-word { font-weight: 800; color: #388e3c; }

.pz-drop {
  background: #e8f5e9; border: 3rpx dashed #a5d6a7;
  border-radius: 28rpx; padding: 14rpx 12rpx;
  display: flex; flex-wrap: wrap; gap: 6rpx; align-items: center;
  justify-content: center; min-height: 80rpx; margin-bottom: 8rpx;
}
.pz-drop-word {
  border-radius: 40rpx;
  font-weight: 600; line-height: 1.2;
  background: linear-gradient(135deg, #a5d6a7, #66bb6a);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(56,142,60,.15);
  animation: popIn .25s ease;
}
.pz-drop-word.hint-glow {
  background: linear-gradient(135deg, #fde68a, #fbbf24) !important;
  color: #78350f !important;
  box-shadow: 0 2rpx 10rpx rgba(251,191,36,.25) !important;
}
.pz-drop-word.done { opacity: .65; }
.pz-drop-slot {
  font-weight: 700; color: #a5d6a7;
  padding: 4rpx 2rpx; letter-spacing: 3rpx;
  text-decoration: underline; text-decoration-thickness: 4rpx;
  text-underline-offset: 6rpx; text-decoration-color: #a5d6a7;
}
.pz-drop-skipped { width: 100%; text-align: center; font-size: 28rpx; color: #388e3c; font-weight: 700; padding: 20rpx 0; }

.pz-error { display: flex; align-items: center; justify-content: center; gap: 4rpx; min-height: 28rpx; margin-bottom: 6rpx; }
.pz-error-icon { font-size: 22rpx; }
.pz-error-text { font-size: 22rpx; color: #f43f5e; font-weight: 600; }

.pz-actions { display: flex; gap: 10rpx; margin: 10rpx 0 16rpx; }
.pz-act {
  flex: 1; padding: 12rpx 0; border-radius: 48rpx;
  font-size: 26rpx; font-weight: 700; text-align: center;
  cursor: pointer; transition: all .12s;
}
.pz-act:active { transform: scale(.92); }
.pz-act-reveal { background: linear-gradient(135deg, #a5d6a7, #66bb6a); color: #fff; box-shadow: 0 3rpx 12rpx rgba(102,187,106,.3); }
.pz-act-skip { background: linear-gradient(135deg, #c8e6c9, #81c784); color: #fff; box-shadow: 0 3rpx 12rpx rgba(129,199,132,.3); }

.pz-bank-label { font-size: 22rpx; color: #66bb6a; font-weight: 700; margin-bottom: 8rpx; display: flex; align-items: center; gap: 4rpx; }
.pz-bank { display: flex; flex-wrap: wrap; gap: 6rpx; justify-content: center; margin-bottom: 24rpx; padding: 2rpx 0; }
.pz-bank-word {
  border-radius: 40rpx;
  font-weight: 500; line-height: 1.2;
  background: #fff; border: 2rpx solid #a5d6a7;
  color: #388e3c; cursor: pointer; transition: all .1s;
  box-shadow: 0 1rpx 6rpx rgba(56,142,60,.08);
}
.pz-bank-word:active { transform: scale(.88); background: #e8f5e9; }
.pz-bank-word.used { opacity: .15; pointer-events: none; transform: scale(.85); }

.pz-tip { text-align: center; font-size: 20rpx; color: #a5d6a7; }

.pz-result { text-align: center; padding: 40rpx 0; }
.pz-r-icon { font-size: 72rpx; display: block; margin-bottom: 8rpx; }
.pz-r-title {
  font-size: 34rpx; font-weight: 800;
  background: linear-gradient(135deg, #66bb6a, #388e3c);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; display: block; margin-bottom: 14rpx;
}
.pz-r-stars { display: flex; gap: 6rpx; justify-content: center; margin-bottom: 18rpx; }
.pz-star { font-size: 44rpx; color: #e8f5e9; transition: all .3s; }
.pz-star.lit { color: #fbbf24; text-shadow: 0 0 14rpx rgba(251,191,36,.3); }
.pz-r-stats { display: flex; gap: 32rpx; justify-content: center; margin-bottom: 24rpx; }
.pz-rs-item { text-align: center; }
.pz-rs-num { display: block; font-size: 40rpx; font-weight: 800; color: #1b5e20; }
.pz-rs-lbl { display: block; font-size: 20rpx; color: #66bb6a; margin-top: 2rpx; }
.pz-r-actions { display: flex; flex-direction: column; gap: 10rpx; align-items: center; }
.pz-r-btn {
  padding: 16rpx 64rpx; border-radius: 48rpx;
  font-size: 28rpx; font-weight: 700; cursor: pointer; transition: all .12s;
}
.pz-r-btn:active { transform: scale(.94); }
.pz-r-btn.primary { background: linear-gradient(135deg, #a5d6a7, #66bb6a); color: #fff; box-shadow: 0 4rpx 16rpx rgba(102,187,106,.35); }
.pz-r-btn.snd { background: #e8f5e9; color: #388e3c; border: 2rpx solid #a5d6a7; }

@keyframes popIn { 0% { transform: scale(.4); opacity: 0; } 70% { transform: scale(1.08); } 100% { transform: scale(1); opacity: 1; } }
@keyframes pulseHint { 0%, 100% { opacity: 1; } 50% { opacity: .6; } }

/* Dark theme puzzle */
.dark-theme .pz-title {
  background: linear-gradient(135deg, #66bb6a, #388e3c) !important;
  -webkit-background-clip: text !important; -webkit-text-fill-color: transparent !important;
  background-clip: text !important;
}
.dark-theme .pz-progress { color: #81c784 !important; }
.dark-theme .pz-score { background: #4a3a1a !important; color: #fbbf24 !important; }
.dark-theme .pz-combo { background: #1a3a2a !important; color: #66bb6a !important; }
.dark-theme .pz-adj-lbl { color: #4a6a4a !important; }
.dark-theme .pz-adj-btn { background: #2a4a2a !important; color: #81c784 !important; }
.dark-theme .pz-adj-btn:active { background: #3a5a3a !important; }
.dark-theme .pz-adj-val { color: #81c784 !important; }
.dark-theme .pz-hint { background: #1a2a1a !important; }
.dark-theme .pz-hint-label { background: #2a4a2a !important; color: #81c784 !important; }
.dark-theme .pz-hint-cn { color: #c8e6c9 !important; }
.dark-theme .pz-word-count { color: #66bb6a !important; }
.dark-theme .pz-wc-num { color: #81c784 !important; }
.dark-theme .pz-wc-hint { color: #81c784 !important; }
.dark-theme .pz-hint-progress { color: #f43f5e !important; }
.dark-theme .pz-hp-word { color: #66bb6a !important; }
.dark-theme .pz-drop { background: #1a2a1a !important; border-color: #2a5a3a !important; }
.dark-theme .pz-drop-word { background: linear-gradient(135deg, #2a5a3a, #1a4a2a) !important; color: #c8e6c9 !important; box-shadow: none !important; }
.dark-theme .pz-drop-word.hint-glow { background: linear-gradient(135deg, #5a4a1a, #4a3a0a) !important; color: #fbbf24 !important; box-shadow: 0 0 16rpx rgba(251,191,36,.2) !important; }
.dark-theme .pz-drop-slot { color: #3a6a4a !important; text-decoration-color: #3a6a4a !important; }
.dark-theme .pz-drop-skipped { color: #66bb6a !important; }
.dark-theme .pz-error-text { color: #f43f5e !important; }
.dark-theme .pz-act-reveal { background: linear-gradient(135deg, #2a4a2a, #1a3a1a) !important; color: #66bb6a !important; box-shadow: none !important; }
.dark-theme .pz-act-skip { background: linear-gradient(135deg, #2a5a3a, #1a4a2a) !important; color: #66bb6a !important; box-shadow: none !important; }
.dark-theme .pz-bank-label { color: #66bb6a !important; }
.dark-theme .pz-bank-word { background: #1a2a1a !important; border-color: #2a5a3a !important; color: #c8e6c9 !important; box-shadow: none !important; }
.dark-theme .pz-bank-word:active { background: #2a3a2a !important; }
.dark-theme .pz-r-title {
  background: linear-gradient(135deg, #66bb6a, #388e3c) !important;
  -webkit-background-clip: text !important; -webkit-text-fill-color: transparent !important;
  background-clip: text !important;
}
.dark-theme .pz-rs-num { color: #c8e6c9 !important; }
.dark-theme .pz-rs-lbl { color: #66bb6a !important; }
.dark-theme .pz-r-btn.primary { background: linear-gradient(135deg, #2a5a3a, #1a4a2a) !important; color: #c8e6c9 !important; box-shadow: none !important; }
.dark-theme .pz-r-btn.snd { background: #1a2a1a !important; color: #66bb6a !important; border-color: #2a5a3a !important; }
.dark-theme .pz-star { color: #2a3a2a !important; }
.dark-theme .pz-star.lit { color: #fbbf24 !important; }
.dark-theme .pz-hint-en { color: #66bb6a !important; }
