<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="page-header">
    <text class="page-title">学习目标</text>
    <text class="page-subtitle">设定每日学习任务量</text>
  </view>

  <view class="goal-card">
    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">🎵</text>
        <text class="goal-label">听力精听</text>
      </view>
      <view class="goal-controls">
        <view class="goal-btn" data-field="listen" data-delta="-1" catchtap="change">−</view>
        <text class="goal-num">{{listen}}</text>
        <view class="goal-btn" data-field="listen" data-delta="1" catchtap="change">+</view>
      </view>
    </view>

    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">💬</text>
        <text class="goal-label">语境句子</text>
      </view>
      <view class="goal-controls">
        <view class="goal-btn" data-field="sentence" data-delta="-1" catchtap="change">−</view>
        <text class="goal-num">{{sentence}}</text>
        <view class="goal-btn" data-field="sentence" data-delta="1" catchtap="change">+</view>
      </view>
    </view>

    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">🌟</text>
        <text class="goal-label">翻译练习</text>
      </view>
      <view class="goal-controls">
        <view class="goal-btn" data-field="translation" data-delta="-1" catchtap="change">−</view>
        <text class="goal-num">{{translation}}</text>
        <view class="goal-btn" data-field="translation" data-delta="1" catchtap="change">+</view>
      </view>
    </view>

    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">✨</text>
        <text class="goal-label">写作练习</text>
      </view>
      <view class="goal-controls">
        <view class="goal-btn" data-field="writing" data-delta="-1" catchtap="change">−</view>
        <text class="goal-num">{{writing}}</text>
        <view class="goal-btn" data-field="writing" data-delta="1" catchtap="change">+</view>
      </view>
    </view>
  </view>

  <view class="goal-card" style="margin-top: 24rpx;">
    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">🌙</text>
        <text class="goal-label">暗黑模式</text>
      </view>
      <view class="toggle-btn {{darkMode ? 'on' : ''}}" bindtap="toggleDark">
        <view class="toggle-knob"></view>
      </view>
    </view>
  </view>

  <view class="tip-block">
    <text class="tip-text">💡 建议每天完成：1 篇听力 + 5 个句子 + 1 篇翻译 + 1 篇写作</text>
  </view>
</view>
