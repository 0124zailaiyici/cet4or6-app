<view class="page {{darkMode ? 'dark-theme' : ''}}" style="--fs: {{fs}}">
  <view class="page-header">
    <text class="page-title">学习目标</text>
    <text class="page-subtitle">设定每日学习任务量</text>
  </view>

  <view class="goal-card">
    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">🎵</text>
        <text class="goal-label">听力精听</text>
      </view>
      <view class="goal-controls">
        <view class="goal-btn" data-field="listen" data-delta="-1" catchtap="change">−</view>
        <text class="goal-num">{{listen}}</text>
        <view class="goal-btn" data-field="listen" data-delta="1" catchtap="change">+</view>
      </view>
    </view>

    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">💬</text>
        <text class="goal-label">语境句子</text>
      </view>
      <view class="goal-controls">
        <view class="goal-btn" data-field="sentence" data-delta="-1" catchtap="change">−</view>
        <text class="goal-num">{{sentence}}</text>
        <view class="goal-btn" data-field="sentence" data-delta="1" catchtap="change">+</view>
      </view>
    </view>

    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">🌟</text>
        <text class="goal-label">翻译练习</text>
      </view>
      <view class="goal-controls">
        <view class="goal-btn" data-field="translation" data-delta="-1" catchtap="change">−</view>
        <text class="goal-num">{{translation}}</text>
        <view class="goal-btn" data-field="translation" data-delta="1" catchtap="change">+</view>
      </view>
    </view>

    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">✨</text>
        <text class="goal-label">写作练习</text>
      </view>
      <view class="goal-controls">
        <view class="goal-btn" data-field="writing" data-delta="-1" catchtap="change">−</view>
        <text class="goal-num">{{writing}}</text>
        <view class="goal-btn" data-field="writing" data-delta="1" catchtap="change">+</view>
      </view>
    </view>
  </view>

  <view class="goal-card" style="margin-top: 24rpx;">
    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">🌙</text>
        <text class="goal-label">暗黑模式</text>
      </view>
      <view class="toggle-btn {{darkMode ? 'on' : ''}}" bindtap="toggleDark">
        <view class="toggle-knob"></view>
      </view>
    </view>
  </view>

  <view class="goal-card" style="margin-top: 24rpx;">
    <view class="goal-item" catchtap="clearCache">
      <view class="goal-info">
        <text class="goal-icon">🗑️</text>
        <text class="goal-label">清除缓存</text>
      </view>
      <text class="info-text">{{cacheSize}}</text>
    </view>
    <view class="goal-item">
      <view class="goal-info">
        <text class="goal-icon">🔄</text>
        <text class="goal-label">版本</text>
      </view>
      <text class="info-text">v{{version}}</text>
    </view>
  </view>

  <view class="goal-card" style="margin-top: 24rpx;">
    <view class="goal-item" catchtap="exportData">
      <view class="goal-info">
        <text class="goal-icon">📤</text>
        <text class="goal-label">导出学习数据</text>
      </view>
      <text class="info-text">备份 ›</text>
    </view>
    <view class="goal-item" catchtap="importData">
      <view class="goal-info">
        <text class="goal-icon">📥</text>
        <text class="goal-label">导入学习数据</text>
      </view>
      <text class="info-text">恢复 ›</text>
    </view>
  </view>

  <view class="goal-card" style="margin-top: 24rpx;">
    <view class="goal-item">
      <view class="goal-info" style="flex:1">
        <text class="goal-icon">📚</text>
        <text class="goal-label">关于</text>
      </view>
      <text class="info-text">四级备考助手</text>
    </view>
    <view class="goal-item" style="padding-top:12rpx;border-bottom:none">
      <text class="tip-text">💡 专注 CET-4 真题练习，涵盖听力、阅读、翻译、写作四大模块，支持 PDF 导入、AI 批改、错题复习</text>
    </view>
  </view>

  <view class="goal-card" style="margin-top: 24rpx;">
    <view class="goal-item" catchtap="goReminder">
      <view class="goal-info">
        <text class="goal-icon">🔔</text>
        <text class="goal-label">学习提醒</text>
      </view>
      <text class="info-text">订阅 ›</text>
    </view>
  </view>

  <view class="goal-card" style="margin-top: 24rpx;">
    <view class="goal-item" catchtap="goFeedback">
      <view class="goal-info">
        <text class="goal-icon">💬</text>
        <text class="goal-label">帮助与反馈</text>
      </view>
      <text class="info-text">意见 ›</text>
    </view>
  </view>

  <view class="tip-block">
    <text class="tip-text">💡 建议每天完成：1 篇听力 + 5 个句子 + 1 篇翻译 + 1 篇写作</text>
  </view>

<!-- 字号调节 -->
<view class="fs-ctrl {{fsOpen ? 'fs-show' : ''}}">
  <view class="fs-btn-box" catchtap="toggleFs">
    <text class="fs-btn-icon">Aa</text>
  </view>
  <view class="fs-slider" wx:if="{{fsOpen}}">
    <text class="fs-label fs-dec" catchtap="changeFs" data-d="-2">A−</text>
    <view class="fs-track">
      <view class="fs-fill" style="width: {{(fs - 12) / 14 * 100}}%"></view>
      <view class="fs-thumb" style="left: {{(fs - 12) / 14 * 100}}%"></view>
    </view>
    <text class="fs-label fs-inc" catchtap="changeFs" data-d="2">A+</text>
  </view>
</view>
</view>
