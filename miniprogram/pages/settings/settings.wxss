.page {
  min-height: 100vh;
  padding: 32rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  font-size: calc(44 * var(--fs) / 16 * 1rpx);
  font-weight: 700;
  color: var(--text-primary);
}

.page-subtitle {
  display: block;
  font-size: calc(26 * var(--fs) / 16 * 1rpx);
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.goal-card {
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 8rpx 0;
  box-shadow: 0 4rpx 20rpx var(--shadow);
}

.goal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--tag-bg);
}

.goal-item:last-child {
  border-bottom: none;
}

.goal-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.goal-icon {
  font-size: calc(36 * var(--fs) / 16 * 1rpx);
}

.goal-label {
  font-size: calc(30 * var(--fs) / 16 * 1rpx);
  font-weight: 600;
  color: var(--text-primary);
}

.goal-controls {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.goal-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(32 * var(--fs) / 16 * 1rpx);
  color: var(--pink);
  font-weight: 700;
}

.goal-btn:active {
  background: var(--border);
}

.goal-num {
  font-size: calc(40 * var(--fs) / 16 * 1rpx);
  font-weight: 700;
  color: var(--text-primary);
  min-width: 60rpx;
  text-align: center;
}

.toggle-btn {
  width: 96rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: var(--tag-bg);
  position: relative;
  transition: background 0.3s;
}

.toggle-btn.on {
  background: var(--pink);
}

.toggle-knob {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.toggle-btn.on .toggle-knob {
  left: 48rpx;
}

.tip-block {
  margin-top: 32rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx var(--shadow);
}

.tip-text {
  font-size: calc(26 * var(--fs) / 16 * 1rpx);
  color: var(--text-secondary);
  line-height: 1.6;
}

.info-text {
  font-size: calc(26 * var(--fs) / 16 * 1rpx);
  color: var(--text-secondary);
}

.goal-item:active {
  background: var(--tag-bg);
}
