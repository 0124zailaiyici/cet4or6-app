<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="topbar">
    <view class="tb-back" catchtap="goBack">返回</view>
    <text class="tb-title">仔细阅读</text>
    <view class="tb-badge tag-C">精读</view>
  </view>
  <view class="pass-zone" bindtouchstart="onParaTouchStart" bindtouchend="onParaTouchEnd">
    <scroll-view class="pz-scroll" scroll-y>
      <view class="pz-text">
        <view class="pass-para" wx:for="{{_curParas}}" wx:key="*this" wx:for-item="para">{{para}}</view>
      </view>
    </scroll-view>
    <view class="dots" wx:if="{{_paraPages.length > 1}}">
      <view wx:for="{{_paraPages}}" wx:key="*this" wx:for-index="idx" class="dot {{idx === _paraPageIdx ? 'on' : ''}}"></view>
    </view>
  </view>
  <view class="divider"></view>
  <view class="quest-zone">
    <view class="qz-label">❓ 第{{currentQ + 1}}/{{passage.questions.length}}题</view>
    <view class="qz-c-card" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
      <view class="qz-c-question">{{passage.questions[currentQ]}}</view>
      <view class="qz-opts" wx:if="{{passage._choices[currentQ].length > 0}}">
        <view wx:for="{{passage._choices[currentQ]}}" wx:key="*this" wx:for-index="oi" wx:for-item="ch" class="qzo {{passage._ca[currentQ] === ch ? 'on' : ''}}" data-qi="{{currentQ}}" data-val="{{ch}}" catchtap="onSelect">{{ch}}</view>
      </view>
    </view>
    <view class="qz-dots" wx:if="{{passage.questions.length > 1}}">
      <view wx:for="{{passage.questions}}" wx:key="*this" wx:for-index="i" class="qzd {{i === currentQ ? 'on' : ''}}"></view>
    </view>
  </view>
</view>