.page { min-height: 100vh; background: #f3eeed; display: flex; flex-direction: column; }
.topbar { background: linear-gradient(135deg, #ffb3c6, #ff8fab); padding: 48rpx 24rpx 16rpx; color: #fff; flex-shrink: 0; display: flex; align-items: center; }
.scroll { flex: 1; }
.audio-row { padding: 16rpx 24rpx; }
.audio-btn { display: inline-block; padding: 14rpx 28rpx; border-radius: 40rpx; background: #ff8fab; color: #fff; font-size: 26rpx; font-weight: 600; }
.audio-btn.playing { background: #d81b60; }
.card { background: #fff; margin: 8rpx 20rpx; border-radius: 14rpx; padding: 16rpx; }
.q-stem { font-size: 24rpx; font-weight: 700; color: #2d2d4e; margin-bottom: 10rpx; }
.opt { display: flex; align-items: center; gap: 8rpx; padding: 10rpx 16rpx; border-radius: 10rpx; background: #f8f0f3; font-size: 22rpx; color: #2d2d4e; margin-bottom: 6rpx; transition: 0.15s; }
.opt.sel { background: #ff8fab; color: #fff; }
.opt.correct { background: rgba(76,175,80,0.1); color: #2e7d32; border: 2rpx solid #81c784; }
.opt.wrong { background: rgba(229,115,115,0.08); color: #c62828; border: 2rpx solid #e57373; text-decoration: line-through; }
.letter { font-weight: 800; width: 28rpx; text-align: center; flex-shrink: 0; }
.text { flex: 1; line-height: 1.4; }
.tb-submit { font-size: 24rpx; font-weight: 700; color: #fff; padding: 6rpx 20rpx; border-radius: 12rpx; background: #ff8fab; flex-shrink: 0; }
.tb-score { font-size: 24rpx; font-weight: 700; color: #546e7a; background: rgba(84,110,122,0.08); padding: 4rpx 16rpx; border-radius: 12rpx; flex-shrink: 0; }
.tb-score.on { color: #fff; background: #1e88e5; }
.dark-theme .tb-score { color: #a090b0 !important; background: rgba(160,144,176,0.12) !important; }
.dark-theme .tb-score.on { color: #fff !important; background: #1e88e5 !important; }
.result-view { flex: 1; display: flex; flex-direction: column; min-height: 0; background: #f7f0ef; }
.rv-list { flex: 1; min-height: 0; height: 1rpx; padding: 16rpx 20rpx 0; }
.rv-card { background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 14rpx; box-shadow: 0 2rpx 12rpx rgba(84,110,122,0.04); border-left: 4rpx solid transparent; }
.rv-card.correct { border-left-color: #81c784; }
.rv-card.wrong { border-left-color: #e57373; }
.rvc-hd { display: flex; align-items: center; gap: 10rpx; margin-bottom: 8rpx; }
.rvc-num { width: 36rpx; height: 36rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; color: #fff; flex-shrink: 0; }
.rvc-num.ok { background: #81c784; }
.rvc-num.bad { background: #e57373; }
.rvc-label { font-size: 24rpx; font-weight: 700; color: #2d2d4e; }
.rvc-opts { display: flex; flex-direction: column; gap: 6rpx; margin-bottom: 8rpx; }
.rvc-opt { font-size: 24rpx; color: #4a4a6a; line-height: 1.5; padding: 12rpx 18rpx; border-radius: 10rpx; background: #faf7f6; border: 1rpx solid #ece4e2; }
.rvc-opt.ans { color: #2e7d32; font-weight: 600; border-color: #81c784; background: rgba(129,199,132,0.08); }
.rvc-opt.wrong { color: #c62828; text-decoration: line-through; border-color: #e57373; background: rgba(229,115,115,0.06); }
.dark-theme .result-view { background: #161625 !important; }
.dark-theme .rv-card { background: #1e1e38 !important; }
.dark-theme .rvc-label { color: #e0d0e8 !important; }
