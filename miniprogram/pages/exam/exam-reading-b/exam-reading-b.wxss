.page { min-height: 100vh; display: flex; flex-direction: column; background: #f3eeed; }

.topbar { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 24rpx 8rpx; flex-shrink: 0; }
.tb-back { padding: 0 16rpx; height: 48rpx; border-radius: 12rpx; background: rgba(84,110,122,0.08); display: flex; align-items: center; font-size: 24rpx; color: #546e7a; }
.tb-title { flex: 1; font-size: 28rpx; font-weight: 700; color: #2d2d4e; }
.tb-badge { font-size: 18rpx; color: #fff; padding: 4rpx 14rpx; border-radius: 12rpx; }
.tag-B { background: linear-gradient(135deg, #64b5f6, #1e88e5); }

.pass-zone { flex: 1; display: flex; flex-direction: column; padding: 0 20rpx; min-height: 0; overflow: hidden; }
.pz-scroll { flex: 1; overflow: hidden; background: #eef1f3; border-radius: 18rpx; padding: 20rpx 24rpx; }
.pz-text { font-size: 28rpx; line-height: 1.9; color: #2d3a4a; word-break: break-word; }
.pass-para { margin-bottom: 14rpx; }

.divider { height: 2rpx; background: #dad0ca; flex-shrink: 0; }

.quest-zone { flex: 1; display: flex; flex-direction: column; padding: 0 20rpx 24rpx; min-height: 0; overflow: hidden; background: #f7f0ef; }
.qz-label { font-size: 20rpx; font-weight: 600; color: #546e7a; padding: 8rpx 0 4rpx; flex-shrink: 0; }
.qb-scroll { flex: 1; min-height: 0; }
.qb-scroll::-webkit-scrollbar { width: 0; }

.qb-item { display: flex; align-items: center; gap: 8rpx; padding: 6rpx 20rpx; border-bottom: 1rpx solid #f5f0f0; background: #fff; }
.qb-item:last-child { border-bottom: none; }
.qb-item.active { background: rgba(30,136,229,0.06); border-left: 4rpx solid #1e88e5; padding-left: 16rpx; }
.qbi-num { width: 32rpx; height: 32rpx; border-radius: 8rpx; background: rgba(30,136,229,0.06); display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; color: #1e88e5; flex-shrink: 0; }
.qbi-txt { flex: 1; font-size: 24rpx; line-height: 1.5; color: #2d2d4e; word-break: break-word; }
.qbi-ans { width: 40rpx; height: 40rpx; border-radius: 10rpx; background: linear-gradient(135deg,#64b5f6,#1e88e5); display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; color: #fff; flex-shrink: 0; box-shadow: 0 2rpx 8rpx rgba(30,136,229,0.2); }

.qb-bar { padding: 6rpx 0 2rpx; flex-shrink: 0; }
.qb-bar-letters { display: flex; gap: 6rpx; justify-content: center; flex-wrap: wrap; }
.qb-l { width: 52rpx; height: 52rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 700; color: #fff; background: linear-gradient(135deg,#64b5f6,#1e88e5); box-shadow: 0 3rpx 12rpx rgba(30,136,229,0.3); }
.qb-l:active { transform: scale(0.9); }

.dark-theme.page { background: #12121f !important; }
.dark-theme .tb-title { color: #e0d0e8 !important; }
.dark-theme .pz-scroll { background: #1a1a30 !important; }
.dark-theme .pz-text { color: #c0b8d0 !important; }
.dark-theme .divider { background: #2a2a4a !important; }
.dark-theme .quest-zone { background: #161625 !important; }
.dark-theme .qz-label { color: #a090b0 !important; }
.dark-theme .qb-item { background: #1e1e38 !important; border-color: #2a2a4a !important; }
.dark-theme .qbi-txt { color: #e0d0e8 !important; }

.dots { display: flex; justify-content: center; gap: 6rpx; padding: 6rpx 0 4rpx; flex-shrink: 0; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #d0c8d0; }
.dot.on { background: #546e7a; width: 22rpx; border-radius: 5rpx; }
