.page { height: 100vh; display: flex; flex-direction: column; background: #f3eeed; overflow: hidden; }

.topbar { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 24rpx 8rpx; flex-shrink: 0; }
.tb-back { padding: 0 16rpx; height: 48rpx; border-radius: 12rpx; background: rgba(84,110,122,0.08); display: flex; align-items: center; font-size: calc(24 * var(--fs-body) / 16 * 1rpx); color: #546e7a; }
.tb-title { flex: 1; font-size: calc(28 * var(--fs-title) / 16 * 1rpx); font-weight: 700; color: #2d2d4e; }
.tb-badge { font-size: calc(18 * var(--fs-sm) / 16 * 1rpx); color: #fff; padding: 4rpx 14rpx; border-radius: 12rpx; }
.tag-B { background: linear-gradient(135deg, #64b5f6, #1e88e5); }
.tb-score { font-size: calc(24 * var(--fs-body) / 16 * 1rpx); font-weight: 700; color: #546e7a; background: rgba(84,110,122,0.08); padding: 4rpx 16rpx; border-radius: 12rpx; flex-shrink: 0; }
.tb-score.on { color: #fff; background: #1e88e5; }
.dark-theme .tb-score { color: #a090b0 !important; background: rgba(160,144,176,0.12) !important; }
.dark-theme .tb-score.on { color: #fff !important; background: #1e88e5 !important; }

.pass-zone { flex: 1; display: flex; flex-direction: column; padding: 0 20rpx; min-height: 0; overflow: hidden; }
.pz-scroll { flex: 1; overflow: hidden; background: #eef1f3; border-radius: 18rpx; padding: 20rpx 24rpx; }
.pz-text { font-size: calc(28 * var(--fs-body) / 16 * 1rpx); line-height: 1.9; color: #2d3a4a; word-break: break-word; }
.pass-para { margin-bottom: 14rpx; }

.divider { height: 2rpx; background: #dad0ca; flex-shrink: 0; }

.quest-zone { flex: 1; display: flex; flex-direction: column; padding: 0 20rpx 24rpx; min-height: 0; overflow: hidden; background: #f7f0ef; }
.qz-label { font-size: calc(20 * var(--fs-sm) / 16 * 1rpx); font-weight: 600; color: #546e7a; padding: 8rpx 0 4rpx; flex-shrink: 0; }
.qb-scroll { flex: 1; min-height: 0; }
.qb-scroll::-webkit-scrollbar { width: 0; }

.qb-item { display: flex; align-items: center; gap: 8rpx; padding: 6rpx 20rpx; border-bottom: 1rpx solid #f5f0f0; background: #fff; }
.qb-item:last-child { border-bottom: none; }
.qb-item.active { background: rgba(30,136,229,0.06); border-left: 4rpx solid #1e88e5; padding-left: 16rpx; }
.qbi-num { width: 32rpx; height: 32rpx; border-radius: 8rpx; background: rgba(30,136,229,0.06); display: flex; align-items: center; justify-content: center; font-size: calc(20 * var(--fs-sm) / 16 * 1rpx); font-weight: 700; color: #1e88e5; flex-shrink: 0; }
.qbi-txt { flex: 1; font-size: calc(24 * var(--fs-body) / 16 * 1rpx); line-height: 1.5; color: #2d2d4e; word-break: break-word; }
.qbi-ans { width: 40rpx; height: 40rpx; border-radius: 10rpx; background: linear-gradient(135deg,#64b5f6,#1e88e5); display: flex; align-items: center; justify-content: center; font-size: calc(22 * var(--fs-body) / 16 * 1rpx); font-weight: 700; color: #fff; flex-shrink: 0; box-shadow: 0 2rpx 8rpx rgba(30,136,229,0.2); }

.qb-bar { padding: 6rpx 0 2rpx; flex-shrink: 0; }
.qb-bar-letters { display: flex; gap: 6rpx; justify-content: center; flex-wrap: wrap; }
.qb-l { width: 52rpx; height: 52rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: calc(26 * var(--fs-body) / 16 * 1rpx); font-weight: 700; color: #fff; background: linear-gradient(135deg,#64b5f6,#1e88e5); box-shadow: 0 3rpx 12rpx rgba(30,136,229,0.3); }
.qb-l:active { transform: scale(0.9); }

.dark-theme.page { background: #12121f !important; }
.dark-theme .tb-title { color: #e0d0e8 !important; }
.dark-theme .pz-scroll { background: #1a1a30 !important; }
.dark-theme .pz-text { color: #c0b8d0 !important; }
.dark-theme .divider { background: #2a2a4a !important; }
.dark-theme .quest-zone { background: #161625 !important; }


.dark-theme .qz-label { color: #a090b0 !important; }
.dark-theme .qb-item { background: #1e1e38 !important; border-color: #2a2a4a !important; }

.result-view { flex: 1.5; display: flex; flex-direction: column; min-height: 0; background: #f7f0ef; }
.rv-list { flex: 1; min-height: 0; height: 1rpx; padding: 16rpx 20rpx 0; }
.rv-card { background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 14rpx; box-shadow: 0 2rpx 12rpx rgba(84,110,122,0.04); border-left: 4rpx solid transparent; animation: rvCardIn 0.4s ease both; }
@keyframes rvCardIn { from { opacity: 0; transform: translateX(-16rpx); } to { opacity: 1; transform: translateX(0); } }
.rv-card:nth-child(1) { animation-delay: 0.03s; }
.rv-card:nth-child(2) { animation-delay: 0.07s; }
.rv-card:nth-child(3) { animation-delay: 0.11s; }
.rv-card:nth-child(4) { animation-delay: 0.15s; }
.rv-card:nth-child(5) { animation-delay: 0.19s; }
.rv-card.correct { border-left-color: #81c784; }
.rv-card.wrong { border-left-color: #e57373; }
.rvc-hd { display: flex; align-items: center; gap: 10rpx; margin-bottom: 8rpx; }
.rvc-num { width: 36rpx; height: 36rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: calc(20 * var(--fs-sm) / 16 * 1rpx); font-weight: 700; color: #fff; flex-shrink: 0; }
.rvc-num.ok { background: #81c784; }
.rvc-num.bad { background: #e57373; }
.rvc-label { font-size: calc(24 * var(--fs-sm) / 16 * 1rpx); font-weight: 700; color: #2d2d4e; }
.rvc-locate { font-size: calc(18 * var(--fs-body) / 16 * 1rpx); color: #388e3c; margin-left: auto; flex-shrink: 0; padding: 2rpx 12rpx; border-radius: 6rpx; background: rgba(56,142,60,0.08); border: 1rpx solid rgba(56,142,60,0.15); }
.rvc-stem { font-size: calc(26 * var(--fs-body) / 16 * 1rpx); color: #2d2d4e; line-height: 1.6; display: block; margin-bottom: 12rpx; }
.rvc-ans { display: flex; align-items: center; gap: 8rpx; margin-bottom: 6rpx; }
.rvc-ans-label { font-size: calc(22 * var(--fs-sm) / 16 * 1rpx); color: #8a7a9a; }
.rvc-ans-val { font-size: calc(24 * var(--fs-body) / 16 * 1rpx); font-weight: 600; }
.rvc-ans-val.ok { color: #388e3c; }
.rvc-ans-val.wrong { color: #e57373; text-decoration: line-through; }
.rvc-hint { font-size: calc(22 * var(--fs-sm) / 16 * 1rpx); color: #6a7a8a; line-height: 1.6; margin-top: 8rpx; padding: 12rpx 16rpx; border-radius: 10rpx; background: rgba(0,0,0,0.03); }
.rv-nav { display: flex; gap: 8rpx; padding: 10rpx 20rpx 0; overflow-x: auto; flex-shrink: 0; white-space: nowrap; }
.rv-nav::-webkit-scrollbar { width: 0; height: 0; }
.rvn-item { font-size: calc(22 * var(--fs-body) / 16 * 1rpx); padding: 6rpx 14rpx; border-radius: 10rpx; background: #fff; color: #546e7a; border: 1rpx solid #ece4e2; flex-shrink: 0; cursor: pointer; transition: 0.15s; }
.rvn-item:active { background: #eef1f3; }
.rvn-item.on { background: #1e88e5; color: #fff; border-color: #1e88e5; }
.dark-theme .rvn-item:not(.on) { background: #2a2a4a !important; color: #a090b0 !important; border-color: #3a3a5a !important; }
.dark-theme .rvn-item.on { background: #1e88e5 !important; color: #fff !important; }
.dark-theme .result-view { background: #161625 !important; }
.dark-theme .rv-card { background: #1e1e38 !important; }
.dark-theme .rvc-label { color: #e0d0e8 !important; }
.dark-theme .rvc-locate { color: #81c784 !important; border-color: rgba(129,199,132,0.2) !important; background: rgba(129,199,132,0.08) !important; }
.dark-theme .rvc-stem { color: #c0b0d0 !important; }
.dark-theme .rvc-ans-val { color: #e0d0e8 !important; }
.dark-theme .rvc-hint { color: #a090b0 !important; background: rgba(255,255,255,0.04) !important; }
.dark-theme .qbi-txt { color: #e0d0e8 !important; }

.qbia-ok { background: linear-gradient(135deg,#66bb6a,#388e3c) !important; }
.qbia-ko { background: linear-gradient(135deg,#ef5350,#c62828) !important; }
.qbi-miss { font-size: calc(20 * var(--fs-body) / 16 * 1rpx); color: #e53935; font-weight: 600; flex-shrink: 0; }
.qbi-cor { font-size: calc(20 * var(--fs-body) / 16 * 1rpx); color: #1e88e5; font-weight: 600; margin-left: 4rpx; flex-shrink: 0; }
.qbl-ok { background: linear-gradient(135deg,#66bb6a,#388e3c) !important; }
.qbl-ko { background: linear-gradient(135deg,#ef5350,#c62828) !important; }

.dots { display: flex; justify-content: center; gap: 6rpx; padding: 6rpx 0 4rpx; flex-shrink: 0; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #d0c8d0; }
.dot.on { background: #546e7a; width: 22rpx; border-radius: 5rpx; }


