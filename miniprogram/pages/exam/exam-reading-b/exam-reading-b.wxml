<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="topbar">
    <view class="tb-back" catchtap="goBack">返回</view>
    <text class="tb-title">长篇阅读匹配</text>
    <view class="tb-badge tag-B">匹配</view>
  </view>
  <view class="pass-zone">
    <scroll-view class="pz-scroll" scroll-y>
      <text class="pz-text">{{passage.passage}}</text>
    </scroll-view>
  </view>
  <view class="divider"></view>
  <view class="quest-zone">
    <view class="qz-label">📋 匹配陈述（先点陈述，再点字母）</view>
    <scroll-view class="qz-scroll" scroll-y>
      <view wx:for="{{passage.questions}}" wx:for-index="qi" wx:for-item="q" wx:key="qi" class="qb-item {{activeStmt === qi ? 'active' : ''}}" data-qi="{{qi}}" catchtap="onSelectStmt">
        <text class="qbi-num">{{qi + 36}}</text>
        <text class="qbi-txt">{{q}}</text>
        <view class="qbi-ans" wx:if="{{passage._ma[qi]}}" data-qi="{{qi}}" catchtap="onRemoveMatch"><text>{{passage._ma[qi]}}</text></view>
      </view>
    </scroll-view>
    <view class="qb-bar">
      <view class="qb-bar-letters">
        <text class="qb-l" wx:for="{{letters}}" wx:key="*this" wx:for-item="l" catchtap="onMatchLetter" data-val="{{l}}">{{l}}</text>
      </view>
    </view>
  </view>
</view>