.page { min-height: 100vh; background: #f3eeed; display: flex; flex-direction: column; }
.topbar { background: linear-gradient(135deg, #ffb3c6, #ff8fab); padding: 48rpx 24rpx 16rpx; color: #fff; flex-shrink: 0; display: flex; align-items: center; }

.pass-zone { flex: 1; display: flex; flex-direction: column; padding: 0 20rpx; min-height: 0; overflow: hidden; }
.pass-scroll { flex: 1; overflow: hidden; background: #eef1f3; border-radius: 18rpx; padding: 20rpx 24rpx; }
.pass-text { font-size: 28rpx; line-height: 1.9; color: #2d3a4a; word-break: break-word; }

.bk-tag { display: inline; color: #ff6b8a; font-weight: 700; border-bottom: 2px solid #ff6b8a; padding: 0 3px; }
.bk-tag.filled { color: #2d2d4e; border-color: #81c784; background: rgba(129,199,132,0.12); }
.bk-tag.active { color: #fff; background: #ff6b8a; border-color: #ff6b8a; border-radius: 4px; padding: 0 6px; }

.pass-dots { display: flex; justify-content: center; gap: 4px; padding: 4px 0 0; }
.pass-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #d0c8d0; }
.pass-dot.on { background: #546e7a; width: 28rpx; border-radius: 6rpx; }

.divider { height: 2rpx; background: #dad0ca; flex-shrink: 0; }

.quest-zone { flex: 1; display: flex; flex-direction: column; min-height: 0; padding: 0 20rpx 16rpx; background: #faf5f7; }
.quest-scroll { flex: 1; min-height: 0; }
.label { font-size: 22rpx; font-weight: 600; color: #546e7a; padding: 8rpx 0 4rpx; }

.chips { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; padding: 4rpx 0; }
.chip { font-size: 26rpx; color: #4a4a6a; padding: 14rpx 20rpx; border-radius: 14rpx; background: rgba(84,110,122,0.04); border: 2rpx solid rgba(84,110,122,0.06); text-align: center; word-break: break-word; }
.chip.used { opacity: 0.3; border-color: #ccc; background: #f0f0f0; }

.blank-row { display: flex; align-items: center; gap: 10rpx; padding: 8rpx 0; border-bottom: 1rpx solid #e8e0e0; }
.blank-row:last-child { border-bottom: none; }
.blank-label { font-size: 24rpx; font-weight: 700; color: #2d2d4e; width: 90rpx; flex-shrink: 0; }
.blank-val { font-size: 22rpx; color: #999; padding: 4rpx 16rpx; border-radius: 8rpx; background: #fff; min-width: 80rpx; text-align: center; }
.blank-val.filled { color: #d81b60; background: #fce4ec; font-weight: 600; }
.blank-clr { font-size: 22rpx; color: #ccc; padding: 4rpx; flex-shrink: 0; }

.match-row { display: flex; align-items: center; gap: 8rpx; padding: 10rpx 16rpx; background: #fff; border-radius: 12rpx; margin-bottom: 6rpx; border-left: 3px solid transparent; }
.match-row.active { background: rgba(30,136,229,0.06); border-left-color: #1e88e5; }
.match-num { width: 32rpx; height: 32rpx; border-radius: 8rpx; background: rgba(30,136,229,0.06); display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; color: #1e88e5; flex-shrink: 0; }
.match-text { flex: 1; font-size: 24rpx; line-height: 1.5; color: #2d2d4e; word-break: break-word; min-width: 0; }
.match-ans { width: 40rpx; height: 40rpx; border-radius: 10rpx; background: linear-gradient(135deg,#64b5f6,#1e88e5); display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; color: #fff; flex-shrink: 0; }

.letter-bar { display: flex; gap: 6rpx; justify-content: center; flex-wrap: wrap; padding: 8rpx 0; }
.letter { width: 52rpx; height: 52rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 700; color: #fff; background: linear-gradient(135deg,#64b5f6,#1e88e5); box-shadow: 0 3rpx 10rpx rgba(30,136,229,0.3); }
.letter:active { transform: scale(0.9); }

.cq-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 12rpx; box-shadow: 0 2rpx 10rpx rgba(84,110,122,0.05); }
.cq-stem { font-size: 28rpx; line-height: 1.7; color: #2d2d4e; font-weight: 500; margin-bottom: 16rpx; word-break: break-word; }
.cq-opts { display: flex; flex-direction: column; gap: 10rpx; }
.cq-opt { font-size: 26rpx; color: #4a4a6a; padding: 18rpx 22rpx; border-radius: 14rpx; background: #faf7f6; border: 2rpx solid #ece4e2; display: flex; align-items: center; line-height: 1.5; word-break: break-word; }
.cq-opt.sel { color: #1e88e5; font-weight: 600; border-color: #1e88e5; background: rgba(30,136,229,0.06); box-shadow: 0 2rpx 10rpx rgba(30,136,229,0.1); }

.dark-theme.page { background: #12121f !important; }
.dark-theme .topbar { background: linear-gradient(135deg, #2a2a4a, #1a1a38) !important; }
.dark-theme .pass-scroll { background: #1a1a30 !important; }
.dark-theme .pass-text { color: #c0b8d0 !important; }
.dark-theme .bk-tag { color: #ff8fab !important; border-color: #ff8fab !important; }
.dark-theme .bk-tag.filled { color: #e0d0e8 !important; border-color: #81c784 !important; background: rgba(129,199,132,0.15) !important; }
.dark-theme .bk-tag.active { color: #fff !important; background: #ff6b8a !important; border-color: #ff6b8a !important; }
.dark-theme .divider { background: #2a2a4a !important; }
.dark-theme .quest-zone { background: #161625 !important; }
.dark-theme .label { color: #a090b0 !important; }
.dark-theme .chip { background: #2a2a4a !important; color: #c0b0d0 !important; border-color: #3a3a5a !important; }
.dark-theme .chip.used { opacity: 0.3; background: #1a1a30 !important; }
.dark-theme .blank-label { color: #e0d0e8 !important; }
.dark-theme .blank-val { background: #2a2a4a !important; color: #9080a0 !important; }
.dark-theme .blank-val.filled { background: #3a1a2a !important; color: #ff8fab !important; }
.dark-theme .match-row { background: #1e1e38 !important; }
.dark-theme .match-text { color: #e0d0e8 !important; }
.dark-theme .cq-card { background: #1e1e38 !important; }
.dark-theme .cq-stem { color: #e0d0e8 !important; }
.dark-theme .cq-opt { background: #2a2a4a !important; color: #c0b0d0 !important; border-color: #3a3a5a !important; }
.dark-theme .cq-opt.sel { color: #64b5f6 !important; border-color: #64b5f6 !important; background: rgba(100,181,246,0.1) !important; }
