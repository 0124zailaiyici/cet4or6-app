.page { min-height: 100vh; background: #f3eeed; display: flex; flex-direction: column; }
.topbar { background: linear-gradient(135deg, #ffb3c6, #ff8fab); padding: 48rpx 24rpx 16rpx; color: #fff; flex-shrink: 0; display: flex; align-items: center; }

.pass-zone { flex: 1; display: flex; flex-direction: column; padding: 0 20rpx; min-height: 0; overflow: hidden; }
.pass-scroll { flex: 1; overflow: hidden; background: #eef1f3; border-radius: 18rpx; padding: 20rpx 24rpx; }
.pass-text { font-size: 28rpx; line-height: 1.9; color: #2d3a4a; }

.divider { height: 2rpx; background: #dad0ca; flex-shrink: 0; }

.quest-zone { flex: 1; display: flex; flex-direction: column; min-height: 0; padding: 0 20rpx 24rpx; background: #f7f0ef; }
.quest-scroll { flex: 1; min-height: 0; }
.label { font-size: 20rpx; font-weight: 600; color: #546e7a; padding: 8rpx 0 4rpx; }

.chips { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; padding: 4rpx 0; }
.chip { font-size: 26rpx; color: #4a4a6a; padding: 14rpx 20rpx; border-radius: 14rpx; background: rgba(84,110,122,0.04); border: 2rpx solid rgba(84,110,122,0.06); }
.chip.used { opacity: 0.3; border-color: #ccc; background: #f0f0f0; }

.blank-row { padding: 8rpx 0; border-bottom: 1rpx solid #e8e0e0; }
.blank-label { font-size: 24rpx; font-weight: 700; color: #2d2d4e; margin-bottom: 4rpx; }
.blank-opts { display: flex; flex-wrap: wrap; gap: 6rpx; }
.bchip { padding: 6rpx 14rpx; border-radius: 8rpx; background: #f0e8f0; font-size: 22rpx; color: #2d2d4e; }
.bchip.sel { background: #ff8fab; color: #fff; }

.match-row { display: flex; align-items: center; gap: 8rpx; padding: 10rpx 16rpx; background: #fff; border-radius: 12rpx; margin-bottom: 6rpx; }
.match-row.active { background: rgba(30,136,229,0.06); border-left: 4rpx solid #1e88e5; }
.match-num { width: 32rpx; height: 32rpx; border-radius: 8rpx; background: rgba(30,136,229,0.06); display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; color: #1e88e5; flex-shrink: 0; }
.match-text { flex: 1; font-size: 24rpx; color: #2d2d4e; }
.match-ans { width: 40rpx; height: 40rpx; border-radius: 10rpx; background: linear-gradient(135deg,#64b5f6,#1e88e5); display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; color: #fff; flex-shrink: 0; }

.letters-bar { display: flex; gap: 6rpx; justify-content: center; flex-wrap: wrap; padding: 8rpx 0; }
.letter { width: 52rpx; height: 52rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 700; color: #fff; background: linear-gradient(135deg,#64b5f6,#1e88e5); }

.cq-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 12rpx; }
.cq-stem { font-size: 28rpx; line-height: 1.7; color: #2d2d4e; font-weight: 500; margin-bottom: 18rpx; }
.cq-opts { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cq-opt { width: calc(50% - 6rpx); font-size: 26rpx; color: #4a4a6a; padding: 20rpx 24rpx; border-radius: 16rpx; background: #f8f5f4; border: 2rpx solid #ece4e2; }
.cq-opt.sel { color: #1e88e5; font-weight: 600; border-color: #1e88e5; background: rgba(30,136,229,0.06); }

.nav-row { display: flex; gap: 12rpx; padding: 8rpx 0; }
.nav { flex: 1; padding: 14rpx; border-radius: 14rpx; text-align: center; font-size: 24rpx; font-weight: 600; background: #e8e0e8; color: #2d2d4e; }
.nav.disabled { opacity: 0.4; }

.dark-theme.page { background: #12121f !important; }
.dark-theme .topbar { background: linear-gradient(135deg, #2a2a4a, #1a1a38) !important; }
.dark-theme .pass-scroll { background: #1a1a30 !important; }
.dark-theme .pass-text { color: #c0b8d0 !important; }
.dark-theme .divider { background: #2a2a4a !important; }
.dark-theme .quest-zone { background: #161625 !important; }
.dark-theme .label { color: #a090b0 !important; }
.dark-theme .chip { background: #2a2a4a !important; color: #c0b0d0 !important; border-color: #3a3a5a !important; }
.dark-theme .chip.used { opacity: 0.3; background: #1a1a30 !important; }
.dark-theme .blank-label { color: #e0d0e8 !important; }
.dark-theme .bchip { background: #2a2a4a !important; color: #c0b0d0 !important; }
.dark-theme .bchip.sel { background: #d81b60 !important; color: #fff !important; }
.dark-theme .match-row { background: #1e1e38 !important; }
.dark-theme .match-text { color: #e0d0e8 !important; }
.dark-theme .cq-card { background: #1e1e38 !important; }
.dark-theme .cq-stem { color: #e0d0e8 !important; }
.dark-theme .cq-opt { background: #2a2a4a !important; color: #c0b0d0 !important; border-color: #3a3a5a !important; }
.dark-theme .cq-opt.sel { color: #64b5f6 !important; border-color: #64b5f6 !important; background: rgba(100,181,246,0.1) !important; }
.dark-theme .nav { background: #2a2a4a !important; color: #c0b0d0 !important; }
