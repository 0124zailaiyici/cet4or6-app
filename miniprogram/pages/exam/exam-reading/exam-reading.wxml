<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="topbar">
    <text catchtap="goBack">← 返回</text>
    <text style="flex:1;text-align:center">{{passages[idx].sectionType === 'A' ? '选词填空' : passages[idx].sectionType === 'B' ? '长篇阅读匹配' : '仔细阅读'}}</text>
    <text>{{idx + 1}}/{{passages.length}}</text>
  </view>
  <block wx:for="{{passages}}" wx:for-index="pi" wx:for-item="p" wx:key="id">
    <block wx:if="{{pi === idx}}">
      <view class="pass-zone">
        <scroll-view class="pass-scroll" scroll-y>
          <text class="pass-text" wx:if="{{p.sectionType !== 'A' || !p._segments}}">{{p.passage}}</text>
          <text class="pass-text" wx:else>
            <block wx:for="{{p._segments}}" wx:key="*this" wx:for-item="seg">
              <text wx:if="{{seg.type === 'sep'}}">{{seg.text}}</text>
              <text wx:elif="{{seg.type === 'blank'}}" class="bk-tag {{p._ans.blankAnswers[seg.num] ? 'filled' : ''}} {{activeBlank === seg.num ? 'active' : ''}}" data-key="{{seg.num}}" catchtap="onBlankTap">{{p._ans.blankAnswers[seg.num] || seg.num}}</text>
            </block>
          </text>
        </scroll-view>
        <view class="pass-dots"><view class="pass-dot on"></view><view class="pass-dot"></view></view>
      </view>
      <view class="divider"></view>
      <view class="quest-zone">
        <scroll-view class="quest-scroll" scroll-y>
          <block wx:if="{{p.sectionType === 'A'}}">
            <view class="label">选词（15选10）<text wx:if="{{activeBlank}}" style="color:#ff6b8a"> · 请选词填入第{{activeBlank}}空</text></view>
            <view class="chips">
              <text wx:for="{{p.options}}" wx:for-index="wi" wx:for-item="w" wx:key="*this" class="chip {{p._chipUsed[wi] ? 'used' : ''}}" data-word="{{w}}" catchtap="onChipTap">{{['A','B','C','D','E','F','G','H','I','J','K','L','M','N','O'][wi]}}. {{w}}</text>
            </view>
            <view wx:for="{{p.correctAnswers}}" wx:for-index="k" wx:key="k" class="blank-row">
              <text class="blank-label">第{{k}}空</text>
              <text class="blank-val {{p._ans.blankAnswers[k] ? 'filled' : ''}}">{{p._ans.blankAnswers[k] || '未选'}}</text>
              <text class="blank-clr" wx:if="{{p._ans.blankAnswers[k]}}" data-key="{{k}}" catchtap="onBlankClear">✕</text>
            </view>
          </block>
          <block wx:elif="{{p.sectionType === 'B'}}">
            <view class="label">匹配陈述（先点陈述，再点字母）</view>
            <view wx:for="{{p.questions}}" wx:for-index="qi" wx:for-item="q" wx:key="qi" data-qi="{{qi}}" catchtap="onSelectStmt" class="match-row {{activeStmt === qi ? 'active' : ''}}">
              <text class="match-num">{{qi + 36}}</text>
              <text class="match-text">{{q}}</text>
              <text class="match-ans" wx:if="{{p._matchAns[qi]}}">{{p._matchAns[qi]}}</text>
            </view>
            <view class="letter-bar">
              <text wx:for="{{letters}}" wx:for-item="l" wx:key="*this" class="letter" catchtap="onMatchLetter" data-val="{{l}}">{{l}}</text>
            </view>
          </block>
          <block wx:elif="{{p.sectionType === 'C'}}">
            <view wx:for="{{p.questions}}" wx:for-index="qi" wx:for-item="q" wx:key="qi" class="cq-card">
              <view class="cq-stem">{{q}}</view>
              <view class="cq-opts">
                <view wx:for="{{p.choices[qi] || ['A','B','C','D']}}" wx:for-index="oi" wx:for-item="ch" wx:key="*this" class="cq-opt {{p._cAns[qi] === ch ? 'sel' : ''}}" data-qi="{{qi}}" data-val="{{ch}}" catchtap="onSelectC">{{ch}}</view>
              </view>
            </view>
          </block>
        </scroll-view>
      </view>
    </block>
  </block>
</view>