<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="header">
    <text catchtap="goBack" class="hd-back">← 返回</text>
    <text class="hd-title">阅读理解</text>
    <text>{{passages.length}} 篇</text>
  </view>
  <scroll-view class="list" scroll-y>
    <view wx:for="{{passages}}" wx:key="id" class="card" data-id="{{item.id}}" data-type="{{item.sectionType}}" catchtap="select">
      <view class="badge {{item.sectionType === 'A' ? 'b-A' : item.sectionType === 'B' ? 'b-B' : 'b-C'}}">{{item.sectionType === 'A' ? '选词' : item.sectionType === 'B' ? '匹配' : '精读'}}</view>
      <view class="body">
        <text class="title">{{item.sectionType === 'A' ? '选词填空' : item.sectionType === 'B' ? '长篇阅读匹配' : '仔细阅读'}}</text>
        <text class="meta">{{item.sectionType === 'A' ? '10空 · 15选项' : item.sectionType === 'B' ? '10题匹配' : (item.questions ? item.questions.length + '题' : '')}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </scroll-view>
</view>