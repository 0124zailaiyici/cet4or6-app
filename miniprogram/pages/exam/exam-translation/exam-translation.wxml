<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="topbar"><view class="h1">翻译</view><view class="tb-back" catchtap="goBack">返回</view></view>
  <scroll-view class="scroll" scroll-y>
    <view class="sec-label">请将以下中文翻译成英文：</view>
    <view class="src">{{item.chinese}}</view>
    <view class="sec-label">你的翻译</view>
    <textarea class="ta" value="{{answer}}" bindinput="onInput" placeholder="在此输入..." maxlength="-1" />
    <view class="btn-row"><view class="btn" catchtap="save">保存并返回</view></view>
  </scroll-view>
</view>
