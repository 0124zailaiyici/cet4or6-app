<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="topbar">
    <view class="tb-back" catchtap="goBack">返回</view>
    <text class="tb-title">选词填空</text>
    <view class="tb-badge tag-A">选词</view>
  </view>
  <view class="pass-zone" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
    <scroll-view class="pz-scroll" scroll-y>
      <text class="pz-text">
        <block wx:for="{{_curSegs}}" wx:key="*this" wx:for-item="seg">
          <text wx:if="{{seg.type === 'sep'}}">{{seg.text}}</text>
          <text wx:elif="{{seg.type === 'blank'}}" class="bk-tag {{_sel[seg.num] ? 'filled' : ''}} {{_active === seg.num ? 'active' : ''}}" data-key="{{seg.num}}" catchtap="onBlankTap">{{_sel[seg.num] || seg.num}}</text>
        </block>
      </text>
    </scroll-view>
    <view class="dots" wx:if="{{_pages.length > 1}}">
      <view wx:for="{{_pages}}" wx:key="*this" wx:for-index="idx" class="dot {{idx === _pageIdx ? 'on' : ''}}"></view>
    </view>
  </view>
  <view class="divider"></view>
  <view class="quest-zone">
    <view class="qz-label">📋 选词（15选10）<text wx:if="{{_active}}" style="color:#ff6b8a"> · 请选词填入第{{_active}}空</text></view>
    <scroll-view class="qz-chip-scroll" scroll-y>
      <view class="qz-chips">
        <text class="qzc {{_used[wi] ? 'used' : ''}}" wx:for="{{passage.options}}" wx:key="*this" wx:for-index="wi" wx:for-item="w" data-key="{{_active}}" data-word="{{w}}" catchtap="onChipTap">{{['A','B','C','D','E','F','G','H','I','J','K','L','M','N','O'][wi]}}. {{w}}</text>
      </view>
    </scroll-view>
  </view>
</view>