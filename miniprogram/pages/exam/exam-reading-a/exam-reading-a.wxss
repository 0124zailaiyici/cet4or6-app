.page { height: 100vh; display: flex; flex-direction: column; background: #f3eeed; overflow: hidden; }
.page-results { overflow-y: auto; min-height: 100vh; height: auto; display: block; }
.page-results .pass-zone { max-height: 35vh; }
.page-results .result-view { display: block; padding-bottom: 24rpx; }

.topbar { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 24rpx 8rpx; flex-shrink: 0; }
.tb-back { padding: 0 16rpx; height: 48rpx; border-radius: 12rpx; background: rgba(84,110,122,0.08); display: flex; align-items: center; font-size: 24rpx; color: #546e7a; }
.tb-title { flex: 1; font-size: 28rpx; font-weight: 700; color: #2d2d4e; }
.tb-badge { font-size: 18rpx; color: #fff; padding: 4rpx 14rpx; border-radius: 12rpx; }
.tag-A { background: linear-gradient(135deg, #90a4ae, #607d8b); }
.tb-score { font-size: 24rpx; font-weight: 700; color: #546e7a; background: rgba(84,110,122,0.08); padding: 4rpx 16rpx; border-radius: 12rpx; flex-shrink: 0; }
.tb-score.on { color: #fff; background: #1e88e5; }
.dark-theme .tb-score { color: #a090b0 !important; background: rgba(160,144,176,0.12) !important; }
.dark-theme .tb-score.on { color: #fff !important; background: #1e88e5 !important; }

.pass-zone { flex: 1; display: flex; flex-direction: column; padding: 0 20rpx; min-height: 0; overflow: hidden; }
.pz-scroll { flex: 1; overflow: hidden; background: #eef1f3; border-radius: 18rpx; padding: 20rpx 24rpx; }
.pz-text { font-size: 28rpx; line-height: 1.9; color: #2d3a4a; }

.bk-tag { display: inline; color: #ff6b8a; font-weight: 700; border-bottom: 3rpx solid #ff6b8a; padding: 0 4rpx; }
.bk-tag.filled { color: #2d2d4e; border-color: #81c784; background: rgba(129,199,132,0.1); }
.bk-tag.active { color: #fff; background: #ff6b8a; border-color: #ff6b8a; border-radius: 6rpx; padding: 0 8rpx; }

.divider { height: 2rpx; background: #dad0ca; flex-shrink: 0; }

.quest-zone { flex: 1; display: flex; flex-direction: column; padding: 0 20rpx 24rpx; min-height: 0; overflow: hidden; background: #f7f0ef; }
.qz-label { font-size: 20rpx; font-weight: 600; color: #546e7a; padding: 8rpx 0 4rpx; flex-shrink: 0; }
.qz-chip-scroll { flex: 1; min-height: 0; }
.qz-chips { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; align-content: start; padding: 4rpx 0; }
.qzc { font-size: 26rpx; color: #4a4a6a; line-height: 1.5; padding: 14rpx 20rpx; border-radius: 14rpx; background: rgba(84,110,122,0.04); border: 2rpx solid rgba(84,110,122,0.06); transition: 0.2s; text-align: center; word-break: break-word; }
.qzc.used { opacity: 0.3; border-color: #ccc; background: #f0f0f0; }

.result-view { flex: 1; display: flex; flex-direction: column; min-height: 0; background: #f7f0ef; }
.rv-list { flex: 1; min-height: 0; padding: 16rpx 20rpx 0; }
.rv-card { background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 14rpx; box-shadow: 0 2rpx 12rpx rgba(84,110,122,0.04); border-left: 4rpx solid transparent; animation: rvCardIn 0.4s ease both; }
@keyframes rvCardIn { from { opacity: 0; transform: translateX(-16rpx); } to { opacity: 1; transform: translateX(0); } }
.rv-card:nth-child(1) { animation-delay: 0.03s; }
.rv-card:nth-child(2) { animation-delay: 0.07s; }
.rv-card:nth-child(3) { animation-delay: 0.11s; }
.rv-card:nth-child(4) { animation-delay: 0.15s; }
.rv-card:nth-child(5) { animation-delay: 0.19s; }
.rv-card.correct { border-left-color: #81c784; }
.rv-card.wrong { border-left-color: #e57373; }
.rvc-hd { display: flex; align-items: center; gap: 10rpx; margin-bottom: 8rpx; }
.rvc-num { width: 36rpx; height: 36rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; color: #fff; flex-shrink: 0; }
.rvc-num.ok { background: #81c784; }
.rvc-num.bad { background: #e57373; }
.rvc-label { font-size: 24rpx; font-weight: 700; color: #2d2d4e; }
.rvc-locate { font-size: 18rpx; color: #388e3c; margin-left: auto; flex-shrink: 0; padding: 2rpx 12rpx; border-radius: 6rpx; background: rgba(56,142,60,0.08); border: 1rpx solid rgba(56,142,60,0.15); }
.rvc-ans { display: flex; align-items: center; gap: 8rpx; margin-bottom: 6rpx; }
.rvc-ans-label { font-size: 22rpx; color: #8a7a9a; }
.rvc-ans-val { font-size: 24rpx; font-weight: 600; }
.rvc-ans-val.ok { color: #388e3c; }
.rvc-ans-val.wrong { color: #e57373; text-decoration: line-through; }
.rvc-hint { font-size: 22rpx; color: #6a7a8a; line-height: 1.6; margin-top: 8rpx; padding: 12rpx 16rpx; border-radius: 10rpx; background: rgba(0,0,0,0.03); }
.dark-theme .result-view { background: #161625 !important; }
.dark-theme .rv-card { background: #1e1e38 !important; }
.dark-theme .rvc-label { color: #e0d0e8 !important; }
.dark-theme .rvc-locate { color: #81c784 !important; border-color: rgba(129,199,132,0.2) !important; background: rgba(129,199,132,0.08) !important; }
.dark-theme .rvc-ans-val { color: #e0d0e8 !important; }
.dark-theme .rvc-hint { color: #a090b0 !important; background: rgba(255,255,255,0.04) !important; }

.dots { display: flex; justify-content: center; gap: 6rpx; padding: 6rpx 0 4rpx; flex-shrink: 0; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #d0c8d0; }
.dot.on { background: #546e7a; width: 22rpx; border-radius: 5rpx; }

.dark-theme.page { background: #12121f !important; }
.dark-theme .tb-title { color: #e0d0e8 !important; }
.dark-theme .pz-scroll { background: #1a1a30 !important; }
.dark-theme .pz-text { color: #c0b8d0 !important; }
.dark-theme .bk-tag { color: #ff8fab !important; border-color: #ff8fab !important; }
.dark-theme .bk-tag.filled { color: #e0d0e8 !important; border-color: #81c784 !important; background: rgba(129,199,132,0.15) !important; }
.dark-theme .bk-tag.active { color: #fff !important; background: #ff6b8a !important; }
.dark-theme .divider { background: #2a2a4a !important; }
.dark-theme .quest-zone { background: #161625 !important; }
.dark-theme .qz-label { color: #a090b0 !important; }
.dark-theme .qzc { background: #2a2a4a !important; color: #c0b0d0 !important; border-color: #3a3a5a !important; }
.dark-theme .qzc.used { opacity: 0.3; background: #1a1a30 !important; }


.bk-ok { color: #2e7d32 !important; border-color: #2e7d32 !important; background: rgba(46,125,50,0.08) !important; }
.bk-ko { color: #c62828 !important; border-color: #c62828 !important; background: rgba(198,40,40,0.08) !important; }
.bk-cor { font-size: 22rpx; color: #1e88e5; margin-left: 6rpx; font-weight: 400; }
.qzc-ok { border-color: #4caf50 !important; color: #2e7d32 !important; background: rgba(76,175,80,0.08) !important; }
.qzc-ko { border-color: #e53935 !important; color: #c62828 !important; background: rgba(229,57,53,0.08) !important; text-decoration: line-through; }


.dark-theme .bk-ok { color: #81c784 !important; border-color: #81c784 !important; background: rgba(129,199,132,0.15) !important; }
.dark-theme .bk-ko { color: #e57373 !important; border-color: #e57373 !important; background: rgba(229,115,115,0.15) !important; }
.dark-theme .bk-cor { color: #64b5f6 !important; }
.dark-theme .qzc-ok { border-color: #4caf50 !important; color: #81c784 !important; background: rgba(76,175,80,0.12) !important; }
.dark-theme .qzc-ko { border-color: #ef5350 !important; color: #e57373 !important; background: rgba(239,83,80,0.12) !important; }

.back-rs { position: fixed; bottom: 40rpx; right: 36rpx; background: rgba(30,136,229,0.92); color: #fff; padding: 16rpx 30rpx; border-radius: 40rpx; font-size: 26rpx; font-weight: 600; box-shadow: 0 4rpx 20rpx rgba(30,136,229,0.3); z-index: 999; }
