<view class="page {{darkMode ? 'dark-theme' : ''}}">

  <!-- ===== 选套题 ===== -->
  <block wx:if="{{phase === 'list'}}">
    <view class="topbar"><h1>模拟考试</h1><text class="sub">选一套真题，计时模拟真实考场</text></view>
    <block wx:for="{{examSets}}" wx:key="id">
      <view class="card">
        <view class="c-row"><text class="t">{{item.label}}</text><text class="badge">已导入</text></view>
        <view class="tags"><text class="tg">✏️ 写作</text><text class="tg">🎧 听力</text><text class="tg">📖 阅读</text><text class="tg">🌟 翻译</text></view>
        <view class="tags"><text class="tg">⏱ 125分钟</text><text class="tg">📊 自动评分</text></view>
        <view class="start" data-set-id="{{item.id}}" catchtap="startExam">开始考试</view>
      </view>
    </block>
  </block>

  <!-- ===== 考试中 ===== -->
  <block wx:if="{{phase === 'exam'}}">
    <view class="timer-bar">
      <text class="t-num {{timer < 300 ? 'warn' : ''}}">{{timerStr}}</text>
      <text class="t-phase">{{sectionNames[currentSection]}} · 作答中</text>
    </view>
    <view class="sects">
      <view class="se {{currentSection === 0 ? 'on' : ''}}" data-section="0" catchtap="switchSection">✏️ 写作</view>
      <view class="se {{currentSection === 1 ? 'on' : ''}}" data-section="1" catchtap="switchSection">🎧 听力</view>
      <view class="se {{currentSection === 2 ? 'on' : ''}}" data-section="2" catchtap="switchSection">📖 阅读</view>
      <view class="se {{currentSection === 3 ? 'on' : ''}}" data-section="3" catchtap="switchSection">🌟 翻译</view>
    </view>

    <scroll-view class="body" scroll-y>
      <!-- Writing -->
      <view wx:if="{{currentSection === 0}}" class="card">
        <text class="qlbl">✏️ Part I Writing (30 min)</text>
        <text class="qt">For this part, you are allowed 30 minutes to write a news report...</text>
        <textarea class="input" placeholder="在此写作..." value="{{writingText}}" bindinput="onWritingInput" maxlength="2000"></textarea>
      </view>

      <!-- Listening -->
      <view wx:if="{{currentSection === 1}}">
        <view class="card" wx:if="{{listeningQuestions.length === 0}}">
          <text class="qt">暂无听力题目，请先在听力页面作答。</text>
        </view>
        <view class="card" wx:for="{{listeningQuestions}}" wx:key="key" wx:for-item="q" wx:for-index="qi">
          <text class="qlbl">{{q.source}} · {{q.question}}</text>
          <view class="opts">
            <view class="o {{q.userAnswer === 'A' ? 'on' : ''}}" wx:if="{{q.options[0]}}" data-idx="{{qi}}" data-oi="0" catchtap="selectListening">{{q.options[0]}}</view>
            <view class="o {{q.userAnswer === 'B' ? 'on' : ''}}" wx:if="{{q.options[1]}}" data-idx="{{qi}}" data-oi="1" catchtap="selectListening">{{q.options[1]}}</view>
            <view class="o {{q.userAnswer === 'C' ? 'on' : ''}}" wx:if="{{q.options[2]}}" data-idx="{{qi}}" data-oi="2" catchtap="selectListening">{{q.options[2]}}</view>
            <view class="o {{q.userAnswer === 'D' ? 'on' : ''}}" wx:if="{{q.options[3]}}" data-idx="{{qi}}" data-oi="3" catchtap="selectListening">{{q.options[3]}}</view>
          </view>
        </view>
      </view>

      <!-- Reading -->
      <view wx:if="{{currentSection === 2}}">
        <view class="card" wx:if="{{readingQuestions.length === 0}}">
          <text class="qt">暂无阅读题目。</text>
        </view>
        <view class="card" wx:for="{{readingQuestions}}" wx:key="key" wx:for-item="q" wx:for-index="qi">
          <text class="qlbl">{{q.source}} · Q{{qi + 1}}</text>
          <text class="qt">{{q.question}}</text>
          <view class="opts">
            <view class="o {{q.userAnswer === 'A' ? 'on' : ''}}" data-idx="{{qi}}" data-oi="0" catchtap="selectReading">{{q.options[0]}}</view>
            <view class="o {{q.userAnswer === 'B' ? 'on' : ''}}" data-idx="{{qi}}" data-oi="1" catchtap="selectReading">{{q.options[1]}}</view>
            <view class="o {{q.userAnswer === 'C' ? 'on' : ''}}" data-idx="{{qi}}" data-oi="2" catchtap="selectReading">{{q.options[2]}}</view>
            <view class="o {{q.userAnswer === 'D' ? 'on' : ''}}" data-idx="{{qi}}" data-oi="3" catchtap="selectReading">{{q.options[3]}}</view>
          </view>
        </view>
      </view>

      <!-- Translation -->
      <view wx:if="{{currentSection === 3}}" class="card">
        <text class="qlbl">🌟 Part IV Translation (30 min)</text>
        <text class="qt">舞狮作为中国传统民间表演已有2000多年历史...</text>
        <textarea class="input" placeholder="在此翻译..." value="{{translationText}}" bindinput="onTranslationInput" maxlength="2000"></textarea>
      </view>
    </scroll-view>

    <view class="submit-row"><view class="sbtn" catchtap="submitExam">交卷并评分</view></view>
  </block>

  <!-- ===== 结果 ===== -->
  <block wx:if="{{phase === 'result'}}">
    <view class="topbar"><h1>考试结果</h1><text class="sub">{{currentSet.label}}</text></view>

    <view class="card" style="text-align:center">
      <text class="score">{{readingCorrect + listeningCorrect}}</text>
      <text class="subl">答对题数 · 阅读{{readingCorrect}}/{{readingTotal}} 听力{{listeningCorrect}}/{{listeningTotal}}</text>
    </view>

    <view class="card">
      <text class="qt">📊 各题型得分</text>
      <view class="bar-row">
        <text class="bl">🎧 听力</text>
        <view class="bb"><view class="bf" style="width:{{listeningTotal > 0 ? listeningCorrect / listeningTotal * 100 : 0}}%;background:#4fc3f7"></view></view>
        <text class="bn">{{listeningCorrect}}/{{listeningTotal}}</text>
      </view>
      <view class="bar-row">
        <text class="bl">📖 阅读</text>
        <view class="bb"><view class="bf" style="width:{{readingTotal > 0 ? readingCorrect / readingTotal * 100 : 0}}%;background:#81c784"></view></view>
        <text class="bn">{{readingCorrect}}/{{readingTotal}}</text>
      </view>
    </view>

    <view class="card">
      <text class="qt">📋 详细结果</text>
      <view wx:for="{{readingQuestions}}" wx:key="key" wx:for-item="q" class="rrow">
        <text class="rq">{{q.question}}</text>
        <text class="ra {{q.userAnswer === q.correct ? 'g' : 'r'}}">{{q.userAnswer || '未答'}} {{q.userAnswer && q.userAnswer !== q.correct ? '→ ' + q.correct : ''}}</text>
      </view>
      <text wx:if="{{readingQuestions.length === 0}}" class="note">暂无阅读记录</text>
    </view>

    <view class="submit-row"><view class="sbtn2" catchtap="backToList">返回列表</view></view>
  </block>

</view>
