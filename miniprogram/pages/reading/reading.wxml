<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <block wx:if="{{!current}}">
    <view class="rh-header">
      <view class="rh-bg"></view>
      <view class="rh-content">
        <text class="rh-title">📖 阅读理解</text>
        <text class="rh-sub">{{readings.length}} 篇阅读材料</text>
      </view>
    </view>

    <view class="rlist">
      <view class="rcard" wx:for="{{readings}}" wx:key="id" data-id="{{item.id}}" catchtap="select">
        <view class="rc-badge rc-{{item.sectionType}}">{{item.sectionType === 'A' ? '选词' : item.sectionType === 'B' ? '匹配' : '精读'}}</view>
        <view class="rc-body">
          <text class="rc-title">{{item.title}}</text>
          <text class="rc-meta">{{item.questions.length}} 题 | {{item.options ? item.options.length : 0}} 选项</text>
        </view>
        <text class="rc-arrow">›</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="reading-detail">
      <view class="detail-header">
        <view class="back-btn" catchtap="back">←</view>
        <text class="detail-title">{{current.sectionType === 'A' ? '选词填空' : current.sectionType === 'B' ? '长篇阅读' : '仔细阅读'}}</text>
      </view>

      <!-- 文章正文区域（可滚动） -->
      <scroll-view class="passage-scroll" scroll-y>
        <view class="passage-card">
          <text class="passage-text">{{current.passage}}</text>
        </view>
      </scroll-view>

      <!-- 底部固定区域：题目/选项 -->
      <view class="bottom-section">
        <!-- Section A: 选词填空 - 显示选项 -->
        <block wx:if="{{current.sectionType === 'A' && current.options && current.options.length > 0}}">
          <view class="opt-bar">
            <text class="opt-bar-title">📋 可选词：</text>
            <view class="opt-tags">
              <text class="opt-tag" wx:for="{{current.options}}" wx:key="*this" wx:for-index="idx">{{item}}</text>
            </view>
          </view>
        </block>

        <!-- Section B: 长篇阅读 - 显示匹配陈述 -->
        <block wx:elif="{{current.sectionType === 'B' && current.questions && current.questions.length > 0}}">
          <view class="q-bar">
            <text class="q-bar-title">📋 匹配陈述：</text>
            <scroll-view class="q-bar-scroll" scroll-x>
              <text class="q-bar-item" wx:for="{{current.questions}}" wx:key="*this" wx:for-index="idx">{{idx + 1}}.{{item}}</text>
            </scroll-view>
          </view>
        </block>

        <!-- Section C: 仔细阅读 - 显示题目 -->
        <block wx:elif="{{current.sectionType === 'C' && current.questions && current.questions.length > 0}}">
          <view class="q-bar">
            <text class="q-bar-title">📋 题目：</text>
            <scroll-view class="q-bar-scroll" scroll-x>
              <text class="q-bar-item" wx:for="{{current.questions}}" wx:key="*this" wx:for-index="idx">{{item}}</text>
            </scroll-view>
          </view>
        </block>
      </view>
    </view>
  </block>
</view>
