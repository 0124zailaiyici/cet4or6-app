<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <!-- 列表页 -->
  <block wx:if="{{!current}}">
    <view class="rh-header">
      <view class="rh-bg"></view>
      <view class="rh-content">
        <text class="rh-title">📖 阅读理解</text>
        <text class="rh-sub">{{readings.length}} 篇阅读材料</text>
      </view>
    </view>
    <view class="rlist">
      <view class="rcard" wx:for="{{readings}}" wx:key="id" data-id="{{item.id}}" catchtap="select">
        <view class="rc-badge rc-{{item.sectionType}}">{{item.sectionType === 'A' ? '选词' : item.sectionType === 'B' ? '匹配' : '精读'}}</view>
        <view class="rc-body">
          <text class="rc-title">{{item.title}}</text>
          <text class="rc-meta">{{item.sectionType === 'A' ? '10空 · 15选项' : item.sectionType === 'B' ? '10题匹配' : (item.questions.length + '题' + (item.choices[0] ? ' · ' + item.choices[0].length + '选项' : ''))}}</text>
        </view>
        <view class="rc-status">
          <view class="rcs-dot {{completionMap[item.id] && completionMap[item.id].submitted ? 'done' : ''}}"></view>
          <text class="rcs-score" wx:if="{{completionMap[item.id] && completionMap[item.id].submitted}}">{{completionMap[item.id].score}}/{{completionMap[item.id].totalScore}}</text>
        </view>
        <text class="rc-arrow">›</text>
      </view>
    </view>
  </block>

  <!-- ===== 详情页 ===== -->
  <block wx:else>
    <view class="detail-root">

      <!-- 顶栏 -->
      <view class="topbar">
        <view class="tb-back" catchtap="back">返回</view>
        <text class="tb-title">{{current.sectionType === 'A' ? '选词填空' : current.sectionType === 'B' ? '长篇阅读匹配' : '仔细阅读'}}</text>
        <view class="tb-badge {{'tag-' + current.sectionType}}">{{current.sectionType === 'A' ? '选词' : current.sectionType === 'B' ? '匹配' : '精读'}}</view>
        <view class="tb-submit {{submitted ? 'done' : ''}}" wx:if="{{!submitted}}" catchtap="submit">提交</view>
        <text class="tb-score" wx:if="{{submitted}}">{{score}}/{{totalScore}}</text>
      </view>

      <!-- 文章区 -->
      <view class="pass-zone" bindtouchstart="onTouchStart" bindtouchend="onPassageTouchEnd">
        <scroll-view class="pz-scroll" scroll-y enhanced="{{true}}">
          <!-- Section A：交互式填空 -->
          <block wx:if="{{passageSeg.length > 0 && passageSeg[passagePage]}}">
            <text class="pz-text">
              <block wx:for="{{passageSeg[passagePage]}}" wx:key="num" wx:for-item="seg">
                <text wx:if="{{seg.type === 'text'}}">{{seg.text}}</text>
                <text wx:else class="bk-tag {{blankAnswers[seg.num] ? 'filled' : ''}} {{activeBlank === seg.num ? 'active' : ''}}" data-num="{{seg.num}}" catchtap="onBlankTap">{{blankAnswers[seg.num] || seg.num}}</text>
              </block>
            </text>
          </block>
          <!-- 其他类型：富文本段落 -->
          <rich-text wx:elif="{{formattedPages.length > 0}}" nodes="{{formattedPages[passagePage]}}"></rich-text>
          <text wx:else class="pz-text">{{passagePages[passagePage]}}</text>
        </scroll-view>
        <view class="pz-nav" wx:if="{{passagePages.length > 1}}">
          <view class="pz-dots">
            <view class="pzd {{i === passagePage ? 'on' : ''}}" wx:for="{{passagePages}}" wx:key="*this" wx:for-index="i"></view>
          </view>
          <text class="pz-num">{{passagePage + 1}}/{{passagePages.length}}</text>
        </view>
      </view>

      <!-- 分割线 -->
      <view class="divider"></view>

      <!-- 题目区 -->
      <view class="quest-zone" wx:if="{{current.sectionType === 'A' || (current.questions && current.questions.length > 0)}}">

        <!-- Section A：选词填空 -->
        <block wx:if="{{current.sectionType === 'A'}}">
          <view class="qz-label">📋 选词（15选10）<text wx:if="{{activeBlank}}" style="color:#ff6b8a"> · 请选词填入第{{activeBlank}}空</text></view>
          <scroll-view class="qz-chip-scroll" scroll-y>
            <view class="qz-chips">
              <text class="qzc {{usedFlags[i] ? 'used' : ''}} {{submitted ? 'locked' : ''}}" wx:for="{{current.options}}" wx:key="*this" wx:for-index="i" data-idx="{{i}}" catchtap="onOptionTap">{{optionLetters[i]}}. {{item}}</text>
            </view>
          </scroll-view>
        </block>

        <!-- Section B：长篇匹配 -->
        <block wx:elif="{{current.sectionType === 'B'}}">
          <view class="qz-label">📋 匹配陈述 {{matchCount}}/{{current.questions.length}}</view>
          <view class="qb-grid" bindtouchstart="onTouchStart" bindtouchend="onQuestionTouchEnd">
            <view class="qb-item {{activeStmt === (i + bStmtPage * 5) ? 'active' : ''}}" wx:for="{{bStmtPages[bStmtPage]}}" wx:key="*this" wx:for-index="i" data-idx="{{i + bStmtPage * 5}}" catchtap="selectStmt">
              <text class="qbi-num">{{i + bStmtPage * 5 + 1}}</text>
              <text class="qbi-txt">{{item}}</text>
              <view class="qbi-ans" wx:if="{{matchAnswers[i + bStmtPage * 5]}}" data-idx="{{i + bStmtPage * 5}}" catchtap="removeMatch">
                <text>{{matchAnswers[i + bStmtPage * 5]}}</text>
              </view>
            </view>
          </view>
          <view class="qz-dots">
            <view class="qzd {{j === bStmtPage ? 'on' : ''}}" wx:for="{{bStmtPages}}" wx:key="*this" wx:for-index="j"></view>
          </view>
          <view class="qb-bar" wx:if="{{!submitted}}">
            <view class="qb-bar-letters">
              <text class="qb-l" wx:for="{{availLetters}}" wx:key="*this" wx:for-item="L" data-letter="{{L}}" catchtap="assignLetter">{{L}}</text>
            </view>
          </view>
        </block>

        <!-- Section C：统一卡片 -->
        <block wx:else>
          <view class="qz-label">❓ 第{{currentQ + 1}}/{{current.questions.length}}题</view>
          <view class="qz-c-card" bindtouchstart="onTouchStart" bindtouchend="onQuestionTouchEnd">
            <view class="qz-c-question">{{current.questions[currentQ]}}</view>
            <view class="qz-opts {{compactOpts ? 'compact' : ''}}" wx:if="{{current.choices && current.choices[currentQ] && current.choices[currentQ].length > 0}}">
              <view class="qzo {{cSelIdx === i ? 'on' : ''}} {{submitted ? 'locked' : ''}}" wx:for="{{current.choices[currentQ]}}" wx:key="*this" wx:for-index="i" data-letter="{{optionLetters[i]}}" catchtap="onChoiceTap">{{item}}</view>
            </view>
          </view>
          <view class="qz-dots">
            <view class="qzd {{i === currentQ ? 'on' : ''}}" wx:for="{{current.questions}}" wx:key="*this" wx:for-index="i"></view>
          </view>
        </block>

      </view>

      <!-- ===== 结果弹窗 ===== -->
      <view class="result-overlay" wx:if="{{showResult}}" catchtap="hideResult">
        <view class="result-card" catchtap="">
          <view class="res-header">
            <text class="res-title">答题结果</text>
            <view class="res-score-wrap">
              <text class="res-score {{score === totalScore ? 'perfect' : score >= totalScore * 0.6 ? 'good' : 'low'}}">{{score}}/{{totalScore}}</text>
            </view>
          </view>
          <scroll-view class="res-list" scroll-y>
            <view class="res-item {{item.isCorrect ? 'correct' : 'wrong'}}" wx:for="{{resultItems}}" wx:key="label">
              <view class="resi-hd">
                <text class="resi-label">{{item.label}}</text>
                <text class="resi-icon">{{item.isCorrect ? '✓' : '✗'}}</text>
              </view>
              <view class="resi-bd">
                <text class="resi-your">你的: {{item.userAnswer}}</text>
                <text class="resi-ans" wx:if="{{!item.isCorrect}}">正确: {{item.correctAnswer}}</text>
              </view>
            </view>
          </scroll-view>
          <view class="res-foot" catchtap="hideResult">
            <text>关闭</text>
          </view>
        </view>
      </view>

    </view>
  </block>
</view>
