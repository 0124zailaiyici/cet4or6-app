<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <block wx:if="{{!current}}">
    <view class="rh-header">
      <view class="rh-bg"></view>
      <view class="rh-content">
        <text class="rh-title">📖 阅读理解</text>
        <text class="rh-sub">{{readings.length}} 篇阅读材料</text>
      </view>
    </view>
    <view class="rlist">
      <view class="rcard" wx:for="{{readings}}" wx:key="id" data-id="{{item.id}}" catchtap="select">
        <view class="rc-badge rc-{{item.sectionType}}">{{item.sectionType === 'A' ? '选词' : item.sectionType === 'B' ? '匹配' : '精读'}}</view>
        <view class="rc-body">
          <text class="rc-title">{{item.title}}</text>
          <text class="rc-meta">{{item.questions.length}} 题</text>
        </view>
        <text class="rc-arrow">›</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="reading-detail">

      <!-- 顶栏 -->
      <view class="detail-header">
        <view class="back-btn" catchtap="back">←</view>
        <text class="detail-title">{{current.sectionType === 'A' ? '选词填空' : current.sectionType === 'B' ? '长篇阅读' : '仔细阅读'}}</text>
      </view>

      <!-- 文章区：左右滑动翻页 -->
      <view class="passage-area" bindtouchstart="onTouchStart" bindtouchend="onPassageTouchEnd">
        <scroll-view class="pa-scroll" scroll-y>
          <text class="pa-text">{{passagePages[passagePage]}}</text>
        </scroll-view>
        <view class="pa-indicator" wx:if="{{passagePages.length > 1}}">
          <text class="pa-dot {{i === passagePage ? 'on' : ''}}" wx:for="{{passagePages}}" wx:key="*this" wx:for-index="i"></text>
        </view>
      </view>

      <!-- 题目+选项区 -->
      <view class="question-area" wx:if="{{current.questions && current.questions.length > 0}}">
        <view class="qa-top" bindtouchstart="onTouchStart" bindtouchend="onQuestionTouchEnd">
          <text class="qa-label">第{{currentQ + 1}}/{{current.questions.length}}题</text>
          <text class="qa-text">{{current.questions[currentQ]}}</text>
        </view>

        <!-- 选项 -->
        <view class="qa-options" wx:if="{{current.options && current.options.length > 0}}">
          <text class="qao-item" wx:for="{{current.options}}" wx:key="*this" wx:for-index="idx">{{idx + 1}}. {{item}}</text>
        </view>
        <view class="qa-options" wx:else>
          <text class="qao-item" wx:for="{{choiceLabels}}" wx:key="*this">{{item}}</text>
        </view>

        <view class="qa-dots">
          <view class="qad {{i === currentQ ? 'on' : ''}}" wx:for="{{current.questions}}" wx:key="*this"></view>
        </view>
      </view>

    </view>
  </block>
</view>
