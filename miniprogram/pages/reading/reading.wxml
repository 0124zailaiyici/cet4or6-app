<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <block wx:if="{{!current}}">
    <view class="rh-header">
      <view class="rh-bg"></view>
      <view class="rh-content">
        <text class="rh-title">📖 阅读理解</text>
        <text class="rh-sub">{{readings.length}} 篇阅读材料</text>
      </view>
    </view>
    <view class="rlist">
      <view class="rcard" wx:for="{{readings}}" wx:key="id" data-id="{{item.id}}" catchtap="select">
        <view class="rc-badge rc-{{item.sectionType}}">{{item.sectionType === 'A' ? '选词' : item.sectionType === 'B' ? '匹配' : '精读'}}</view>
        <view class="rc-body">
          <text class="rc-title">{{item.title}}</text>
          <text class="rc-meta">{{item.questions.length}} 题</text>
        </view>
        <text class="rc-arrow">›</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="reading-detail">

      <!-- 顶栏 -->
      <view class="detail-header">
        <view class="back-btn" catchtap="back">←</view>
        <text class="detail-title">{{current.sectionType === 'A' ? '选词填空' : current.sectionType === 'B' ? '长篇阅读' : '仔细阅读'}}</text>
      </view>

      <!-- ===== 文章区（左右滑动） ===== -->
      <view class="passage-section" bindtouchstart="onTouchStart" bindtouchend="onPassageTouchEnd">
        <view class="ps-content">
          <text class="ps-text">{{passagePages[passagePage]}}</text>
        </view>
        <view class="ps-bar">
          <text class="ps-btn {{passagePage === 0 ? 'disabled' : ''}}" catchtap="prevPassage">‹</text>
          <text class="ps-dot" wx:for="{{passagePages}}" wx:key="*this" wx:for-index="idx">
            <text class="{{idx === passagePage ? 'active' : ''}}">{{idx + 1}}</text>
          </text>
          <text class="ps-btn {{passagePage >= passagePages.length - 1 ? 'disabled' : ''}}" catchtap="nextPassage">›</text>
        </view>
      </view>

      <!-- ===== 题目区（左右滑动） ===== -->
      <view class="question-section" wx:if="{{current.questions && current.questions.length > 0}}">
        <view class="qs-bar">
          <text class="qs-nav {{currentQ === 0 ? 'disabled' : ''}}" catchtap="prevQ">‹</text>
          <view class="qs-title">第{{currentQ + 1}}/{{current.questions.length}}题</view>
          <text class="qs-nav {{currentQ >= current.questions.length - 1 ? 'disabled' : ''}}" catchtap="nextQ">›</text>
        </view>

        <view class="qs-content" bindtouchstart="onTouchStart" bindtouchend="onQuestionTouchEnd">
          <view class="qs-text">{{current.questions[currentQ]}}</view>
          <!-- 选项 -->
          <view class="qs-options" wx:if="{{current.options && current.options.length > 0}}">
            <text class="qso-item" wx:for="{{current.options}}" wx:key="*this" wx:for-index="idx">{{idx + 1}}.{{item}}</text>
          </view>
          <view class="qs-options" wx:else>
            <text class="qso-item" wx:for="{{choiceLabels}}" wx:key="*this">{{item}}</text>
          </view>
        </view>

        <view class="qs-dots">
          <view class="qsd {{i === currentQ ? 'on' : ''}}" wx:for="{{current.questions}}" wx:key="*this"></view>
        </view>
      </view>

    </view>
  </block>
</view>
