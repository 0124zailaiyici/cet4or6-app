<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <block wx:if="{{!current}}">
    <view class="rh-header">
      <view class="rh-bg"></view>
      <view class="rh-content">
        <text class="rh-title">📖 阅读理解</text>
        <text class="rh-sub">{{readings.length}} 篇阅读材料</text>
      </view>
    </view>
    <view class="rlist">
      <view class="rcard" wx:for="{{readings}}" wx:key="id" data-id="{{item.id}}" catchtap="select">
        <view class="rc-badge rc-{{item.sectionType}}">{{item.sectionType === 'A' ? '选词' : item.sectionType === 'B' ? '匹配' : '精读'}}</view>
        <view class="rc-body">
          <text class="rc-title">{{item.title}}</text>
          <text class="rc-meta">{{item.questions.length}} 题</text>
        </view>
        <text class="rc-arrow">›</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="reading-detail">

      <!-- 顶部：返回 -->
      <view class="detail-header">
        <view class="back-btn" catchtap="back">←</view>
        <text class="detail-title">{{current.sectionType === 'A' ? '选词填空' : current.sectionType === 'B' ? '长篇阅读' : '仔细阅读'}}</text>
      </view>

      <!-- 文章（固定高度区域）-->
      <view class="passage-box">
        <scroll-view class="ps-scroll" scroll-y>
          <view class="ps-card">{{passagePages[passagePage]}}</view>
        </scroll-view>
        <view class="ps-nav">
          <text class="ps-btn {{passagePage === 0 ? 'disabled' : ''}}" catchtap="prevPassage">‹</text>
          <text class="ps-label">{{passagePage + 1}}/{{passagePages.length}}</text>
          <text class="ps-btn {{passagePage >= passagePages.length - 1 ? 'disabled' : ''}}" catchtap="nextPassage">›</text>
        </view>
      </view>

      <!-- 题目区（固定高度区域）-->
      <view class="question-box">
        <view class="qb-header" wx:if="{{current.questions && current.questions.length > 0}}">
          <text class="qb-nav {{currentQ === 0 ? 'disabled' : ''}}" catchtap="prevQ">‹</text>
          <text class="qb-title">第{{currentQ + 1}}/{{current.questions.length}}题</text>
          <text class="qb-nav {{currentQ >= current.questions.length - 1 ? 'disabled' : ''}}" catchtap="nextQ">›</text>
        </view>

        <scroll-view class="qb-scroll" scroll-y>
          <text class="qb-text">{{current.questions[currentQ]}}</text>

          <view class="qc-list qc-grid" wx:if="{{current.options && current.options.length > 0}}">
            <text class="qc-item qc-chip" wx:for="{{current.options}}" wx:key="*this" wx:for-index="idx">{{idx + 1}}.{{item}}</text>
          </view>
          <view class="qc-list" wx:elif="{{choiceLabels && choiceLabels.length > 0}}">
            <text class="qc-item" wx:for="{{choiceLabels}}" wx:key="*this">{{item}}</text>
          </view>
        </scroll-view>

        <view class="qb-dots">
          <view class="qb-dot {{i === currentQ ? 'active' : ''}}" wx:for="{{current.questions}}" wx:key="*this"></view>
        </view>
      </view>

    </view>
  </block>
</view>
