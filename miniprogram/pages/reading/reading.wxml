<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <!-- 列表页 -->
  <block wx:if="{{!current}}">
    <view class="rh-header">
      <view class="rh-bg"></view>
      <view class="rh-content">
        <text class="rh-title">📖 阅读理解</text>
        <text class="rh-sub">{{readings.length}} 篇阅读材料</text>
      </view>
    </view>
    <view class="rlist">
      <view class="rcard" wx:for="{{readings}}" wx:key="id" data-id="{{item.id}}" catchtap="select">
        <view class="rc-badge rc-{{item.sectionType}}">{{item.sectionType === 'A' ? '选词' : item.sectionType === 'B' ? '匹配' : '精读'}}</view>
        <view class="rc-body">
          <text class="rc-title">{{item.title}}</text>
          <text class="rc-meta">{{item.questions.length}} 题 · {{item.options ? item.options.length : 0}} 选项</text>
        </view>
        <text class="rc-arrow">›</text>
      </view>
    </view>
  </block>

  <!-- 详情页 -->
  <block wx:else>
    <view class="reading-detail">

      <!-- 顶栏 -->
      <view class="topbar">
        <view class="tb-back" catchtap="back">←</view>
        <text class="tb-title">{{current.sectionType === 'A' ? '选词填空' : current.sectionType === 'B' ? '长篇阅读' : '仔细阅读'}}</text>
        <view class="tb-badge {{'tag-' + current.sectionType}}">
          {{current.sectionType === 'A' ? '选词' : current.sectionType === 'B' ? '匹配' : '精读'}}
        </view>
      </view>

      <!-- 文章区 -->
      <view class="passage-wrap">
        <view class="pw-header">
          <text class="pw-label">📄 文章</text>
          <text class="pw-page">{{passagePage + 1}}/{{passagePages.length}}</text>
        </view>
        <view class="pw-card">
          <scroll-view class="pw-scroll" scroll-y bindtouchstart="onTouchStart" bindtouchend="onPassageTouchEnd">
            <text class="pw-text">{{passagePages[passagePage]}}</text>
          </scroll-view>
        </view>
        <view class="pw-dots">
          <view class="pwd {{i === passagePage ? 'on' : ''}}" wx:for="{{passagePages}}" wx:key="*this" wx:for-index="i"></view>
        </view>
      </view>

      <!-- 分割 -->
      <view class="section-divider"></view>

      <!-- 题目区（选词填空始终显示，其他需有题目才显示）-->
      <view class="question-wrap" wx:if="{{current.sectionType === 'A' || (current.questions && current.questions.length > 0)}}">

        <!-- 题型 A：选词填空 → 显示15选项 -->
        <block wx:if="{{current.sectionType === 'A'}}">
          <view class="qw-header">
            <text class="qw-label">📋 选词（15选10）</text>
            <text class="qw-count">{{current.options ? current.options.length : 0}} 词</text>
          </view>
          <view class="qw-card">
            <view class="qw-chips">
              <text class="qwc-item" wx:for="{{current.options}}" wx:key="*this" wx:for-index="idx">{{idx + 1}}.{{item}}</text>
            </view>
          </view>
        </block>

        <!-- 题型 B/C：显示题目 + 选项 -->
        <block wx:else>
          <view class="qw-header">
            <text class="qw-label">❓ 题目</text>
            <text class="qw-count">{{currentQ + 1}}/{{current.questions.length}}</text>
          </view>
          <view class="qw-card" bindtouchstart="onTouchStart" bindtouchend="onQuestionTouchEnd">
            <text class="qw-text">{{current.questions[currentQ]}}</text>
            <view class="qw-options" wx:if="{{current.choices && current.choices[currentQ] && current.choices[currentQ].length > 0}}">
              <text class="qwo-item" wx:for="{{current.choices[currentQ]}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
          <view class="qw-dots">
            <view class="qwd {{i === currentQ ? 'on' : ''}}" wx:for="{{current.questions}}" wx:key="*this" wx:for-index="i"></view>
          </view>
        </block>

      </view>

    </view>
  </block>
</view>
