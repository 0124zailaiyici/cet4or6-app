.page { min-height: 100vh; }

/* ===== List ===== */
.rh-header { position: relative; overflow: hidden; }
.rh-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 200rpx;
  background: linear-gradient(135deg, #90a4ae, #546e7a);
  border-radius: 0 0 40rpx 40rpx;
}
.rh-content { position: relative; padding: 48rpx 36rpx 36rpx; }
.rh-title { font-size: 48rpx; font-weight: 800; color: #fff; }
.rh-sub { display: block; font-size: 26rpx; color: rgba(255,255,255,0.8); margin-top: 6rpx; }
.rlist { padding: 20rpx 36rpx; display: flex; flex-direction: column; gap: 16rpx; }
.rcard {
  background: #fff; border-radius: 22rpx; padding: 24rpx; box-shadow: 0 4rpx 20rpx rgba(84,110,122,0.06);
  display: flex; align-items: center; gap: 16rpx;
}
.rcard:active { transform: translateY(-2rpx); }
.rc-badge {
  width: 80rpx; height: 80rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: #fff; flex-shrink: 0;
}
.rc-A { background: linear-gradient(135deg, #90a4ae, #607d8b); }
.rc-B { background: linear-gradient(135deg, #64b5f6, #1e88e5); }
.rc-C { background: linear-gradient(135deg, #81c784, #388e3c); }
.rc-body { flex: 1; }
.rc-title { display: block; font-size: 28rpx; font-weight: 600; color: #2d2d4e; }
.rc-meta { display: block; font-size: 22rpx; color: #8a7a9a; margin-top: 4rpx; }
.rc-arrow { font-size: 36rpx; color: #8a7a9a; }

/* ===== Detail ===== */
.detail-root { display: flex; flex-direction: column; height: 100vh; background: #f3eeed; }

/* Topbar */
.topbar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 24rpx 8rpx; flex-shrink: 0;
}
.tb-back {
  width: 44rpx; height: 44rpx; border-radius: 12rpx; background: rgba(84,110,122,0.08);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #546e7a;
}
.tb-title { flex: 1; font-size: 28rpx; font-weight: 700; color: #2d2d4e; }
.tb-badge { font-size: 18rpx; color: #fff; padding: 4rpx 14rpx; border-radius: 12rpx; }
.tag-A { background: linear-gradient(135deg, #90a4ae, #607d8b); }
.tag-B { background: linear-gradient(135deg, #64b5f6, #1e88e5); }
.tag-C { background: linear-gradient(135deg, #81c784, #388e3c); }

/* === Passage zone === */
.pass-zone {
  flex: 1; display: flex; flex-direction: column;
  padding: 0 20rpx; min-height: 0; overflow: hidden;
}
.pz-scroll {
  flex: 1; overflow: hidden;
  background: #eef1f3; border-radius: 18rpx; padding: 20rpx 24rpx;
}
.pz-text { font-size: 28rpx; line-height: 1.9; color: #2d3a4a; }
.pz-nav {
  display: flex; justify-content: center; align-items: center;
  gap: 10rpx; padding: 6rpx 0 4rpx; flex-shrink: 0;
}
.pz-dots { display: flex; gap: 6rpx; }
.pzd { width: 10rpx; height: 10rpx; border-radius: 50%; background: #d0c8d0; }
.pzd.on { background: #546e7a; width: 20rpx; border-radius: 5rpx; }
.pz-num { font-size: 18rpx; color: #8a7a9a; }

/* === Divider === */
.divider { height: 2rpx; background: #dad0ca; flex-shrink: 0; }

/* === Question zone === */
.quest-zone {
  flex: 1; display: flex; flex-direction: column;
  padding: 0 20rpx 24rpx; min-height: 0; overflow: hidden;
  background: #f7f0ef;
}

.qz-label { font-size: 20rpx; font-weight: 600; color: #546e7a; padding: 6rpx 0 2rpx; flex-shrink: 0; }

.qz-dots { display: flex; justify-content: center; gap: 6rpx; padding: 6rpx 0 0; flex-shrink: 0; }
.qzd { width: 10rpx; height: 10rpx; border-radius: 50%; background: #d0c8d0; }
.qzd.on { background: #546e7a; width: 20rpx; border-radius: 5rpx; }
