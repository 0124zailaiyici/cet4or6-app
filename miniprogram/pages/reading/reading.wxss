.page { min-height: 100vh; }

/* ===== List ===== */
.rh-header { position: relative; overflow: hidden; }
.rh-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 200rpx;
  background: linear-gradient(135deg, #90a4ae, #546e7a);
  border-radius: 0 0 40rpx 40rpx;
}
.rh-content { position: relative; padding: 48rpx 36rpx 36rpx; }
.rh-title { font-size: 48rpx; font-weight: 800; color: #fff; }
.rh-sub { display: block; font-size: 26rpx; color: rgba(255,255,255,0.8); margin-top: 6rpx; }
.rlist { padding: 20rpx 36rpx; display: flex; flex-direction: column; gap: 16rpx; }
.rcard {
  background: #fff; border-radius: 22rpx; padding: 24rpx; box-shadow: 0 4rpx 20rpx rgba(84,110,122,0.06);
  display: flex; align-items: center; gap: 16rpx;
}
.rcard:active { transform: translateY(-2rpx); }
.rc-badge {
  width: 80rpx; height: 80rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: #fff; flex-shrink: 0;
}
.rc-A { background: linear-gradient(135deg, #90a4ae, #607d8b); }
.rc-B { background: linear-gradient(135deg, #64b5f6, #1e88e5); }
.rc-C { background: linear-gradient(135deg, #81c784, #388e3c); }
.rc-body { flex: 1; }
.rc-title { display: block; font-size: 28rpx; font-weight: 600; color: #2d2d4e; }
.rc-meta { display: block; font-size: 22rpx; color: #8a7a9a; margin-top: 4rpx; }
.rc-arrow { font-size: 36rpx; color: #8a7a9a; }

/* ===== Detail ===== */
.reading-detail { display: flex; flex-direction: column; height: 100vh; background: #f8f6f0; }

/* Top bar */
.topbar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 12rpx 28rpx 8rpx; flex-shrink: 0;
}
.tb-back {
  width: 48rpx; height: 48rpx; border-radius: 12rpx; background: rgba(84,110,122,0.08);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #546e7a;
}
.tb-title { flex: 1; font-size: 30rpx; font-weight: 700; color: #2d2d4e; }
.tb-badge {
  font-size: 20rpx; color: #fff; padding: 6rpx 18rpx; border-radius: 14rpx;
}
.tag-A { background: linear-gradient(135deg, #90a4ae, #607d8b); }
.tag-B { background: linear-gradient(135deg, #64b5f6, #1e88e5); }
.tag-C { background: linear-gradient(135deg, #81c784, #388e3c); }

/* Passage section */
.passage-wrap {
  flex: 1; display: flex; flex-direction: column;
  padding: 0 28rpx; min-height: 0;
  background: #f8f6f0;
}
.pw-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx;
}
.pw-label { font-size: 22rpx; color: #546e7a; font-weight: 600; letter-spacing: 2rpx; }
.pw-page { font-size: 20rpx; color: #8a7a9a; }

.pw-card {
  flex: 1;
  background: #eef1f3;
  border-radius: 24rpx; padding: 24rpx 28rpx;
  display: flex; flex-direction: column;
}
.pw-text {
  flex: 1;
  font-size: 28rpx; line-height: 1.9; color: #2d3a4a;
  overflow: hidden;
}

.pw-dots {
  display: flex; justify-content: center; gap: 8rpx; padding: 12rpx 0 8rpx;
}
.pwd { width: 12rpx; height: 12rpx; border-radius: 50%; background: #d0c8d0; transition: 0.3s; }
.pwd.on { background: #546e7a; width: 28rpx; border-radius: 6rpx; }

/* Divider */
.section-divider {
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(84,110,122,0.08) 20%, rgba(84,110,122,0.08) 80%, transparent);
  flex-shrink: 0;
}

/* Question section */
.question-wrap {
  flex: 1.3; display: flex; flex-direction: column;
  padding: 8rpx 28rpx 32rpx; min-height: 0;
  background: #faf5f7;
}
.qw-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx;
}
.qw-label { font-size: 22rpx; color: #546e7a; font-weight: 600; letter-spacing: 2rpx; }
.qw-count { font-size: 20rpx; color: #8a7a9a; }

.qw-card {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx; padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(84,110,122,0.04);
  display: flex; flex-direction: column;
}
.qw-text {
  font-size: 30rpx; line-height: 1.7; color: #2d2d4e; font-weight: 500;
  margin-bottom: 16rpx;
}

/* Options: vertical list (Section B/C) */
.qw-options {
  flex: 1; display: flex; flex-direction: column; gap: 12rpx;
}
.qwo-item {
  flex: 1; display: flex; align-items: center;
  font-size: 26rpx; color: #4a4a6a;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(84,110,122,0.04);
  border: 2rpx solid rgba(84,110,122,0.06);
  line-height: 1.5;
}

/* Options: chips (Section A) */
.qw-chips {
  display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx;
}
.qwc-item {
  font-size: 26rpx; color: #4a4a6a; padding: 14rpx 28rpx;
  border-radius: 16rpx; background: rgba(84,110,122,0.05);
  border: 2rpx solid rgba(84,110,122,0.08);
}

/* Dots */
.qw-dots {
  display: flex; justify-content: center; gap: 8rpx; padding: 12rpx 0 0;
}
.qwd { width: 12rpx; height: 12rpx; border-radius: 50%; background: #d0c8d0; transition: 0.3s; }
.qwd.on { background: #546e7a; width: 28rpx; border-radius: 6rpx; }
