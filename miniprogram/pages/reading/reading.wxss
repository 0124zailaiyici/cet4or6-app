.page { min-height: 100vh; }

/* ===== List ===== */
.rh-header { position: relative; overflow: hidden; }
.rh-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 200rpx;
  background: linear-gradient(135deg, #90a4ae, #546e7a);
  border-radius: 0 0 40rpx 40rpx;
}
.rh-content { position: relative; padding: 48rpx 36rpx 36rpx; }
.rh-title { font-size: 48rpx; font-weight: 800; color: #fff; }
.rh-sub { display: block; font-size: 26rpx; color: rgba(255,255,255,0.8); margin-top: 6rpx; }
.rlist { padding: 20rpx 36rpx; display: flex; flex-direction: column; gap: 16rpx; }
.rcard {
  background: #fff; border-radius: 22rpx; padding: 24rpx; box-shadow: 0 4rpx 20rpx rgba(84,110,122,0.06);
  display: flex; align-items: center; gap: 16rpx;
}
.rcard:active { transform: translateY(-2rpx); }
.rc-badge {
  width: 80rpx; height: 80rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: #fff; flex-shrink: 0;
}
.rc-A { background: linear-gradient(135deg, #90a4ae, #607d8b); }
.rc-B { background: linear-gradient(135deg, #64b5f6, #1e88e5); }
.rc-C { background: linear-gradient(135deg, #81c784, #388e3c); }
.rc-body { flex: 1; }
.rc-title { display: block; font-size: 28rpx; font-weight: 600; color: #2d2d4e; }
.rc-meta { display: block; font-size: 22rpx; color: #8a7a9a; margin-top: 4rpx; }
.rc-arrow { font-size: 36rpx; color: #8a7a9a; }

/* ===== Detail ===== */
.reading-detail { display: flex; flex-direction: column; height: 100vh; }

.detail-header {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 32rpx; flex-shrink: 0;
}
.back-btn {
  width: 64rpx; height: 64rpx; border-radius: 18rpx; background: rgba(84,110,122,0.08);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #546e7a;
}
.detail-title { flex: 1; font-size: 30rpx; font-weight: 700; color: #2d2d4e; }

/* ===== 上半：文章区域 ===== */
.passage-area {
  flex: 1; display: flex; flex-direction: column;
  padding: 0 32rpx; min-height: 0;
}
.passage-scroll { flex: 1; }
.passage-card {
  background: #fff; border-radius: 22rpx; padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(84,110,122,0.06);
}
.passage-text { font-size: 28rpx; line-height: 1.9; color: #2d2d4e; }

.passage-nav {
  display: flex; align-items: center; justify-content: center;
  gap: 24rpx; padding: 12rpx 0;
}
.pn-btn {
  font-size: 40rpx; color: #546e7a; padding: 8rpx; line-height: 1;
}
.pn-btn.disabled { color: #d0c8d0; }
.pn-label { font-size: 24rpx; color: #8a7a9a; }

/* ===== 分割线 ===== */
.divider { height: 4rpx; background: #f0e8f0; flex-shrink: 0; }

/* ===== 下半：题目区域 ===== */
.question-area {
  flex: 1; display: flex; flex-direction: column;
  padding: 16rpx 32rpx 32rpx; min-height: 0;
}

.q-header {
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx; margin-bottom: 12rpx; flex-shrink: 0;
}
.q-nav {
  font-size: 40rpx; color: #546e7a; padding: 8rpx; line-height: 1;
}
.q-nav.disabled { color: #d0c8d0; }
.q-title { font-size: 24rpx; font-weight: 600; color: #546e7a; }

.q-scroll { flex: 1; }
.q-text { font-size: 28rpx; line-height: 1.7; color: #2d2d4e; display: block; }

.q-choices { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.qc-item {
  font-size: 26rpx; color: #4a4a6a; padding: 12rpx 24rpx;
  border-radius: 16rpx; background: rgba(84,110,122,0.04);
}
.qc-chip {
  font-size: 24rpx; padding: 10rpx 20rpx;
  background: rgba(84,110,122,0.06);
}

.q-dots {
  display: flex; justify-content: center; gap: 10rpx;
  margin-top: 12rpx; flex-shrink: 0;
}
.q-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #d0c8d0;
}
.q-dot.active { background: #546e7a; width: 24rpx; border-radius: 6rpx; }
