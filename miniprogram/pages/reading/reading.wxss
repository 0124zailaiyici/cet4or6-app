.page { min-height: 100vh; padding-bottom: 48rpx; }

/* ===== List view ===== */
.rh-header { position: relative; overflow: hidden; }
.rh-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 200rpx;
  background: linear-gradient(135deg, #90a4ae, #546e7a);
  border-radius: 0 0 40rpx 40rpx;
}
.rh-content { position: relative; padding: 48rpx 36rpx 36rpx; }
.rh-title { font-size: 48rpx; font-weight: 800; color: #fff; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); }
.rh-sub { display: block; font-size: 26rpx; color: rgba(255,255,255,0.8); margin-top: 6rpx; }

.rlist { padding: 20rpx 36rpx; display: flex; flex-direction: column; gap: 16rpx; }
.rcard {
  background: #fff; border-radius: 22rpx; padding: 24rpx; box-shadow: 0 4rpx 20rpx rgba(84,110,122,0.06);
  display: flex; align-items: center; gap: 16rpx; transition: transform 0.2s;
}
.rcard:active { transform: translateY(-2rpx); }

.rc-badge {
  width: 80rpx; height: 80rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: #fff; flex-shrink: 0;
}
.rc-A { background: linear-gradient(135deg, #90a4ae, #607d8b); }
.rc-B { background: linear-gradient(135deg, #64b5f6, #1e88e5); }
.rc-C { background: linear-gradient(135deg, #81c784, #388e3c); }

.rc-body { flex: 1; }
.rc-title { display: block; font-size: 28rpx; font-weight: 600; color: #2d2d4e; }
.rc-meta { display: block; font-size: 22rpx; color: #8a7a9a; margin-top: 4rpx; }
.rc-arrow { font-size: 36rpx; color: #8a7a9a; }

/* ===== Detail view (flex layout) ===== */
.reading-detail {
  display: flex; flex-direction: column;
  height: 100vh; padding-bottom: 0;
}

.detail-header {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 36rpx; flex-shrink: 0;
}
.back-btn {
  width: 64rpx; height: 64rpx; border-radius: 18rpx; background: rgba(84,110,122,0.08);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #546e7a; flex-shrink: 0;
}
.detail-title { font-size: 30rpx; font-weight: 700; color: #2d2d4e; flex: 1; }

/* Passage scroll area (takes remaining space) */
.passage-scroll { flex: 1; padding: 0 36rpx; }
.passage-card {
  background: #fff; border-radius: 22rpx; padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(84,110,122,0.06);
}
.passage-text { font-size: 28rpx; line-height: 1.9; color: #2d2d4e; }

/* Fixed bottom section */
.bottom-section {
  flex-shrink: 0;
  background: #fff;
  border-top: 2rpx solid #f0e8f0;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
  padding: 20rpx 36rpx 36rpx;
  max-height: 40vh;
}

/* Options bar (Section A) */
.opt-bar-title {
  display: block; font-size: 24rpx; font-weight: 600; color: #546e7a; margin-bottom: 12rpx;
}
.opt-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.opt-tag {
  font-size: 24rpx; color: #2d2d4e; padding: 8rpx 18rpx;
  border-radius: 16rpx; background: rgba(84,110,122,0.06);
}

/* Questions bar (Section B & C) */
.q-bar-title {
  display: block; font-size: 24rpx; font-weight: 600; color: #546e7a; margin-bottom: 12rpx;
}
.q-bar-scroll { white-space: nowrap; padding-bottom: 8rpx; }
.q-bar-item {
  display: inline-block; font-size: 24rpx; color: #4a4a6a;
  padding: 10rpx 20rpx; margin-right: 12rpx;
  border-radius: 16rpx; background: rgba(84,110,122,0.04);
  white-space: normal; max-width: 500rpx;
  vertical-align: top;
}
