.page { min-height: 100vh; }

/* ===== List ===== */
.rh-header { position: relative; overflow: hidden; }
.rh-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 200rpx;
  background: linear-gradient(135deg, #90a4ae, #546e7a);
  border-radius: 0 0 40rpx 40rpx;
}
.rh-content { position: relative; padding: 48rpx 36rpx 36rpx; }
.rh-title { font-size: 48rpx; font-weight: 800; color: #fff; }
.rh-sub { display: block; font-size: 26rpx; color: rgba(255,255,255,0.8); margin-top: 6rpx; }
.rlist { padding: 20rpx 36rpx; display: flex; flex-direction: column; gap: 16rpx; }
.rcard {
  background: #fff; border-radius: 22rpx; padding: 24rpx; box-shadow: 0 4rpx 20rpx rgba(84,110,122,0.06);
  display: flex; align-items: center; gap: 16rpx;
}
.rcard:active { transform: translateY(-2rpx); }
.rc-badge {
  width: 80rpx; height: 80rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: #fff; flex-shrink: 0;
}
.rc-A { background: linear-gradient(135deg, #90a4ae, #607d8b); }
.rc-B { background: linear-gradient(135deg, #64b5f6, #1e88e5); }
.rc-C { background: linear-gradient(135deg, #81c784, #388e3c); }
.rc-body { flex: 1; }
.rc-title { display: block; font-size: 28rpx; font-weight: 600; color: #2d2d4e; }
.rc-meta { display: block; font-size: 22rpx; color: #8a7a9a; margin-top: 4rpx; }
.rc-arrow { font-size: 36rpx; color: #8a7a9a; }

/* Completion status on list cards */
.rc-status { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.rcs-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #d0c8d0; border: 2rpx solid #e0d8e0;
}
.rcs-dot.done { background: #81c784; border-color: #66bb6a; }
.rcs-score { font-size: 22rpx; font-weight: 600; color: #546e7a; }

/* ===== Detail ===== */
.detail-root { display: flex; flex-direction: column; height: 100vh; background: #f3eeed; position: relative; }

/* Content zone */
.content-zone { flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden; position: relative; }

/* Answer zone */
.answer-zone { flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden; }

/* Topbar */
.topbar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 24rpx 8rpx; flex-shrink: 0;
}
.tb-back {
  padding: 0 16rpx; height: 48rpx; border-radius: 12rpx; background: rgba(84,110,122,0.08);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #546e7a;
}
.tb-title { flex: 1; font-size: 28rpx; font-weight: 700; color: #2d2d4e; }
.tb-badge { font-size: 18rpx; color: #fff; padding: 4rpx 14rpx; border-radius: 12rpx; }
.tag-A { background: linear-gradient(135deg, #90a4ae, #607d8b); }
.tag-B { background: linear-gradient(135deg, #64b5f6, #1e88e5); }
.tag-C { background: linear-gradient(135deg, #81c784, #388e3c); }

/* Submit button */
.tb-submit {
  padding: 0 20rpx; height: 48rpx; border-radius: 24rpx;
  background: linear-gradient(135deg, #1e88e5, #1565c0);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 600; color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(30,136,229,0.3);
}
.tb-submit:active { opacity: 0.85; transform: scale(0.96); }
.tb-submit.done { background: #81c784; box-shadow: none; }
.tb-score {
  font-size: 24rpx; font-weight: 700; color: #546e7a;
  background: rgba(84,110,122,0.08); padding: 4rpx 16rpx; border-radius: 12rpx;
}
.tb-score.on { color: #fff; background: #1e88e5; }
.tb-reset {
  padding: 0 16rpx; height: 40rpx; border-radius: 10rpx;
  background: rgba(229,57,53,0.08); border: 1rpx solid rgba(229,57,53,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #e53935;
}
.tb-reset:active { opacity: 0.8; }

/* === Passage zone === */
.pass-zone {
  flex: 1; display: flex; flex-direction: column;
  padding: 0 20rpx; min-height: 0; overflow: hidden;
}
.pz-scroll {
  flex: 1; overflow: hidden;
  background: #eef1f3; border-radius: 18rpx; padding: 20rpx 24rpx;
  --scroll-bar-color: transparent;
}
.pz-text { font-size: 28rpx; line-height: 1.9; color: #2d3a4a; }
.pz-nav {
  display: flex; justify-content: center; align-items: center;
  gap: 10rpx; padding: 6rpx 0 4rpx; flex-shrink: 0;
}
.pz-dots { display: flex; gap: 6rpx; }
.pzd { width: 10rpx; height: 10rpx; border-radius: 50%; background: #d0c8d0; }
.pzd.on { background: #546e7a; width: 20rpx; border-radius: 5rpx; }
.pz-num { font-size: 18rpx; color: #8a7a9a; }

/* === Divider === */
.divider { height: 2rpx; background: #dad0ca; flex-shrink: 0; }

/* === Question zone === */
.quest-zone {
  flex: 1; display: flex; flex-direction: column;
  padding: 0 20rpx 24rpx; min-height: 0; overflow: hidden;
  background: #f7f0ef;
}

.qz-label { font-size: 20rpx; font-weight: 600; color: #546e7a; padding: 8rpx 0 4rpx; flex-shrink: 0; }

/* 选词填空 chips */
.qz-chip-scroll { flex: 1; min-height: 0; }
.qz-chips { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; align-content: start; padding: 4rpx 0; }
.qzc {
  font-size: 26rpx; color: #4a4a6a; line-height: 1.5;
  padding: 14rpx 20rpx; border-radius: 14rpx;
  background: rgba(84,110,122,0.04); border: 2rpx solid rgba(84,110,122,0.06);
  transition: 0.2s;
}
.qzc.used { opacity: 0.3; border-color: #ccc; background: #f0f0f0; }
.qzc.locked { opacity: 0.6; }

/* 交互式空白标签 */
.bk-tag {
  display: inline; color: #ff6b8a; font-weight: 700;
  border-bottom: 3rpx solid #ff6b8a; padding: 0 4rpx;
}
.bk-tag.filled { color: #2d2d4e; border-color: #81c784; background: rgba(129,199,132,0.1); }
.bk-tag.active { color: #fff; background: #ff6b8a; border-color: #ff6b8a; border-radius: 6rpx; padding: 0 8rpx; }

/* Section C 统一卡片 */
.qz-c-card {
  flex: 1; overflow-y: auto;
  background: #fff; border-radius: 20rpx; padding: 24rpx 24rpx 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(84,110,122,0.06);
}
.qz-c-question {
  font-size: 28rpx; line-height: 1.7; color: #2d2d4e; font-weight: 500;
  margin-bottom: 18rpx; display: block;
}

/* 选项区域 */
.qz-opts { display: flex; flex-wrap: wrap; gap: 12rpx; }
.qzo {
  width: calc(50% - 6rpx);
  font-size: 26rpx; color: #4a4a6a; line-height: 1.5;
  padding: 20rpx 24rpx; border-radius: 16rpx;
  background: #f8f5f4; border: 2rpx solid #ece4e2;
  transition: 0.15s;
}
.qzo.on {
  color: #1e88e5; font-weight: 600;
  border-color: #1e88e5;
  background: rgba(30,136,229,0.06);
  box-shadow: 0 2rpx 12rpx rgba(30,136,229,0.1);
}
.qzo.locked { opacity: 0.6; }
.qz-opts.compact .qzo { padding: 12rpx 20rpx; font-size: 24rpx; border-radius: 12rpx; }
.qzo-ref { font-size: 22rpx; color: #8a7a9a; line-height: 1.6; font-style: italic; }

/* dots */
.qz-dots { display: flex; justify-content: center; gap: 6rpx; padding: 8rpx 0 0; flex-shrink: 0; }
.qzd { width: 10rpx; height: 10rpx; border-radius: 50%; background: #d0c8d0; }
.qzd.on { background: #546e7a; width: 20rpx; border-radius: 5rpx; }

/* ===== Section B ===== */
.qb-grid {
  flex: 1; overflow: hidden;
  background: #fff; border-radius: 18rpx; padding: 2rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(84,110,122,0.04);
}
.qb-item {
  display: flex; align-items: center; gap: 10rpx;
  padding: 10rpx 24rpx; border-bottom: 1rpx solid #f5f0f0;
}
.qb-item:last-child { border-bottom: none; }
.qb-item.active { background: rgba(30,136,229,0.06); border-left: 4rpx solid #1e88e5; padding-left: 20rpx; }

.qbi-num {
  width: 40rpx; height: 40rpx; border-radius: 10rpx; background: rgba(30,136,229,0.06);
  display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; color: #1e88e5; flex-shrink: 0;
}
.qbi-txt { flex: 1; font-size: 26rpx; line-height: 1.5; color: #2d2d4e; }
.qbi-ans {
  width: 48rpx; height: 48rpx; border-radius: 12rpx;
  background: linear-gradient(135deg,#64b5f6,#1e88e5); display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; color: #fff; flex-shrink: 0; box-shadow: 0 2rpx 8rpx rgba(30,136,229,0.2);
}

.qb-bar { padding: 8rpx 0 4rpx; flex-shrink: 0; }
.qb-bar-letters { display: flex; gap: 8rpx; justify-content: center; flex-wrap: wrap; }
.qb-l {
  width: 72rpx; height: 72rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; color: #fff;
  background: linear-gradient(135deg,#64b5f6,#1e88e5);
  box-shadow: 0 4rpx 16rpx rgba(30,136,229,0.3);
}
.qb-l:active { transform: scale(0.9); }

/* ===== Vocab bar ===== */
.vocab-bar {
  flex-shrink: 0; padding: 6rpx 20rpx 4rpx; background: #f7f0ef;
}
.vb-toggle {
  font-size: 20rpx; color: #e65100; font-weight: 600; padding: 4rpx 0;
}
.vb-list {
  display: flex; flex-wrap: wrap; gap: 8rpx; padding: 6rpx 0 4rpx;
}
.vb-word {
  font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx;
  background: rgba(230,81,0,0.06); color: #e65100; border: 1rpx solid rgba(230,81,0,0.12);
}
.vb-zh { color: #8a7a9a; font-size: 18rpx; }

/* ===== 结果视图（提交后） ===== */
.result-view {
  flex: 1; display: flex; flex-direction: column; min-height: 0;
  background: #f7f0ef;
}

.rv-list { flex: 1; min-height: 0; height: 1rpx; padding: 16rpx 20rpx 0; }

.rv-card {
  background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx;
  margin-bottom: 14rpx; box-shadow: 0 2rpx 12rpx rgba(84,110,122,0.04);
  border-left: 4rpx solid transparent;
}
.rv-card.correct { border-left-color: #81c784; }
.rv-card.wrong { border-left-color: #e57373; }

.rvc-hd { display: flex; align-items: center; gap: 10rpx; margin-bottom: 8rpx; }
.rvc-num {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; font-weight: 700; color: #fff; flex-shrink: 0;
}
.rvc-num.ok { background: #81c784; }
.rvc-num.bad { background: #e57373; }
.rvc-label { font-size: 24rpx; font-weight: 700; color: #2d2d4e; }
.rvc-locate {
  font-size: 18rpx; color: #388e3c; margin-left: auto; flex-shrink: 0;
  padding: 2rpx 12rpx; border-radius: 6rpx; background: rgba(56,142,60,0.08);
  border: 1rpx solid rgba(56,142,60,0.15);
}
.rvc-stem { font-size: 26rpx; color: #2d2d4e; line-height: 1.6; display: block; margin-bottom: 12rpx; }

.rvc-opts { display: flex; flex-direction: column; gap: 6rpx; margin-bottom: 8rpx; }
.rvc-opt {
  font-size: 24rpx; color: #4a4a6a; line-height: 1.5;
  padding: 12rpx 18rpx; border-radius: 10rpx;
  background: #faf7f6; border: 1rpx solid #ece4e2;
}
.rvc-opt.ans {
  color: #2e7d32; font-weight: 600;
  border-color: #81c784; background: rgba(129,199,132,0.08);
}
.rvc-opt.wrong {
  color: #c62828; text-decoration: line-through;
  border-color: #e57373; background: rgba(229,115,115,0.06);
}

.rvc-ans { display: flex; align-items: center; gap: 8rpx; margin-bottom: 6rpx; }
.rvc-ans-label { font-size: 22rpx; color: #8a7a9a; }
.rvc-ans-val { font-size: 24rpx; font-weight: 600; }
.rvc-ans-val.ok { color: #388e3c; }
.rvc-ans-val.wrong { color: #e57373; text-decoration: line-through; }

.rvc-hint {
  font-size: 22rpx; color: #6a7a8a; line-height: 1.6;
  margin-top: 8rpx; padding: 12rpx 16rpx; border-radius: 10rpx;
  background: rgba(0,0,0,0.03);
}
.rv-header {
  padding: 28rpx 32rpx 20rpx; text-align: center; flex-shrink: 0;
  border-bottom: 1rpx solid #f0e8e8;
}
.rv-title { font-size: 26rpx; font-weight: 700; color: #2d2d4e; }
.rv-score-wrap { margin-top: 12rpx; }
.rv-score {
  display: inline-block; font-size: 44rpx; font-weight: 800;
  padding: 10rpx 32rpx; border-radius: 18rpx;
  color: #546e7a; background: rgba(84,110,122,0.08);
}
.rv-score.perfect { color: #388e3c; background: rgba(129,199,132,0.12); }
.rv-score.good { color: #1e88e5; background: rgba(30,136,229,0.08); }
.rv-score.low { color: #e53935; background: rgba(229,57,53,0.08); }

.rv-list { flex: 1; min-height: 0; height: 1rpx; padding: 8rpx 24rpx 0; }
.rv-item { padding: 16rpx 0; border-bottom: 1rpx solid #ecdcdc; }
.rv-item:last-child { border-bottom: none; }
.rvi-hd { display: flex; align-items: center; gap: 8rpx; }
.rvi-label { font-size: 24rpx; font-weight: 600; color: #2d2d4e; }
.rvi-icon {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; font-weight: 700; color: #fff; flex-shrink: 0;
}
.rv-item.correct .rvi-icon { background: #81c784; }
.rv-item.wrong .rvi-icon { background: #e57373; }

.rvi-locate {
  font-size: 18rpx; color: #388e3c; margin-left: auto;
  padding: 2rpx 8rpx; border-radius: 6rpx; background: rgba(56,142,60,0.08); flex-shrink: 0;
}
.rvi-bd { margin-top: 6rpx; display: flex; gap: 16rpx; }
.rvi-your { font-size: 22rpx; color: #546e7a; }
.rv-item.wrong .rvi-your { color: #e57373; text-decoration: line-through; }
.rvi-ans { font-size: 22rpx; color: #388e3c; font-weight: 600; }
.rvi-hint {
  font-size: 20rpx; color: #6a7a8a; line-height: 1.5;
  margin-top: 6rpx; padding: 8rpx 12rpx; border-radius: 8rpx;
  background: rgba(0,0,0,0.03);
}
