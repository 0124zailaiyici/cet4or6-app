<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="w-header">
    <view class="wh-bg"></view>
    <view class="wh-content">
      <text class="wh-title">写作教学</text>
    </view>
  </view>

  <view class="w-tabs">
    <view class="wt-item {{tab === 0 ? 'active' : ''}}" catchtap="onSwitchTab" data-tab="{{0}}">句型库</view>
    <view class="wt-item {{tab === 1 ? 'active' : ''}}" catchtap="onSwitchTab" data-tab="{{1}}">段落写作</view>
    <view class="wt-item {{tab === 2 ? 'active' : ''}}" catchtap="onSwitchTab" data-tab="{{2}}">全文模拟</view>
  </view>

  <!-- Tab 0: Patterns -->
  <block wx:if="{{tab === 0}}">
    <scroll-view class="w-content" scroll-y>
      <view class="wlist">
        <view class="wcard" wx:for="{{patterns}}" wx:key="id" data-id="{{item.id}}" catchtap="togglePattern">
          <view class="wc-pat">{{item.pattern}}</view>
          <text class="wc-cn">{{item.chinese}}</text>
          <view class="wc-example" wx:if="{{expandedPattern === item.id}}">
            <text class="wc-el">例句：</text>
            <text class="wc-et">{{item.example}}</text>
          </view>
        </view>
      </view>

      <view class="practice-area">
        <text class="pa-label">用上方句型写一个句子：</text>
        <textarea class="pa-input" placeholder="在此输入你的句子…" value="{{userSentence}}" bindinput="onSentenceInput" maxlength="300" auto-height></textarea>
        <view class="pa-btn" catchtap="submitSentence">提交练习</view>
      </view>

      <view class="result-box" wx:if="{{showResult}}">
        <text class="rb-text">{{result}}</text>
      </view>
    </scroll-view>
  </block>

  <!-- Tab 1: Paragraph -->
  <block wx:elif="{{tab === 1}}">
    <scroll-view class="w-content" scroll-y>
      <view class="prompt-card">
        <text class="pc-label">主题句：</text>
        <text class="pc-text">Environmental protection is everyone's responsibility.</text>
      </view>
      <view class="practice-area">
        <text class="pa-label">续写段落（60-120词）：</text>
        <textarea class="pa-input" placeholder="从此主题句开始续写…" value="{{userParagraph}}" bindinput="onParagraphInput" maxlength="800" auto-height></textarea>
        <view class="pa-btn" catchtap="submitParagraph">提交评审</view>
      </view>
      <view class="result-box" wx:if="{{showResult}}">
        <text class="rb-text">{{result}}</text>
      </view>
    </scroll-view>
  </block>

  <!-- Tab 2: Full Writing -->
  <block wx:else>
    <block wx:if="{{!currentWriting}}">
      <scroll-view class="w-content" scroll-y>
        <view class="wlist">
          <view class="wcard wc-writing" wx:for="{{writings}}" wx:key="id" data-id="{{item.id}}" catchtap="enterWriting">
            <text class="wc-wtitle">{{item.title}}</text>
            <text class="wc-wpreview">{{item.prompt.slice(0, 60)}}…</text>
          </view>
        </view>
      </scroll-view>
    </block>
    <block wx:else>
      <view class="detail-header">
        <view class="back-btn" catchtap="backToWritingList">返回</view>
        <text class="detail-title">全文写作</text>
      </view>
      <scroll-view class="w-content" scroll-y>
        <view class="prompt-card">
          <text class="pc-title">{{currentWriting.title}}</text>
          <text class="pc-text">{{currentWriting.prompt}}</text>
        </view>
        <view class="practice-area">
          <text class="pa-label">你的作文（120-180词）：</text>
          <textarea class="pa-input" placeholder="在此输入你的作文…" value="{{writingAnswer}}" bindinput="onWritingInput" maxlength="2000" auto-height></textarea>
          <view class="pa-btn" catchtap="submitWriting">提交批改</view>
        </view>
        <view class="result-box" wx:if="{{showResult}}">
          <text class="rb-text">{{result}}</text>
        </view>
      </scroll-view>
    </block>
  </block>
</view>
