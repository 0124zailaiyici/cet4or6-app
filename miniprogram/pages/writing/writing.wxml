<view class="page {{darkMode ? 'dark-theme' : ''}}" style="--fs-title:{{fsTitle}};--fs-body:{{fsBody}};--fs-opt:{{fsOpt}};--fs-btn:{{fsBtn}};--fs-sm:{{fsSm}}">

  <!-- ══ Normal Header ══ -->
  <view class="header" wx:if="{{!detailMode}}">
    <view class="header-row">
      <view class="header-l">
        <view class="header-icon">✍️</view>
        <view>
          <view class="header-t1">CET-4 写作训练</view>
          <view class="header-t2">写作教学 2.0</view>
        </view>
      </view>
      <view class="header-ai {{aiAvailable ? '' : 'hidden'}} {{aiEnabled ? '' : 'off'}}" catchtap="toggleAi">🤖</view>
    </view>
  </view>

  <!-- ══ Detail Header ══ -->
  <view class="detail-header" wx:if="{{detailMode}}">
    <view class="dh-top">
      <view class="dh-back" catchtap="backToWritingList">返回</view>
      <view class="dh-title">{{currentWriting.title}}</view>
      <view class="header-ai {{aiAvailable ? '' : 'hidden'}} {{aiEnabled ? '' : 'off'}}" catchtap="toggleAi">🤖</view>
    </view>
  </view>

  <!-- ══ Tabs ══ -->
  <view class="tabs">
    <view class="tab {{tab === 0 ? 'active' : ''}}" catchtap="onSwitchTab" data-tab="{{0}}">📖 句型急救包</view>
    <view class="tab {{tab === 1 ? 'active' : ''}}" catchtap="onSwitchTab" data-tab="{{1}}">📝 中英写作助手</view>
    <view class="tab {{tab === 2 ? 'active' : ''}}" catchtap="onSwitchTab" data-tab="{{2}}">📄 写作速查</view>
  </view>

  <!-- ═══════════════ TAB 0: 句型急救包 ═══════════════ -->
  <scroll-view class="content" scroll-y wx:if="{{tab === 0}}">
    <view class="hint">💡 三步走：选分类 → 看例句 → 选用练习</view>

    <!-- 搜索 -->
    <view class="srch-wrap">
      <input class="srch" placeholder="🔍 搜索句型（如 environment）…" value="{{toolkitSearch}}" bindinput="onToolkitSearch" />
    </view>

    <!-- 分类 -->
    <scroll-view class="cats-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="cats">
        <view class="cat {{toolkitCategory === item ? 'on' : ''}}" wx:for="{{categoryOptions}}" wx:key="item" data-cat="{{item}}" catchtap="setToolkitCategory">{{categoryEmojis[item]}} {{item}}</view>
      </view>
    </scroll-view>

    <!-- 句型列表 -->
    <view class="tkl" wx:for="{{patterns}}" wx:key="id" wx:if="{{patternVisible[index]}}">
      <view class="tki" data-id="{{item.id}}" catchtap="togglePattern">
        <view class="tki-header">
          <view>
            <view class="tki-pat">{{item.pattern}}</view>
            <view class="tki-cn">{{item.chinese}} · <text class="tki-tag">{{patternCategories[item.id] || '通用'}}</text></view>
          </view>
          <view class="tki-expand">{{expandedPattern === item.id ? '▲' : '▼'}}</view>
        </view>
        <view wx:if="{{expandedPattern === item.id}}" class="tki-example">
          <view class="ex-en">📝 {{item.example}}</view>
          <view class="ex-trans">{{item.trans}}</view>
          <view class="tki-btn" catchtap="insertPattern" data-id="{{item.id}}">✅ 选用此句型</view>
        </view>
      </view>
    </view>

    <!-- 当前选用 -->
    <view class="selected-hint" wx:if="{{selectedPattern}}">
      <text>✅ 已选用：</text>
      <text class="selected-pat">{{selectedPattern.pattern}}</text>
    </view>

    <!-- 练习区 -->
    <view class="practice">
      <view class="practice-h">
        <view class="practice-label">造句练习</view>
        <text wx:if="{{selectedPattern}}" class="practice-hint">用上面选中的句型写句子</text>
        <text wx:else class="practice-hint dim">先在列表中点「选用」选一个句型</text>
      </view>
      <view class="practice-ref" wx:if="{{selectedPattern}}">
        <view class="ref-label">📝 参考例句</view>
        <view class="ref-en">{{selectedPattern.example}}</view>
        <view class="ref-trans">{{selectedPattern.trans}}</view>
      </view>
      <view class="pi-wrap">
        <textarea class="pi" placeholder="{{selectedPattern ? '用「' + selectedPattern.pattern + '」写一个句子…' : '请先在句型列表中选用一个句型'}}" value="{{userSentence}}" bindinput="onSentenceInput" maxlength="300" auto-height disabled="{{submitting}}" bindcompositionstart="onCompStart" bindcompositionend="onCompEnd"></textarea>
        <text class="pi-wc {{sentenceWordCount > 0 ? 'on' : ''}}">{{sentenceWordCount}} 词</text>
      </view>
      <view class="btn btn-primary {{submitting ? 'disabled' : ''}}" catchtap="submitSentence">{{submitting ? '提交中…' : '提交练习'}}</view>
    </view>

    <view class="result" wx:if="{{showResult}}">
      <view class="r-h">🔍 评审结果</view>
      <text class="r-text">{{result}}</text>
    </view>
  </scroll-view>

  <!-- ═══════════════ TAB 1: 中英写作助手 ═══════════════ -->
  <scroll-view class="content" scroll-y wx:elif="{{tab === 1}}">
    <view class="hint">🎯 中文构思 → 逐句翻译 → 组装成段</view>

    <!-- Step bar -->
    <view class="steps">
      <view class="step {{guideStep > 1 ? 'done' : ''}} {{guideStep === 1 ? 'active' : ''}}" data-step="{{1}}" catchtap="setGuideStep">① 写中文</view>
      <view class="step {{guideStep > 2 ? 'done' : ''}} {{guideStep === 2 ? 'active' : ''}}" data-step="{{2}}" catchtap="setGuideStep">② 翻译</view>
      <view class="step {{guideStep > 3 ? 'done' : ''}} {{guideStep === 3 ? 'active' : ''}}" data-step="{{3}}" catchtap="setGuideStep">③ 组装</view>
      <view class="step {{guideStep > 4 ? 'done' : ''}} {{guideStep === 4 ? 'active' : ''}}" data-step="{{4}}" catchtap="setGuideStep">④ 润色</view>
    </view>

    <!-- Step 1: 写中文 -->
    <block wx:if="{{guideStep === 1}}">
      <view class="cn-step">
        <view class="cn-step-title">✍️ 用中文写 3-5 个要点</view>
        <view class="cn-step-desc">围绕"{{currentTopic.label}}"，每行写一个你想说的要点</view>
        <view class="cn-example">
          <view class="cn-example-label">💡 参考示例</view>
          <view class="cn-example-line" wx:for="{{cnExampleLines}}" wx:key="*this">{{item}}</view>
        </view>
        <textarea class="cn-input" placeholder="{{cnPlaceholder}}" value="{{cnInput}}" bindinput="onCnInput" bindcompositionstart="onCompStart" bindcompositionend="onCnCompEnd"></textarea>
      </view>
      <view class="pills">
        <view class="pill {{currentTopic.label === item.label ? 'on' : ''}}" wx:for="{{paragraphTopics}}" wx:key="label" data-index="{{index}}" catchtap="selectTopic">{{item.label}}</view>
      </view>
      <view class="btn btn-primary" catchtap="goToStep2">写好了，去翻译 →</view>
    </block>

    <!-- Step 2: 逐句翻译 -->
    <block wx:if="{{guideStep === 2}}">
      <view class="hint">💡 对每个中文要点，参考推荐词汇和句型写出英文句子</view>
      <block wx:for="{{transCards}}" wx:for-item="card" wx:key="index">
        <view class="trans-card">
          <view class="trans-num">{{card.index + 1}}</view>
          <view class="trans-cn">🀄 {{card.chinese}}</view>
          <view class="trans-kw">
            <text>🔑 推荐词汇：</text>
            <text wx:for="{{card.vocab}}" wx:for-item="kw" wx:key="*this" class="kw-tag">{{kw}}</text>
          </view>
          <view class="trans-pat">
            <text>🔗 可用句型：</text>
            <text wx:for="{{card.patterns}}" wx:for-item="pt" wx:key="*this" class="pat-tag">{{pt}}</text>
          </view>
          <textarea class="trans-en {{card.done ? 'done' : ''}}" placeholder="写英文句子……" value="{{card.english}}" bindinput="onTransEnInput" data-index="{{card.index}}" bindcompositionstart="onCompStart" bindcompositionend="onCompEnd"></textarea>
          <text wx:if="{{card.done}}" class="trans-done-label">✅ 已完成</text>
        </view>
      </block>
      <view class="btn btn-primary" catchtap="goToStep3">全部写完了，去组装 →</view>
      <view class="btn btn-secondary" data-step="{{1}}" catchtap="setGuideStep">← 回上一步</view>
    </block>

    <!-- Step 3: 组装 -->
    <block wx:if="{{guideStep === 3}}">
      <view class="hint">💡 调整句子顺序、连接词，完成段落组装</view>
      <block wx:for="{{transCards}}" wx:for-item="card" wx:key="index">
        <view class="asm-card">
          <view class="asm-card-hd">
            <view class="asm-card-num">{{index + 1}}</view>
            <view class="asm-card-actions">
              <view class="asm-btn" catchtap="moveCard" data-index="{{index}}" data-dir="{{-1}}">↑</view>
              <view class="asm-btn" catchtap="moveCard" data-index="{{index}}" data-dir="{{1}}">↓</view>
              <view class="asm-btn asm-btn-del" catchtap="removeCard" data-index="{{index}}">✕</view>
            </view>
          </view>
          <view class="asm-card-cn" wx:if="{{card.chinese}}">🀄 {{card.chinese}}</view>
          <view class="asm-card-cn asm-card-cn-dim" wx:else>🀄 新要点</view>
          <view class="asm-linkers">
            <view class="asm-linker {{card.linkerIdx === 0 ? 'on' : ''}}" catchtap="setCardLinker" data-index="{{index}}" data-linker="{{0}}">Firstly</view>
            <view class="asm-linker {{card.linkerIdx === 1 ? 'on' : ''}}" catchtap="setCardLinker" data-index="{{index}}" data-linker="{{1}}">Moreover</view>
            <view class="asm-linker {{card.linkerIdx === 2 ? 'on' : ''}}" catchtap="setCardLinker" data-index="{{index}}" data-linker="{{2}}">Furthermore</view>
            <view class="asm-linker {{card.linkerIdx === 3 ? 'on' : ''}}" catchtap="setCardLinker" data-index="{{index}}" data-linker="{{3}}">In addition</view>
            <view class="asm-linker {{card.linkerIdx === 4 ? 'on' : ''}}" catchtap="setCardLinker" data-index="{{index}}" data-linker="{{4}}">Additionally</view>
            <view class="asm-linker {{card.linkerIdx === 5 ? 'on' : ''}}" catchtap="setCardLinker" data-index="{{index}}" data-linker="{{5}}">Besides</view>
            <view class="asm-linker {{card.linkerIdx === 6 ? 'on' : ''}}" catchtap="setCardLinker" data-index="{{index}}" data-linker="{{6}}">However</view>
            <view class="asm-linker {{card.linkerIdx === 7 ? 'on' : ''}}" catchtap="setCardLinker" data-index="{{index}}" data-linker="{{7}}">Therefore</view>
            <view class="asm-linker {{card.linkerIdx === 8 ? 'on' : ''}}" catchtap="setCardLinker" data-index="{{index}}" data-linker="{{8}}">In conclusion</view>
          </view>
          <textarea class="asm-card-en" placeholder="写英文句子……" value="{{card.english}}" bindinput="onCardEnInput" data-index="{{index}}" bindcompositionstart="onCompStart" bindcompositionend="onCompEnd"></textarea>
        </view>
      </block>
      <view class="asm-add" catchtap="addCard">+ 追加一个要点</view>
      <view class="asm-preview">
        <view class="asm-preview-label">📄 段落预览</view>
        <view class="asm-preview-text" wx:if="{{assemblyInput}}">{{assemblyInput}}</view>
        <view class="asm-preview-text asm-preview-dim" wx:else>调整上方卡片，这里会实时显示完整段落…</view>
      </view>
      <view class="btn btn-primary" catchtap="goToStep4">提交检查 →</view>
      <view class="btn btn-secondary" data-step="{{2}}" catchtap="setGuideStep">← 回上一步</view>
    </block>

    <!-- Step 4: 润色 -->
    <block wx:if="{{guideStep === 4}}">
      <view class="polish-card">
        <view class="polish-score">{{polishStats.score}}<text class="polish-score-label">/100</text></view>
        <view class="polish-dims">
          <view class="dim-item"><text class="dim-num">{{polishStats.words}}</text><text class="dim-label">词数 目标120-180</text></view>
          <view class="dim-item"><text class="dim-num">{{polishStats.sentences}}</text><text class="dim-label">句子数</text></view>
          <view class="dim-item"><text class="dim-num">{{polishStats.patterns}}</text><text class="dim-label">句型数</text></view>
        </view>
        <view class="polish-divider"></view>
        <view wx:for="{{polishItems}}" wx:key="index" class="polish-item">
          <text class="{{item.ok ? 'polish-ok' : 'polish-warn'}}">{{item.ok ? '✅' : '💡'}}</text>
          <text>{{item.text}}</text>
        </view>
      </view>
      <view class="polish-text" wx:if="{{assemblyInput}}">
        <view class="polish-text-label">📄 你的段落</view>
        <view class="polish-text-body">{{assemblyInput}}</view>
      </view>
      <view class="btn btn-secondary" data-step="{{3}}" catchtap="setGuideStep">← 回编辑修改</view>
      <view class="btn btn-primary" style="margin-top:16rpx" catchtap="resetAll">🔄 重新写一篇</view>
    </block>
  </scroll-view>

  <!-- ═══════════════ TAB 2: 写作速查 ═══════════════ -->
  <scroll-view class="content" scroll-y wx:elif="{{tab === 2 && !currentWriting}}">
    <view class="hint">📝 选一道题，参考关键词提示进行写作</view>
    <view class="wl">
      <view class="wi" wx:for="{{writings}}" wx:for-index="index" wx:key="id" data-id="{{item.id}}" catchtap="enterWriting">
        <view class="wi-icon">📄</view>
        <view class="wi-body">
          <view class="wi-title">{{item.title}}</view>
          <view class="wi-meta">120–180 词 · 四级{{examTypeLabels[index]}}</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- Detail -->
  <scroll-view class="content" scroll-y wx:elif="{{tab === 2 && currentWriting}}">

    <!-- 题目 -->
    <view class="prompt-card">
      <view class="prompt-icon">📋 题目</view>
      <view class="prompt-text">{{currentWriting.prompt}}</view>
    </view>

    <!-- 关键词 + 句型提示条 -->
    <view class="ref-strip">
      <view class="ref-strip-group">
        <text class="ref-strip-label">🔑 词汇：</text>
        <text wx:for="{{writingKeywords}}" wx:for-item="kw" wx:key="*this" class="kw-tag">{{kw}}</text>
      </view>
      <view class="ref-strip-divider"></view>
      <view class="ref-strip-group">
        <text class="ref-strip-label">🔗 句型：</text>
        <text wx:for="{{writingPatternTags}}" wx:for-item="pt" wx:key="*this" class="pat-tag">{{pt}}</text>
      </view>
    </view>

    <!-- 写作区 -->
    <view class="writing-area">
      <view class="wa-header">
        <text class="wa-label">✍️ 你的作文</text>
        <text class="wa-hint">120–180 词</text>
      </view>
      <textarea class="wa-input" placeholder="直接在这里写你的作文……" value="{{writingAnswer}}" bindinput="onWritingInput" auto-height bindcompositionstart="onCompStart" bindcompositionend="onCompEnd"></textarea>

      <view class="wc-info">
        <text>词数</text>
        <view class="wc-bar-track"><view class="wc-bar-fill {{writingWordCount > 0 && writingWordCount < 120 ? 'under' : ''}} {{writingWordCount > 180 ? 'over' : ''}}" style="width: {{writingWordCount > 180 ? 100 : (writingWordCount / 180 * 100)}}%"></view></view>
        <text><text class="wc-num {{writingWordCount > 0 && writingWordCount < 120 ? 'under' : ''}} {{writingWordCount > 180 ? 'over' : ''}}">{{writingWordCount}}</text> / 180</text>
      </view>

      <view class="action-row">
        <view class="btn btn-primary {{submitting ? 'disabled' : ''}}" style="flex:1" catchtap="submitWriting">{{submitting ? '提交中…' : '📤 交卷评分'}}</view>
        <view class="btn-outline" catchtap="backToWritingList">← 返回</view>
      </view>
    </view>

    <view class="result" wx:if="{{showResult}}">
      <view class="r-h">📊 批改结果</view>
      <text class="r-text">{{result}}</text>
    </view>
  </scroll-view>


<!-- 字号调节 -->
<view class="fs-ctrl {{fsOpen ? 'fs-show' : ''}}">
  <view class="fs-btn-box" catchtap="toggleFs">
    <text class="fs-btn-icon">Aa</text>
  </view>
  <view class="fs-panel" wx:if="{{fsOpen}}">
    <view class="fs-row">
      <text class="fs-row-label">标题</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="title" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsTitle}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="title" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">正文</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="body" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsBody}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="body" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">选项</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="opt" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsOpt}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="opt" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">按钮</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="btn" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsBtn}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="btn" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">辅助</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="sm" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsSm}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="sm" data-d="2">+</text>
      </view>
    </view>
  </view>
</view>
</view>
