.page { min-height: 100vh; background: #fff; }

/* ══ Header ══ */
.header {
  background: linear-gradient(135deg, #d4a0dc 0%, #9c27b0 100%);
  padding: 88rpx 40rpx 36rpx; position: relative;
}
.header-row { display: flex; align-items: center; justify-content: space-between; }
.header-l { display: flex; align-items: center; gap: 20rpx; }
.header-icon {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  background: rgba(255,255,255,0.18); display: flex;
  align-items: center; justify-content: center; font-size: 36rpx;
}
.header-t1 { font-size: 22rpx; color: rgba(255,255,255,0.55); font-weight: 500; }
.header-t2 { font-size: 38rpx; font-weight: 700; color: #fff; margin-top: 2rpx; }
.header-ai {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  background: rgba(255,255,255,0.15); display: flex;
  align-items: center; justify-content: center; font-size: 34rpx;
}
.header-ai.hidden { display: none; }
.header-ai.off { opacity: 0.35; }

/* ══ Detail Header ══ */
.detail-header {
  background: linear-gradient(135deg, #d4a0dc 0%, #9c27b0 100%);
  padding: 88rpx 40rpx 28rpx;
}
.dh-top { display: flex; align-items: center; gap: 16rpx; }
.dh-back {
  padding: 12rpx 28rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.15);
  font-size: 26rpx; font-weight: 500; color: #fff; flex-shrink: 0;
}
.dh-title {
  font-size: 30rpx; font-weight: 600; color: #fff; flex: 1;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ══ Tabs ══ */
.tabs {
  display: flex; gap: 6rpx; margin: 24rpx 32rpx 0;
  background: #f5f0f8; border-radius: 20rpx; padding: 6rpx;
}
.tab {
  flex: 1; text-align: center; padding: 16rpx 0; font-size: 24rpx;
  color: #a090b0; border-radius: 16rpx; font-weight: 500;
}
.tab.active { background: #fff; color: #9c27b0; font-weight: 700; }

/* ══ Content ══ */
.content { padding: 32rpx 32rpx 64rpx; }
.hint { font-size: 24rpx; color: #b09bc0; margin-bottom: 24rpx; }
.hint.dim { color: #ddd0e0; }

/* ══ Selected hint ══ */
.selected-hint {
  display: flex; align-items: center; gap: 6rpx;
  padding: 12rpx 16rpx; background: rgba(156,39,176,0.04);
  border-radius: 12rpx; font-size: 22rpx; color: #504060; margin: 12rpx 0;
}
.selected-pat { color: #9c27b0; font-weight: 600; font-family: monospace; }

/* ══ Search ══ */
.srch-wrap { margin-bottom: 16rpx; }
.srch {
  width: 100%; padding: 20rpx 24rpx; border-radius: 16rpx;
  border: 3rpx solid #ede4f0; font-size: 26rpx; outline: none;
}
.srch:focus { border-color: #d4a0dc; }

/* ══ Categories scroll ══ */
.cats-scroll { margin-bottom: 20rpx; overflow: hidden; }
.cats { display: flex; gap: 10rpx; white-space: nowrap; }
.cat {
  padding: 10rpx 24rpx; border-radius: 20rpx; font-size: 22rpx;
  background: #f5f0f8; color: #b09bc0; flex-shrink: 0;
}
.cat.on { background: rgba(156,39,176,0.08); color: #9c27b0; font-weight: 600; }

/* ══ Toolkit List ══ */
.tkl { display: flex; flex-direction: column; gap: 8rpx; }
.tki {
  padding: 16rpx 20rpx; background: #faf5fc; border-radius: 14rpx;
}
.tki-header {
  display: flex; justify-content: space-between; align-items: center;
}
.tki-pat { font-size: 26rpx; font-weight: 600; color: #9c27b0; font-family: monospace; }
.tki-cn { font-size: 20rpx; color: #b09bc0; margin-top: 4rpx; }
.tki-tag {
  display: inline-block; font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 6rpx;
  background: rgba(156,39,176,0.05); color: #9c27b0;
}
.tki-expand { font-size: 22rpx; color: #c0b0cc; flex-shrink: 0; }
.tki-example {
  margin-top: 12rpx; padding: 14rpx 16rpx; background: #fff;
  border-radius: 10rpx; border-left: 4rpx solid #d4a0dc;
  font-size: 24rpx; line-height: 1.7; color: #504060;
}
.tki-example .ex-en { color: #3a2a4a; font-weight: 500; }
.tki-example .ex-trans { color: #b09bc0; margin-top: 6rpx; font-size: 22rpx; }
.tki-btn {
  display: inline-block; margin-top: 10rpx; padding: 8rpx 24rpx; border-radius: 14rpx;
  background: rgba(156,39,176,0.08); color: #9c27b0; font-size: 22rpx;
}

/* ══ Recent ══ */
.recent { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 16rpx; }
.rec {
  padding: 8rpx 18rpx; border-radius: 14rpx; font-size: 22rpx;
  background: rgba(156,39,176,0.06); color: #9c27b0;
}

/* ══ Practice / Ref ══ */
.practice { margin: 28rpx 0; }
.practice-h {
  display: flex; justify-content: space-between; align-items: baseline;
  margin-bottom: 16rpx;
}
.practice-label { font-size: 26rpx; font-weight: 600; color: #504060; }
.practice-hint { font-size: 22rpx; color: #c0b0cc; }
.practice-hint.dim { color: #ddd0e0; }
.practice-ref {
  padding: 14rpx 16rpx; background: rgba(156,39,176,0.04); border-radius: 10rpx;
  border: 3rpx dashed #d4a0dc; margin-bottom: 16rpx; font-size: 24rpx; color: #504060; line-height: 1.7;
}
.practice-ref .ref-label { font-size: 22rpx; color: #9c27b0; font-weight: 600; margin-bottom: 6rpx; }
.practice-ref .ref-en { color: #3a2a4a; font-weight: 500; }
.practice-ref .ref-trans { color: #b09bc0; margin-top: 4rpx; font-size: 22rpx; }

/* ══ Textarea Base ══ */
.pi-wrap { position: relative; margin-bottom: 20rpx; }
.pi {
  width: 100%; min-height: 144rpx; padding: 20rpx 24rpx 48rpx; border-radius: 20rpx;
  border: 3rpx solid #ede4f0; font-size: 28rpx; line-height: 1.6; color: #3a2a4a;
  resize: none; outline: none; font-family: inherit; box-sizing: border-box;
}
.pi:focus { border-color: #ce93d8; }
.pi::placeholder { color: #d0c0d8; }
.pi-wc {
  position: absolute; right: 20rpx; bottom: 12rpx; font-size: 20rpx; color: #c0b0cc;
}
.pi-wc.on { color: #9c27b0; }

/* ══ Button ══ */
.btn {
  display: flex; width: 100%; height: 80rpx; border-radius: 40rpx;
  font-size: 26rpx; font-weight: 600; align-items: center; justify-content: center;
}
.btn-primary { background: linear-gradient(135deg, #d4a0dc, #9c27b0); color: #fff; }
.btn-primary.disabled { opacity: 0.4; }
.btn-secondary {
  background: rgba(156,39,176,0.06); color: #9c27b0; margin-top: 12rpx;
}

/* ══ Result ══ */
.result {
  background: #fff; border-radius: 28rpx; padding: 32rpx 36rpx;
  box-shadow: 0 2rpx 24rpx rgba(156,39,176,0.03); margin-top: 28rpx;
}
.r-h { font-size: 24rpx; font-weight: 600; color: #504060; margin-bottom: 20rpx; }
.r-text { font-size: 24rpx; color: #504060; line-height: 1.8; white-space: pre-wrap; display: block; }

/* ══ Steps ══ */
.steps { display: flex; gap: 6rpx; margin-bottom: 20rpx; }
.step {
  flex: 1; text-align: center; padding: 12rpx 0; border-radius: 14rpx;
  font-size: 22rpx; color: #c0b0cc; background: #f9f5fc;
}
.step.done { background: rgba(156,39,176,0.08); color: #9c27b0; font-weight: 600; }
.step.active { background: #9c27b0; color: #fff; font-weight: 600; }

/* ══ Step 1: 写中文 ══ */
.cn-step {
  background: #faf5fc; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 16rpx;
}
.cn-step-title { font-size: 28rpx; font-weight: 600; color: #3a2a4a; margin-bottom: 6rpx; }
.cn-step-desc { font-size: 24rpx; color: #b09bc0; margin-bottom: 16rpx; line-height: 1.6; }
.cn-input {
  width: 100%; min-height: 400rpx; padding: 24rpx 28rpx; border-radius: 16rpx;
  border: 3rpx solid #ede4f0; font-size: 28rpx; line-height: 1.8; color: #3a2a4a;
  resize: none; outline: none; font-family: inherit; box-sizing: border-box;
}
.cn-input:focus { border-color: #d4a0dc; }
.cn-input::placeholder { color: #d0c0d8; }
.cn-example {
  padding: 16rpx 28rpx; margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: rgba(156,39,176,0.03);
  border: 3rpx dashed #e0d0e8;
  box-sizing: border-box;
}
.cn-example-label { font-size: 22rpx; color: #9c27b0; font-weight: 500; margin-bottom: 6rpx; }
.cn-example-line { font-size: 24rpx; color: #b09bc0; line-height: 1.8; }

/* ══ Step 2: 逐句翻译 ══ */
.trans-card {
  background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx;
  border: 3rpx solid #ede4f0; margin-bottom: 16rpx;
}
.trans-num {
  display: inline-block; width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(156,39,176,0.08); color: #9c27b0;
  font-size: 22rpx; font-weight: 700; text-align: center; line-height: 36rpx;
  margin-bottom: 8rpx;
}
.trans-cn { font-size: 26rpx; color: #3a2a4a; font-weight: 600; margin-bottom: 8rpx; }
.trans-kw { font-size: 22rpx; color: #b09bc0; margin-bottom: 8rpx; display: flex; flex-wrap: wrap; gap: 6rpx; align-items: center; }
.trans-pat { font-size: 22rpx; color: #b09bc0; margin-bottom: 12rpx; display: flex; flex-wrap: wrap; gap: 6rpx; align-items: center; }
.trans-en {
  width: 100%; min-height: 80rpx; padding: 16rpx 20rpx; border-radius: 12rpx;
  border: 3rpx solid #ede4f0; font-size: 26rpx; line-height: 1.5;
  resize: none; outline: none; font-family: inherit; color: #3a2a4a;
}
.trans-en:focus { border-color: #ce93d8; }
.trans-en::placeholder { color: #d0c0d8; }
.trans-en.done { border-color: #c8e6c9; background: rgba(76,175,80,0.02); }
.trans-done-label { font-size: 20rpx; color: #43a047; margin-top: 8rpx; }

/* ══ Tags ══ */
.kw-tag {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 6rpx;
  background: rgba(76,175,80,0.06); color: #388e3c; font-size: 20rpx;
}
.pat-tag {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 6rpx;
  background: rgba(156,39,176,0.05); color: #9c27b0; font-size: 20rpx; font-family: monospace;
}

/* ══ Step 3: 卡片式组装 ══ */
.asm-card {
  background: #fff; border-radius: 16rpx; padding: 18rpx 22rpx;
  border: 3rpx solid #ede4f0; margin-bottom: 12rpx;
}
.asm-card-hd {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 8rpx;
}
.asm-card-num {
  width: 32rpx; height: 32rpx; border-radius: 50%;
  background: rgba(156,39,176,0.06); color: #9c27b0;
  font-size: 20rpx; font-weight: 700; text-align: center; line-height: 32rpx;
}
.asm-card-actions { display: flex; gap: 4rpx; }
.asm-btn {
  width: 36rpx; height: 36rpx; border-radius: 8rpx; font-size: 20rpx;
  background: rgba(156,39,176,0.04); color: #b09bc0; text-align: center; line-height: 36rpx;
}
.asm-btn:active { background: rgba(156,39,176,0.1); }
.asm-btn-del { color: #e57373; }
.asm-card-cn { font-size: 24rpx; color: #3a2a4a; margin-bottom: 8rpx; }
.asm-card-cn-dim { color: #c0b0cc; }
.asm-linkers {
  display: flex; flex-wrap: wrap; gap: 6rpx; margin-bottom: 8rpx;
}
.asm-linker {
  padding: 4rpx 14rpx; border-radius: 6rpx; font-size: 20rpx;
  background: rgba(156,39,176,0.03); color: #b09bc0;
  border: 2rpx solid transparent;
}
.asm-linker.on { background: rgba(156,39,176,0.08); color: #9c27b0; border-color: #ce93d8; }
.asm-card-en {
  width: 100%; min-height: 72rpx; padding: 12rpx 16rpx; border-radius: 10rpx;
  border: 3rpx solid #ede4f0; font-size: 26rpx; line-height: 1.5;
  resize: none; outline: none; font-family: inherit; color: #3a2a4a; box-sizing: border-box;
}
.asm-card-en:focus { border-color: #ce93d8; }
.asm-card-en::placeholder { color: #d0c0d8; }
.asm-add {
  display: flex; align-items: center; gap: 6rpx; padding: 14rpx 22rpx;
  border: 3rpx dashed #ede4f0; border-radius: 14rpx; margin-bottom: 16rpx;
  font-size: 24rpx; color: #c0b0cc; justify-content: center;
}
.asm-add:active { background: rgba(156,39,176,0.02); border-color: #d4a0dc; color: #9c27b0; }
.asm-preview {
  background: #f9f5fc; border-radius: 14rpx; padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
}
.asm-preview-label { font-size: 22rpx; color: #9c27b0; font-weight: 500; margin-bottom: 10rpx; }
.asm-preview-text { font-size: 24rpx; line-height: 1.8; color: #504060; white-space: pre-wrap; }
.asm-preview-dim { color: #c0b0cc; font-style: italic; }

/* ══ Step 4: 润色 ══ */
.polish-card {
  background: #fff; border-radius: 20rpx; padding: 28rpx 28rpx 16rpx;
  border: 3rpx solid #ede4f0; margin-bottom: 16rpx;
}
.polish-score { text-align: center; font-size: 56rpx; font-weight: 800; color: #9c27b0; line-height: 1; }
.polish-score-label { font-size: 24rpx; font-weight: 400; color: #c0b0cc; }
.polish-dims { display: flex; gap: 24rpx; justify-content: center; margin: 20rpx 0 16rpx; flex-wrap: wrap; }
.dim-item { text-align: center; }
.dim-num { font-size: 32rpx; font-weight: 700; color: #504060; display: block; }
.dim-label { font-size: 20rpx; color: #b09bc0; margin-top: 4rpx; }
.polish-divider { height: 2rpx; background: #f0e4f8; margin: 8rpx 0; }
.polish-item {
  padding: 14rpx 0; border-bottom: 2rpx solid #f0e4f8; font-size: 24rpx; color: #504060;
  display: flex; gap: 8rpx; align-items: flex-start;
}
.polish-item:last-child { border-bottom: none; }
.polish-ok { color: #43a047; }
.polish-warn { color: #e65100; }
.polish-text {
  background: #f9f5fc; border-radius: 14rpx; padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
}
.polish-text-label { font-size: 22rpx; color: #9c27b0; font-weight: 500; margin-bottom: 8rpx; }
.polish-text-body { font-size: 24rpx; line-height: 1.8; color: #504060; white-space: pre-wrap; }

/* ══ Pills / Topic Select ══ */
.pills { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.pill {
  padding: 10rpx 28rpx; border-radius: 28rpx; font-size: 24rpx;
  background: #f5f0f8; color: #b09bc0;
}
.pill.on { background: rgba(156,39,176,0.08); color: #9c27b0; font-weight: 600; }

/* ══ Tab 2: Prompt Card ══ */
.prompt-card {
  background: linear-gradient(135deg, #faf5fc 0%, #f5f0f8 100%);
  border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 16rpx;
  border-left: 6rpx solid #d4a0dc;
}
.prompt-icon { font-size: 22rpx; color: #9c27b0; font-weight: 600; margin-bottom: 8rpx; }
.prompt-text { font-size: 26rpx; line-height: 1.7; color: #3a2a4a; }

/* ══ Tab 2: Ref Strip ══ */
.ref-strip {
  display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 16rpx;
  padding: 16rpx 20rpx; background: #fff; border-radius: 14rpx;
  border: 3rpx solid #ede4f0;
}
.ref-strip-group {
  display: flex; flex-wrap: wrap; gap: 6rpx; align-items: center;
}
.ref-strip-label { font-size: 22rpx; color: #b09bc0; margin-right: 6rpx; }
.ref-strip-divider { width: 100%; height: 0; margin: 6rpx 0; }

/* ══ Tab 2: Writing Area ══ */
.writing-area { margin-top: 0; }
.wa-header {
  display: flex; justify-content: space-between; align-items: baseline;
  margin-bottom: 12rpx;
}
.wa-label { font-size: 26rpx; font-weight: 600; color: #504060; }
.wa-hint { font-size: 22rpx; color: #b09bc0; }
.wa-input {
  width: 100%; min-height: 360rpx; padding: 24rpx 28rpx;
  border-radius: 20rpx; border: 3rpx solid #ede4f0;
  font-size: 28rpx; line-height: 1.8; color: #3a2a4a;
  resize: none; outline: none; font-family: inherit;
}
.wa-input:focus { border-color: #ce93d8; }
.wa-input::placeholder { color: #d0c0d8; }

/* ══ Tab 2: WC Info ══ */
.wc-info {
  display: flex; align-items: center; gap: 12rpx;
  margin: 12rpx 0 16rpx; font-size: 22rpx; color: #b09bc0;
}
.wc-num { color: #9c27b0; font-weight: 700; font-size: 30rpx; }
.wc-num.under { color: #ef6c00; }
.wc-num.over { color: #f44336; }
.wc-bar-track {
  flex: 1; height: 6rpx; border-radius: 3rpx; background: #f0e4f8; overflow: hidden;
}
.wc-bar-fill {
  height: 100%; border-radius: 3rpx;
  background: linear-gradient(90deg,#d4a0dc,#9c27b0);
  width: 0%;
}
.wc-bar-fill.under { background: linear-gradient(90deg,#ffcc80,#ef6c00); }
.wc-bar-fill.over { background: linear-gradient(90deg,#ef9a9a,#f44336); }

/* ══ Tab 2: Action Row ══ */
.action-row {
  display: flex; gap: 12rpx;
}
.action-row .btn { margin-top: 0; }
.btn-outline {
  flex: 0 0 auto; height: 80rpx; padding: 0 28rpx; border-radius: 40rpx;
  font-size: 24rpx; font-weight: 500; display: flex; align-items: center; justify-content: center;
  background: rgba(156,39,176,0.05); color: #9c27b0; border: none;
}

/* ══ Writing List ══ */
.wl { display: flex; flex-direction: column; gap: 16rpx; }
.wi {
  display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx;
  background: #fff; border-radius: 24rpx;
  border-left: 6rpx solid #d4a0dc;
  box-shadow: 0 2rpx 8rpx rgba(156,39,176,0.03);
}
.wi-icon {
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  background: rgba(156,39,176,0.05); display: flex;
  align-items: center; justify-content: center; font-size: 28rpx; flex-shrink: 0;
}
.wi-body { flex: 1; min-width: 0; }
.wi-title { font-size: 26rpx; font-weight: 600; color: #504060; }
.wi-meta { font-size: 20rpx; color: #c0b0cc; margin-top: 4rpx; }

/* ══ Dark Theme ══ */
.dark-theme.page { background: #12121f !important; }
.dark-theme .header, .dark-theme .detail-header { background: linear-gradient(135deg, #3a2050, #2a1040) !important; }
.dark-theme .header-t1 { color: rgba(255,255,255,0.45) !important; }
.dark-theme .tabs { background: #2a2a4a !important; }
.dark-theme .tab { color: #a090b0 !important; }
.dark-theme .tab.active { background: #1e1e38 !important; color: #ce93d8 !important; }
.dark-theme .cn-step { background: #1e1e38 !important; }
.dark-theme .cn-step-title { color: #e0d0e8 !important; }
.dark-theme .cn-input { background: #2a2a4a !important; color: #e0d0e8 !important; border-color: #3a3a5a !important; }
.dark-theme .cn-input:focus { border-color: #ce93d8 !important; }
.dark-theme .cn-example { background: rgba(206,147,216,0.03) !important; border-color: #3a3a5a !important; }
.dark-theme .cn-example-line { color: #8a7a9a !important; }
.dark-theme .trans-card { background: #1e1e38 !important; border-color: #3a3a5a !important; }
.dark-theme .trans-cn { color: #e0d0e8 !important; }
.dark-theme .trans-en { background: #2a2a4a !important; color: #e0d0e8 !important; border-color: #3a3a5a !important; }
.dark-theme .trans-en:focus { border-color: #ce93d8 !important; }
.dark-theme .asm-card { background: #1e1e38 !important; border-color: #3a3a5a !important; }
.dark-theme .asm-card-cn { color: #e0d0e8 !important; }
.dark-theme .asm-card-en { background: #2a2a4a !important; color: #e0d0e8 !important; border-color: #3a3a5a !important; }
.dark-theme .asm-card-en:focus { border-color: #ce93d8 !important; }
.dark-theme .asm-linker { background: rgba(206,147,216,0.04) !important; color: #6a5a7a !important; }
.dark-theme .asm-linker.on { background: rgba(206,147,216,0.1) !important; color: #ce93d8 !important; border-color: #ce93d8 !important; }
.dark-theme .asm-add { border-color: #3a3a5a !important; color: #6a5a7a !important; }
.dark-theme .asm-preview { background: #1a1a2e !important; }
.dark-theme .asm-preview-text { color: #d0c0d8 !important; }
.dark-theme .polish-card { background: #1e1e38 !important; border-color: #3a3a5a !important; }
.dark-theme .polish-item { border-bottom-color: #3a3a5a !important; }
