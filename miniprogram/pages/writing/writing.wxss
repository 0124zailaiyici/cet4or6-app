.page {
  min-height: 100vh;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.page-header {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2d2d4e;
}

.tab-bar {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  background: #fff0f3;
  border-radius: 20rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #8a7a9a;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #ffffff;
  color: #ff9eb5;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(255, 158, 181, 0.15);
}

.content-scroll {
  flex: 1;
}

.pattern-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.pattern-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 158, 181, 0.08);
}

.pattern-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pattern-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff9eb5;
  font-family: monospace;
}

.pattern-arrow {
  font-size: 22rpx;
  color: #8a7a9a;
}

.pattern-chinese {
  display: block;
  font-size: 24rpx;
  color: #8a7a9a;
  margin-top: 8rpx;
}

.pattern-example {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fff5f7;
}

.example-label {
  font-size: 24rpx;
  color: #8a7a9a;
  display: block;
  margin-bottom: 6rpx;
}

.example-text {
  font-size: 26rpx;
  color: #2d2d4e;
  line-height: 1.7;
}

.practice-block {
  margin-bottom: 24rpx;
}

.practice-label {
  display: block;
  font-size: 26rpx;
  color: #8a7a9a;
  margin-bottom: 12rpx;
}

.practice-input {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #ffd9e0;
  color: #2d2d4e;
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #ff9eb5, #ff8a80);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 158, 181, 0.3);
}

.result-block {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 158, 181, 0.08);
  margin-bottom: 32rpx;
}

.result-text {
  font-size: 26rpx;
  color: #2d2d4e;
  line-height: 1.8;
  white-space: pre-wrap;
}

.paragraph-prompt {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 158, 181, 0.08);
  margin-bottom: 24rpx;
}

.prompt-label {
  font-size: 24rpx;
  color: #8a7a9a;
  display: block;
  margin-bottom: 8rpx;
}

.prompt-text {
  font-size: 30rpx;
  color: #2d2d4e;
  line-height: 1.7;
  font-style: italic;
}

.writing-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.writing-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 158, 181, 0.08);
}

.writing-card:active {
  transform: scale(0.98);
}

.writing-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2d2d4e;
  margin-bottom: 8rpx;
}

.writing-prompt-preview {
  font-size: 24rpx;
  color: #8a7a9a;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.back-btn {
  width: 100rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f3;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #8a7a9a;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d2d4e;
}

.writing-prompt-block {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 158, 181, 0.08);
  margin-bottom: 24rpx;
}

.writing-title-lg {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2d2d4e;
  margin-bottom: 12rpx;
}

.writing-prompt {
  font-size: 26rpx;
  color: #6a6a8a;
  line-height: 1.7;
}
