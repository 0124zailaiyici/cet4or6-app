<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="topbar">
    <view class="h1">学习提醒</view>
    <text class="tag">📱 订阅消息</text>
  </view>

  <view class="card">
    <view class="row">
      <view class="r-left"><text class="icon">🌅</text><text class="label">晨间听力</text></view>
      <view class="sub {{morningSub ? 'on' : ''}}" catchtap="toggleMorning">{{morningSub ? '✓ 已订阅' : '订阅'}}</view>
    </view>
    <view class="times">
      <view class="t {{morningTime === t ? 'on' : ''}}" wx:for="{{morningTimes}}" wx:key="*this" data-time="{{item}}" catchtap="setMorningTime">{{item}}</view>
    </view>
    <text class="hint">每天 {{morningTime}} 推送听力练习提醒</text>
  </view>

  <view class="card">
    <view class="row">
      <view class="r-left"><text class="icon">🌙</text><text class="label">晚间复习</text></view>
      <view class="sub {{eveningSub ? 'on' : ''}}" catchtap="toggleEvening">{{eveningSub ? '✓ 已订阅' : '订阅'}}</view>
    </view>
    <view class="times">
      <view class="t {{eveningTime === t ? 'on' : ''}}" wx:for="{{eveningTimes}}" wx:key="*this" data-time="{{item}}" catchtap="setEveningTime">{{item}}</view>
    </view>
    <text class="hint">每天 {{eveningTime}} 推送复习提醒</text>
  </view>

  <view class="card">
    <view class="row">
      <view class="r-left"><text class="icon">📊</text><text class="label">学习周报</text></view>
      <view class="sub {{weeklySub ? 'on' : ''}}" catchtap="toggleWeekly">{{weeklySub ? '✓ 已订阅' : '订阅'}}</view>
    </view>
    <text class="hint">每周日晚 21:00 推送本周学习总结</text>
  </view>

  <view class="tip">
    <text class="tip-t">💡 提醒将通过微信服务通知推送，请确保已开启通知权限</text>
  </view>

<!-- 字号调节 -->
<view class="fs-ctrl {{fsOpen ? 'fs-show' : ''}}">
  <view class="fs-btn-box" catchtap="toggleFs">
    <text class="fs-btn-icon">Aa</text>
  </view>
  <view class="fs-panel" wx:if="{{fsOpen}}">
    <view class="fs-row">
      <text class="fs-row-label">标题</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="title" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsTitle}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="title" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">正文</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="body" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsBody}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="body" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">选项</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="opt" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsOpt}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="opt" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">按钮</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="btn" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsBtn}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="btn" data-d="2">+</text>
      </view>
    </view>
    <view class="fs-row">
      <text class="fs-row-label">辅助</text>
      <view class="fs-row-ctrl">
        <text class="fs-btn-sub" catchtap="changeFs" data-cat="sm" data-d="-2">−</text>
        <text class="fs-btn-val">{{fsSm}}</text>
        <text class="fs-btn-add" catchtap="changeFs" data-cat="sm" data-d="2">+</text>
      </view>
    </view>
  </view>
</view>
</view>
