.page { min-height: 100vh; background: #f3eeed; }
.topbar {
  display: flex; align-items: center; gap: 10px;
  padding: 48rpx 24rpx 14rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #ffb3c6, #ff8fab); color: #fff;
}
.topbar h1 { flex: 1; font-size: 34rpx; font-weight: 800; }
.topbar .tag { font-size: 22rpx; background: rgba(255,255,255,0.2); padding: 4rpx 16rpx; border-radius: 12rpx; }

.card { background: #fff; margin: 12rpx 20rpx; border-radius: 18rpx; padding: 20rpx; box-shadow: 0 2rpx 12rpx rgba(255,158,181,0.04); }
.row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.r-left { display: flex; align-items: center; gap: 10rpx; }
.icon { font-size: 36rpx; }
.label { font-size: 28rpx; font-weight: 600; color: #2d2d4e; }
.sub { font-size: 22rpx; color: #ff6b8a; font-weight: 600; padding: 6rpx 16rpx; border-radius: 12rpx; border: 2rpx solid rgba(255,107,138,0.2); }
.sub.on { background: rgba(255,107,138,0.06); }
.times { display: flex; gap: 10rpx; padding-left: 46rpx; margin-bottom: 8rpx; }
.t { font-size: 22rpx; color: #8a7a9a; background: #fff0f3; padding: 6rpx 18rpx; border-radius: 10rpx; }
.t.on { color: #fff; background: #ff6b8a; font-weight: 600; }
.hint { font-size: 22rpx; color: #8a7a9a; padding-left: 46rpx; }

.tip { margin: 20rpx; padding: 20rpx; background: #fff; border-radius: 14rpx; box-shadow: 0 2rpx 12rpx rgba(255,158,181,0.04); }
.tip-t { font-size: 24rpx; color: #8a7a9a; line-height: 1.6; }

.dark-theme.page { background: #12121f !important; }
.dark-theme .topbar { background: linear-gradient(135deg, #2a2a4a, #1a1a38) !important; }
.dark-theme .card { background: #1e1e38 !important; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.2) !important; }
.dark-theme .label { color: #e0d0e8 !important; }
.dark-theme .t { background: #2a2a4a !important; color: #a090b0 !important; }
.dark-theme .t.on { color: #fff !important; background: #ff8fab !important; }
.dark-theme .hint, .dark-theme .tip-t { color: #a090b0 !important; }
.dark-theme .sub { color: #ff8fab !important; border-color: rgba(255,143,171,0.2) !important; }
.dark-theme .tip { background: #1e1e38 !important; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.2) !important; }
