.page {
  min-height: 100vh;
  padding: 48rpx 36rpx 64rpx;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.greeting {
  font-size: 28rpx;
  color: #8a7a9a;
  letter-spacing: 2rpx;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #2d2d4e;
  line-height: 1.2;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #8a7a9a;
  margin-top: 4rpx;
}

.settings-icon {
  font-size: 44rpx;
  padding: 12rpx;
  opacity: 0.6;
}

/* Checkin card */
.checkin-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 158, 181, 0.1);
}

.checkin-card.done {
  background: linear-gradient(135deg, #f5fff0, #ffffff);
}

.ci-status {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2d2d4e;
}

.ci-streak {
  display: block;
  font-size: 24rpx;
  color: #ff9eb5;
  margin-top: 4rpx;
}

.ci-btn {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #ff9eb5, #ff8a80);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.3);
}

.ci-btn.disabled, .ci-btn.done {
  background: #e8e0ec;
  color: #b5a0c0;
  box-shadow: none;
  font-size: 32rpx;
}

/* Daily progress */
.day-progress {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 158, 181, 0.1);
}

.dp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.dp-title {
  font-size: 26rpx;
  color: #8a7a9a;
  font-weight: 500;
}

.dp-pct {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff9eb5;
}

.dp-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: #fff0f3;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.dp-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #ff9eb5, #ff8a80);
  transition: width 0.6s ease;
}

.dp-items {
  display: flex;
  gap: 24rpx;
}

.dp-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dp-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dp-label {
  font-size: 22rpx;
  color: #8a7a9a;
}

/* Module grid */
.module-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
}

.module-card {
  width: calc(50% - 14rpx);
}

.module-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 6rpx 32rpx rgba(255, 158, 181, 0.08);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  transition: transform 0.2s, box-shadow 0.2s;
}

.module-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 40rpx rgba(255, 158, 181, 0.15);
}

.mc-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.mc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d2d4e;
}

.mc-desc {
  font-size: 24rpx;
  color: #8a7a9a;
  line-height: 1.4;
}

.mc-meta {
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 4rpx;
}
