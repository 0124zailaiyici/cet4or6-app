.page { min-height:100vh; background:#faf5f7; padding:0 24rpx 36rpx; }

/* ===== Hero ===== */
.hero { position:relative; margin:0 -24rpx; padding:0 24rpx 24rpx; overflow:hidden; }
.hero-bg { position:absolute; top:0; left:0; right:0; bottom:0; background:linear-gradient(180deg,#fff0f3 0%,#faf5f7 100%); border-radius:0 0 36rpx 36rpx; }
.hero-content { position:relative; z-index:1; }
.hero-top { display:flex; align-items:center; justify-content:space-between; padding:24rpx 4rpx 20rpx; }
.hero-info { }
.greeting { font-size:36rpx; font-weight:900; color:#2d2d4e; display:block; line-height:1.3; }
.streak { display:inline-flex; align-items:center; gap:6rpx; margin-top:6rpx; padding:4rpx 16rpx 4rpx 10rpx; border-radius:20rpx; background:linear-gradient(135deg,#fff0f3,#fff5f7); font-size:22rpx; font-weight:700; color:#e86a8a; }
.checkin { padding:12rpx 28rpx; border-radius:24rpx; background:linear-gradient(135deg,#ff8fab,#ff6b8a); color:#fff; font-size:24rpx; font-weight:700; box-shadow:0 4rpx 16rpx rgba(255,107,138,0.2); flex-shrink:0; }
.checkin:active { transform:scale(.95); }
.checkin.done { background:#e8dce2; color:#8a7a82; box-shadow:none; }

.hero-metrics { display:flex; align-items:center; background:#fff; border-radius:20rpx; padding:18rpx 0; margin-top:4rpx; box-shadow:0 4rpx 20rpx rgba(200,160,180,0.08); }
.hm-item { flex:1; display:flex; flex-direction:column; align-items:center; gap:2rpx; }
.hm-v { font-size:32rpx; font-weight:900; color:#2d2d4e; line-height:1.2; }
.hm-l { font-size:20rpx; font-weight:600; color:#b0a0b0; }
.hm-divider { width:2rpx; height:32rpx; background:#f5eef0; flex-shrink:0; }

/* ===== Mission ===== */
.mission { margin-bottom:20rpx; border-radius:24rpx; overflow:hidden; }
.mission:active { transform:scale(.97); }
.mission-bg { padding:28rpx 28rpx 24rpx; background:linear-gradient(135deg,#ff8fab,#f06292); position:relative; }
.mission-bg::after { content:'🎯'; position:absolute; right:24rpx; top:50%; transform:translateY(-50%); font-size:64rpx; opacity:.12; }
.mission-label { font-size:22rpx; font-weight:700; color:rgba(255,255,255,.75); letter-spacing:2rpx; display:block; margin-bottom:4rpx; }
.mission-title { font-size:40rpx; font-weight:900; color:#fff; display:block; line-height:1.2; }
.mission-sub { font-size:24rpx; font-weight:600; color:rgba(255,255,255,.85); display:block; margin-top:6rpx; }
.mission-btn { display:inline-flex; align-items:center; gap:4rpx; margin-top:16rpx; padding:12rpx 28rpx; border-radius:22rpx; background:rgba(255,255,255,.2); font-size:24rpx; font-weight:700; color:#fff; }
.mission-btn:active { background:rgba(255,255,255,.3); }

/* ===== Daily Sentence ===== */
.ds { padding:22rpx 24rpx; border-radius:20rpx; background:#fff; border:2rpx solid #f5eef0; margin-bottom:20rpx; box-shadow:0 4rpx 20rpx rgba(200,160,180,0.06); }
.ds:active { transform:scale(.98); }
.ds-hd { display:flex; align-items:center; justify-content:space-between; margin-bottom:12rpx; }
.ds-tag { font-size:22rpx; font-weight:700; color:#e86a8a; letter-spacing:1rpx; }
.ds-play { width:48rpx; height:48rpx; border-radius:50%; background:linear-gradient(135deg,#ff8fab,#d4b5ff); display:flex; align-items:center; justify-content:center; font-size:22rpx; color:#fff; box-shadow:0 4rpx 14rpx rgba(255,143,171,.2); }
.ds-play:active { transform:scale(.9); }
.ds-en { font-size:28rpx; font-weight:700; color:#2d2d4e; line-height:1.6; display:block; }
.ds-zh { font-size:24rpx; font-weight:600; color:#8a7a9a; margin-top:6rpx; display:block; line-height:1.5; }

/* ===== Quick Actions ===== */
.qa-row { display:flex; gap:14rpx; margin-bottom:28rpx; }
.qa { flex:1; display:flex; flex-direction:column; align-items:center; gap:6rpx; padding:24rpx 0; border-radius:20rpx; background:linear-gradient(180deg,#fff 0%,#faf5f7 100%); border:2rpx solid #f0e8ea; box-shadow:0 4rpx 12rpx rgba(200,160,180,0.04); }
.qa:active { transform:scale(.94); background:#faf5f7; }
.qa-e { font-size:36rpx; }
.qa-t { font-size:24rpx; font-weight:700; color:#4a3a4a; }

/* ===== Section header ===== */
.sec-h { display:flex; align-items:center; gap:8rpx; margin-bottom:16rpx; padding:0 4rpx; }
.sec-h text { font-size:24rpx; font-weight:700; color:#2d2d4e; }
.sec-h::after { content:''; flex:1; height:2rpx; background:linear-gradient(90deg,#ffd9e0,transparent); margin-left:10rpx; }

/* ===== Grid ===== */
.grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:14rpx; }
.gi { border-radius:20rpx; padding:28rpx 10rpx 22rpx; text-align:center; display:flex; flex-direction:column; align-items:center; gap:8rpx; box-shadow:0 6rpx 20rpx rgba(0,0,0,0.06); }
.gi:active { transform:scale(.92); opacity:.85; }
.gi-e { font-size:44rpx; line-height:1; }
.gi-n { font-size:24rpx; font-weight:700; color:#fff; }

.mc-listening { background:linear-gradient(135deg,#4fc3f7,#2196f3); }
.mc-reading { background:linear-gradient(135deg,#78909c,#455a64); }
.mc-translation { background:linear-gradient(135deg,#ffb74d,#ff9800); }
.mc-writing { background:linear-gradient(135deg,#ce93d8,#9c27b0); }
.mc-sentences { background:linear-gradient(135deg,#81c784,#4caf50); }
.mc-vocab { background:linear-gradient(135deg,#7c4dff,#651fff); }
.mc-dictionary { background:linear-gradient(135deg,#e57373,#d32f2f); }
.mc-statistics { background:linear-gradient(135deg,#4db6ac,#00897b); }
.mc-exam { background:linear-gradient(135deg,#4fc3f7,#0288d1); }

/* ===== Dark mode ===== */
.dark-theme { background:#12121f !important; }
.dark-theme .hero-bg { background:linear-gradient(180deg,#1e1e38 0%,#12121f 100%) !important; }
.dark-theme .greeting { color:#e0d0e8 !important; }
.dark-theme .streak { background:rgba(255,143,171,.1) !important; color:#ff8fab !important; }
.dark-theme .checkin { background:linear-gradient(135deg,#ff8fab,#e86a8a) !important; }
.dark-theme .checkin.done { background:#2a2a4a !important; color:#a090b0 !important; }
.dark-theme .hero-metrics { background:#1e1e38 !important; }
.dark-theme .hm-v { color:#e0d0e8 !important; }
.dark-theme .hm-l { color:#a090b0 !important; }
.dark-theme .hm-divider { background:#2a2a4a !important; }
.dark-theme .ds { background:#1e1e38 !important; border-color:#2a2a4a !important; }
.dark-theme .ds-tag { color:#ff8fab !important; }
.dark-theme .ds-en { color:#e0d0e8 !important; }
.dark-theme .ds-zh { color:#a090b0 !important; }
.dark-theme .qa { background:#1e1e38 !important; border-color:#2a2a4a !important; }
.dark-theme .qa-t { color:#d0c0d8 !important; }
.dark-theme .sec-h text { color:#e0d0e8 !important; }
