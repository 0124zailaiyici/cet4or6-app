.page { min-height: 100vh; }

/* ===== Hero / Header ===== */
.hero-section { position: relative; overflow: hidden; padding-bottom: 16rpx; }
.hero-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 280rpx;
  background: linear-gradient(135deg, #ffb3c6, #ff8fab);
  border-radius: 0 0 50rpx 50rpx;
}
.hero-content { position: relative; padding: 48rpx 32rpx 0; }
.hero-top { display: flex; justify-content: space-between; align-items: flex-start; }
.hero-text { flex: 1; }
.hero-greeting { font-size: 26rpx; color: rgba(255,255,255,0.85); }
.hero-title { font-size: 44rpx; font-weight: 800; color: #fff; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08); margin-top: 2rpx; }
.hero-actions { flex-shrink: 0; margin-top: 6rpx; }
.hero-btn {
  padding: 8rpx 22rpx; border-radius: 20rpx; background: rgba(255,255,255,0.2);
  font-size: 24rpx; color: #fff; font-weight: 600;
}
.hero-btn.done { background: rgba(255,255,255,0.3); }

/* ===== Stats ===== */
.stats-banner { display: flex; gap: 12rpx; margin-top: 20rpx; }
.stat-card {
  flex: 1; background: #fff; border-radius: 18rpx; padding: 18rpx 8rpx;
  text-align: center; box-shadow: 0 4rpx 20rpx rgba(255,158,181,0.08);
}
.stat-num { display: block; font-size: 40rpx; font-weight: 800; color: #ff6b8a; }
.stat-label { display: block; font-size: 20rpx; color: #8a7a9a; margin-top: 4rpx; }

/* ===== Exam card ===== */
.exam-card {
  display: flex; align-items: center; justify-content: space-between;
  margin: 20rpx 20rpx 0; padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #4fc3f7, #2196f3);
  box-shadow: 0 4rpx 24rpx rgba(33,150,243,0.2);
}
.exam-card:active { opacity: 0.9; }
.ec-left { display: flex; align-items: center; gap: 14rpx; }
.ec-icon { font-size: 40rpx; }
.ec-title { display: block; font-size: 28rpx; font-weight: 700; color: #fff; }
.ec-desc { display: block; font-size: 20rpx; color: rgba(255,255,255,0.8); margin-top: 2rpx; }
.ec-btn { font-size: 24rpx; color: #fff; font-weight: 600; background: rgba(255,255,255,0.2); padding: 10rpx 24rpx; border-radius: 14rpx; }

/* ===== Home body ===== */
.home-body { padding: 4rpx 20rpx 30rpx; }

.sec { margin-top: 24rpx; }
.sec-h { display: flex; align-items: center; gap: 8rpx; margin-bottom: 14rpx; padding: 0 4rpx; }
.sec-h text { font-size: 24rpx; font-weight: 700; color: #2d2d4e; }
.sec-h::after { content: ''; flex: 1; height: 2rpx; background: linear-gradient(90deg, #ffd9e0, transparent); margin-left: 10rpx; }

/* ===== 3-column grid ===== */
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12rpx; }
.gi {
  border-radius: 20rpx; padding: 24rpx 8rpx; text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.gi:active { opacity: 0.85; transform: scale(0.96); }
.gi .gi-e { font-size: 40rpx; line-height: 1; }
.gi .gi-n { font-size: 24rpx; font-weight: 700; color: #fff; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15); }
.gi .gi-d { font-size: 18rpx; color: rgba(255,255,255,0.75); }

/* Card colors */
.mc-listening { background: linear-gradient(135deg, #4fc3f7, #2196f3); }
.mc-sentences { background: linear-gradient(135deg, #81c784, #4caf50); }
.mc-translation { background: linear-gradient(135deg, #ffb74d, #ff9800); }
.mc-writing { background: linear-gradient(135deg, #ce93d8, #9c27b0); }
.mc-favorites { background: linear-gradient(135deg, #ffd54f, #ffc107); }
.mc-dict { background: linear-gradient(135deg, #90a4ae, #607d8b); }
.mc-reading { background: linear-gradient(135deg, #78909c, #455a64); }
.mc-errors { background: linear-gradient(135deg, #ff8a65, #d84315); }
.mc-vocab { background: linear-gradient(135deg, #7c4dff, #651fff); }
.mc-statistics { background: linear-gradient(135deg, #4db6ac, #00897b); }

/* ===== Bottom card ===== */
.btm-card { margin-top: 28rpx; background: #fff; border-radius: 22rpx; padding: 22rpx 24rpx; box-shadow: 0 2rpx 16rpx rgba(255,158,181,0.04); }
.btm-row { display: flex; align-items: center; gap: 16rpx; }
.btm-n { font-size: 48rpx; font-weight: 800; color: #ff6b8a; }
.btm-info { flex: 1; }
.btm-t { display: block; font-size: 24rpx; font-weight: 600; color: #2d2d4e; margin-bottom: 8rpx; }
.btm-bar { height: 8rpx; border-radius: 4rpx; background: #fff0f3; }
.btm-f { height: 100%; border-radius: 4rpx; background: linear-gradient(90deg, #ff8fab, #ff6b8a); transition: width 0.3s; min-width: 0; }
.btm-tip { display: block; font-size: 22rpx; color: #8a7a9a; margin-top: 14rpx; }
