<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="hero">
    <view class="hero-text">
      <text class="greeting">{{greeting}} ✨</text>
      <text class="title">四级备考助手</text>
      <text class="subtitle">每天进步一点点 💪</text>
    </view>
    <view class="hero-actions">
      <view class="settings-icon" data-url="/pages/settings/settings" catchtap="goTo">⚙️</view>
    </view>
  </view>

  <view class="checkin-card {{checkedIn ? 'done' : ''}}">
    <view class="ci-left">
      <text class="ci-status">{{checkedIn ? '今日已打卡' : '今日未打卡'}}</text>
      <text class="ci-streak">🔥 连续 {{streak}} 天</text>
    </view>
    <view class="ci-right">
      <view class="ci-btn {{checkedIn ? 'disabled' : ''}}" wx:if="{{!checkedIn}}" catchtap="handleCheckIn">签到</view>
      <view class="ci-btn done" wx:else>✅</view>
    </view>
  </view>

  <view class="day-progress">
    <view class="dp-header">
      <text class="dp-title">今日进度</text>
      <text class="dp-pct">{{goalStats.overallPct}}%</text>
    </view>
    <view class="dp-bar">
      <view class="dp-fill" style="width: {{goalStats.overallPct}}%"></view>
    </view>
    <view class="dp-items">
      <view class="dp-item">
        <view class="dp-dot" style="background: #b5d8f7"></view>
        <text class="dp-label">听力 {{todayStats.listened}}</text>
      </view>
      <view class="dp-item">
        <view class="dp-dot" style="background: #c5e1a5"></view>
        <text class="dp-label">句子 {{todayStats.sentences}}</text>
      </view>
      <view class="dp-item">
        <view class="dp-dot" style="background: #ffd3b6"></view>
        <text class="dp-label">翻译 {{todayStats.translations}}</text>
      </view>
      <view class="dp-item">
        <view class="dp-dot" style="background: #d8b4fe"></view>
        <text class="dp-label">写作 {{todayStats.writings}}</text>
      </view>
    </view>
  </view>

  <view class="module-grid">
    <view class="module-card" wx:for="{{modules}}" wx:key="id" data-url="{{item.url}}" catchtap="goTo">
      <view class="mc-icon" style="background: {{item.color}}18">
        <text>{{item.icon}}</text>
      </view>
      <text class="mc-title">{{item.title}}</text>
      <text class="mc-desc">{{item.desc}}</text>
      <view class="mc-meta" style="color: {{item.color}}">{{item.count}} 题</view>
    </view>
  </view>
</view>
