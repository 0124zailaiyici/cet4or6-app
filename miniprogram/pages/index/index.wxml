<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="hero-section">
    <view class="hero-bg"></view>
    <view class="hero-content">
      <view class="hero-top">
        <view class="hero-text">
          <text class="hero-greeting">{{greeting}}</text>
          <text class="hero-title">四级备考</text>
        </view>
        <view class="hero-actions">
          <view class="hero-btn" data-url="/pages/settings/settings" catchtap="goTo">⚙️</view>
          <view class="hero-btn" data-url="/pages/statistics/statistics" catchtap="goTo">📊</view>
        </view>
      </view>
      <view class="hero-checkin {{checkedIn ? 'done' : ''}}" catchtap="handleCheckIn">
        <text class="hc-label">{{checkedIn ? '已打卡' : '签到学习'}}</text>
        <text class="hc-streak">🔥 {{streak}} 天连续</text>
      </view>
    </view>
  </view>

  <view class="stats-banner">
    <view class="stat-card">
      <text class="stat-num">{{goalStats.overallPct}}%</text>
      <text class="stat-label">今日完成</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{todayStats.listened + todayStats.sentences + todayStats.translations + todayStats.writings}}</text>
      <text class="stat-label">今日题数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{streak}}</text>
      <text class="stat-label">连续天数</text>
    </view>
  </view>

  <view class="exam-banner" data-url="/pages/exam/exam" catchtap="goTo">
    <view class="ex-info">
      <text class="ex-title">🎯 模拟考试</text>
      <text class="ex-desc">套题计时 · 真考环境 · 自动评分</text>
    </view>
    <text class="ex-btn">开始 ›</text>
  </view>

  <view class="section-header">
    <text class="section-title">学习模块</text>
    <text class="section-subtitle">选择模块开始学习</text>
  </view>

  <view class="module-grid">
    <view class="module-card mc-listening" data-url="/pages/listening/listening" catchtap="goTo">
      <view class="mc-badge">5篇</view>
      <text class="mc-emoji">🎵</text>
      <text class="mc-name">听力精听</text>
      <text class="mc-brief">单句循环 · 听写</text>
    </view>
    <view class="module-card mc-sentences" data-url="/pages/sentences/sentences" catchtap="goTo">
      <view class="mc-badge">50句</view>
      <text class="mc-emoji">💬</text>
      <text class="mc-name">语境句子</text>
      <text class="mc-brief">卡片学习 · 搜索</text>
    </view>
    <view class="module-card mc-translation" data-url="/pages/translation/translation" catchtap="goTo">
      <view class="mc-badge">10题</view>
      <text class="mc-emoji">🌟</text>
      <text class="mc-name">翻译练习</text>
      <text class="mc-brief">AI 批改 · 评分</text>
    </view>
    <view class="module-card mc-writing" data-url="/pages/writing/writing" catchtap="goTo">
      <view class="mc-badge">5题</view>
      <text class="mc-emoji">✨</text>
      <text class="mc-name">写作教学</text>
      <text class="mc-brief">句型 · 段落 · 全文</text>
    </view>
    <view class="module-card mc-favorites" data-url="/pages/favorites/favorites" catchtap="goTo">
      <view class="mc-badge">{{favoriteCount}}项</view>
      <text class="mc-emoji">⭐</text>
      <text class="mc-name">收藏夹</text>
      <text class="mc-brief">收藏 · 难句本</text>
    </view>
    <view class="module-card mc-dict" data-url="/pages/dictionary/dictionary" catchtap="goTo">
      <view class="mc-badge">查词</view>
      <text class="mc-emoji">📖</text>
      <text class="mc-name">英语词典</text>
      <text class="mc-brief">音标 · 释义 · 例句</text>
    </view>
    <view class="module-card mc-reading" data-url="/pages/reading/reading" catchtap="goTo">
      <view class="mc-badge">{{readingCount}}篇</view>
      <text class="mc-emoji">📖</text>
      <text class="mc-name">阅读理解</text>
      <text class="mc-brief">真题 · 解析</text>
    </view>
    <view class="module-card mc-errors" data-url="/pages/errors/errors" catchtap="goTo">
      <view class="mc-badge">错题</view>
      <text class="mc-emoji">📝</text>
      <text class="mc-name">错题本</text>
      <text class="mc-brief">查漏补缺</text>
    </view>
    <view class="module-card mc-vocab" data-url="/pages/vocab/vocab" catchtap="goTo">
      <view class="mc-badge">闯关</view>
      <text class="mc-emoji">📕</text>
      <text class="mc-name">单词本</text>
      <text class="mc-brief">挑战 · 掌握</text>
    </view>
  </view>
</view>
