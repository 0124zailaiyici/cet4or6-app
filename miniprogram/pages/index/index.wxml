<view class="page {{darkMode ? 'dark-theme' : ''}}">

  <!-- ===== Hero ===== -->
  <view class="hero">
    <view class="hero-bg"></view>
    <view class="hero-content">
    <view class="hero-top" style="padding-top:{{statusBarHeight + 24}}px">
      <view class="hero-info">
          <text class="greeting">{{greeting}}</text>
          <view class="streak" wx:if="{{streak > 0}}">
            <text>🔥 连续 {{streak}} 天</text>
          </view>
          <view class="streak" wx:else>
            <text>💪 今天开始积累</text>
          </view>
        </view>
        <view class="checkin {{checkedIn ? 'done' : ''}}" catchtap="handleCheckIn">{{checkedIn ? '✓ 已打卡' : '📌 打卡'}}</view>
      </view>
      <view class="hero-metrics">
        <view class="hm-item"><text class="hm-v">{{todayListen}}</text><text class="hm-l">听力</text></view>
        <view class="hm-divider"></view>
        <view class="hm-item"><text class="hm-v">{{todaySentence}}</text><text class="hm-l">句子</text></view>
        <view class="hm-divider"></view>
        <view class="hm-item"><text class="hm-v">{{todayTrans}}</text><text class="hm-l">翻译</text></view>
        <view class="hm-divider"></view>
        <view class="hm-item"><text class="hm-v">{{todayWrite}}</text><text class="hm-l">写作</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 今日任务 ===== -->
  <view class="mission" catchtap="doMission">
    <view class="mission-bg">
      <text class="mission-label">📌 今日任务</text>
      <text class="mission-title">{{missionTitle}}</text>
      <text class="mission-sub">{{missionSub}}</text>
      <view class="mission-btn">
        <text>{{missionBtn}}</text>
        <text> →</text>
      </view>
    </view>
  </view>

  <!-- ===== 每日一句 ===== -->
  <view class="ds" catchtap="playDailySentence">
    <view class="ds-hd">
      <text class="ds-tag">💬 每日一句</text>
      <view class="ds-play {{dailyPlaying ? 'on' : ''}}">
        <text wx:if="{{dailyPlaying}}">⏸</text>
        <text wx:else>▶</text>
      </view>
    </view>
    <text class="ds-en">{{dailyEn}}</text>
    <text class="ds-zh">{{dailyZh}}</text>
  </view>

  <!-- ===== 快捷操作 ===== -->
  <view class="qa-row">
    <view class="qa" catchtap="quickListen">
      <text class="qa-e">🎧</text>
      <text class="qa-t">听一句</text>
    </view>
    <view class="qa" catchtap="quickVocab">
      <text class="qa-e">📖</text>
      <text class="qa-t">背一词</text>
    </view>
    <view class="qa" catchtap="quickReading">
      <text class="qa-e">📝</text>
      <text class="qa-t">读一篇</text>
    </view>
  </view>

  <!-- ===== 模块网格 ===== -->
  <view class="sec-h"><text>📚 真题训练</text></view>
  <view class="grid">
    <view class="gi mc-listening" data-url="/pages/listening/listening" catchtap="goTo">
      <text class="gi-e">🎵</text><text class="gi-n">听力</text>
    </view>
    <view class="gi mc-reading" data-url="/pages/reading/reading" catchtap="goTo">
      <text class="gi-e">📖</text><text class="gi-n">阅读</text>
    </view>
    <view class="gi mc-translation" data-url="/pages/translation/translation" catchtap="goTo">
      <text class="gi-e">✏️</text><text class="gi-n">翻译</text>
    </view>
    <view class="gi mc-writing" data-url="/pages/writing/writing" catchtap="goTo">
      <text class="gi-e">📝</text><text class="gi-n">写作</text>
    </view>
    <view class="gi mc-sentences" data-url="/pages/sentences/sentences" catchtap="goTo">
      <text class="gi-e">💬</text><text class="gi-n">句子</text>
    </view>
    <view class="gi mc-vocab" data-url="/pages/vocab/vocab" catchtap="goTo">
      <text class="gi-e">📕</text><text class="gi-n">单词本</text>
    </view>
    <view class="gi mc-statistics" data-url="/pages/statistics/statistics" catchtap="goTo">
      <text class="gi-e">📊</text><text class="gi-n">统计</text>
    </view>
    <view class="gi mc-exam" data-url="/pages/exam/exam" catchtap="goTo">
      <text class="gi-e">📋</text><text class="gi-n">模拟考</text>
    </view>
  </view>

</view>
