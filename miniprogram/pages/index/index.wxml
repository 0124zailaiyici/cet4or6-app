<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="hero-section">
    <view class="hero-bg"></view>
    <view class="hero-content">
      <view class="hero-top">
        <view class="hero-text">
          <text class="hero-greeting">{{greeting}}</text>
          <text class="hero-title">四级备考助手</text>
        </view>
        <view class="hero-actions">
          <view class="hero-btn {{checkedIn ? 'done' : ''}}" catchtap="handleCheckIn">{{checkedIn ? '✓ 已打卡' : '📌 打卡'}}</view>
        </view>
      </view>
      <view class="stats-banner">
        <view class="stat-card">
          <text class="stat-num">{{goalStats.overallPct}}%</text>
          <text class="stat-label">今日完成</text>
        </view>
        <view class="stat-card">
          <text class="stat-num">{{todayStats.listened + todayStats.sentences + todayStats.translations + todayStats.writings}}</text>
          <text class="stat-label">今日题数</text>
        </view>
        <view class="stat-card">
          <text class="stat-num">{{streak}}</text>
          <text class="stat-label">连续天数</text>
        </view>
      </view>
    </view>
  </view>

  <view class="exam-banner" data-url="/pages/exam/exam" catchtap="goTo">
    <view class="ex-info"><text class="ex-title">🎯 模拟考试</text><text class="ex-desc">125分钟 · 真考环境 · 自动评分</text></view>
    <text class="ex-btn">进入 ›</text>
  </view>

  <view class="home-body">
    <view class="sec-lbl">📖 真题训练</view>
    <view class="grid-3">
      <view class="gi mc-listening" data-url="/pages/listening/listening" catchtap="goTo">
        <text class="gi-e">🎵</text><text class="gi-n">听力</text><text class="gi-d">精听</text>
      </view>
      <view class="gi mc-reading" data-url="/pages/reading/reading" catchtap="goTo">
        <text class="gi-e">📖</text><text class="gi-n">阅读</text><text class="gi-d">理解</text>
      </view>
      <view class="gi mc-translation" data-url="/pages/translation/translation" catchtap="goTo">
        <text class="gi-e">🌟</text><text class="gi-n">翻译</text><text class="gi-d">练习</text>
      </view>
      <view class="gi mc-writing" data-url="/pages/writing/writing" catchtap="goTo">
        <text class="gi-e">✍️</text><text class="gi-n">写作</text><text class="gi-d">教学</text>
      </view>
      <view class="gi mc-sentences" data-url="/pages/sentences/sentences" catchtap="goTo">
        <text class="gi-e">💬</text><text class="gi-n">句子</text><text class="gi-d">语境</text>
      </view>
    </view>

    <view class="sec-lbl">📚 学习工具</view>
    <view class="grid-3">
      <view class="gi mc-vocab" data-url="/pages/vocab/vocab" catchtap="goTo">
        <text class="gi-e">📕</text><text class="gi-n">单词本</text><text class="gi-d">闯关</text>
      </view>
      <view class="gi mc-errors" data-url="/pages/errors/errors" catchtap="goTo">
        <text class="gi-e">📝</text><text class="gi-n">错题本</text><text class="gi-d">查漏</text>
      </view>
      <view class="gi mc-favorites" data-url="/pages/favorites/favorites" catchtap="goTo">
        <text class="gi-e">⭐</text><text class="gi-n">收藏</text><text class="gi-d">管理</text>
      </view>
      <view class="gi mc-dict" data-url="/pages/dictionary/dictionary" catchtap="goTo">
        <text class="gi-e">📖</text><text class="gi-n">词典</text><text class="gi-d">查询</text>
      </view>
      <view class="gi mc-statistics" data-url="/pages/statistics/statistics" catchtap="goTo">
        <text class="gi-e">📊</text><text class="gi-n">统计</text><text class="gi-d">进度</text>
      </view>
    </view>
  </view>
</view>
