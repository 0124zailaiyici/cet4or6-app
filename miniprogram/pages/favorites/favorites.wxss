.page {
  min-height: 100vh;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.page-header {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.tab-bar {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  background: var(--tag-bg);
  border-radius: 20rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-radius: 16rpx;
}

.tab-item.active {
  background: var(--card-bg);
  color: #ff9eb5;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(255, 158, 181, 0.15);
}

.content-scroll {
  flex: 1;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.fav-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fav-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 215, 0, 0.1);
}

.fav-english {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--text-primary);
}

.fav-chinese {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
  line-height: 1.6;
}

.fav-bottom {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.fav-topic {
  font-size: 22rpx;
  color: var(--text-secondary);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: var(--tag-bg);
}

.fav-master {
  font-size: 22rpx;
  color: var(--mint);
}

.fav-remove {
  font-size: 24rpx;
  color: var(--peach);
  margin-left: auto;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 211, 182, 0.3);
}
