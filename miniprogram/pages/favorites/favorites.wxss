.page { min-height: 100vh; padding-bottom: 48rpx; }

.f-header { position: relative; overflow: hidden; }
.fh-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 200rpx;
  background: linear-gradient(135deg, #ffd54f, #ffc107);
  border-radius: 0 0 40rpx 40rpx;
}
.fh-content { position: relative; padding: 48rpx 36rpx 36rpx; }
.fh-title { font-size: calc(48 * var(--fs) / 16 * 1rpx); font-weight: 800; color: #fff; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); }

.f-tabs { display: flex; gap: 4rpx; margin: 20rpx 36rpx; background: rgba(255,193,7,0.08); border-radius: 18rpx; padding: 6rpx; }
.ft-item { flex: 1; text-align: center; padding: 16rpx 0; font-size: calc(26 * var(--fs) / 16 * 1rpx); color: #8a7a9a; border-radius: 14rpx; }
.ft-item.active { background: #fff; color: #ff8f00; font-weight: 600; box-shadow: 0 2rpx 12rpx rgba(255,193,7,0.1); }

.f-content { padding: 0 36rpx; }
.f-list { display: flex; flex-direction: column; gap: 14rpx; }

.fcard { background: #fff; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 2rpx 16rpx rgba(255,193,7,0.04); border: 2rpx solid rgba(255,215,0,0.08); }
.fc-head { display: flex; align-items: flex-start; gap: 10rpx; }
.fc-english { flex: 1; font-size: calc(28 * var(--fs) / 16 * 1rpx); line-height: 1.7; color: #2d2d4e; }
.fc-mastered { font-size: calc(20 * var(--fs) / 16 * 1rpx); color: #27ae60; padding: 2rpx 12rpx; border-radius: 10rpx; background: rgba(39,174,96,0.06); white-space: nowrap; margin-top: 4rpx; }
.fc-chinese { display: block; font-size: calc(24 * var(--fs) / 16 * 1rpx); color: #6a6a8a; margin-top: 8rpx; line-height: 1.6; }
.fc-bottom { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.fc-tag { font-size: calc(20 * var(--fs) / 16 * 1rpx); color: #ff8f00; padding: 4rpx 14rpx; border-radius: 12rpx; background: rgba(255,193,7,0.06); }
.fc-remove { font-size: calc(22 * var(--fs) / 16 * 1rpx); color: #e74c3c; margin-left: auto; padding: 6rpx 16rpx; border-radius: 14rpx; border: 2rpx solid rgba(231,76,60,0.25); }

.hcard { background: #fff; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 2rpx 16rpx rgba(255,158,181,0.04); }
.hc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.hc-source { font-size: calc(22 * var(--fs) / 16 * 1rpx); color: #ff9eb5; }
.hc-index { font-size: calc(20 * var(--fs) / 16 * 1rpx); color: #8a7a9a; }
.hc-text { display: block; font-size: calc(28 * var(--fs) / 16 * 1rpx); line-height: 1.7; color: #2d2d4e; }
.hc-remove { display: inline-block; font-size: calc(22 * var(--fs) / 16 * 1rpx); color: #e74c3c; margin-top: 12rpx; padding: 6rpx 16rpx; border-radius: 14rpx; border: 2rpx solid rgba(231,76,60,0.25); }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.empty-emoji { font-size: calc(72 * var(--fs) / 16 * 1rpx); margin-bottom: 20rpx; }
.empty-text { font-size: calc(28 * var(--fs) / 16 * 1rpx); color: #2d2d4e; font-weight: 600; margin-bottom: 8rpx; }
.empty-hint { font-size: calc(24 * var(--fs) / 16 * 1rpx); color: #8a7a9a; }
