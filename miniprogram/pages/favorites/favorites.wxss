.page { min-height: 100vh; padding-bottom: 48rpx; }

.f-header { position: relative; }
.fh-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 200rpx;
  background: linear-gradient(135deg, #ffd54f, #ffc107);
  border-radius: 0 0 40rpx 40rpx;
}
.fh-content { position: relative; padding: 48rpx 36rpx 36rpx; }
.fh-title { font-size: 48rpx; font-weight: 800; color: #fff; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); }

.f-tabs { display: flex; gap: 4rpx; margin: 20rpx 36rpx; background: rgba(255,193,7,0.08); border-radius: 18rpx; padding: 6rpx; }
.ft-item { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: #8a7a9a; border-radius: 14rpx; }
.ft-item.active { background: #fff; color: #ff8f00; font-weight: 600; box-shadow: 0 2rpx 12rpx rgba(255,193,7,0.1); }

.f-content { padding: 0 36rpx; }
.f-list { display: flex; flex-direction: column; gap: 14rpx; }

.fcard { background: #fff; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 2rpx 16rpx rgba(255,193,7,0.04); border: 2rpx solid rgba(255,215,0,0.08); }
.fc-english { display: block; font-size: 28rpx; line-height: 1.7; color: #2d2d4e; }
.fc-chinese { display: block; font-size: 24rpx; color: #6a6a8a; margin-top: 8rpx; line-height: 1.6; }
.fc-bottom { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.fc-tag { font-size: 20rpx; color: #ff8f00; padding: 4rpx 14rpx; border-radius: 12rpx; background: rgba(255,193,7,0.06); }
.fc-remove { font-size: 22rpx; color: #ffd3b6; margin-left: auto; padding: 6rpx 16rpx; border-radius: 14rpx; border: 2rpx solid rgba(255,211,182,0.2); }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.empty-emoji { font-size: 72rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #2d2d4e; font-weight: 600; margin-bottom: 8rpx; }
.empty-hint { font-size: 24rpx; color: #8a7a9a; }
