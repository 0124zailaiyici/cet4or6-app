<view class="page {{darkMode ? 'dark-theme' : ''}}">
  <view class="f-header">
    <view class="fh-bg"></view>
    <view class="fh-content">
      <text class="fh-title">收藏夹</text>
    </view>
  </view>

  <view class="f-tabs">
    <view class="ft-item {{tab === 0 ? 'active' : ''}}" catchtap="switchTab" data-tab="0">⭐ 收藏句子</view>
    <view class="ft-item {{tab === 1 ? 'active' : ''}}" catchtap="switchTab" data-tab="1">❗ 难句记录</view>
  </view>

  <scroll-view class="f-content" scroll-y>
    <block wx:if="{{tab === 0}}">
      <view class="empty-state" wx:if="{{favSentences.length === 0}}">
        <text class="empty-emoji">⭐</text>
        <text class="empty-text">还没有收藏的句子</text>
        <text class="empty-hint">在句子页面点击 ☆ 即可收藏</text>
      </view>
      <view class="f-list" wx:else>
        <view class="fcard" wx:for="{{favSentences}}" wx:key="id">
          <text class="fc-english">{{item.english}}</text>
          <text class="fc-chinese">{{item.chinese}}</text>
          <view class="fc-bottom">
            <text class="fc-tag">{{item.topic}}</text>
            <view class="fc-remove" data-id="{{item.id}}" catchtap="removeFavorite">取消收藏</view>
          </view>
        </view>
      </view>
    </block>
    <block wx:elif="{{tab === 1}}">
      <view class="empty-state">
        <text class="empty-emoji">❗</text>
        <text class="empty-text">难句记录功能开发中</text>
        <text class="empty-hint">在听力页面标记难句后将在这里展示</text>
      </view>
    </block>
  </scroll-view>
</view>
