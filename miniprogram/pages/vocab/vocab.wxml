<view class="page {{darkMode ? 'dark dark-theme' : ''}} theme-{{theme}} mode-{{mode}}">
  <view class="tb">
    <view class="ttl">单词本</view>
    <view class="sub">背词模式 · {{mode === 'battle' ? '战斗' : mode === 'garden' ? '花园' : '集卡'}}</view>
  </view>

  <view class="msel">
    <view class="mbtn {{mode === 'battle' ? 'on' : ''}}" data-mode="battle" catchtap="setMode">⚔️ 战斗</view>
    <view class="mbtn {{mode === 'garden' ? 'on' : ''}}" data-mode="garden" catchtap="setMode">🌸 花园</view>
    <view class="mbtn {{mode === 'card' ? 'on' : ''}}" data-mode="card" catchtap="setMode">🎴 集卡</view>
  </view>

  <!-- 卡包+挑战+故事入口 -->
  <view class="extra-bar">
    <view class="ex-btn" catchtap="openPacks">🎴 卡包</view>
    <view class="ex-btn {{challengeDone ? 'done' : ''}}" catchtap="startChallenge">⚡ {{challengeDone ? '今日已挑战' : '每日挑战'}}</view>
    <view class="ex-btn" catchtap="openStoryView">💌 故事</view>
  </view>

  <view class="stats">
    <view class="st"><text class="n g">{{mastered}}</text><text class="l">✓ 已掌握</text></view>
    <view class="st"><text class="n">{{learning}}</text><text class="l">📝 学习中</text></view>
    <view class="st"><text class="n">{{streak}}</text><text class="l">🔥 连胜</text></view>
  </view>

  <!-- 主题选择 -->
  <view class="tp">
    <view class="tp-dot {{theme === '' ? 'on' : ''}}" data-theme="" catchtap="setTheme">
      <view class="tpc" style="background:linear-gradient(135deg,#ffb3c6,#ff8fab)"></view>
    </view>
    <view class="tp-dot {{theme === 'ocean' ? 'on' : ''}}" data-theme="ocean" catchtap="setTheme">
      <view class="tpc" style="background:linear-gradient(135deg,#00acc1,#00897b)"></view>
    </view>
    <view class="tp-dot {{theme === 'sunset' ? 'on' : ''}}" data-theme="sunset" catchtap="setTheme">
      <view class="tpc" style="background:linear-gradient(135deg,#ff6f00,#e65100)"></view>
    </view>
    <view class="tp-dot {{theme === 'forest' ? 'on' : ''}}" data-theme="forest" catchtap="setTheme">
      <view class="tpc" style="background:linear-gradient(135deg,#558b2f,#2e7d32)"></view>
    </view>
    <view class="tp-dot {{theme === 'midnight' ? 'on' : ''}}" data-theme="midnight" catchtap="setTheme">
      <view class="tpc" style="background:linear-gradient(135deg,#7c4dff,#5c6bc0)"></view>
    </view>
  </view>

  <!-- 搜索框（仅单词视图） -->
  <view class="sbar" wx:if="{{!showAch && !showSents && !showPack && !showStoryView}}">
    <input class="sinp" placeholder="🔍 搜索单词或释义…" value="{{searchQuery}}" bindinput="onSearchInput" />
  </view>

  <!-- 导航 -->
  <view class="sec-nav">
    <view class="snav {{showAch || showSents ? '' : 'on'}}" catchtap="openWords">📖 单词</view>
    <view class="snav {{showAch ? 'on' : ''}}" catchtap="openAch">🏆 成就</view>
    <view class="snav {{showSents ? 'on' : ''}}" catchtap="openSents">📝 例句</view>
  </view>

  <view class="tabs" wx:if="{{!showAch && !showSents}}">
    <view class="tab {{tab === 0 ? 'on' : ''}}" data-tab="0" catchtap="switchTab">📝 学习中</view>
    <view class="tab {{tab === 1 ? 'on' : ''}}" data-tab="1" catchtap="switchTab">🔥 待复习</view>
    <view class="tab {{tab === 2 ? 'on' : ''}}" data-tab="2" catchtap="switchTab">✓ 已掌握</view>
    <view class="tab add" catchtap="addWord">+ 添加</view>
  </view>

  <view class="addbar {{showAddInput ? 'show' : ''}}">
    <input class="addinp" placeholder="输入英文单词" value="{{addInputValue}}" bindinput="onAddInput" bindconfirm="onAddConfirm" focus="{{showAddInput}}" />
    <view class="addok" catchtap="onAddBtn">添加</view>
  </view>

  <!-- 卡包视图 -->
  <scroll-view class="list" scroll-y wx:if="{{showPack}}" catchtap="closeSwipe">
    <view class="pk-detail" wx:if="{{selectedPack}}">
      <view class="pk-back" catchtap="selectPack" data-pack="">← 返回卡包</view>
      <view class="pk-hd"><text class="pk-e">{{packEmoji}}</text><text class="pk-n">{{packName}}</text></view>
      <view class="pk-word" wx:for="{{packWords}}" wx:key="word">
        <text class="pkw">{{item.word}}</text>
        <text class="pkd">{{item.def}}</text>
        <text class="pks">{{item.got ? '✅' : '🔒'}}</text>
      </view>
    </view>
    <view class="pk-grid" wx:else>
      <view class="pk-card {{packStats[index] >= item.words.length ? 'full' : ''}}" wx:for="{{PACKS}}" wx:key="id" wx:for-index="index" data-pack="{{item.id}}" catchtap="selectPack">
        <text class="pke">{{item.emoji}}</text>
        <text class="pkn">{{item.name}}</text>
        <text class="pkc">{{packStats[index] || 0}}/{{item.words.length}}</text>
        <view class="pkb"><view class="pkf" style="width:{{((packStats[index] || 0) / item.words.length * 100) + '%'}}"></view></view>
        <text class="pkch" wx:if="{{packStats[index] >= item.words.length}}">✅ 已集齐</text>
      </view>
    </view>
  </scroll-view>

  <!-- 故事视图 -->
  <scroll-view class="list" scroll-y wx:elif="{{showStoryView}}" catchtap="closeSwipe">
    <view class="story-card">
      <text class="sce">{{unlockedStories > 0 ? STORIES[unlockedStories - 1].icon : '🔒'}}</text>
      <text class="scsub">已解锁 {{unlockedStories}}/{{STORIES.length}} 章</text>
      <text class="sctxt" wx:if="{{unlockedStories > 0}}">「{{STORIES[unlockedStories - 1].text}}」</text>
      <text class="sctxt" wx:else style="color:#bbb">完成背词或集齐卡包即可解锁故事章节。</text>
    </view>
    <view class="story-list">
      <view class="si {{i < unlockedStories ? '' : 'locked'}}" wx:for="{{STORIES}}" wx:key="title" wx:for-index="i">
        <text class="sii">{{i + 1}}</text>
        <text class="sii2">{{i < unlockedStories ? item.icon : '🔒'}}</text>
        <text class="sit">{{i < unlockedStories ? ('第' + (i+1) + '章 · ' + item.title) : '??'}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 成就视图 -->
  <scroll-view class="list" scroll-y wx:elif="{{showAch}}" catchtap="closeSwipe">
    <view class="ag">
      <view class="agc {{achProgress[index] >= item.target ? 'done' : ''}}" wx:for="{{ACHS}}" wx:key="id" wx:for-index="index">
        <text class="agi">{{item.icon}}</text>
        <text class="agn">{{item.name}}</text>
        <text class="agd">{{item.desc}}</text>
        <view class="agp"><view class="agf" style="width:{{Math.min(100, (achProgress[index] || 0) / item.target * 100) + '%'}}"></view></view>
        <text class="aglock">{{achProgress[index] >= item.target ? '✅' : '🔒'}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 例句视图 -->
  <scroll-view class="list" scroll-y wx:elif="{{showSents}}" catchtap="closeSwipe">
    <view class="sents-ctrl">
      <text class="sents-cbtn" catchtap="sentFontDown">A−</text>
      <text class="sents-size">{{sentFontSize}}</text>
      <text class="sents-cbtn" catchtap="sentFontUp">A+</text>
    </view>
    <view class="empt" wx:if="{{savedSents.length === 0}}"><text class="emt">还没有收藏的例句</text><text class="emh">在翻卡时点击⭐即可收藏</text></view>
    <view class="sc" wx:for="{{savedSents}}" wx:key="en" wx:for-index="idx">
      <view class="sc-del" catchtap="toggleSaveSent" data-idx="{{idx}}">🗑️</view>
      <text class="sce" style="font-size:{{sentFontSize}}rpx">{{item.en}}</text>
      <text class="scc" style="font-size:{{sentFontSize - 2}}rpx">{{item.cn}}</text>
      <text class="scs">📖 {{item.src || ''}}</text>
    </view>
  </scroll-view>

  <!-- 单词列表 -->
  <scroll-view class="list" scroll-y wx:else catchtap="closeSwipe">
    <view class="empty" wx:if="{{filteredWords.length === 0 && !loading}}">
      <text>📝 暂无单词</text>
      <text class="hint">从真题阅读自动收集，或点右上角 + 添加</text>
      <view class="empty-btn" catchtap="goReading">去做阅读题</view>
    </view>
    <view class="skeleton" wx:elif="{{loading}}">
      <view class="skel-spin"></view>
      <text class="skel-text">提取单词中...</text>
    </view>
    <view class="wcard-wrap" wx:for="{{filteredWords}}" wx:key="word" wx:for-index="idx" data-idx="{{idx}}" bindtouchstart="swipeStart" bindtouchmove="swipeMove" bindtouchend="swipeEnd">
      <view class="wcard {{swipedIdx === idx ? 'open' : ''}}">
        <view class="wi {{item.status === 'master' ? 'master' : item.status === 'review' ? 'review' : 'new'}}">
          <text>{{item.word ? item.word[0].toUpperCase() : ''}}</text>
        </view>
        <view class="wb">
          <text class="ww">{{item.word}}</text>
          <text class="wp" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
          <text class="wcn">{{item.chn || item.definition || ''}}</text>
          <text class="wsrc" wx:if="{{item.context}}">{{item.context}}</text>
          <text class="wsrc" wx:if="{{item.source}}">📖 {{item.source}}</text>
        </view>
        <view class="wmode" wx:if="{{mode === 'battle'}}">
          <text wx:for="{{5 - Math.min(4, item.correctStreak)}}" wx:key="*this">❤️</text>
          <text wx:for="{{Math.min(4, item.correctStreak)}}" wx:key="*this">🖤</text>
        </view>
        <view wx:elif="{{mode === 'garden'}}" class="wmode">
          <text wx:if="{{item.growth <= 0}}">🌱</text>
          <text wx:elif="{{item.growth <= 1}}">🌿</text>
          <text wx:elif="{{item.growth <= 2}}">🌹</text>
          <text wx:else>🌳</text>
        </view>
        <view wx:elif="{{mode === 'card'}}" class="wmode">
          <text wx:for="{{Math.min(3, item.stars)}}" wx:key="*this">⭐</text>
          <text wx:for="{{3 - Math.min(3, item.stars)}}" wx:key="*this">☆</text>
        </view>
        <view class="wact {{item.status === 'master' ? 'done' : ''}} {{!item.chn ? 'lookup' : ''}}" data-idx="{{idx}}" catchtap="{{item.chn ? 'startGame' : 'lookupWord'}}">
          {{item.status === 'master' ? '✓' : (item.chn ? '浏览' : '查词')}}
        </view>
      </view>
      <view class="wdel" catchtap="deleteWord" data-word="{{item.word}}">删除</view>
    </view>
  </scroll-view>

  <!-- 翻卡 -->
  <view class="game-overlay {{gameWord || gameLoading ? 'show' : ''}}" catchtap="closeGame">
    <view class="flip-ctn {{gameWord || gameLoading ? 'show' : ''}}" catchtap="">
      <view wx:if="{{!gameWord && gameLoading}}"><view class="gloading">加载中，请稍后…</view></view>
      <view class="flip-inner {{gameFlipped ? 'flipped' : ''}}" wx:elif="{{gameWord}}">
        <view class="flip-front" catchtap="flipCard">
          <view class="gtop">
            <text class="gprog">{{gameWordIdx - gameSessionStart + 1}}/{{gameSessionLimit}}</text>
            <view class="gclose" catchtap="closeGame">✕</view>
          </view>
          <view wx:if="{{mode === 'battle'}}">
            <text class="gcombo" wx:if="{{combo > 1}}">🔥 {{combo}} 连击</text>
            <text class="gmonster"><text wx:if="{{(gameWordIdx - gameSessionStart) % 5 === 0}}">👹</text><text wx:elif="{{(gameWordIdx - gameSessionStart) % 5 === 1}}">🐉</text><text wx:elif="{{(gameWordIdx - gameSessionStart) % 5 === 2}}">👾</text><text wx:elif="{{(gameWordIdx - gameSessionStart) % 5 === 3}}">🧟</text><text wx:else>🐺</text></text>
            <view class="gmonster-hp"><text wx:for="{{5 - Math.min(4, gameWord.correctStreak)}}" wx:key="*this">❤️</text><text wx:for="{{Math.min(4, gameWord.correctStreak)}}" wx:key="*this">🖤</text></view>
          </view>
          <view wx:elif="{{mode === 'garden'}}" class="ggarden">
            <text class="gplant"><text wx:if="{{gameWord.growth <= 0}}">🌱</text><text wx:elif="{{gameWord.growth <= 1}}">🌿</text><text wx:elif="{{gameWord.growth <= 2}}">🌹</text><text wx:else>🌳</text></text>
            <text class="gmsg"><text wx:if="{{gameWord.growth <= 0}}">刚种下这颗种子</text><text wx:elif="{{gameWord.growth <= 1}}">小苗正在生长</text><text wx:elif="{{gameWord.growth <= 2}}">花开了</text><text wx:else>已长成大树</text></text>
          </view>
          <view wx:elif="{{mode === 'card'}}" class="gcard">
            <text class="gbadge"><text wx:if="{{gameWord.stars <= 0}}">🃏</text><text wx:elif="{{gameWord.stars <= 1}}">🎴</text><text wx:elif="{{gameWord.stars <= 2}}">💎</text><text wx:else>🌟</text></text>
            <text class="grarity {{gameWord.stars <= 0 ? 'N' : gameWord.stars <= 1 ? 'R' : gameWord.stars <= 2 ? 'SR' : 'SSR'}}"><text wx:if="{{gameWord.stars <= 0}}">N</text><text wx:elif="{{gameWord.stars <= 1}}">R</text><text wx:elif="{{gameWord.stars <= 2}}">SR</text><text wx:else>SSR</text></text>
          </view>
          <text class="gq" wx:if="{{gameWord.source}}">📖 {{gameWord.source.split('/')[0].trim()}}</text>
          <text class="gw">{{gameWord.word}}</text>
          <text class="gp" wx:if="{{gameWord.phonetic}}">{{gameWord.phonetic}}</text>
          <text class="gctx" wx:if="{{gameWord.context}}">{{gameWord.context}}</text>
          <view class="speaker" catchtap="speakWord">🔊 听发音</view>
          <text class="ghint">点击翻转</text>
        </view>
        <view class="flip-back" catchtap="flipCard">
          <view class="gtop">
            <text class="gprog">{{gameWordIdx - gameSessionStart + 1}}/{{gameSessionLimit}}</text>
            <view class="gclose" catchtap="closeGame">✕</view>
          </view>
          <text class="fbw">{{gameWord.word}}</text>
          <text class="fbp" wx:if="{{gameWord.phonetic}}">{{gameWord.phonetic}}</text>
          <view class="gc">{{gameWord.chn}}</view>
          <text class="gctxcn" wx:if="{{gameWord.contextCn}}">{{gameWord.contextCn}}</text>
          <view class="gsave" catchtap="toggleSaveSent" data-en="{{gameWord.context}}" data-cn="{{gameWord.contextCn}}" data-src="{{gameWord.word}}·{{gameWord.source}}">⭐ 收藏例句</view>
          <view class="gacts">
            <view class="gb hard" catchtap="markHard">😵 不认识</view>
            <view class="gb known" catchtap="markKnown">✅ 认识</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 庆祝 -->
  <view class="celebrate {{celebrateShow ? 'show' : ''}}">
    <view class="cbox">
      <text class="cemoji">{{mode === 'battle' ? '⚔️' : mode === 'garden' ? '🌸' : '🎴'}}</text>
      <text class="ctit">{{mode === 'battle' ? 'BOSS 击败！' : mode === 'garden' ? '花园又长大了！' : '新卡包解锁！'}}</text>
      <text class="csub">本轮完成，累计掌握 {{mastered}} 个词</text>
      <view class="cbtn" catchtap="closeCelebrate">继续加油 💪</view>
    </view>
  </view>
  <canvas class="confetti" id="confettiCanvas" type="2d"></canvas>

  <!-- 故事弹窗 -->
  <view class="spop {{showStory ? 'show' : ''}}">
    <view class="spox">
      <text class="spe">{{showStory ? STORIES[storyIdx].icon : ''}}</text>
      <text class="spt">第 {{storyIdx + 1}} 章 · {{showStory ? STORIES[storyIdx].title : ''}}</text>
      <text class="sptxt">{{showStory ? STORIES[storyIdx].text : ''}}</text>
      <view class="spbtn" catchtap="closeStory">继续背词 🚀</view>
    </view>
  </view>

  <view class="mm-overlay {{showManualModal ? 'show' : ''}}" catchtap="cancelManualModal">
    <view class="mm-box" catchtap="">
      <view class="mm-ttl">未查询到「{{manualModalWord}}」</view>
      <input class="mm-inp" placeholder="输入中文释义后回车添加" value="{{manualModalValue}}" bindinput="onManualInput" bindconfirm="confirmManualModal" focus="{{showManualModal}}" />
      <view class="mm-btns">
        <view class="mm-btn" catchtap="cancelManualModal">取消</view>
        <view class="mm-btn mm-pri" catchtap="confirmManualModal">确定</view>
      </view>
    </view>
  </view>
</view>