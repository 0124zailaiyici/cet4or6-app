.page { min-height: 100vh; background: #f3eeed; display: flex; flex-direction: column; }
.topbar {
  display: flex; align-items: center; gap: 10px;
  padding: 48rpx 24rpx 14rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #ffb3c6, #ff8fab); color: #fff;
}
.topbar h1 { flex: 1; font-size: 34rpx; font-weight: 800; }
.add-btn { font-size: 22rpx; background: rgba(255,255,255,0.2); padding: 6rpx 18rpx; border-radius: 12rpx; }

.stats { display: flex; gap: 8rpx; margin: 12rpx 14rpx; }
.st { flex: 1; background: #fff; border-radius: 14rpx; padding: 14rpx; text-align: center; box-shadow: 0 2rpx 12rpx rgba(255,158,181,0.04); }
.st .n { display: block; font-size: 32rpx; font-weight: 800; color: #ff6b8a; }
.st .n.g { color: #388e3c; }
.st .l { display: block; font-size: 20rpx; color: #8a7a9a; margin-top: 2rpx; }

.tabs { display: flex; gap: 4rpx; margin: 0 14rpx 10rpx; }
.tab { flex: 1; text-align: center; padding: 12rpx 0; font-size: 22rpx; color: #8a7a9a; background: #fff; border-radius: 12rpx; }
.tab.on { color: #ff6b8a; font-weight: 600; background: rgba(255,107,138,0.06); border: 2rpx solid rgba(255,107,138,0.12); }

.list { flex: 1; padding: 0 14rpx 20rpx; }
.wcard { background: #fff; border-radius: 16rpx; padding: 16rpx 18rpx; box-shadow: 0 2rpx 12rpx rgba(255,158,181,0.04); display: flex; align-items: center; gap: 14rpx; margin-bottom: 10rpx; }
.wi { width: 56rpx; height: 56rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 800; flex-shrink: 0; }
.wi.new { background: rgba(255,107,138,0.06); color: #ff6b8a; }
.wi.review { background: rgba(255,152,0,0.06); color: #f57c00; }
.wi.master { background: rgba(56,142,60,0.06); color: #388e3c; }
.wb { flex: 1; }
.ww { display: block; font-size: 30rpx; font-weight: 700; color: #2d2d4e; margin-bottom: 2rpx; }
.wdef { display: block; font-size: 22rpx; color: #2d2d4e; margin-bottom: 2rpx; }
.wsrc { display: block; font-size: 20rpx; color: #ccc; }
.wstreak { display: flex; align-items: center; margin-top: 4rpx; }
.sd { font-size: 16rpx; color: #d0c8d0; margin-right: 4rpx; }
.sd.on { color: #ff6b8a; }
.wact { font-size: 22rpx; color: #ff6b8a; padding: 6rpx 16rpx; border-radius: 10rpx; border: 2rpx solid rgba(255,107,138,0.12); flex-shrink: 0; }
.wact.done { color: #388e3c; border-color: rgba(56,142,60,0.12); background: rgba(56,142,60,0.04); }

.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; font-size: 28rpx; color: #8a7a9a; }
.empty .hint { font-size: 24rpx; margin-top: 8rpx; }

/* Game overlay */
.goverlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 100; }
.gcard { background: #fff; border-radius: 24rpx; padding: 36rpx 28rpx; width: 620rpx; text-align: center; box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.2); }
.gsrc { display: block; font-size: 20rpx; color: #ff6b8a; font-weight: 600; margin-bottom: 6rpx; }
.gw { display: block; font-size: 48rpx; font-weight: 800; color: #2d2d4e; margin-bottom: 4rpx; }
.gp { display: block; font-size: 24rpx; color: #8a7a9a; margin-bottom: 24rpx; }
.gopts { display: flex; flex-direction: column; gap: 10rpx; }
.go { padding: 20rpx 24rpx; border-radius: 14rpx; font-size: 26rpx; color: #4a4a6a; background: #f8f5f4; border: 2rpx solid #ece4e2; text-align: left; transition: 0.15s; }
.go.right { color: #388e3c; border-color: #388e3c; background: rgba(56,142,60,0.04); }
.go.wrong { color: #d32f2f; border-color: #d32f2f; background: rgba(211,47,47,0.04); }
.gf { display: flex; gap: 12rpx; margin-top: 20rpx; }
.gb { flex: 1; padding: 18rpx; border-radius: 14rpx; font-size: 26rpx; font-weight: 600; }
.gb.skip { background: #fff0f3; color: #8a7a9a; }
.gb.next { background: linear-gradient(135deg, #ff8fab, #ff6b8a); color: #fff; }

/* Dark */
.dark-theme.page { background: #12121f !important; }
.dark-theme .topbar { background: linear-gradient(135deg, #2a2a4a, #1a1a38) !important; }
.dark-theme .st { background: #1e1e38 !important; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.25) !important; }
.dark-theme .st .l { color: #a090b0 !important; }
.dark-theme .tab { background: #1e1e38 !important; color: #a090b0 !important; }
.dark-theme .tab.on { color: #ff8fab !important; background: rgba(255,143,171,0.08) !important; border-color: rgba(255,143,171,0.2) !important; }
.dark-theme .wcard { background: #1e1e38 !important; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.25) !important; }
.dark-theme .ww { color: #e0d0e8 !important; }
.dark-theme .wdef { color: #a090b0 !important; }
.dark-theme .wsrc { color: #6a6a8a !important; }
.dark-theme .wact { color: #ff8fab !important; border-color: rgba(255,143,171,0.15) !important; }
.dark-theme .wact.done { color: #66bb6a !important; }
.dark-theme .gcard { background: #1e1e38 !important; }
.dark-theme .gw { color: #e0d0e8 !important; }
.dark-theme .go { background: #2a2a4a !important; border-color: #3a3a5a !important; color: #a090b0 !important; }
.dark-theme .go.right { color: #66bb6a !important; border-color: #66bb6a !important; }
.dark-theme .go.wrong { color: #ef5350 !important; border-color: #ef5350 !important; }
.dark-theme .empty { color: #a090b0 !important; }
