.dark-theme .pa-label, .dark-theme .pc-label, .dark-theme .q-hint,
.dark-theme .h-bar, .dark-theme .hc-index, .dark-theme .sb-input,
.dark-theme .topic-count, .dark-theme .sc-tag, .dark-theme .sc-action-label,
