page, .page {
  --shadow: rgba(255, 158, 181, 0.1);
  --border: #ffd9e0;
  --white: #ffffff;
  --text-primary: #2d2d4e;
  --text-secondary: #8a7a9a;
  --card-bg: #ffffff;
  --tag-bg: #fff0f3;
  --pink: #ff6b8a;
}

.dark-theme {
  --shadow: rgba(0, 0, 0, 0.3);
  --border: #3a3a5a;
  --white: #1e1e38;
  --text-primary: #e0d0e8;
  --text-secondary: #a090b0;
  --card-bg: #1e1e38;
  --tag-bg: #2a2a4a;
  --pink: #ff8fab;
}

page {
  height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  box-sizing: border-box;
}

.page {
  background-color: #fff5f7;
  color: #2d2d4e;
  box-sizing: border-box;
}

view, text, scroll-view { box-sizing: border-box; }

/* ==================== Dark mode ==================== */
.dark-theme.page, .page.dark-theme {
  background-color: #12121f !important;
  color: #e0d0e8 !important;
}

/* ---- Global cards ---- */
.dark-theme .card, .dark-theme .lcard, .dark-theme .rcard,
.dark-theme .fcard, .dark-theme .hcard, .dark-theme .search-box,
.dark-theme .goal-card, .dark-theme .tip-block, .dark-theme .prompt-card,
.dark-theme .practice-area, .dark-theme .result-box, .dark-theme .detail-root,
.dark-theme .rh-header, .dark-theme .pass-zone, .dark-theme .quest-zone,
.dark-theme .qz-c-card, .dark-theme .audio-player, .dark-theme .page-view,
.dark-theme .ref-scroll, .dark-theme .ref-text, .dark-theme .sentence-item,
.dark-theme .stat-card, .dark-theme .st-card, .dark-theme .st-card-item,
.dark-theme .page-header, .dark-theme .hero-actions, .dark-theme .stats-banner,
.dark-theme .module-card, .dark-theme .stat-box, .dark-theme .set-card,
.dark-theme .player, .dark-theme .d-sbox, .dark-theme .calendar,
.dark-theme .s-card, .dark-theme .imm-card, .dark-theme .gen-modal,
.dark-theme .topic-section, .dark-theme .mode-bar, .dark-theme .result-card,
.dark-theme .q-bubble, .dark-theme .input-area, .dark-theme .progress-card,
.dark-theme .detail-header, .dark-theme .s-header, .dark-theme .st-header,
.dark-theme .f-header, .dark-theme .w-header, .dark-theme .l-header,
.dark-theme .calendar-card, .dark-theme .section-card {
  background-color: #1e1e38 !important;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3) !important;
}

/* ---- Page headers / gradients ---- */
.dark-theme .hero-bg, .dark-theme .lh-bg, .dark-theme .sth-bg,
.dark-theme .wh-bg, .dark-theme .fh-bg, .dark-theme .sh-bg,
.dark-theme .rh-bg {
  background: linear-gradient(135deg, #2a2a4a, #1a1a38) !important;
}

