.dark-theme .se-play, .dark-theme .se-hard, .dark-theme .p-nav,
.dark-theme .back-btn, .dark-theme .tb-back, .dark-theme .sh-btn,
.dark-theme .mode-btn, .dark-theme .topic-pill, .dark-theme .gen-count-btn,
.dark-theme .gen-close, .dark-theme .gen-type-btn, .dark-theme .empty-btn,
.dark-theme .nav-btn, .dark-theme .hb-l, .dark-theme .search-btn,
.dark-theme .d-back, .dark-theme .btn-retry, .dark-theme .clear-btn,
.dark-theme .qo, .dark-theme .qzo, .dark-theme .qzc, .dark-theme .qb-l,
.dark-theme .stat-card, .dark-theme .st-card, .dark-theme .st-card-item,
.dark-theme .pa-btn, .dark-theme .sc-fav, .dark-theme .sc-master,
.dark-theme .sc-action-label, .dark-theme .go-back, .dark-theme .back-top,
.dark-theme .hero-btn, .dark-theme .hero-checkin, .dark-theme .btn-go,
.dark-theme .gen-submit, .dark-theme .detail-complete, .dark-theme .nav-icon,
.dark-theme .ft-item, .dark-theme .wt-item, .dark-theme .tab {
