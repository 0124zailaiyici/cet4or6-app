.dark-theme .cal-h, .dark-theme .s-pill:not(.active), .dark-theme .set-btn,
.dark-theme .goal-icon, .dark-theme .tip-text, .dark-theme .hero-greeting,
.dark-theme .lh-sub, .dark-theme .sh-sub, .dark-theme .sth-sub,
.dark-theme .fh-sub, .dark-theme .wh-sub, .dark-theme .rh-sub,
.dark-theme .rc-meta, .dark-theme .pz-num, .dark-theme .ap-time,
.dark-theme .p-section, .dark-theme .se-num, .dark-theme .sc-chinese,
.dark-theme .imm-chinese, .dark-theme .empty-desc, .dark-theme .gen-hint,
.dark-theme .lc-text, .dark-theme .h-date, .dark-theme .h-ans,
