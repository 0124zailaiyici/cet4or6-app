page, .page {
  --shadow: rgba(255, 158, 181, 0.1);
  --border: #ffd9e0;
  --white: #ffffff;
}

.dark-theme {
  --shadow: rgba(0, 0, 0, 0.3);
  --border: #3a3a5a;
  --white: #1e1e38;
}

page {
  height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  box-sizing: border-box;
}

.page {
  background-color: #fff5f7;
  color: #2d2d4e;
  box-sizing: border-box;
}

view, text, scroll-view { box-sizing: border-box; }

/* ==================== Dark overrides ==================== */
.dark-theme.page, .page.dark-theme {
  background-color: #12121f !important;
  color: #e0d0e8 !important;
}
.dark-theme .card, .dark-theme .module-card, .dark-theme .stats-section,
.dark-theme .checkin-card, .dark-theme .s-card, .dark-theme .tcard,
.dark-theme .lcard, .dark-theme .wcard, .dark-theme .stat-box,
.dark-theme .goal-card, .dark-theme .search-box, .dark-theme .player,
.dark-theme .d-sbox, .dark-theme .set-card, .dark-theme .calendar {
  background-color: #1e1e38 !important;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3) !important;
}
.dark-theme .page-title, .dark-theme .mc-name, .dark-theme .s-card .sc-english,
.dark-theme .scard-text, .dark-theme .tcard-cn, .dark-theme .lcard-name,
.dark-theme .wcard-pat, .dark-theme .cc-label, .dark-theme .stat-num,
.dark-theme .set-label, .dark-theme .set-num, .dark-theme .cal-month {
  color: #e0d0e8 !important;
}
.dark-theme .mc-desc, .dark-theme .lcard-meta, .dark-theme .tcard-src,
.dark-theme .scard-tag, .dark-theme .stat-lbl, .dark-theme .cal-h,
.dark-theme .s-pill:not(.active), .dark-theme .set-btn {
  color: #a090b0 !important;
  background-color: #2a2a4a !important;
}

/* Hidden scrollbar for all scroll-views */
scroll-view ::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}
