.dark-theme .hero-title, .dark-theme .hero-greeting, .dark-theme .hero-text,
.dark-theme .detail-title, .dark-theme .section-title, .dark-theme .section-subtitle,
.dark-theme .mc-name, .dark-theme .lcard-name, .dark-theme .rc-title,
.dark-theme .lc-title, .dark-theme .lh-title, .dark-theme .sh-title,
.dark-theme .sth-title, .dark-theme .fh-title, .dark-theme .wh-title,
.dark-theme .rh-title, .dark-theme .tb-title, .dark-theme .sc-english,
.dark-theme .imm-english, .dark-theme .empty-title, .dark-theme .gen-title,
.dark-theme .scard-text, .dark-theme .tcard-cn, .dark-theme .wcard-pat,
.dark-theme .cc-label, .dark-theme .cal-month, .dark-theme .set-label,
.dark-theme .set-num, .dark-theme .stat-num, .dark-theme .st-num,
.dark-theme .goal-label, .dark-theme .goal-num, .dark-theme .p-stem,
.dark-theme .qz-question, .dark-theme .qz-label, .dark-theme .se-en,
.dark-theme .pz-text, .dark-theme .pc-tip, .dark-theme .pc-num,
.dark-theme .d-title, .dark-theme .q-text, .dark-theme .input-field,
.dark-theme .h-title, .dark-theme .sc-title, .dark-theme .cal-title,
.dark-theme .word, .dark-theme .def-text, .dark-theme .d-nav,
.dark-theme .nav-title, .dark-theme .wc-pat, .dark-theme .pat-text,
