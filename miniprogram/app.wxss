/* ---- Dividers / borders ---- */
.dark-theme .divider, .dark-theme .goal-item, .dark-theme .st-item,
.dark-theme .sentence-item, .dark-theme .qb-item, .dark-theme .fav-item,
.dark-theme .dict-def, .dark-theme .history-item, .dark-theme .h-item,
.dark-theme .st-item-row, .dark-theme .sc-bottom, .dark-theme .def-item,
.dark-theme .tab, .dark-theme .gen-type-btn,
.dark-theme .p-stem, .dark-theme .controls-bar, .dark-theme .player-bar,
.dark-theme .topbar, .dark-theme .detail-header, .dark-theme .w-tabs,
.dark-theme .f-tabs, .dark-theme .tabs, .dark-theme .mode-bar,
.dark-theme .search-bar, .dark-theme .search-box, .dark-theme .input-area,
