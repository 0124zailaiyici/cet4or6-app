page {
  height: 100vh;
  background-color: #fff5f7;
  color: #2d2d4e;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  box-sizing: border-box;
}

view, text, scroll-view {
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 181, 0.12);
}
