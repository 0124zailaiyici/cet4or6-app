page, .page {
  --bg: #fff5f7;
  --card-bg: #ffffff;
  --tag-bg: #fff0f3;
  --text-primary: #2d2d4e;
  --text-secondary: #8a7a9a;
  --text-tertiary: #6a6a8a;
  --pink: #ff9eb5;
  --pink-dark: #ff8a80;
  --mint: #c5e1a5;
  --blue: #b5d8f7;
  --peach: #ffd3b6;
  --purple: #d8b4fe;
  --gold: #ffd700;
  --shadow: rgba(255, 158, 181, 0.1);
  --border: #ffd9e0;
  --white: #ffffff;
}

.dark-theme {
  --bg: #12121f;
  --card-bg: #1e1e38;
  --tag-bg: #2a2a4a;
  --text-primary: #e0d0e8;
  --text-secondary: #a090b0;
  --text-tertiary: #807090;
  --pink-dark: #e8839a;
  --mint: #8db87a;
  --blue: #7fa8d8;
  --peach: #e8b898;
  --purple: #b88ad8;
  --gold: #e8c800;
  --shadow: rgba(0, 0, 0, 0.3);
  --border: #3a3a5a;
  --white: #1e1e38;
}

page {
  height: 100vh;
  background-color: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  box-sizing: border-box;
}

.page {
  background-color: var(--bg);
}

view, text, scroll-view {
  box-sizing: border-box;
}

.card {
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx var(--shadow);
}
