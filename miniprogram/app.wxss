  color: #a090b0 !important;
}
.dark-theme .spd.on, .dark-theme .ctl.on, .dark-theme .speed-btn.active,
.dark-theme .ctrl-btn.active, .dark-theme .tab.active, .dark-theme .mode-btn.active,
.dark-theme .s-pill.active, .dark-theme .topic-pill.active,
.dark-theme .gen-type-btn.on, .dark-theme .ft-item.active,
.dark-theme .wt-item.active, .dark-theme .sh-btn-primary,
.dark-theme .qo.on, .dark-theme .qzo.on, .dark-theme .se-play.playing,
.dark-theme .se-hard.active, .dark-theme .qb-l:active,
.dark-theme .sc-fav.fav-on, .dark-theme .sc-master.master-on {
  color: #ff8fab !important;
  border-color: rgba(255,143,171,0.2) !important;
  background-color: rgba(255,143,171,0.08) !important;
}

/* ---- Pause button / primary accent ---- */
.dark-theme .pb-play, .dark-theme .p-play, .dark-theme .detail-complete,
.dark-theme .btn-go, .dark-theme .gen-submit, .dark-theme .hero-btn,
.dark-theme .hero-checkin.done, .dark-theme .lc-check.done {
  background: linear-gradient(135deg, #4a4a7a, #3a3a6a) !important;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3) !important;
}

/* ---- Toggle switch ---- */
.dark-theme .toggle-btn { background-color: #2a2a4a !important; }
.dark-theme .toggle-btn.on { background-color: #ff8fab !important; }
.dark-theme .toggle-knob { background-color: #ffffff !important; }

/* ---- Scrollbar ---- */
.dark-theme ::-webkit-scrollbar-thumb { background: #3a3a5a !important; }

/* ---- Inputs / textarea ---- */
.dark-theme .input-field, .dark-theme .search-input, .dark-theme .pa-input,
.dark-theme .sb-input, .dark-theme .gen-input, .dark-theme .paste-area {
  background-color: #2a2a4a !important;
  color: #e0d0e8 !important;
  border-color: #3a3a5a !important;
}

/* ---- Charts / progress ---- */
.dark-theme .pb-fill, .dark-theme .ap-fill, .dark-theme .home-progress .fill,
.dark-theme .cb-fill, .dark-theme .rc-dfill, .dark-theme .chart-bar .fill {
  background: linear-gradient(90deg, #4a4a7a, #3a3a6a) !important;
}
.dark-theme .ap-thumb { background: #4a4a7a !important; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4) !important; }

/* ---- calendar dots ---- */
.dark-theme .cal-d { background: #2a2a4a !important; }
.dark-theme .cal-d.checked { background: #ff8fab !important; }
.dark-theme .cal-d.today { border-color: #e0d0e8 !important; }

/* ---- status dots ---- */
.dark-theme .pzd, .dark-theme .qzd, .dark-theme .pd, .dark-theme .b-dot,
.dark-theme .st-bar .d { background: #2a2a4a !important; }
.dark-theme .pzd.on, .dark-theme .qzd.on, .dark-theme .pd.on, .dark-theme .b-dot.on,
.dark-theme .st-bar .d.on { background: #a090b0 !important; }

/* ---- ap bar ---- */
.dark-theme .ap-bar, .dark-theme .pb-progress { background: #2a2a4a !important; }

/* ---- Reading options ---- */
.dark-theme .pass-zone { background: transparent !important; }
.dark-theme .pz-scroll { background: #1e1e38 !important; }
.dark-theme .qz-q-scroll { background: #1e1e38 !important; }

/* ---- Blank tags ---- */
.dark-theme .bk-tag { color: #ff8fab !important; border-color: #ff8fab !important; }
.dark-theme .bk-tag.filled { color: #e0d0e8 !important; border-color: #4a4a7a !important; background: rgba(74,74,122,0.1) !important; }
.dark-theme .bk-tag.active { color: #fff !important; background: #ff8fab !important; border-color: #ff8fab !important; }

/* ---- badges ---- */
.dark-theme .rc-badge, .dark-theme .tb-badge {
  background: #2a2a4a !important;
}

/* ---- Stars ---- */
.dark-theme .sc-fav.fav-on, .dark-theme .fc-remove { color: #ff8fab !important; }

/* ===== Loading Skeleton ===== */
.skeleton { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 200rpx 0; }
.skel-spin { width: 60rpx; height: 60rpx; border: 6rpx solid #fff0f3; border-top-color: #ff6b8a; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
.skel-text { font-size: 26rpx; color: #8a7a9a; }

/* Empty state action button */
.empty-btn { margin-top: 24rpx; padding: 14rpx 36rpx; border-radius: 14rpx; background: linear-gradient(135deg, #ff8fab, #ff6b8a); color: #fff; font-size: 26rpx; font-weight: 600; }
.dark-theme .empty-btn { background: linear-gradient(135deg, #4a4a7a, #3a3a6a) !important; }

.dark-theme .skel-spin { border-color: #2a2a4a; border-top-color: #ff8fab; }
.dark-theme .skel-text { color: #a090b0; }
